---
import '@/styles/global.css';
import '@/styles/layout.css';
import { url } from '@/lib/url';
import { getCurrentUser } from '@/lib/api';

interface Props {
  title?: string;
}

const { title = 'Tennis Club' } = Astro.props;

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const currentUser = await getCurrentUser(sessionCookie);
---

<!doctype html>
<html lang="pl" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Tennis Club</title>
  <link rel="icon" href={url('/favicon.ico')} type="image/x-icon" />
</head>

<body class="public-layout">
  <nav class="public-nav">
    <div class="nav-container">
      <a href={url('/')} class="nav-brand">🎾 Tennis Club</a>
      <div class="nav-actions">
        {currentUser ? (
          <a href={url('/dashboard')} class="tc-btn tc-btn-primary tc-btn-sm">Panel główny</a>
        ) : (
          <div class="nav-auth-wrapper">
            <!-- Desktop: Dwa przyciski -->
            <div class="nav-auth-desktop">
              <a href={url('/login')} class="tc-btn tc-btn-secondary tc-btn-sm">Zaloguj się</a>
              <a href={url('/register')} class="tc-btn tc-btn-primary tc-btn-sm">Zarejestruj się</a>
            </div>
            
            <!-- Mobile: Jeden przycisk z menu -->
            <div class="nav-auth-mobile">
              <button id="mobile-auth-btn" class="tc-btn tc-btn-primary tc-btn-sm">
                Logowanie ▾
              </button>
              <div id="mobile-auth-dropdown" class="auth-dropdown">
                <a href={url('/login')}>Zaloguj się</a>
                <a href={url('/register')}>Zarejestruj się</a>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </nav>

  <script>
    const btn = document.getElementById('mobile-auth-btn');
    const dropdown = document.getElementById('mobile-auth-dropdown');
    
    if (btn && dropdown) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('is-open');
      });
      
      // Zamknij menu po kliknięciu poza nie
      document.addEventListener('click', () => {
        dropdown.classList.remove('is-open');
      });
    }
  </script>

  <main class="public-main">
    <slot />
  </main>

  <footer class="public-footer">
    <div class="footer-container">
      <p>&copy; {new Date().getFullYear()} Tennis Club. Wszystkie prawa zastrzeżone.</p>
    </div>
  </footer>
</body>
</html>
