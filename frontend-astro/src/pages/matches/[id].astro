---
// matches/[id].astro — detal meczu towarzyskiego
// GET /api/matches/<id>/  (IsAuthenticated — wymaga cookie sesji)
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import MatchEditForm from '@/components/MatchEditForm.tsx';
import { getMatch, getCurrentUser, type MatchHistoryEntry } from '@/lib/api';
import { url } from '@/lib/url';

const { id } = Astro.params;
const matchId = id ? parseInt(id, 10) : NaN;

if (isNaN(matchId)) {
  return Astro.redirect(url('/matches'));
}

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const [match, currentUser] = await Promise.all([
  getMatch(matchId, sessionCookie),
  getCurrentUser(sessionCookie),
]);

// Nie znaleziono meczu lub brak dostępu
if (!match) {
  return Astro.redirect(url('/matches'));
}

// ── Helpery ────────────────────────────────────────────────────────────────

function userName(u: MatchHistoryEntry['p1']): string {
  if (!u) return '—';
  const full = `${u.first_name} ${u.last_name}`.trim();
  return full || u.username;
}

function userInitials(u: MatchHistoryEntry['p1']): string {
  if (!u) return '?';
  const parts = [u.first_name, u.last_name].filter(Boolean);
  if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
  return (u.username?.[0] ?? '?').toUpperCase();
}

function fmtDate(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString('pl-PL', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    });
  } catch { return iso; }
}

// Sety: lista par [p1_gems, p2_gems] dla rozegranych setów
const sets: Array<[number, number]> = [];
if (match.p1_set1 != null && match.p2_set1 != null) sets.push([match.p1_set1, match.p2_set1]);
if (match.p1_set2 != null && match.p2_set2 != null) sets.push([match.p1_set2, match.p2_set2]);
if (match.p1_set3 != null && match.p2_set3 != null) sets.push([match.p1_set3, match.p2_set3]);

const scoreStr = sets.map(([a, b]) => `${a}:${b}`).join(', ') || '—';

// Kto wygrał
const p1Won = match.win === 'p1';
const p2Won = match.win === 'p2';

// Czy zalogowany user jest uczestnikiem — do podświetlenia "Twój" wynik
const myId = currentUser?.id ?? null;
const iAmP1 = myId === match.p1?.id || myId === match.p3?.id;
const iAmP2 = myId === match.p2?.id || myId === match.p4?.id;

const myResult = iAmP1 ? (p1Won ? 'win' : 'loss') : iAmP2 ? (p2Won ? 'win' : 'loss') : null;
const resultLabel = myResult === 'win' ? 'Twoja wygrana' : myResult === 'loss' ? 'Twoja porażka' : null;
const resultClass = myResult === 'win' ? 'result--win' : myResult === 'loss' ? 'result--loss' : '';

const typeLabel = match.description
  ? match.description.charAt(0) + match.description.slice(1).toLowerCase()
  : 'Mecz';
const formatLabel = match.match_double ? 'Debel' : 'Singiel';

// Drużyny (dla debla: p1+p3 vs p2+p4)
const team1 = [match.p1, match.p3].filter(Boolean) as NonNullable<MatchHistoryEntry['p1']>[];
const team2 = [match.p2, match.p4].filter(Boolean) as NonNullable<MatchHistoryEntry['p1']>[];

const canEdit = match.can_edit ?? false;

// is_tournament + link do turnieju
const isTournament = match.is_tournament ?? false;
const tournamentId = match.tournament_id ?? null;

// score_status / reported_by
const scoreStatus   = match.score_status ?? null;     // 'PENDING' | 'CONFIRMED' | null
const reportedBy    = match.reported_by   ?? null;

// Czy zalogowany user jest uczestnikiem ale nie może edytować (np. mecz turniejowy)
const iAmParticipant = iAmP1 || iAmP2;

---

<AppLayout
  title={`Mecz #${matchId}`}
  showSearch={false}
  showCta={false}
  currentUser={currentUser}
>

  {canEdit ? (
    <MatchEditForm
      client:load
      matchId={matchId}
      matchesUrl={url('/matches')}
      p1Label={team1.map(u => u.first_name || u.username).join(' / ')}
      p2Label={team2.map(u => u.first_name || u.username).join(' / ')}
      initialSets={{
        p1_set1: String(match.p1_set1 ?? ''),
        p2_set1: String(match.p2_set1 ?? ''),
        p1_set2: String(match.p1_set2 ?? ''),
        p2_set2: String(match.p2_set2 ?? ''),
        p1_set3: String(match.p1_set3 ?? ''),
        p2_set3: String(match.p2_set3 ?? ''),
      }}
    />
  ) : (
    <div class="match-topbar">
      <nav class="breadcrumb" aria-label="Nawigacja okruszkowa">
        <a href={url('/matches')} class="breadcrumb__link">Mecze</a>
        <span class="breadcrumb__sep" aria-hidden="true">›</span>
        <span class="breadcrumb__current">Mecz #{matchId}</span>
      </nav>
    </div>
  )}

  <!-- Header karty meczu -->
  <div class={`match-header tc-card ${resultClass}`}>
    <div class="match-header__top">
      <div class="match-header__badges">
        {isTournament
          ? (tournamentId
              ? <a href={`/tournaments/${tournamentId}`} class="tc-badge tc-badge-primary match-badge-link">Turniejowy</a>
              : <span class="tc-badge tc-badge-primary">Turniejowy</span>
            )
          : <span class="tc-badge tc-badge-neutral">Towarzyski</span>
        }
        <span class="tc-badge tc-badge-neutral">{formatLabel}</span>
      </div>
    </div>

    <!-- Sędziowanie: gracze vs wynik -->
    <div class="match-scoreboard">
      <!-- Drużyna 1 -->
      <div class={`match-team ${p1Won ? 'match-team--winner' : p2Won ? 'match-team--loser' : ''}`}>
        {team1.map(u => (
          <div class="match-team__player">
            <div class={`tc-avatar tc-avatar-md${u.id === myId ? ' tc-avatar--me' : ''}`} aria-hidden="true">
              {userInitials(u)}
            </div>
            <div class="match-team__name">
              {userName(u)}
              {u.id === myId && <span class="me-badge">Ty</span>}
            </div>
          </div>
        ))}
      </div>

      <!-- Wynik setów + badge "Twoja wygrana/porażka" na środku -->
      <div class="match-score">
        {resultLabel && (
          <span class={`match-result-badge match-result-badge--${myResult}`}>
            {resultLabel}
          </span>
        )}
        <div class="match-score__sets">
          {sets.length > 0 ? sets.map(([a, b], i) => (
            <div class="match-score__set">
              <span class="set-label">Set {i + 1}</span>
              <div class="set-nums">
                <span class={a > b ? 'set-gem--win' : 'set-gem--loss'}>{a}</span>
                <span class="set-sep">:</span>
                <span class={b > a ? 'set-gem--win' : 'set-gem--loss'}>{b}</span>
              </div>
            </div>
          )) : (
            <span class="match-score__empty">Brak wyniku</span>
          )}
        </div>
      </div>

      <!-- Drużyna 2 -->
      <div class={`match-team match-team--right ${p2Won ? 'match-team--winner' : p1Won ? 'match-team--loser' : ''}`}>
        {team2.map(u => (
          <div class="match-team__player">
            <div class={`tc-avatar tc-avatar-md${u.id === myId ? ' tc-avatar--me' : ''}`} aria-hidden="true">
              {userInitials(u)}
            </div>
            <div class="match-team__name">
              {u.id === myId && <span class="me-badge">Ty</span>}
              {userName(u)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="match-header__date">{fmtDate(match.match_date)}</div>

    {(scoreStatus || reportedBy) && (
      <div class="match-header__meta">
        {scoreStatus && (
          <span class={`match-status-chip match-status-chip--${scoreStatus === 'CONFIRMED' ? 'ok' : 'pending'}`}>
            {scoreStatus === 'CONFIRMED' ? 'Wynik potwierdzony' : 'Oczekuje potwierdzenia'}
          </span>
        )}
        {reportedBy && (
          <span class="match-meta-item">
            Wpisał: <strong>{userName(reportedBy)}</strong>
          </span>
        )}
      </div>
    )}
  </div>




  <!-- Info gdy uczestnik nie może edytować (P3) -->
  {!canEdit && iAmParticipant && (
    <div class="match-noedit-info">
      {isTournament
        ? 'Wynik meczu turniejowego jest zarządzany przez organizatora — nie możesz go edytować.'
        : scoreStatus === 'CONFIRMED'
          ? 'Wynik został potwierdzony i nie można go już zmienić.'
          : 'Edycja wyniku jest w tej chwili niedostępna.'
      }
    </div>
  )}




</AppLayout>

<style>
  :global(.match-topbar) {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px; gap: 12px;
    width: 100%;
    flex-wrap: wrap;
  }
  :global(.match-topbar) :global(.breadcrumb) { margin-bottom: 0; }

  :global(.breadcrumb) {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.8rem; color: var(--tc-sub);
    margin-bottom: 20px;
  }
  :global(.breadcrumb__link) { color: var(--tc-accent); text-decoration: none; }
  :global(.breadcrumb__link:hover) { text-decoration: underline; }
  :global(.breadcrumb__sep) { color: var(--tc-muted); }
  :global(.breadcrumb__current) { color: var(--tc-ink); font-weight: 500; }

  /* ── Match header card ───────────────────────────────────────────────── */
  .match-header { padding: 24px 28px; }

  .result--win  { border-left: 3px solid var(--tc-win); }
  .result--loss { border-left: 3px solid var(--tc-hot); }

  .match-header__top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px; flex-wrap: wrap; gap: 10px;
  }
  .match-header__badges { display: flex; gap: 6px; }

  .match-result-badge {
    font-size: 0.78rem; font-weight: 700;
    padding: 4px 12px; border-radius: 99px;
  }
  .match-result-badge--win  { background: rgba(34,197,94,0.12); color: var(--tc-win); }
  .match-result-badge--loss { background: rgba(239,68,68,0.1);  color: var(--tc-hot); }

  /* ── Scoreboard ──────────────────────────────────────────────────────── */
  .match-scoreboard {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    padding: 16px 0 24px;
    max-width: 760px;
    margin: 0 auto;
    width: 100%;
  }

  .match-team {
    display: flex; flex-direction: column; gap: 10px;
  }
  .match-team--right {
    align-items: flex-end;
    text-align: right;
  }
  .match-team--winner .match-team__name {
    font-weight: 700; color: var(--tc-ink);
  }

  .match-team--loser .tc-avatar {
    border: 1.5px solid var(--tc-hot);
    background: rgba(239, 68, 68, 0.08);
    color: var(--tc-hot);
  }

  .match-team__player {
    display: flex; align-items: center; gap: 10px;
  }
  .match-team--right .match-team__player {
    flex-direction: row-reverse;
  }

  .match-team__name {
    font-size: 1.05rem; color: var(--tc-sub);
    display: flex; align-items: center; gap: 6px;
  }

  .team-won-badge {
    display: inline-flex; align-items: center;
    font-size: 0.72rem; font-weight: 700;
    background: rgba(34,197,94,0.12); color: var(--tc-win);
    padding: 3px 10px; border-radius: 99px;
    margin-top: 4px;
    letter-spacing: 0.02em;
  }

  .me-badge {
    font-size: 0.65rem; font-weight: 700;
    background: rgba(34,197,94,0.15); color: var(--tc-win);
    padding: 1px 6px; border-radius: 99px;
  }

  .tc-avatar--me {
    border: 1.5px solid var(--tc-win);
    background: rgba(34,197,94,0.15);
    color: var(--tc-win);
  }

  /* ── Score display ───────────────────────────────────────────────────── */
  .match-score {
    text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 6px;
  }

  .match-score__sets {
    display: flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: center;
  }

  .match-score__set {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: var(--radius-sm);
    padding: 10px 16px;
    min-width: 76px;
  }

  .set-label {
    font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--tc-muted);
  }

  .set-nums {
    display: flex; align-items: baseline; gap: 3px;
  }

  .set-gem--win  { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; color: var(--tc-ink); }
  .set-gem--loss { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; color: var(--tc-muted); }
  .set-sep       { color: var(--tc-muted); font-size: 1rem; font-weight: 400; }

  .match-score__empty { font-size: 0.875rem; color: var(--tc-muted); }

  .match-header__date {
    font-size: 0.82rem; color: var(--tc-sub);
    text-align: center; margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--tc-card-border);
  }

  /* ── Sets table ──────────────────────────────────────────────────────── */
  .sets-table-wrap { overflow-x: auto; }
  .sets-table { min-width: 400px; }
  .col-num { text-align: right; }
  .font-bold { font-weight: 700; color: var(--tc-ink); }

  .row--winner td { background: rgba(34,197,94,0.03); }

  .sets-player {
    display: flex; align-items: center; gap: 10px;
    font-size: 0.875rem;
  }

  /* Avatar sizes */
  .tc-avatar-md {
    width: 40px; height: 40px;
    font-size: 0.85rem;
  }
  .match-scoreboard .tc-avatar-md {
    width: 46px; height: 46px;
    font-size: 0.95rem;
  }

  /* ── Edit form ───────────────────────────────────────────────────────── */
  :global(.edit-sets) {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
  }
  :global(.edit-set) {
    flex: 1;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 10px;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  :global(.edit-set--opt) {
    opacity: 0.85;
  }
  :global(.edit-set-label) {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--tc-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
    white-space: nowrap;
  }
  :global(.edit-required) {
    color: var(--tc-accent);
  }
  :global(.edit-optional) {
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--tc-muted);
    text-transform: none;
    letter-spacing: 0;
  }
  :global(.edit-set-row) {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
  }
  :global(.edit-set-col) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  :global(.edit-set-who) {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--tc-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.edit-num-input) {
    width: 58px;
    text-align: center;
    padding: 8px 4px;
    border-radius: 8px;
    border: 1px solid var(--tc-card-border);
    background: var(--tc-card-bg);
    color: var(--tc-ink);
    font-size: 1.15rem;
    font-weight: 700;
    font-family: var(--font-mono);
    outline: none;
    -moz-appearance: textfield;
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  :global(.edit-num-input:focus) {
    border-color: var(--tc-accent);
    box-shadow: 0 0 0 3px var(--tc-accent-soft);
  }
  :global(.edit-num-input::-webkit-outer-spin-button),
  :global(.edit-num-input::-webkit-inner-spin-button) {
    -webkit-appearance: none;
    margin: 0;
  }
  :global(.edit-set-sep) {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--tc-muted);
    margin-top: 20px;
    flex-shrink: 0;
  }


  /* ── Match meta (status, reported_by) ───────────────────────────────── */
  .match-header__meta {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
    margin-top: 10px; padding-top: 10px;
    border-top: 1px solid var(--tc-card-border);
    font-size: 0.78rem; color: var(--tc-sub);
  }

  .match-status-chip {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 2px 8px; border-radius: 99px;
    font-size: 0.73rem; font-weight: 600;
  }
  .match-status-chip--ok {
    background: rgba(34,197,94,0.1); color: var(--tc-win);
  }
  .match-status-chip--pending {
    background: rgba(245,158,11,0.1); color: var(--tc-warn);
  }

  .match-meta-item { color: var(--tc-sub); font-size: 0.78rem; }
  .match-meta-item strong { color: var(--tc-ink); }

  /* ── Tournament badge link ───────────────────────────────────────────── */
  .match-badge-link {
    text-decoration: none;
    cursor: pointer;
  }
  .match-badge-link:hover { opacity: 0.8; }

  /* ── No-edit info banner ─────────────────────────────────────────────── */
  .match-noedit-info {
    margin-top: 20px;
    padding: 10px 14px;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: var(--radius-md);
    font-size: 0.82rem; color: var(--tc-sub);
  }

  /* ── Edit form hint ──────────────────────────────────────────────────── */
  :global(.edit-form-hint) {
    margin-top: 10px; margin-bottom: 0;
    font-size: 0.75rem; color: var(--tc-muted);
  }

  /* ── Crown icon ──────────────────────────────────────────────────────── */
  .match-team__crown svg { color: #fbbf24; }

  /* ── Mobile ──────────────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    /* Topbar: breadcrumb i przycisk "Edytuj" jeden pod drugim */
    :global(.match-topbar) {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 14px;
    }

    /* Karta meczu — mniejszy padding */
    .match-header { padding: 16px; }

    /* Scoreboard: zamiast 1fr auto 1fr → pionowo: gracz1 / wynik / gracz2 */
    .match-scoreboard {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 4px 0 14px;
    }

    /* Drużyny: wyśrodkowane na mobilu dla spójności z wynikami */
    .match-team,
    .match-team--right {
      align-items: center;
      text-align: center;
    }
    .match-team__player,
    .match-team--right .match-team__player {
      flex-direction: row;
      justify-content: center;
    }

    /* Wynik setów — wyśrodkowany separator między drużynami */
    .match-score {
      border-top: 1px solid var(--tc-card-border);
      border-bottom: 1px solid var(--tc-card-border);
      padding: 10px 0;
    }
    .match-score__set { font-size: 1.3rem; }
    .match-score__empty { font-size: 1.3rem; }

    /* Avatar nieco mniejszy */
    .tc-avatar-md { width: 34px; height: 34px; font-size: 0.78rem; }

    /* Tabela setów — scroll poziomy */
    .sets-table { min-width: 360px; }

    /* Formularz edycji — sety w kolumnie na komórkach */
    :global(.edit-sets) {
      flex-direction: column;
      gap: 10px;
    }
    :global(.edit-num-input) {
      width: 52px;
    }

  }
</style>

