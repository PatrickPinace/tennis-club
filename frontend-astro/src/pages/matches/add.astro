---
// matches/add.astro — formularz dodawania rozegranego meczu towarzyskiego (singiel i debel)
// Prywatna strona: wymaga zalogowania.
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import AddMatchForm from '@/components/AddMatchForm.tsx';
import { getCurrentUser } from '@/lib/api';
import { url } from '@/lib/url';

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const currentUser = await getCurrentUser(sessionCookie);

if (!currentUser) {
  return Astro.redirect(url('/login') + '?next=' + encodeURIComponent(url('/matches/add')));
}

const today = new Date().toISOString().slice(0, 10);
---

<AppLayout title="Dodaj mecz" showSearch={false} showCta={false} currentUser={currentUser}>
  <nav class="tc-breadcrumb" aria-label="Nawigacja">
    <a href={url('/matches')}>← Moje mecze</a>
  </nav>

  <AddMatchForm
    client:load
    myId={currentUser.id}
    today={today}
    matchesUrl={url('/matches')}
  />
</AppLayout>

<style>
  :global(.tc-breadcrumb) { max-width: 600px; margin: 0 auto; }

  :global(.add-wrap) {
    padding: 0 var(--page-px, 28px) 40px;
    max-width: 600px;
    margin: 0 auto;
  }

  :global(.add-header) { margin-bottom: 24px; }
  :global(.add-title) {
    font-size: 1.4rem; font-weight: 800; color: var(--tc-ink);
    margin: 0 0 4px; letter-spacing: -0.02em;
  }
  :global(.add-subtitle) {
    font-size: 0.875rem; color: var(--tc-sub); margin: 0;
  }

  :global(.add-alert) {
    padding: 10px 14px; border-radius: 8px;
    font-size: 0.84rem; font-weight: 600;
    margin-bottom: 16px;
  }
  :global(.add-alert--err) {
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.22);
    color: var(--tc-hot);
  }

  :global(.add-card) { padding: 24px 28px; }

  /* ── Format toggle ── */
  :global(.af-format-toggle) {
    display: inline-flex; border: 1px solid var(--tc-card-border);
    border-radius: 8px; overflow: hidden;
  }
  :global(.af-format-btn) {
    padding: 7px 20px;
    font-size: 0.84rem; font-weight: 600;
    background: var(--tc-chip-bg); color: var(--tc-sub);
    border: none; cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  :global(.af-format-btn + .af-format-btn) {
    border-left: 1px solid var(--tc-card-border);
  }
  :global(.af-format-btn--active) {
    background: var(--tc-accent); color: var(--tc-accent-ink);
  }

  /* ── Team headers (debel) ── */
  :global(.af-team-header) { margin-bottom: 8px; margin-top: 4px; }
  :global(.af-team-label) {
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.07em;
    padding: 3px 10px; border-radius: 99px;
  }
  :global(.af-team-label--you) { background: rgba(34,197,94,0.1); color: var(--tc-win); }
  :global(.af-team-label--opp) { background: rgba(239,68,68,0.1); color: var(--tc-hot); }

  /* ── Fields ── */
  :global(.af-field) { margin-bottom: 18px; }
  :global(.af-label) {
    display: block;
    font-size: 0.78rem; font-weight: 600; color: var(--tc-sub);
    text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: 6px;
  }
  :global(.af-required) { color: var(--tc-accent); }
  :global(.af-optional) { font-weight: 400; font-size: 0.75rem; color: var(--tc-muted); text-transform: none; letter-spacing: 0; }

  :global(.af-input) {
    display: block; width: 100%; box-sizing: border-box;
    padding: 9px 12px; border-radius: 8px;
    border: 1px solid var(--tc-card-border);
    background: var(--tc-chip-bg); color: var(--tc-ink);
    font-size: 0.9rem; outline: none;
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  :global(.af-input:focus) {
    border-color: var(--tc-accent);
    box-shadow: 0 0 0 3px var(--tc-accent-soft);
  }
  :global(.af-input--date) { max-width: 200px; }

  :global(.af-field-err) {
    font-size: 0.76rem; color: var(--tc-hot);
    margin: 5px 0 0; font-weight: 600;
  }

  /* ── Autocomplete ── */
  :global(.af-autocomplete) { position: relative; }
  :global(.af-search-status) {
    font-size: 0.76rem; color: var(--tc-muted);
    margin-top: 4px; min-height: 16px;
  }

  :global(.af-suggestions) {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0;
    z-index: 100;
    background: var(--tc-card-bg); border: 1px solid var(--tc-card-border);
    border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.18);
    list-style: none; padding: 4px 0; margin: 0;
    max-height: 240px; overflow-y: auto;
  }

  :global(.af-sug-item) {
    display: flex; align-items: center; gap: 8px;
    padding: 9px 12px; cursor: pointer;
    transition: background 0.1s;
  }
  :global(.af-sug-item:hover) { background: var(--tc-overlay); }

  :global(.af-sug-name) { font-size: 0.875rem; font-weight: 600; color: var(--tc-ink); }
  :global(.af-sug-sub) { font-size: 0.75rem; color: var(--tc-sub); }
  :global(.af-sug-empty) {
    padding: 10px 12px;
    font-size: 0.84rem; color: var(--tc-muted); text-align: center;
  }

  /* ── Sets ── */
  :global(.af-sets) { display: flex; gap: 10px; }

  :global(.af-set) {
    flex: 1;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 10px;
    padding: 12px 10px;
    display: flex; flex-direction: column; align-items: center;
  }
  :global(.af-set--opt) { opacity: 0.85; }

  :global(.af-set-label) {
    display: block;
    font-size: 0.7rem; font-weight: 700; color: var(--tc-muted);
    text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: 10px; white-space: nowrap;
  }

  :global(.af-set-row) { display: flex; align-items: center; gap: 8px; }
  :global(.af-set-col) { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  :global(.af-set-who) {
    font-size: 0.65rem; font-weight: 600; color: var(--tc-muted);
    text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap;
  }

  :global(.af-num) {
    width: 58px; text-align: center;
    padding: 8px 4px; border-radius: 8px;
    border: 1px solid var(--tc-card-border);
    background: var(--tc-card-bg); color: var(--tc-ink);
    font-size: 1.15rem; font-weight: 700; font-family: var(--font-mono);
    outline: none; -moz-appearance: textfield;
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  :global(.af-num:focus) {
    border-color: var(--tc-accent);
    box-shadow: 0 0 0 3px var(--tc-accent-soft);
  }
  :global(.af-num::-webkit-outer-spin-button),
  :global(.af-num::-webkit-inner-spin-button) { -webkit-appearance: none; margin: 0; }

  :global(.af-set-sep) {
    font-size: 1.1rem; font-weight: 700; color: var(--tc-muted);
    margin-top: 20px; flex-shrink: 0;
  }

  /* ── Actions ── */
  :global(.af-actions) {
    display: flex; justify-content: flex-end; gap: 10px;
    margin-top: 24px; padding-top: 18px;
    border-top: 1px solid var(--tc-card-border);
  }

  @media (max-width: 520px) {
    :global(.add-card) { padding: 16px; }
    :global(.af-sets) { flex-direction: column; gap: 10px; }
    :global(.af-set) { flex-direction: row; align-items: flex-start; justify-content: space-between; padding: 10px 14px; }
    :global(.af-set-label) { margin-bottom: 0; align-self: center; }
    :global(.af-actions) { flex-direction: column-reverse; }
    :global(.af-actions .tc-btn) { width: 100%; justify-content: center; }
    :global(.af-num) { width: 52px; }
  }
</style>
