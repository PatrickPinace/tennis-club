---
// rankings.astro — tabela rankingowa połączona z Django API
// GET /api/rankings/list/?type=SNG  (IsAuthenticatedOrReadOnly — publiczny)
// Karta "Moja pozycja" wypełniana client-side z /api/dashboard/summary/
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import { getRankings, type PlayerRankingEntry } from '@/lib/api';

// ── Pobierz dane przy budowaniu (publiczny endpoint, bez auth) ─────────────────
let players: PlayerRankingEntry[] = [];
let isLive = false;

try {
  const data = await getRankings('SNG');
  if (data && data.length > 0) {
    players = data;
    isLive = true;
  }
} catch (e) {
  console.warn('[rankings] API error, using fallback demo data:', e);
}

// ── Fallback demo — gdy API niedostępne lub baza pusta ─────────────────────────
if (players.length === 0) {
  players = [
    { position: 1, display_name: 'Tomasz Bąk',      points: 2840, matches_played: 62, matches_won: 51, matches_lost: 11, sets_won: 112, sets_lost: 44, win_rate: 82, match_type: 'SNG', season: 2026 },
    { position: 2, display_name: 'Piotr Wiśniewski', points: 2710, matches_played: 58, matches_won: 46, matches_lost: 12, sets_won: 100, sets_lost: 40, win_rate: 79, match_type: 'SNG', season: 2026 },
    { position: 3, display_name: 'Adam Kowalczyk',   points: 2590, matches_played: 55, matches_won: 43, matches_lost: 12, sets_won: 94,  sets_lost: 38, win_rate: 78, match_type: 'SNG', season: 2026 },
    { position: 4, display_name: 'Marcin Kowalski',  points: 2440, matches_played: 48, matches_won: 34, matches_lost: 14, sets_won: 80,  sets_lost: 42, win_rate: 71, match_type: 'SNG', season: 2026 },
    { position: 5, display_name: 'Rafał Nowak',      points: 2380, matches_played: 52, matches_won: 35, matches_lost: 17, sets_won: 78,  sets_lost: 48, win_rate: 67, match_type: 'SNG', season: 2026 },
    { position: 6, display_name: 'Paweł Zając',      points: 2250, matches_played: 44, matches_won: 28, matches_lost: 16, sets_won: 64,  sets_lost: 44, win_rate: 64, match_type: 'SNG', season: 2026 },
    { position: 7, display_name: 'Łukasz Dąbrowski', points: 2180, matches_played: 41, matches_won: 26, matches_lost: 15, sets_won: 60,  sets_lost: 40, win_rate: 63, match_type: 'SNG', season: 2026 },
    { position: 8, display_name: 'Marek Wróbel',     points: 2050, matches_played: 38, matches_won: 23, matches_lost: 15, sets_won: 54,  sets_lost: 42, win_rate: 61, match_type: 'SNG', season: 2026 },
  ];
}

// ── Helpers ───────────────────────────────────────────────────────────────────
function getInitials(name: string): string {
  return name.split(' ').filter(Boolean).slice(0, 2).map(w => w[0].toUpperCase()).join('');
}

function fmtPoints(pts: number | string): string {
  return Math.round(Number(pts)).toLocaleString('pl-PL');
}

const top3 = players.slice(0, 3);
const rest = players.slice(3);
const totalPlayers = players.length;

const medalColors = ['gold', 'silver', 'bronze'] as const;
---

<AppLayout
  title="Ranking"
  greeting="Ranking klubowy"
  showCta={false}
  showSearch={false}
>

  <!-- Moja pozycja — client-side; ukryta domyślnie -->
  <div class="rk-my" id="my-rank-card" style="display:none;" aria-live="polite">
    <div class="rk-my__left">
      <div class="rk-my__pos">
        <span class="rk-my__pos-num" id="my-rank-pos">—</span>
        <span class="rk-my__pos-label">miejsce</span>
      </div>
      <div class="rk-my__sep" aria-hidden="true"></div>
      <div>
        <div class="rk-my__title">Twoja pozycja</div>
        <div class="rk-my__sub" id="my-rank-sub">Ranking singlowy 2026</div>
      </div>
    </div>
    <div class="rk-my__stats">
      <div class="rk-my__stat">
        <span class="rk-my__stat-val" id="my-rank-pts">—</span>
        <span class="rk-my__stat-label">PUNKTY</span>
      </div>
      <div class="rk-my__stat">
        <span class="rk-my__stat-val" id="my-rank-record">—</span>
        <span class="rk-my__stat-label">BILANS</span>
      </div>
      <div class="rk-my__stat">
        <span class="rk-my__stat-val" id="my-rank-wr">—</span>
        <span class="rk-my__stat-label">WIN RATE</span>
      </div>
    </div>
  </div>

  <!-- Top 3 podium -->
  <div class="rk-podium">
    {top3.map((p, i) => (
      <div class={`rk-podium__card rk-podium__card--${medalColors[i]}`}>
        <div class="rk-podium__medal">{i + 1}</div>
        <div class={`rk-podium__avatar rk-podium__avatar--${medalColors[i]}`} aria-hidden="true">
          {getInitials(p.display_name)}
        </div>
        <div class="rk-podium__name">{p.display_name}</div>
        <div class="rk-podium__pts">{fmtPoints(p.points)} <span class="rk-podium__pts-label">pkt</span></div>
        <div class="rk-podium__meta">
          <span>{p.matches_won}W / {p.matches_lost}L</span>
          <span class="rk-podium__dot">·</span>
          <span class={`rk-podium__wr ${p.win_rate >= 70 ? 'rk-podium__wr--high' : p.win_rate >= 50 ? 'rk-podium__wr--mid' : 'rk-podium__wr--low'}`}>{Math.round(p.win_rate)}%</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Tabela rankingowa -->
  <section class="rk-card">
    <div class="rk-card__header">
      <h2 class="rk-card__title">
        Pełny ranking
        <span class="rk-card__badge" id="rank-count-badge">{totalPlayers}</span>
      </h2>
      <div class="rk-segmented" role="group" aria-label="Typ rankingu">
        <button class="rk-seg rk-seg--active" data-type="SNG">Singiel</button>
        <button class="rk-seg" data-type="DBL">Debel</button>
      </div>
    </div>

    <!-- Nagłówki tabeli -->
    <div class="rk-thead">
      <span class="rk-th rk-th--pos">#</span>
      <span class="rk-th rk-th--player">GRACZ</span>
      <span class="rk-th rk-th--num">PUNKTY</span>
      <span class="rk-th rk-th--num">MECZE</span>
      <span class="rk-th rk-th--num">W/L</span>
      <span class="rk-th rk-th--num">WIN %</span>
    </div>

    <div class="rk-tbody" id="rank-tbody">
      {players.map(p => (
        <div class="rk-row" data-pos={p.position}>
          <div class="rk-row__pos">
            <span class={`rk-pos-badge${p.position <= 3 ? ` rk-pos-badge--${p.position}` : ''}`}>
              {p.position}
            </span>
          </div>
          <div class="rk-row__player">
            <div class={`rk-row__avatar${p.position <= 3 ? ` rk-row__avatar--${medalColors[p.position - 1]}` : ''}`} aria-hidden="true">
              {getInitials(p.display_name)}
            </div>
            <span class="rk-row__name">{p.display_name}</span>
          </div>
          <div class="rk-row__num rk-row__points">{fmtPoints(p.points)}</div>
          <div class="rk-row__num rk-row__muted">{p.matches_played}</div>
          <div class="rk-row__num rk-row__muted">{p.matches_won}/{p.matches_lost}</div>
          <div class="rk-row__num">
            <span class={`rk-wr ${p.win_rate >= 70 ? 'rk-wr--high' : p.win_rate >= 50 ? 'rk-wr--mid' : 'rk-wr--low'}`}>
              {Math.round(p.win_rate)}%
            </span>
          </div>
        </div>
      ))}
    </div>

    <div class="rk-card__footer">
      <span class="rk-footer-info" id="rank-footer-info">
        {isLive
          ? `Dane live · ${new Date().toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' })}`
          : 'Dane demonstracyjne'}
      </span>
      <span class="rk-footer-label" id="rank-card-title">
        {isLive ? 'Singiel 2026' : 'Singiel 2026 (demo)'}
      </span>
    </div>
  </section>

</AppLayout>

<!-- ── Client-side: karta "Moja pozycja" + podświetlenie wiersza ─────────────── -->
<script>
  (async () => {
    const apiBase = document.querySelector<HTMLMetaElement>('meta[name="api-base"]')?.content
      ?? 'http://localhost:8000';

    try {
      const res = await fetch(`${apiBase}/api/dashboard/summary/`, {
        credentials: 'include',
        redirect: 'manual',
      });
      if (!res.ok || res.type === 'opaqueredirect') return;

      const data = await res.json();
      const ranking = data?.ranking;
      if (!ranking || ranking.position == null) return;

      const pos     = ranking.position;
      const pts     = ranking.points ?? '—';
      const won     = ranking.matches_won ?? '—';
      const played  = ranking.matches_played ?? '—';
      const wr      = ranking.win_rate != null ? `${Math.round(ranking.win_rate)}%` : '—';

      // Wypełnij kartę
      const card = document.getElementById('my-rank-card');
      if (card) {
        (document.getElementById('my-rank-pos') as HTMLElement).textContent = String(pos);
        (document.getElementById('my-rank-pts') as HTMLElement).textContent =
          pts != null && pts !== '—' ? Math.round(Number(pts)).toLocaleString('pl-PL') : '—';
        (document.getElementById('my-rank-record') as HTMLElement).textContent = `${won}/${played}`;
        (document.getElementById('my-rank-wr') as HTMLElement).textContent = wr;
        card.style.display = '';
      }

      // Podświetl wiersz w tabeli + dodaj badge "Ty"
      const row = document.querySelector<HTMLElement>(`#rank-tbody .rk-row[data-pos="${pos}"]`);
      if (row) {
        row.classList.add('rk-row--me');
        const nameEl = row.querySelector<HTMLElement>('.rk-row__name');
        if (nameEl && !nameEl.querySelector('.rk-me-badge')) {
          const badge = document.createElement('span');
          badge.className = 'rk-me-badge';
          badge.textContent = 'Ty';
          nameEl.appendChild(badge);
        }
      }
    } catch {
      // Cicha degradacja — użytkownik niezalogowany
    }
  })();

  // ── Przełącznik Singiel / Debel ─────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.rk-seg').forEach(btn => {
    btn.addEventListener('click', async () => {
      document.querySelectorAll('.rk-seg').forEach(b => b.classList.remove('rk-seg--active'));
      btn.classList.add('rk-seg--active');

      const type = btn.dataset.type as 'SNG' | 'DBL';
      const apiBase = document.querySelector<HTMLMetaElement>('meta[name="api-base"]')?.content
        ?? 'http://localhost:8000';

      const tbody = document.getElementById('rank-tbody');
      const footer = document.getElementById('rank-footer-info');
      const countBadge = document.getElementById('rank-count-badge');
      if (!tbody) return;

      try {
        const res = await fetch(`${apiBase}/api/rankings/list/?type=${type}`, {
          credentials: 'include',
          redirect: 'manual',
        });
        if (!res.ok || res.type === 'opaqueredirect') return;
        const rows: Array<{
          position: number; display_name: string; points: number | string;
          matches_played: number; matches_won: number; matches_lost: number;
          win_rate: number;
        }> = await res.json();

        if (!rows || rows.length === 0) {
          tbody.innerHTML = `<div class="rk-empty">Brak danych dla wybranej kategorii.</div>`;
          // Ukryj podium
          const podium = document.querySelector<HTMLElement>('.rk-podium');
          if (podium) podium.style.display = 'none';
          if (countBadge) countBadge.textContent = '0';
          return;
        }

        // Aktualizuj podium (top 3)
        const podium = document.querySelector<HTMLElement>('.rk-podium');
        if (podium) {
          podium.style.display = '';
          const medals = ['gold', 'silver', 'bronze'];
          const cards = podium.querySelectorAll<HTMLElement>('.rk-podium__card');
          const top3 = rows.slice(0, 3);
          cards.forEach((card, i) => {
            if (i < top3.length) {
              const p = top3[i];
              card.style.display = '';
              const nameEl = card.querySelector('.rk-podium__name');
              const ptsEl = card.querySelector('.rk-podium__pts');
              const metaEl = card.querySelector('.rk-podium__meta');
              const avatarEl = card.querySelector('.rk-podium__avatar');
              if (nameEl) nameEl.textContent = p.display_name;
              if (ptsEl) ptsEl.innerHTML = `${Math.round(Number(p.points)).toLocaleString('pl-PL')} <span class="rk-podium__pts-label">pkt</span>`;
              if (metaEl) {
                const wrClass = p.win_rate >= 70 ? 'rk-podium__wr--high' : p.win_rate >= 50 ? 'rk-podium__wr--mid' : 'rk-podium__wr--low';
                metaEl.innerHTML = `<span>${p.matches_won}W / ${(p as any).matches_lost ?? '?'}L</span><span class="rk-podium__dot">·</span><span class="rk-podium__wr ${wrClass}">${Math.round(p.win_rate)}%</span>`;
              }
              if (avatarEl) {
                avatarEl.textContent = p.display_name.split(' ').filter(Boolean).slice(0, 2).map((w: string) => w[0].toUpperCase()).join('');
              }
            } else {
              card.style.display = 'none';
            }
          });
        }

        // Aktualizuj tabelę
        function initials(name: string) {
          return name.split(' ').filter(Boolean).slice(0, 2).map((w: string) => w[0].toUpperCase()).join('');
        }
        function wrClass(wr: number) {
          return wr >= 70 ? 'rk-wr rk-wr--high' : wr >= 50 ? 'rk-wr rk-wr--mid' : 'rk-wr rk-wr--low';
        }
        const medals = ['gold', 'silver', 'bronze'];

        tbody.innerHTML = rows.map(p => `
          <div class="rk-row" data-pos="${p.position}">
            <div class="rk-row__pos">
              <span class="rk-pos-badge${p.position <= 3 ? ` rk-pos-badge--${p.position}` : ''}">${p.position}</span>
            </div>
            <div class="rk-row__player">
              <div class="rk-row__avatar${p.position <= 3 ? ` rk-row__avatar--${medals[p.position - 1]}` : ''}" aria-hidden="true">${initials(p.display_name)}</div>
              <span class="rk-row__name">${p.display_name}</span>
            </div>
            <div class="rk-row__num rk-row__points">${Math.round(Number(p.points)).toLocaleString('pl-PL')}</div>
            <div class="rk-row__num rk-row__muted">${p.matches_played}</div>
            <div class="rk-row__num rk-row__muted">${p.matches_won}/${p.matches_lost}</div>
            <div class="rk-row__num"><span class="${wrClass(p.win_rate)}">${Math.round(p.win_rate)}%</span></div>
          </div>
        `).join('');

        if (countBadge) countBadge.textContent = String(rows.length);

        const label = type === 'SNG' ? 'Singiel' : 'Debel';
        if (footer) {
          footer.textContent = `Dane live · ${new Date().toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' })}`;
        }
        const cardTitle = document.getElementById('rank-card-title');
        if (cardTitle) cardTitle.textContent = `${label} 2026`;
        const rankSub = document.getElementById('my-rank-sub');
        if (rankSub) rankSub.textContent = `Ranking ${type === 'SNG' ? 'singlowy' : 'deblowy'} 2026`;
      } catch {
        // Cicha degradacja
      }
    });
  });
</script>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     RANKINGS — nowy design, tokeny --tc-*
     ══════════════════════════════════════════════════════════════════════════ */

  /* ── Moja pozycja ──────────────────────────────────────────────────────── */
  .rk-my {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-accent-border);
    border-radius: 14px;
    padding: 20px 24px;
    margin-bottom: 16px;
    box-shadow: inset 0 0 0 1px var(--tc-accent-soft);
  }

  .rk-my__left {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .rk-my__pos { text-align: center; }

  .rk-my__pos-num {
    display: block;
    font-size: 2.8rem;
    font-weight: 900;
    color: var(--tc-accent);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .rk-my__pos-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--tc-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .rk-my__sep {
    width: 1px;
    height: 40px;
    background: var(--tc-accent-border);
  }

  .rk-my__title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--tc-ink);
  }

  .rk-my__sub {
    font-size: 0.78rem;
    color: var(--tc-muted);
    margin-top: 2px;
  }

  .rk-my__stats {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .rk-my__stat { text-align: center; }

  .rk-my__stat-val {
    display: block;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--tc-ink);
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .rk-my__stat-label {
    font-size: 0.6rem;
    color: var(--tc-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 4px;
  }

  /* ── Podium (Top 3) ────────────────────────────────────────────────────── */
  .rk-podium {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  .rk-podium__card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    position: relative;
    transition: background 0.25s, border-color 0.25s;
  }

  .rk-podium__card--gold   { border-color: rgba(251, 191, 36, 0.35); }
  .rk-podium__card--silver { border-color: rgba(148, 163, 184, 0.35); }
  .rk-podium__card--bronze { border-color: rgba(180, 108, 64, 0.35); }

  .rk-podium__medal {
    position: absolute;
    top: 12px;
    left: 14px;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .rk-podium__card--gold .rk-podium__medal {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
  }
  .rk-podium__card--silver .rk-podium__medal {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
  }
  .rk-podium__card--bronze .rk-podium__medal {
    background: rgba(180, 108, 64, 0.15);
    color: #b47a40;
  }

  .rk-podium__avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .rk-podium__avatar--gold {
    background: rgba(251, 191, 36, 0.12);
    border: 2px solid rgba(251, 191, 36, 0.5);
    color: #fbbf24;
  }
  .rk-podium__avatar--silver {
    background: rgba(148, 163, 184, 0.12);
    border: 2px solid rgba(148, 163, 184, 0.5);
    color: #94a3b8;
  }
  .rk-podium__avatar--bronze {
    background: rgba(180, 108, 64, 0.12);
    border: 2px solid rgba(180, 108, 64, 0.5);
    color: #b47a40;
  }

  .rk-podium__name {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--tc-ink);
    text-align: center;
    line-height: 1.3;
  }

  .rk-podium__pts {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--tc-ink);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .rk-podium__pts-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--tc-muted);
  }

  .rk-podium__meta {
    font-size: 0.72rem;
    color: var(--tc-muted);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .rk-podium__dot { color: var(--tc-faint); }

  .rk-podium__wr { font-weight: 700; }
  .rk-podium__wr--high { color: var(--tc-accent); }
  .rk-podium__wr--mid  { color: var(--warning, #f59e0b); }
  .rk-podium__wr--low  { color: var(--tc-hot); }

  /* ── Karta rankingowa ──────────────────────────────────────────────────── */
  .rk-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    transition: background 0.25s, border-color 0.25s;
  }

  .rk-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tc-card-border);
  }

  .rk-card__title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--tc-ink);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .rk-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 99px;
    background: var(--tc-accent-soft);
    color: var(--tc-accent-ink);
    font-size: 0.72rem;
    font-weight: 700;
  }

  /* ── Segmented control ─────────────────────────────────────────────────── */
  .rk-segmented {
    display: flex;
    padding: 2px;
    background: var(--tc-chip-bg);
    border-radius: 7px;
  }

  .rk-seg {
    padding: 5px 14px;
    background: transparent;
    border: none;
    border-radius: 5px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--tc-muted);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .rk-seg:hover { color: var(--tc-sub); }

  .rk-seg--active {
    background: var(--tc-card-bg);
    color: var(--tc-ink);
    box-shadow: var(--tc-shadow);
  }

  /* ── Table head ────────────────────────────────────────────────────────── */
  .rk-thead {
    display: grid;
    grid-template-columns: 52px 1fr 100px 80px 90px 80px;
