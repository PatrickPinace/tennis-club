---
// rankings.astro — tabela rankingowa połączona z Django API
// GET /api/rankings/list/?type=SNG  (IsAuthenticatedOrReadOnly — publiczny)
// Karta "Moja pozycja" wypełniana client-side z /api/dashboard/summary/
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import { getRankings, type PlayerRankingEntry } from '@/lib/api';

// ── Pobierz dane przy budowaniu (publiczny endpoint, bez auth) ─────────────────
let players: PlayerRankingEntry[] = [];
let isLive = false;

try {
  const data = await getRankings('SNG');
  if (data && data.length > 0) {
    players = data;
    isLive = true;
  }
} catch (e) {
  console.warn('[rankings] API error, using fallback demo data:', e);
}

// ── Fallback demo — gdy API niedostępne lub baza pusta ─────────────────────────
if (players.length === 0) {
  players = [
    { position: 1, display_name: 'Tomasz Bąk',      points: 2840, matches_played: 62, matches_won: 51, matches_lost: 11, sets_won: 112, sets_lost: 44, win_rate: 82, match_type: 'SNG', season: 2026 },
    { position: 2, display_name: 'Piotr Wiśniewski', points: 2710, matches_played: 58, matches_won: 46, matches_lost: 12, sets_won: 100, sets_lost: 40, win_rate: 79, match_type: 'SNG', season: 2026 },
    { position: 3, display_name: 'Adam Kowalczyk',   points: 2590, matches_played: 55, matches_won: 43, matches_lost: 12, sets_won: 94,  sets_lost: 38, win_rate: 78, match_type: 'SNG', season: 2026 },
    { position: 4, display_name: 'Marcin Kowalski',  points: 2440, matches_played: 48, matches_won: 34, matches_lost: 14, sets_won: 80,  sets_lost: 42, win_rate: 71, match_type: 'SNG', season: 2026 },
    { position: 5, display_name: 'Rafał Nowak',      points: 2380, matches_played: 52, matches_won: 35, matches_lost: 17, sets_won: 78,  sets_lost: 48, win_rate: 67, match_type: 'SNG', season: 2026 },
    { position: 6, display_name: 'Paweł Zając',      points: 2250, matches_played: 44, matches_won: 28, matches_lost: 16, sets_won: 64,  sets_lost: 44, win_rate: 64, match_type: 'SNG', season: 2026 },
    { position: 7, display_name: 'Łukasz Dąbrowski', points: 2180, matches_played: 41, matches_won: 26, matches_lost: 15, sets_won: 60,  sets_lost: 40, win_rate: 63, match_type: 'SNG', season: 2026 },
    { position: 8, display_name: 'Marek Wróbel',     points: 2050, matches_played: 38, matches_won: 23, matches_lost: 15, sets_won: 54,  sets_lost: 42, win_rate: 61, match_type: 'SNG', season: 2026 },
  ];
}

// ── Helpers ───────────────────────────────────────────────────────────────────
function getInitials(name: string): string {
  return name.split(' ').filter(Boolean).slice(0, 2).map(w => w[0].toUpperCase()).join('');
}

function fmtPoints(pts: number | string): string {
  return Math.round(Number(pts)).toLocaleString('pl-PL');
}

const top3 = players.slice(0, 3);
const totalPlayers = players.length;

// Prototyp: kolejność kart w podium to [2, 1, 3] — srebro, złoto (wyższe), brąz
const podiumOrder = top3.length >= 3 ? [top3[1], top3[0], top3[2]] : top3;
const podiumKeys = ['silver', 'gold', 'bronze'] as const;
const podiumLabels = ['SREBRO', 'ZŁOTO', 'BRĄZ'];
const podiumNumbers = [2, 1, 3];
---

<AppLayout
  title="Ranking"
  greeting="Ranking klubowy"
  greetingSub={`${totalPlayers} graczy · sezon wiosna 2026`}
  showCta={false}
  showSearch={false}
>

  <!-- Moja pozycja — client-side; ukryta domyślnie -->
  <div class="rk-my" id="my-rank-card" style="display:none;" aria-live="polite">
    <div class="rk-my__left">
      <div class="rk-my__pos">
        <span class="rk-my__pos-num" id="my-rank-pos">—</span>
        <span class="rk-my__pos-label">miejsce</span>
      </div>
      <div class="rk-my__sep" aria-hidden="true"></div>
      <div>
        <div class="rk-my__title">Twoja pozycja</div>
        <div class="rk-my__sub" id="my-rank-sub">Ranking singlowy 2026</div>
      </div>
    </div>
    <div class="rk-my__stats">
      <div class="rk-my__stat">
        <span class="rk-my__stat-label">PUNKTY</span>
        <span class="rk-my__stat-val" id="my-rank-pts">—</span>
      </div>
      <div class="rk-my__stat">
        <span class="rk-my__stat-label">WYGRANE</span>
        <span class="rk-my__stat-val" id="my-rank-record">—</span>
      </div>
      <div class="rk-my__stat">
        <span class="rk-my__stat-label">SKUTECZNOŚĆ</span>
        <span class="rk-my__stat-val" id="my-rank-wr">—</span>
      </div>
    </div>
  </div>

  <!-- Podium Top 3 — kolejność: [srebro, złoto-wyższe, brąz] jak w prototypie -->
  {top3.length >= 3 && (
    <div class="rk-podium">
      {podiumOrder.map((p, i) => (
        <div class={`rk-podium__card rk-podium__card--${podiumKeys[i]}${i === 1 ? ' rk-podium__card--raised' : ''}`}>
          <div class="rk-podium__header">
            <span class="rk-podium__label">{podiumLabels[i]}</span>
            <span class="rk-podium__num">{podiumNumbers[i]}</span>
          </div>
          <div class="rk-podium__body">
            <div class={`rk-podium__avatar rk-podium__avatar--${podiumKeys[i]}`} aria-hidden="true">
              {getInitials(p.display_name)}
            </div>
            <div class="rk-podium__info">
              <span class="rk-podium__name">{p.display_name}</span>
              <span class="rk-podium__meta">{p.matches_played} meczów · {Math.round(p.win_rate)}% skuteczności</span>
            </div>
          </div>
          <div class="rk-podium__footer">
            <div class="rk-podium__stat">
              <span class="rk-podium__stat-label">PUNKTY</span>
              <span class="rk-podium__stat-val">{fmtPoints(p.points)}</span>
            </div>
            <div class="rk-podium__stat">
              <span class="rk-podium__stat-label">WYGRANE</span>
              <span class="rk-podium__stat-val">{p.matches_won} <span class="rk-podium__stat-of">/ {p.matches_played}</span></span>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- Tabela rankingowa -->
  <section class="rk-card">
    <div class="rk-card__header">
      <div class="rk-card__title-wrap">
        <span class="rk-card__dot" aria-hidden="true"></span>
        <h2 class="rk-card__title">TABELA KLUBOWA</h2>
        <span class="rk-card__badge" id="rank-count-badge">{totalPlayers}</span>
      </div>
      <div class="rk-segmented" role="group" aria-label="Typ rankingu">
        <button class="rk-seg rk-seg--active" data-type="SNG">Singiel</button>
        <button class="rk-seg" data-type="DBL">Debel</button>
      </div>
    </div>

    <!-- Nagłówki tabeli -->
    <div class="rk-thead">
      <span class="rk-th">POZ.</span>
      <span class="rk-th">GRACZ</span>
      <span class="rk-th rk-th--r">MECZE</span>
      <span class="rk-th rk-th--r">WYGRANE</span>
      <span class="rk-th rk-th--r">PUNKTY</span>
    </div>

    <div class="rk-tbody" id="rank-tbody">
      {players.map(p => (
        <div class={`rk-row${p.position === 1 ? ' rk-row--first' : ''}`} data-pos={p.position}>
          <div class="rk-row__pos">
            <span class={`rk-pos-badge${p.position <= 3 ? ` rk-pos-badge--${p.position}` : ''}`}>
              {p.position}
            </span>
          </div>
          <div class="rk-row__player">
            <div class={`rk-row__avatar${p.position <= 3 ? ` rk-row__avatar--${['gold','silver','bronze'][p.position - 1]}` : ''}`} aria-hidden="true">
              {getInitials(p.display_name)}
            </div>
            <div class="rk-row__player-info">
              <span class="rk-row__name">{p.display_name}</span>
              <span class="rk-row__winrate">{Math.round(p.win_rate)}% skuteczności</span>
            </div>
          </div>
          <div class="rk-row__num rk-row__muted">{p.matches_played}</div>
          <div class="rk-row__num rk-row__muted">
            {p.matches_won} <span class="rk-row__of">/ {p.matches_played}</span>
          </div>
          <div class="rk-row__num rk-row__points">
            {fmtPoints(p.points)} <span class="rk-row__pkt">pkt</span>
          </div>
        </div>
      ))}
    </div>

    <div class="rk-card__footer">
      <span class="rk-footer-info" id="rank-footer-info">
        {isLive
          ? `Dane live · ${new Date().toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' })}`
          : 'Dane demonstracyjne'}
      </span>
      <span class="rk-footer-label" id="rank-card-title">
        {isLive ? 'Singiel 2026' : 'Singiel 2026 (demo)'}
      </span>
    </div>
  </section>

</AppLayout>

<!-- ── Client-side: karta "Moja pozycja" + podświetlenie wiersza ─────────────── -->
<script>
  (async () => {
    const apiBase = document.querySelector<HTMLMetaElement>('meta[name="api-base"]')?.content
      ?? 'http://localhost:8000';

    try {
      const res = await fetch(`${apiBase}/api/dashboard/summary/`, {
        credentials: 'include',
        redirect: 'manual',
      });
      if (!res.ok || res.type === 'opaqueredirect') return;

      const data = await res.json();
      const ranking = data?.ranking;
      if (!ranking || ranking.position == null) return;

      const pos    = ranking.position;
      const pts    = ranking.points ?? '—';
      const won    = ranking.matches_won ?? '—';
      const played = ranking.matches_played ?? '—';
      const wr     = ranking.win_rate != null ? `${Math.round(ranking.win_rate)}%` : '—';

      const card = document.getElementById('my-rank-card');
      if (card) {
        (document.getElementById('my-rank-pos') as HTMLElement).textContent = String(pos);
        (document.getElementById('my-rank-pts') as HTMLElement).textContent =
          pts != null && pts !== '—' ? Math.round(Number(pts)).toLocaleString('pl-PL') : '—';
        (document.getElementById('my-rank-record') as HTMLElement).textContent = `${won}/${played}`;
        (document.getElementById('my-rank-wr') as HTMLElement).textContent = wr;
        card.style.display = '';
      }

      // Podświetl wiersz + badge "Ty"
      const row = document.querySelector<HTMLElement>(`#rank-tbody .rk-row[data-pos="${pos}"]`);
      if (row) {
        row.classList.add('rk-row--me');
        const nameEl = row.querySelector<HTMLElement>('.rk-row__name');
        if (nameEl && !nameEl.querySelector('.rk-me-badge')) {
          const badge = document.createElement('span');
          badge.className = 'rk-me-badge';
          badge.textContent = 'TY';
          nameEl.after(badge);
        }
      }
    } catch {
      // Cicha degradacja
    }
  })();

  // ── Helpers powielone dla innerHTML ──────────────────────────────────────────
  function initials(name: string) {
    return name.split(' ').filter(Boolean).slice(0, 2).map((w: string) => w[0].toUpperCase()).join('');
  }
  function fmtPts(pts: number | string) {
    return Math.round(Number(pts)).toLocaleString('pl-PL');
  }
  const medals = ['gold', 'silver', 'bronze'];

  function buildRow(p: {
    position: number; display_name: string; points: number | string;
    matches_played: number; matches_won: number; matches_lost?: number;
    win_rate: number;
  }): string {
    const medalClass = p.position <= 3 ? ` rk-row__avatar--${medals[p.position - 1]}` : '';
    const posBadgeClass = p.position <= 3 ? ` rk-pos-badge--${p.position}` : '';
    return `
      <div class="rk-row${p.position === 1 ? ' rk-row--first' : ''}" data-pos="${p.position}">
        <div class="rk-row__pos">
          <span class="rk-pos-badge${posBadgeClass}">${p.position}</span>
        </div>
        <div class="rk-row__player">
          <div class="rk-row__avatar${medalClass}" aria-hidden="true">${initials(p.display_name)}</div>
          <div class="rk-row__player-info">
            <span class="rk-row__name">${p.display_name}</span>
            <span class="rk-row__winrate">${Math.round(p.win_rate)}% skuteczności</span>
          </div>
        </div>
        <div class="rk-row__num rk-row__muted">${p.matches_played}</div>
        <div class="rk-row__num rk-row__muted">${p.matches_won} <span class="rk-row__of">/ ${p.matches_played}</span></div>
        <div class="rk-row__num rk-row__points">${fmtPts(p.points)} <span class="rk-row__pkt">pkt</span></div>
      </div>
    `;
  }

  function buildPodiumCard(p: {
    position: number; display_name: string; points: number | string;
    matches_played: number; matches_won: number; win_rate: number;
  }, slot: number): string {
    const keys = ['silver', 'gold', 'bronze'];
    const labels = ['SREBRO', 'ZŁOTO', 'BRĄZ'];
    const nums = [2, 1, 3];
    const k = keys[slot];
    const raisedClass = slot === 1 ? ' rk-podium__card--raised' : '';
    return `
      <div class="rk-podium__card rk-podium__card--${k}${raisedClass}">
        <div class="rk-podium__header">
          <span class="rk-podium__label">${labels[slot]}</span>
          <span class="rk-podium__num">${nums[slot]}</span>
        </div>
        <div class="rk-podium__body">
          <div class="rk-podium__avatar rk-podium__avatar--${k}" aria-hidden="true">${initials(p.display_name)}</div>
          <div class="rk-podium__info">
            <span class="rk-podium__name">${p.display_name}</span>
            <span class="rk-podium__meta">${p.matches_played} meczów · ${Math.round(p.win_rate)}% skuteczności</span>
          </div>
        </div>
        <div class="rk-podium__footer">
          <div class="rk-podium__stat">
            <span class="rk-podium__stat-label">PUNKTY</span>
            <span class="rk-podium__stat-val">${fmtPts(p.points)}</span>
          </div>
          <div class="rk-podium__stat">
            <span class="rk-podium__stat-label">WYGRANE</span>
            <span class="rk-podium__stat-val">${p.matches_won} <span class="rk-podium__stat-of">/ ${p.matches_played}</span></span>
          </div>
        </div>
      </div>
    `;
  }

  // ── Przełącznik Singiel / Debel ─────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.rk-seg').forEach(btn => {
    btn.addEventListener('click', async () => {
      document.querySelectorAll('.rk-seg').forEach(b => b.classList.remove('rk-seg--active'));
      btn.classList.add('rk-seg--active');

      const type = btn.dataset.type as 'SNG' | 'DBL';
      const apiBase = document.querySelector<HTMLMetaElement>('meta[name="api-base"]')?.content
        ?? 'http://localhost:8000';

      const tbody = document.getElementById('rank-tbody');
      const footer = document.getElementById('rank-footer-info');
      const countBadge = document.getElementById('rank-count-badge');
      if (!tbody) return;

      try {
        const res = await fetch(`${apiBase}/api/rankings/list/?type=${type}`, {
          credentials: 'include',
          redirect: 'manual',
        });
        if (!res.ok || res.type === 'opaqueredirect') return;
        const rows: Array<{
          position: number; display_name: string; points: number | string;
          matches_played: number; matches_won: number; matches_lost: number;
          win_rate: number;
        }> = await res.json();

        if (!rows || rows.length === 0) {
          tbody.innerHTML = `<div class="rk-empty">Brak danych dla wybranej kategorii.</div>`;
          const podium = document.querySelector<HTMLElement>('.rk-podium');
          if (podium) podium.style.display = 'none';
          if (countBadge) countBadge.textContent = '0';
          return;
        }

        // Aktualizuj podium
        const podium = document.querySelector<HTMLElement>('.rk-podium');
        if (podium && rows.length >= 3) {
          podium.style.display = '';
          // kolejność: [srebro=rows[1], złoto=rows[0], brąz=rows[2]]
          const order = [rows[1], rows[0], rows[2]];
          podium.innerHTML = order.map((p, i) => buildPodiumCard(p, i)).join('');
        } else if (podium) {
          podium.style.display = 'none';
        }

        tbody.innerHTML = rows.map(p => buildRow(p)).join('');
        if (countBadge) countBadge.textContent = String(rows.length);

        const label = type === 'SNG' ? 'Singiel' : 'Debel';
        if (footer) {
          footer.textContent = `Dane live · ${new Date().toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' })}`;
        }
        const cardTitle = document.getElementById('rank-card-title');
        if (cardTitle) cardTitle.textContent = `${label} 2026`;
        const rankSub = document.getElementById('my-rank-sub');
        if (rankSub) rankSub.textContent = `Ranking ${type === 'SNG' ? 'singlowy' : 'deblowy'} 2026`;
      } catch {
        // Cicha degradacja
      }
    });
  });
</script>

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════════
     RANKINGS — layout wg prototypu astro4.jpeg
     is:global wymagane bo JS podmienia innerHTML (buildRow/buildPodiumCard)
     ══════════════════════════════════════════════════════════════════════════ */

  /* ── Moja pozycja (zielona karta - gdy zalogowany) ─────────────────────── */
  .rk-my {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-accent-border);
    border-radius: 14px;
    padding: 20px 24px;
    margin-bottom: 16px;
  }

  .rk-my__left {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .rk-my__pos { text-align: center; }

  .rk-my__pos-num {
    display: block;
    font-size: 2.8rem;
    font-weight: 900;
    color: var(--tc-accent);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .rk-my__pos-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--tc-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .rk-my__sep {
    width: 1px;
    height: 40px;
    background: var(--tc-accent-border);
  }

  .rk-my__title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--tc-ink);
  }

  .rk-my__sub {
    font-size: 0.78rem;
    color: var(--tc-muted);
    margin-top: 2px;
  }

  .rk-my__stats {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .rk-my__stat { text-align: left; }

  .rk-my__stat-label {
    display: block;
    font-size: 0.6rem;
    color: var(--tc-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
  }

  .rk-my__stat-val {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--tc-ink);
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  /* ── Podium ────────────────────────────────────────────────────────────── */
  /* Układ: [srebro] [złoto — raised wyżej] [brąz] */
  .rk-podium {
    display: grid;
    grid-template-columns: 1fr 1.08fr 1fr; /* złoto nieco szersze */
    align-items: flex-end;                  /* karty wyrównane do dołu */
    gap: 10px;
    margin-bottom: 16px;
  }

  /* Złoto — klasa raised: karta wysunięta w górę względem reszty */
  .rk-podium__card--raised {
    margin-bottom: 16px;
    z-index: 1;
  }

  .rk-podium__card {
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    transition: background 0.25s, border-color 0.25s;
  }

  /* ── Nagłówek karty podium — solid kolor jak w prototypie ── */
  .rk-podium__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
  }

  .rk-podium__card--gold .rk-podium__header   { background: #92750a; } /* złoty — ciemne złoto */
  .rk-podium__card--silver .rk-podium__header { background: #6b7a8a; }
  .rk-podium__card--bronze .rk-podium__header { background: #8a6040; }

  .rk-podium__label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.85);
  }

  .rk-podium__num {
    font-size: 2.5rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  /* ── Body ── */
  .rk-podium__body {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px 12px;
  }

  .rk-podium__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.88rem;
    flex-shrink: 0;
  }

  .rk-podium__avatar--gold   { background: rgba(251,191,36,0.15); border: 2px solid rgba(251,191,36,0.5); color: #fbbf24; }
  .rk-podium__avatar--silver { background: rgba(148,163,184,0.15); border: 2px solid rgba(148,163,184,0.5); color: #94a3b8; }
  .rk-podium__avatar--bronze { background: rgba(180,108,64,0.15); border: 2px solid rgba(180,108,64,0.5); color: #b47a40; }

  .rk-podium__info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .rk-podium__name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--tc-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rk-podium__meta {
    font-size: 0.72rem;
    color: var(--tc-muted);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Footer stats ── */
  .rk-podium__footer {
    display: flex;
    gap: 24px;
    padding: 12px 16px 16px;
    border-top: 1px solid var(--tc-card-border-soft);
