---
// notifications.astro — strona z listą powiadomień użytkownika
// Prywatna strona: wymagane zalogowanie (middleware + SSR guard)
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import NotificationsList from '@/components/NotificationsList.tsx';
import { getAllNotifications, getCurrentUser } from '@/lib/api';
import { url } from '@/lib/url';

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;

const [currentUser, notifications] = await Promise.all([
  getCurrentUser(sessionCookie),
  getAllNotifications(sessionCookie),
]);

if (!currentUser) {
  return Astro.redirect(url('/login') + '?next=' + encodeURIComponent(url('/notifications')));
}

const unreadCount = notifications.filter(n => !n.is_read).length;
---

<AppLayout title="Powiadomienia" currentUser={currentUser}>
<div class="page-narrow">
  <PageHeader
    title="Powiadomienia"
    subtitle={unreadCount > 0
      ? `Masz ${unreadCount} nieprzeczytane${unreadCount === 1 ? '' : unreadCount < 5 ? '' : 'ch'} powiadomień`
      : 'Wszystkie powiadomienia przeczytane'}
    centered={true}
  />

  <div class="notif-wrap">
    <NotificationsList
      client:load
      notifications={notifications}
      initialUnread={unreadCount}
    />
  </div>
</div>
</AppLayout>

<style is:global>
  .notif-wrap {
    padding: 0 var(--page-px, 28px) 40px;
  }

  .notif-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center;
    padding: 64px 24px;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: var(--radius-md);
  }
  .notif-empty__title {
    font-size: 1rem; font-weight: 700; color: var(--tc-ink);
    margin: 0 0 8px;
  }
  .notif-empty__sub {
    font-size: 0.85rem; color: var(--tc-sub);
    max-width: 320px; line-height: 1.5; margin: 0;
  }

  .notif-card {
    padding: 0;
    overflow: hidden;
  }

  .notif-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tc-card-border);
    gap: 12px;
    flex-wrap: wrap;
  }
  .notif-toolbar__count {
    font-size: 0.82rem; color: var(--tc-sub);
  }
  .notif-read-all-btn {
    padding: 5px 14px; height: 30px;
    font-size: 0.78rem; font-weight: 600;
    background: transparent;
    color: var(--tc-accent);
    border: 1px solid var(--tc-accent-border);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
    font-family: inherit;
  }
  .notif-read-all-btn:hover {
    background: var(--tc-accent);
    color: var(--tc-accent-ink);
    border-color: var(--tc-accent);
  }

  .notif-list {
    list-style: none;
    margin: 0; padding: 0;
  }

  .notif-item {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tc-card-border);
    transition: background 0.1s;
    position: relative;
  }
  .notif-item:last-child { border-bottom: none; }
  .notif-item:hover { background: var(--tc-overlay); }

  .notif-item__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
    background: transparent;
  }
  .notif-item--unread {
    background: var(--tc-accent-soft);
    border-left: 3px solid var(--tc-accent);
    padding-left: 17px;
  }
  .notif-item--unread .notif-item__dot {
    background: var(--tc-accent);
  }

  .notif-item__body {
    flex: 1; min-width: 0;
  }
  .notif-item__msg {
    margin: 0 0 4px;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--tc-ink);
    word-break: break-word;
  }
  .notif-item--unread .notif-item__msg {
    font-weight: 600;
  }
  .notif-item__time {
    font-size: 0.75rem;
    color: var(--tc-sub);
  }

  .notif-item__mark-btn {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1px solid var(--tc-card-border);
    background: var(--tc-chip-bg);
    color: var(--tc-muted);
    font-size: 0.85rem;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: border-color 0.12s, color 0.12s, background 0.12s;
  }
  .notif-item__mark-btn:hover {
    border-color: var(--tc-accent);
    color: var(--tc-accent);
    background: var(--tc-accent-soft);
  }

  @media (max-width: 480px) {
    .notif-item { padding: 12px 16px; }
    .notif-item--unread { padding-left: 13px; }
  }
</style>
