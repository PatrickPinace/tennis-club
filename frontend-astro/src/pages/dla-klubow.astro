---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { url } from '@/lib/url';

export const prerender = true;
---

<PublicLayout
  title="Dla Klubów Tenisowych"
  description="Kompleksowe narzędzie do zarządzania klubem tenisowym — rezerwacje kortów, turnieje, ligi, rankingi i powiadomienia dla graczy. Wypróbuj bezpłatnie."
>
  <section class="py-16 px-8 max-[480px]:py-8 max-[480px]:px-4 bg-bg">
    <div class="max-w-[860px] mx-auto">
      <h1 class="text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold text-[#0f172a] tracking-[-0.02em] mb-4">
        Narzędzie do zarządzania klubem tenisowym
      </h1>
      <p class="text-[1.1rem] text-[#64748b] mb-10 max-w-[65ch]">
        Jeden system zamiast arkuszy, SMS-ów i papierowych grafików. Obsłuż rezerwacje kortów,
        turnieje i rankingi — wszystko online.
      </p>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-8 mb-12">
        <div class="tc-card p-6">
          <div class="text-[2rem] mb-3">🏟️</div>
          <h2 class="text-[1.1rem] font-bold mb-2 text-[#0f172a]">Rezerwacje kortów</h2>
          <p class="text-[0.95rem] text-[#64748b]">Grafik online, rezerwacje jednorazowe i cykliczne, akceptacja przez managera.</p>
        </div>
        <div class="tc-card p-6">
          <div class="text-[2rem] mb-3">🏆</div>
          <h2 class="text-[1.1rem] font-bold mb-2 text-[#0f172a]">Turnieje i ligi</h2>
          <p class="text-[0.95rem] text-[#64748b]">Single elimination, double elimination, round robin, americano, drabinki rankingowe.</p>
        </div>
        <div class="tc-card p-6">
          <div class="text-[2rem] mb-3">📊</div>
          <h2 class="text-[1.1rem] font-bold mb-2 text-[#0f172a]">Rankingi graczy</h2>
          <p class="text-[0.95rem] text-[#64748b]">Automatyczne rankingi singiel i debel po każdym turnieju. Historia wyników.</p>
        </div>
        <div class="tc-card p-6">
          <div class="text-[2rem] mb-3">🔔</div>
          <h2 class="text-[1.1rem] font-bold mb-2 text-[#0f172a]">Powiadomienia</h2>
          <p class="text-[0.95rem] text-[#64748b]">Gracze są automatycznie informowani o wynikach, wyzwaniach i statusach rezerwacji.</p>
        </div>
      </div>

      <div class="flex gap-4 flex-wrap">
        <a href={url('/register')} class="tc-btn tc-btn-primary">Wypróbuj bezpłatnie</a>
        <a href={url('/kontakt')} class="tc-btn tc-btn-secondary">Zapytaj o demo</a>
      </div>
    </div>
  </section>
</PublicLayout>
