---
// tournaments.astro — lista turniejów połączona z Django API
// GET /api/tournaments/list/   (IsAuthenticatedOrReadOnly — publiczny)
// GET /api/tournaments/mine/   (IsAuthenticated — opcjonalny, graceful fallback)
// GET /api/tournaments/{id}/detail/  (publiczny — featured card standings)
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import {
  getTournamentsList,
  getMyTournaments,
  getTournamentDetail,
  getCurrentUser,
  type TournamentListEntry,
  type TournamentDetail,
  type RRStandingRow,
  type CurrentUser,
} from '@/lib/api';
import { url } from '@/lib/url';

// ── Auth ────────────────────────────────────────────────────────────────────
const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const currentUser: CurrentUser | null = await getCurrentUser(sessionCookie);

// ── Dane z API ──────────────────────────────────────────────────────────────
let tournaments: TournamentListEntry[] = [];
let isLive = false;
let myTournamentIds: Set<number> = new Set();

try {
  const data = await getTournamentsList();
  if (data && data.length > 0) {
    tournaments = data;
    isLive = true;
  }
} catch (e) {
  console.warn('[tournaments] API error, using fallback demo data:', e);
}

// Pobierz „moje turnieje" jeśli zalogowany
if (currentUser) {
  try {
    const mine = await getMyTournaments(sessionCookie);
    myTournamentIds = new Set(mine.map(t => t.id));
  } catch {
    // cicha degradacja
  }
}

// ── Fallback demo ───────────────────────────────────────────────────────────
if (tournaments.length === 0) {
  tournaments = [
    { id: 1, name: 'Puchar Jesieni 2026', description: '', tournament_type: 'SGL', match_format: 'SNG', start_date: '2026-10-28T09:00:00', end_date: '2026-10-29T18:00:00', status: 'REG', rank: 1, is_ranked: true, participant_count: 16, created_by_name: 'Admin', facility_name: 'Korty Otwock', matches_progress: null },
    { id: 2, name: 'Liga Zimowa — Runda 3', description: '', tournament_type: 'RND', match_format: 'SNG', start_date: '2026-11-15T10:00:00', end_date: '2026-11-15T20:00:00', status: 'REG', rank: 2, is_ranked: true, participant_count: 9, created_by_name: 'Admin', facility_name: 'Hala Praga', matches_progress: null },
    { id: 3, name: 'Americano Sobotni #8', description: '', tournament_type: 'AMR', match_format: 'DBL', start_date: '2026-11-05T10:00:00', end_date: '2026-11-05T16:00:00', status: 'ACT', rank: 3, is_ranked: false, participant_count: 6, created_by_name: 'Admin', facility_name: 'Korty Otwock', matches_progress: { done: 2, total: 4 } },
    { id: 5, name: 'Liga Letnia — Finał', description: '', tournament_type: 'RND', match_format: 'SNG', start_date: '2026-09-10T09:00:00', end_date: '2026-09-11T18:00:00', status: 'FIN', rank: 1, is_ranked: true, participant_count: 12, created_by_name: 'Admin', facility_name: 'Korty Otwock', matches_progress: null },
  ] as TournamentListEntry[];
}

// ── Stałe mapy ──────────────────────────────────────────────────────────────
const TYPE_LABEL: Record<string, string> = {
  SGL: 'Eliminacja pojedyncza', DBE: 'Eliminacja podwójna',
  RND: 'Round Robin', LDR: 'Drabinka', AMR: 'Americano', SWS: 'System szwajcarski',
};

const STATUS_META: Record<string, { label: string; color: 'accent' | 'win' | 'muted' }> = {
  DRF: { label: 'Szkic',          color: 'muted' },
  REG: { label: 'Rejestracja',    color: 'win' },
  SCH: { label: 'Zaplanowany',    color: 'muted' },
  ACT: { label: 'Trwa',           color: 'accent' },
  FIN: { label: 'Zakończony',     color: 'muted' },
  CNC: { label: 'Odwołany',       color: 'muted' },
};

function fmtDate(iso: string | null): string {
  if (!iso) return '—';
  try {
    return new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
  } catch { return iso; }
}

// ── Segmentacja ─────────────────────────────────────────────────────────────
const publicTournaments = tournaments.filter(t => t.status !== 'DRF');
const running = publicTournaments.filter(t => t.status === 'ACT');
const registration = publicTournaments.filter(t => t.status === 'REG');
const finished = publicTournaments.filter(t => t.status === 'FIN' || t.status === 'CNC');
const myCount = currentUser ? publicTournaments.filter(t => myTournamentIds.has(t.id)).length : 0;

// ── Featured tournament: pierwszy ACT turniej w którym user uczestniczy ──────
const featuredEntry = running.find(t => myTournamentIds.has(t.id)) ?? running[0] ?? null;
let featuredDetail: TournamentDetail | null = null;
let featuredStandings: RRStandingRow[] = [];

if (featuredEntry) {
  try {
    featuredDetail = await getTournamentDetail(featuredEntry.id);
    if (featuredDetail?.standings) {
      featuredStandings = featuredDetail.standings.slice(0, 4);
    }
  } catch {
    // cicha degradacja — featured bez standings
  }
}

const totalRounds = featuredDetail?.matches_progress?.total ?? featuredEntry?.matches_progress?.total ?? 0;
const doneRounds = featuredDetail?.matches_progress?.done ?? featuredEntry?.matches_progress?.done ?? 0;
const progressPct = totalRounds > 0 ? Math.round(doneRounds / totalRounds * 100) : 0;
---

<AppLayout
  title="Turnieje"
  greeting="Turnieje"
  greetingSub={`${running.length} aktywnych · ${registration.length} do dołączenia`}
  showSearch={false}
  showCta={true}
  ctaLabel="+ Utwórz turniej"
  ctaHref={url('/tournaments/create')}
>

  <!-- Stats -->
  <div class="tr-stats">
    <div class="tr-stat-card tr-stat-card--accent">
      <div class="tr-stat-label">AKTYWNE</div>
      <div class="tr-stat-val" style="color:var(--tc-accent)">{running.length}</div>
      <div class="tr-stat-sub">trwają teraz</div>
    </div>
    <div class="tr-stat-card">
      <div class="tr-stat-label">W REJESTRACJI</div>
      <div class="tr-stat-val">{registration.length}</div>
      <div class="tr-stat-sub">możesz dołączyć</div>
    </div>
    <div class="tr-stat-card">
      <div class="tr-stat-label">MOJE TURNIEJE</div>
      <div class="tr-stat-val">{currentUser ? myCount : '—'}</div>
      <div class="tr-stat-sub">{currentUser ? 'bierzesz udział' : 'zaloguj się'}</div>
    </div>
    <div class="tr-stat-card">
      <div class="tr-stat-label">ZAKOŃCZONE</div>
      <div class="tr-stat-val">{finished.length}</div>
      <div class="tr-stat-sub">{finished.length > 0 ? 'w historii' : 'brak'}</div>
    </div>
  </div>

  <!-- Featured tournament (jeśli jest aktywny) -->
  {featuredEntry && (
    <div class="tr-featured">
      <div class="tr-featured__accent-bar" aria-hidden="true"></div>
      <div class="tr-featured__grid">
        <!-- Lewa strona: info -->
        <div class="tr-featured__info">
          <div class="tr-featured__top">
            <span class="tr-featured__badge">Trwa teraz</span>
            <span class="tr-featured__tag">
              {myTournamentIds.has(featuredEntry.id) ? 'Twój aktywny turniej' : 'Aktywny turniej'}
            </span>
          </div>
          <h2 class="tr-featured__name">{featuredEntry.name}</h2>
          <div class="tr-featured__meta">
            Format {TYPE_LABEL[featuredEntry.tournament_type] ?? featuredEntry.tournament_type}
            · {featuredEntry.participant_count} uczestników
            {totalRounds > 0 && ` · runda ${doneRounds} z ${totalRounds}`}
          </div>

          {totalRounds > 0 && (
            <div class="tr-featured__progress">
              <div class="tr-progress-bar">
                <div class="tr-progress-bar__fill" style={`width:${progressPct}%`}></div>
              </div>
              <div class="tr-progress-meta">
                <span>Postęp turnieju</span>
                <span class="tr-progress-val">{doneRounds} / {totalRounds} rundy</span>
              </div>
            </div>
          )}

          <div class="tr-featured__actions">
            <a href={url(`/tournaments/${featuredEntry.id}`)} class="tr-btn-primary">Zobacz tabelę →</a>
            <a href={url(`/tournaments/${featuredEntry.id}`)} class="tr-btn-secondary">Wyniki rund</a>
          </div>
        </div>

        <!-- Prawa strona: standings -->
        {featuredStandings.length > 0 && (
          <div class="tr-featured__standings">
            <div class="tr-standings-label">AKTUALNE MIEJSCA</div>
            <div class="tr-standings-list">
              {featuredStandings.map((s, i) => {
                const isMe = currentUser &&
                  s.display_name.toLowerCase().includes(currentUser.last_name?.toLowerCase() ?? '___NOMATCH___');
                return (
                  <div class={`tr-standing-row${isMe ? ' tr-standing-row--me' : ''}`}>
                    <span class={`tr-standing-pos${i === 0 ? ' tr-standing-pos--first' : ''}`}>{i + 1}</span>
                    <span class="tr-standing-name">
                      {s.display_name}
                      {isMe && <span class="tr-standing-me">TY</span>}
                    </span>
                    <span class={`tr-standing-pts${isMe ? ' tr-standing-pts--me' : ''}`}>
                      {Math.round(Number(s.points))}
                    </span>
                    <span class="tr-standing-pkt">pkt</span>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Tabela "WSZYSTKIE TURNIEJE" -->
  <section class="tr-card">
    <div class="tr-card__header">
      <div class="tr-card__title-wrap">
        <span class="tr-card__dot" aria-hidden="true"></span>
        <h2 class="tr-card__title">WSZYSTKIE TURNIEJE</h2>
        <span class="tr-card__badge" id="tr-count-badge">{publicTournaments.length}</span>
      </div>
      <div class="tr-segmented" role="group" aria-label="Filtr turniejów" id="tr-filters">
        <button class="tr-seg tr-seg--active" data-filter="all">Wszystkie</button>
        <button class="tr-seg" data-filter="mine">Moje</button>
        <button class="tr-seg" data-filter="open">Otwarte</button>
        <button class="tr-seg" data-filter="finished">Zakończone</button>
      </div>
    </div>

    <!-- Nagłówki tabeli -->
    <div class="tr-thead">
      <span class="tr-th">#</span>
      <span class="tr-th">TURNIEJ</span>
      <span class="tr-th">TYP</span>
      <span class="tr-th tr-th--r">UCZESTNICY</span>
      <span class="tr-th">STATUS</span>
    </div>

    <div class="tr-tbody" id="tr-tbody">
      {publicTournaments.length === 0 ? (
        <div class="tr-empty">Brak turniejów do wyświetlenia.</div>
      ) : (
        publicTournaments.map((t, i) => {
          const sm = STATUS_META[t.status] ?? { label: t.status, color: 'muted' };
          const joined = myTournamentIds.has(t.id);
          const fillPct = t.participant_count > 0 ? Math.min(100, Math.round(t.participant_count / Math.max(t.participant_count, 8) * 100)) : 0;
          return (
            <a
              class="tr-row"
              href={url(`/tournaments/${t.id}`)}
              data-status={t.status}
              data-joined={joined ? 'true' : 'false'}
            >
              <div class="tr-row__idx">{String(i + 1).padStart(2, '0')}</div>
              <div class="tr-row__tournament">
                <div class="tr-row__name-line">
                  <span class="tr-row__name">{t.name}</span>
                  {joined && <span class="tr-row__joined-badge">JESTEŚ W ŚRODKU</span>}
                </div>
                <div class="tr-row__date">
                  {t.status === 'ACT' ? 'Trwa' : t.status === 'FIN' ? 'Zakończony' : fmtDate(t.start_date) ? `Trwa od ${fmtDate(t.start_date)}` : '—'}
                </div>
              </div>
              <div class="tr-row__type">{TYPE_LABEL[t.tournament_type] ?? t.tournament_type}</div>
              <div class="tr-row__participants">
                <span class="tr-row__p-count">{t.participant_count}</span>
                <span class="tr-row__p-max">/ {Math.max(t.participant_count, 8)}</span>
                <div class="tr-row__p-bar">
                  <div class={`tr-row__p-fill tr-row__p-fill--${sm.color}`} style={`width:${fillPct}%`}></div>
                </div>
              </div>
              <div class={`tr-row__status tr-row__status--${sm.color}`}>
                {(sm.color === 'accent' || sm.color === 'win') && <span class="tr-row__status-dot"></span>}
                {sm.label}
              </div>
            </a>
          );
        })
      )}
    </div>
  </section>

</AppLayout>

<!-- ── Client-side: filtrowanie ──────────────────────────────────────────────── -->
<script>
  const rows = document.querySelectorAll<HTMLElement>('#tr-tbody .tr-row');
  const badge = document.getElementById('tr-count-badge');

  document.querySelectorAll<HTMLButtonElement>('#tr-filters .tr-seg').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#tr-filters .tr-seg').forEach(b => b.classList.remove('tr-seg--active'));
      btn.classList.add('tr-seg--active');

      const f = btn.dataset.filter ?? 'all';
      let visible = 0;

      rows.forEach(row => {
        const status = row.dataset.status;
        const joined = row.dataset.joined === 'true';
        let show = true;

        if (f === 'mine')     show = joined;
        if (f === 'open')     show = status === 'REG' || status === 'SCH';
        if (f === 'finished') show = status === 'FIN' || status === 'CNC';

        row.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (badge) badge.textContent = String(visible);
    });
  });
</script>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     TURNIEJE — layout wg prototypu astro5.jpeg, tokeny --tc-*
     ══════════════════════════════════════════════════════════════════════════ */

  /* ── Stat cards ──────────────────────────────────────────────────────────── */
  .tr-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 12px;
  }

  .tr-stat-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: background 0.25s, border-color 0.25s;
  }

  .tr-stat-card--accent { border-color: var(--tc-accent-border); }

  .tr-stat-label {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tc-muted);
  }

  .tr-stat-val {
    font-size: 2rem;
    font-weight: 800;
    color: var(--tc-ink);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }

  .tr-stat-sub {
    font-size: 0.72rem;
    color: var(--tc-muted);
  }

  /* ── Featured tournament card ──────────────────────────────────────────── */
  .tr-featured {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-accent-border);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    margin-bottom: 12px;
    transition: background 0.25s, border-color 0.25s;
  }

  .tr-featured__accent-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--tc-accent), var(--tc-accent-soft));
  }

  .tr-featured__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
  }

  .tr-featured__info {
    padding: 22px 24px;
  }

  .tr-featured__top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .tr-featured__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--tc-accent-soft);
    border: 1px solid var(--tc-accent-border);
    color: var(--tc-accent);
  }

  .tr-featured__badge::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--tc-accent);
  }

  .tr-featured__tag {
    font-size: 0.72rem;
    color: var(--tc-muted);
  }

  .tr-featured__name {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--tc-ink);
    letter-spacing: -0.03em;
    margin: 0 0 6px;
    line-height: 1.2;
  }

  .tr-featured__meta {
    font-size: 0.78rem;
    color: var(--tc-muted);
    margin-bottom: 20px;
  }

  /* Progress bar */
  .tr-featured__progress { margin-bottom: 20px; }

  .tr-progress-bar {
    height: 6px;
    background: var(--tc-chip-bg);
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .tr-progress-bar__fill {
    height: 100%;
    background: var(--tc-accent);
    box-shadow: 0 0 8px var(--tc-accent-glow);
    border-radius: 99px;
    transition: width 0.3s;
  }

  .tr-progress-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--tc-muted);
  }

  .tr-progress-val {
    font-family: var(--font-mono-plex);
    font-weight: 600;
    color: var(--tc-ink);
  }

  .tr-featured__actions {
    display: flex;
    gap: 8px;
  }

  .tr-btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 8px 18px; border-radius: 8px;
    background: var(--tc-accent); color: var(--tc-accent-ink);
    font-size: 0.84rem; font-weight: 700;
    text-decoration: none; transition: opacity 0.15s;
  }
  .tr-btn-primary:hover { opacity: 0.88; }

  .tr-btn-secondary {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 8px 18px; border-radius: 8px;
    background: transparent;
    border: 1px solid var(--tc-card-border);
    color: var(--tc-ink);
    font-size: 0.84rem; font-weight: 600;
    text-decoration: none; transition: background 0.15s;
  }
  .tr-btn-secondary:hover { background: var(--tc-overlay); }

  /* ── Standings (prawa strona featured) ──────────────────────────────────── */
  .tr-featured__standings {
    padding: 22px 24px;
    border-left: 1px solid var(--tc-card-border);
    background: var(--tc-card-bg-2);
  }

  .tr-standings-label {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tc-muted);
    margin-bottom: 12px;
  }

  .tr-standings-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tr-standing-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 7px;
    transition: background 0.1s;
  }

  .tr-standing-row--me {
    background: var(--tc-accent-soft);
    border: 1px solid var(--tc-accent-border);
  }

  .tr-standing-pos {
    width: 22px; height: 22px;
    border-radius: 5px;
    background: var(--tc-chip-bg);
    color: var(--tc-sub);
    font-size: 0.72rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .tr-standing-pos--first {
    background: var(--tc-accent);
    color: var(--tc-accent-ink);
  }

  .tr-standing-name {
    flex: 1;
    min-width: 0;
    font-size: 0.82rem;
    color: var(--tc-ink);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tr-standing-row--me .tr-standing-name { font-weight: 600; }

  .tr-standing-me {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--tc-accent);
    margin-left: 6px;
  }

  .tr-standing-pts {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--tc-ink);
    font-variant-numeric: tabular-nums;
  }

  .tr-standing-pts--me { color: var(--tc-accent); }

  .tr-standing-pkt {
    font-size: 0.62rem;
    color: var(--tc-muted);
  }

  /* ── Table card ────────────────────────────────────────────────────────── */
  .tr-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    transition: background 0.25s, border-color 0.25s;
  }

  .tr-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tc-card-border);
  }

  .tr-card__title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tr-card__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--tc-accent);
    flex-shrink: 0;
  }

  .tr-card__title {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--tc-ink);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tr-card__badge {
    display: inline-flex;
    align-items: center; justify-content: center;
    min-width: 20px; height: 20px;
    padding: 0 6px; border-radius: 99px;
    background: var(--tc-chip-bg);
    color: var(--tc-muted);
    font-size: 0.72rem; font-weight: 700;
  }

  /* ── Segmented control ─────────────────────────────────────────────────── */
  .tr-segmented {
    display: flex;
    padding: 2px;
    background: var(--tc-chip-bg);
    border-radius: 7px;
  }

  .tr-seg {
    padding: 5px 14px;
    background: transparent;
    border: none; border-radius: 5px;
    font-size: 0.75rem; font-weight: 600;
    color: var(--tc-muted);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .tr-seg:hover { color: var(--tc-sub); }

  .tr-seg--active {
    background: var(--tc-card-bg);
    color: var(--tc-ink);
    box-shadow: var(--tc-shadow);
  }

  /* ── Table head ────────────────────────────────────────────────────────── */
  .tr-thead {
    display: grid;
    grid-template-columns: 36px 1fr 160px 120px 110px;
    gap: 12px;
    padding: 8px 20px;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tc-faint);
