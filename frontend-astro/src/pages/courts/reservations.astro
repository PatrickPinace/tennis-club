  }
  [data-theme="dark"] .cal-res--other {
    background: rgba(59,130,246,0.2);
    color: #93c5fd; border-color: rgba(59,130,246,0.5);
  }

  .cal-res__time {
    font-size: 0.65rem; font-weight: 600; opacity: 0.75; margin-bottom: 1px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .cal-res__label {
    font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* Legenda */
  .cal-legend { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .cal-legend__item {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.78rem; color: var(--text-muted);
  }
  .cal-legend__dot {
    width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0;
  }
  .cal-legend__dot--own   { background: rgba(34,197,94,0.4); border: 1px solid #22c55e; }
  .cal-legend__dot--other { background: rgba(59,130,246,0.3); border: 1px solid rgba(59,130,246,0.5); }
  .cal-legend__dot--free  { background: var(--surface-2); border: 1px solid var(--border); }

  /* ── Free slot hover + drag ───────────────────────────────────────────── */
  .cal-slot-free {
    position: relative;
    cursor: ns-resize;
    transition: background 0.08s;
    box-sizing: border-box;
    user-select: none;
  }
  .cal-slot-free:hover {
    background: rgba(34,197,94,0.08);
  }
  /* Tooltip "przeciągnij lub kliknij" — tylko gdy nie ma aktywnego drag */
  .cal-slot-free:hover::after {
    content: '↕ Przeciągnij lub kliknij';
    position: absolute;
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    font-size: 0.6rem; font-weight: 700; color: #16a34a;
    white-space: nowrap; pointer-events: none;
    z-index: 3;
  }
  /* Zaznaczony zakres drag */
  .cal-slot-drag {
    background: rgba(34,197,94,0.22) !important;
    border-color: rgba(34,197,94,0.5) !important;
  }
  .cal-slot-drag::after { display: none !important; }

  [data-theme="dark"] .cal-slot-free:hover { background: rgba(34,197,94,0.12); }
  [data-theme="dark"] .cal-slot-free:hover::after { color: #4ade80; }
  [data-theme="dark"] .cal-slot-drag { background: rgba(34,197,94,0.28) !important; }

  /* ── Popup ─────────────────────────────────────────────────────────────── */
  .res-popup-backdrop {
    position: fixed; inset: 0; z-index: 50;
    background: rgba(0,0,0,0.4);
    display: flex; align-items: center; justify-content: center;
    padding: 16px;
    animation: fadeIn 0.15s ease;
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .res-popup {
    background: var(--surface);
    border: 1px solid var(--border);
