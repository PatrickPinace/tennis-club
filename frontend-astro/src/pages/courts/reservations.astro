<script define:vars={{ GRID_START, GRID_END, SLOT_PX, GRID_H_PX, todayIso }}>
// ── Grafik kortów — sloty co 30 min, drag-to-select, nawigacja tygodniowa ──

// Wszystkie sloty co 30 min (26 slotów na 8:00–21:00)
const SLOTS = [];
for (let h = GRID_START; h < GRID_END; h++) {
  SLOTS.push(`${String(h).padStart(2,'0')}:00`);
  SLOTS.push(`${String(h).padStart(2,'0')}:30`);
}

function addMinutes(time, min) {
  const [h, m] = time.split(':').map(Number);
  const total = h * 60 + m + min;
  return `${String(Math.floor(total / 60)).padStart(2,'0')}:${String(total % 60).padStart(2,'0')}`;
}

function timeToMin(t) { const [h, m] = t.split(':').map(Number); return h * 60 + m; }

let currentDate = todayIso;
let facilityId  = null;
let pendingSlot = null;

// Drag state
let dragState = null; // { courtId, courtName, startIdx, endIdx }

const loading   = document.getElementById('cal-loading');
const empty     = document.getElementById('cal-empty');
const errorBox  = document.getElementById('cal-error');
const errorMsg  = document.getElementById('cal-error-msg');
const calWrap   = document.getElementById('cal-wrap');
const calGrid   = document.getElementById('cal-grid');

const popup        = document.getElementById('res-popup');
const popupDetail  = document.getElementById('res-popup-detail');
const popupConfirm = document.getElementById('res-popup-confirm');
const popupCancel  = document.getElementById('res-popup-cancel');
const popupMsg     = document.getElementById('res-popup-msg');
const toast        = document.getElementById('res-toast');

// ── Utils ────────────────────────────────────────────────────────────────────

function getCsrf() { const m = document.cookie.match(/csrftoken=([^;]+)/); return m ? m[1] : ''; }

function showState(which) {
  loading.style.display  = which === 'loading' ? '' : 'none';
  empty.style.display    = which === 'empty'   ? '' : 'none';
  errorBox.style.display = which === 'error'   ? '' : 'none';
  calWrap.style.display  = which === 'grid'    ? '' : 'none';
}

function fmtDateLabel(iso) {
  try { return new Date(iso + 'T12:00:00').toLocaleDateString('pl-PL', { weekday: 'long', day: 'numeric', month: 'long' }); }
  catch { return iso; }
}

function isSlotPast(time) {
  if (currentDate > todayIso) return false;
  if (currentDate < todayIso) return true;
  const now = new Date();
  const [sh, sm] = time.split(':').map(Number);
  const slotMs = new Date(todayIso + 'T00:00:00');
  slotMs.setHours(sh, sm, 0, 0);
  return slotMs <= now;
}

// ── Toast ────────────────────────────────────────────────────────────────────
const TOAST_ICONS = { success: '✓', error: '✕', warning: '⚠' };
let toastTimer = null;
function showToast(msg, type = 'success') {
  const icon = TOAST_ICONS[type] ?? '';
  toast.innerHTML = `<span class="res-toast__icon">${icon}</span><span>${msg}</span>`;
  toast.className = `res-toast res-toast--${type}`;
  toast.style.display = '';
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { toast.style.display = 'none'; }, 4000);
}

// ── Popup ────────────────────────────────────────────────────────────────────
function openPopup(slot) {
  if (currentDate < todayIso) return;
  if (isSlotPast(slot.startTime)) return;

  pendingSlot = slot;
  const dur = timeToMin(slot.endTime) - timeToMin(slot.startTime);
  const dateStr = fmtDateLabel(slot.date);

  popupDetail.innerHTML = `
    <div class="res-popup__row"><span class="res-popup__row-icon">🎾</span><span class="res-popup__row-label">Kort</span><span class="res-popup__row-value">${slot.courtName}</span></div>
    <div class="res-popup__row"><span class="res-popup__row-icon">📅</span><span class="res-popup__row-label">Data</span><span class="res-popup__row-value">${dateStr}</span></div>
    <div class="res-popup__row"><span class="res-popup__row-icon">⏰</span><span class="res-popup__row-label">Godzina</span><span class="res-popup__row-value">${slot.startTime}–${slot.endTime}<span class="res-popup__duration">${dur} min</span></span></div>
  `;

  popupMsg.style.display = 'none'; popupMsg.innerHTML = '';
  popupConfirm.disabled = false;
  document.getElementById('res-popup-confirm-label').textContent = 'Zarezerwuj';
  const rc = document.getElementById('res-recurring-check');
  const wr = document.getElementById('res-recurring-weeks-row');
  if (rc) rc.checked = false;
  if (wr) wr.style.display = 'none';
  popup.style.display = '';
  setTimeout(() => popupConfirm?.focus(), 50);
}

document.getElementById('res-recurring-check')?.addEventListener('change', function () {
  const wr = document.getElementById('res-recurring-weeks-row');
  if (wr) wr.style.display = this.checked ? '' : 'none';
});

function closePopup() { popup.style.display = 'none'; pendingSlot = null; }
function showPopupError(msg, isConflict = false) {
  popupMsg.innerHTML = `<span>${isConflict ? '⚠' : '✕'}</span><span>${msg}</span>`;
  popupMsg.className = `res-popup__msg res-popup__msg--${isConflict ? 'conflict' : 'error'}`;
  popupMsg.style.display = '';
  popupConfirm.disabled = false;
  document.getElementById('res-popup-confirm-label').textContent = 'Zarezerwuj';
}

document.getElementById('res-popup-close')?.addEventListener('click', closePopup);
popupCancel?.addEventListener('click', closePopup);
popup?.addEventListener('click', e => { if (e.target === popup) closePopup(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && popup?.style.display !== 'none') closePopup(); });

popupConfirm?.addEventListener('click', async () => {
  if (!pendingSlot) return;
  popupConfirm.disabled = true;
  const rc = document.getElementById('res-recurring-check');
  const ws = document.getElementById('res-recurring-weeks');
  const isRecurring = rc?.checked ?? false;
  const weeks = isRecurring ? parseInt(ws?.value ?? '4', 10) : null;
  document.getElementById('res-popup-confirm-label').textContent = isRecurring ? 'Rezerwuję serię…' : 'Rezerwuję…';
  popupMsg.style.display = 'none';

  const body = { court_id: pendingSlot.courtId, date: pendingSlot.date, start_time: pendingSlot.startTime, end_time: pendingSlot.endTime, ...(isRecurring && { recurring: true, weeks }) };

  try {
    const res = await fetch('/api/courts/reserve/', { method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json', 'X-CSRFToken': getCsrf() }, body: JSON.stringify(body) });
    const data = await res.json().catch(() => ({}));
    if (res.ok) { closePopup(); showToast(isRecurring ? `Seria ${data.count} rezerwacji złożona.` : 'Rezerwacja złożona — oczekuje na zatwierdzenie.', 'success'); await Promise.all([loadTimeline(), reloadMyReservations()]); }
    else if (res.status === 409) showPopupError(data.detail || 'Ten slot jest już zajęty.', true);
    else if (res.status === 400) showPopupError(data.detail || 'Nieprawidłowe dane.');
    else showPopupError(data.detail || `Błąd serwera (${res.status}).`);
  } catch { showPopupError('Brak połączenia z serwerem.'); }
});

// ── Reload my reservations ──────────────────────────────────────────────────
async function reloadMyReservations() {
  try {
    const res = await fetch('/api/courts/reservations/', { credentials: 'include' });
    if (!res.ok) return;
    const list = await res.json();
    renderMyReservations(list);
  } catch {}
}

function fmtDateShort(iso) { try { return new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' }); } catch { return iso; } }
function fmtTimeStr(iso) { try { return new Date(iso).toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' }); } catch { return iso; } }

function renderMyReservations(list) {
  const section = document.getElementById('my-res-list');
  if (!section) return;
  const now = new Date();
  const future = (list || []).filter(r => new Date(r.end_time) > now);
  if (future.length === 0) { section.innerHTML = `<div class="rv-empty-row">Nie masz nadchodzących rezerwacji.</div>`; return; }
  section.innerHTML = future.map(r => {
    const status = r.status.toLowerCase();
    const dt = fmtDateShort(r.start_time);
    const tm = `${fmtTimeStr(r.start_time)}–${fmtTimeStr(r.end_time)}`;
    const isFuture = new Date(r.end_time) > now;
    let bc, bl, cc;
    if (status === 'confirmed') { bc = 'rv-badge--confirmed'; bl = 'potwierdzona'; cc = isFuture; }
    else if (status === 'rejected') { bc = 'rv-badge--rejected'; bl = 'odrzucona'; cc = false; }
    else { bc = 'rv-badge--pending'; bl = 'oczekuje'; cc = isFuture; }
    const sid = r.series_id ?? '';
    return `<div class="rv-res-row" data-res-id="${r.id}" data-series-id="${sid}">
      <span class="rv-res-dot"></span>
      <div class="rv-res-info"><div class="rv-res-when">${dt} · ${tm}</div></div>
      <div class="rv-res-court">${r.court_name ?? 'Kort'}${r.facility_name ? ' · ' + r.facility_name : ''}</div>
      <span class="rv-badge ${bc}">${bl}</span>
      ${cc ? `<button class="rv-cancel-btn my-res-cancel-btn" data-res-id="${r.id}" data-series-id="${sid}">Anuluj</button>` : ''}
    </div>`;
  }).join('');
  const badge = document.querySelector('.rv-my-badge');
  if (badge) badge.textContent = String(future.length);
}

// ── Cancel logic ────────────────────────────────────────────────────────────
let cancelConfirmId = null;

document.getElementById('my-res-list').addEventListener('click', async e => {
  const btn = e.target.closest('.my-res-cancel-btn, .my-res-confirm-btn, .my-res-undo-btn, .my-res-confirm-series-btn');
  if (!btn) return;
  const resId = parseInt(btn.dataset.resId, 10);

  if (btn.classList.contains('my-res-cancel-btn')) {
    if (cancelConfirmId && cancelConfirmId !== resId) resetCancelState(cancelConfirmId);
    cancelConfirmId = resId;
    const row = document.querySelector(`.rv-res-row[data-res-id="${resId}"]`);
    if (!row) return;
    row.querySelectorAll('.rv-badge, .rv-cancel-btn').forEach(el => el.style.display = 'none');
    const sid = row.dataset.seriesId || '';
    const seriesBtn = sid ? `<button class="my-res-confirm-series-btn tr-btn-primary" data-res-id="${resId}" data-series-id="${sid}" style="padding:4px 10px;font-size:0.72rem;">Całą serię</button><button class="my-res-confirm-btn rv-action-ghost" data-res-id="${resId}" style="font-size:0.7rem;padding:4px 8px;">Tylko tę</button>` : `<button class="my-res-confirm-btn tr-btn-primary" data-res-id="${resId}" style="padding:4px 10px;font-size:0.72rem;background:var(--tc-hot);">Tak, anuluj</button>`;
    row.insertAdjacentHTML('beforeend', `<div class="my-res-inline-confirm" data-confirm-id="${resId}"><span class="my-res-inline-confirm__label">${sid ? 'Anulować:' : 'Na pewno?'}</span>${seriesBtn}<button class="my-res-undo-btn rv-action-ghost" data-res-id="${resId}" style="padding:4px 8px;font-size:0.7rem;">Cofnij</button></div>`);
    return;
  }

  if (btn.classList.contains('my-res-undo-btn')) { resetCancelState(resId); cancelConfirmId = null; return; }

  if (btn.classList.contains('my-res-confirm-btn')) {
    btn.disabled = true; btn.textContent = '…';
    try {
      const res = await fetch(`/api/courts/reservations/${resId}/`, { method: 'DELETE', credentials: 'include', headers: { 'X-CSRFToken': getCsrf() } });
      if (res.ok || res.status === 204) { cancelConfirmId = null; showToast('Rezerwacja anulowana.', 'success'); await Promise.all([reloadMyReservations(), loadTimeline()]); }
      else { const d = await res.json().catch(() => ({})); showToast(d.detail || 'Błąd.', 'error'); resetCancelState(resId); cancelConfirmId = null; }
    } catch { showToast('Brak połączenia.', 'error'); resetCancelState(resId); cancelConfirmId = null; }
  }

  if (btn.classList.contains('my-res-confirm-series-btn')) {
    const seriesId = btn.dataset.seriesId;
    btn.disabled = true; btn.textContent = '…';
    try {
      const res = await fetch(`/api/courts/series/${seriesId}/`, { method: 'DELETE', credentials: 'include', headers: { 'X-CSRFToken': getCsrf() } });
      if (res.ok) { const d = await res.json().catch(() => ({})); cancelConfirmId = null; showToast(`Anulowano ${d.cancelled ?? ''} rezerwacji.`, 'success'); await Promise.all([reloadMyReservations(), loadTimeline()]); }
      else { showToast('Błąd.', 'error'); resetCancelState(resId); cancelConfirmId = null; }
    } catch { showToast('Brak połączenia.', 'error'); resetCancelState(resId); cancelConfirmId = null; }
  }
});

function resetCancelState(resId) {
  const row = document.querySelector(`.rv-res-row[data-res-id="${resId}"]`);
  if (!row) return;
  row.querySelector('.my-res-inline-confirm')?.remove();
  row.querySelectorAll('.rv-badge, .rv-cancel-btn').forEach(el => el.style.display = '');
}

// ── Owner approve/reject ────────────────────────────────────────────────────
const ownerList = document.getElementById('owner-pending-list');
if (ownerList) {
  ownerList.addEventListener('click', async e => {
    const btn = e.target.closest('.owner-approve-btn, .owner-reject-btn');
    if (!btn) return;
    const resId = parseInt(btn.dataset.resId, 10);
    const action = btn.classList.contains('owner-approve-btn') ? 'approve' : 'reject';
    const row = ownerList.querySelector(`[data-res-id="${resId}"]`);
    row?.querySelectorAll('button').forEach(b => { b.disabled = true; });
    btn.textContent = action === 'approve' ? 'Zatwierdzam…' : 'Odrzucam…';
    try {
      const res = await fetch(`/api/courts/reservations/${resId}/status/`, { method: 'PATCH', credentials: 'include', headers: { 'Content-Type': 'application/json', 'X-CSRFToken': getCsrf() }, body: JSON.stringify({ action }) });
      if (res.ok) { showToast(action === 'approve' ? 'Zatwierdzona.' : 'Odrzucona.', action === 'approve' ? 'success' : 'warning'); row?.remove(); updateOwnerCount(); await loadTimeline(); }
      else { showToast('Błąd.', 'error'); row?.querySelectorAll('button').forEach(b => { b.disabled = false; }); }
    } catch { showToast('Brak połączenia.', 'error'); row?.querySelectorAll('button').forEach(b => { b.disabled = false; }); }
  });
}

function updateOwnerCount() {
  const rows = ownerList?.querySelectorAll('.rv-manager-row') ?? [];
  const badge = document.getElementById('owner-pending-count');
  if (badge) badge.textContent = rows.length > 0 ? `${rows.length} oczekuje` : 'Brak';
  if (rows.length === 0) { const ol = ownerList?.querySelector('.owner-res-list'); if (ol) ol.innerHTML = '<div class="rv-empty-row">Wszystkie obsłużone.</div>'; }
}

// ── Grid render — sloty co 30 min, drag-to-select ───────────────────────────

function slotStateFor(s) {
  if (!s) return 'past';
  if (s.is_mine) return 'mine';
  if (s.status !== 'FREE') return 'taken';
  if (isSlotPast(s.time)) return 'past';
  return 'free';
}

function renderGrid(data) {
  const courts = data.courts;
  if (!courts || courts.length === 0) { showState('empty'); return; }

  const cols = SLOTS.length;
  // Label kolumny co godzinę, nie co 30 min — ale każdy slot osobny
  const colTemplate = `120px repeat(${cols}, minmax(34px, 1fr))`;

  // Stat cards
  let totalFree = 0, totalSlots = 0;
  courts.forEach(c => { c.slots.forEach(s => { totalSlots++; if (s.status === 'FREE' && !s.is_mine) totalFree++; }); });
  const freeEl = document.getElementById('rv-free-slots');
  if (freeEl) freeEl.textContent = String(totalFree);
  const freeSub = document.getElementById('rv-free-slots-sub');
  if (freeSub) freeSub.textContent = `z ${totalSlots} dostępnych`;
  const courtsEl = document.getElementById('rv-courts-count');
  if (courtsEl) courtsEl.textContent = String(courts.length);
  const courtsSub = document.getElementById('rv-courts-sub');
  if (courtsSub) courtsSub.textContent = `dostępne korty`;

  // Nagłówek godzin — etykieta tylko dla :00, pusta dla :30
  let html = `<div class="rv-hour-header" style="display:grid;grid-template-columns:${colTemplate};">`;
  html += `<div class="rv-hour-header__court">KORT</div>`;
  SLOTS.forEach(t => {
    const isHour = t.endsWith(':00');
    html += `<div class="rv-hour-header__label rv-hour-header__label--${isHour ? 'full' : 'half'}">${isHour ? t : ''}</div>`;
  });
  html += `</div>`;

  // Wiersze kortów
  courts.forEach(court => {
    html += `<div class="rv-court-row" style="display:grid;grid-template-columns:${colTemplate};" data-court-id="${court.id}">`;
    html += `<div class="rv-court-label"><div class="rv-court-label__name">${court.name}</div><div class="rv-court-label__surface">${court.surface ?? ''}</div></div>`;

    court.slots.forEach((s, idx) => {
      const st = slotStateFor(s);
      const endTime = addMinutes(s.time, 30);
      const isHalfHour = s.time.endsWith(':30');
      const extraClass = isHalfHour ? ' rv-slot--half' : ' rv-slot--hour';
      const label = st === 'mine' ? 'TY' : st === 'taken' ? '×' : '';

      if (st === 'free') {
        html += `<div class="rv-slot rv-slot--free${extraClass}" data-court-id="${court.id}" data-court-name="${court.name}" data-slot-idx="${idx}" data-start="${s.time}" data-end="${endTime}" role="button" tabindex="0" title="${s.time}–${endTime}"></div>`;
      } else if (st === 'mine') {
        html += `<div class="rv-slot rv-slot--mine${extraClass}" title="Twoja rezerwacja ${s.time}">${label}</div>`;
      } else if (st === 'taken') {
        html += `<div class="rv-slot rv-slot--taken${extraClass}" title="Zajęty ${s.time}">${label}</div>`;
      } else {
        html += `<div class="rv-slot rv-slot--past${extraClass}"></div>`;
      }
    });
    html += `</div>`;
  });

  calGrid.innerHTML = html;
  showState('grid');
  attachSlotHandlers(courts);
}

// ── Drag-to-select ───────────────────────────────────────────────────────────

function attachSlotHandlers(courts) {
  // Klawiatura — Enter/Space na wolnym slocie
  calGrid.querySelectorAll('.rv-slot--free').forEach(el => {
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openPopup({ courtId: +el.dataset.courtId, courtName: el.dataset.courtName, date: currentDate, startTime: el.dataset.start, endTime: el.dataset.end });
      }
    });
  });

  // Drag-to-select na każdym wierszu kortu
  calGrid.querySelectorAll('.rv-court-row[data-court-id]').forEach(row => {
    const courtId   = +row.dataset.courtId;
    const courtName = row.querySelector('.rv-court-label__name')?.textContent ?? '';
    const freeSlots = Array.from(row.querySelectorAll('.rv-slot--free'));

    if (freeSlots.length === 0) return;

    let isDragging = false;
    let dragStartIdx = -1;
    let dragEndIdx   = -1;

    function getSlotIdx(el) { return freeSlots.indexOf(el); }

    function highlightRange(a, b) {
      const lo = Math.min(a, b), hi = Math.max(a, b);
      freeSlots.forEach((s, i) => {
        s.classList.toggle('rv-slot--drag', i >= lo && i <= hi);
      });
    }

    function clearHighlight() {
      freeSlots.forEach(s => s.classList.remove('rv-slot--drag'));
    }

    // Sprawdź czy zakres zawiera tylko wolne sloty na tym korcie
    function rangeIsFree(a, b) {
      const lo = Math.min(a, b), hi = Math.max(a, b);
      // Pobierz wszystkie sloty (nie tylko free) z tego wiersza
      const allSlots = Array.from(row.querySelectorAll('.rv-slot[data-slot-idx]'));
      for (let i = lo; i <= hi; i++) {
        const s = freeSlots[i];
        if (!s) return false;
      }
      return true;
    }

    // mousedown — start drag
    row.addEventListener('mousedown', e => {
      const el = e.target.closest('.rv-slot--free');
      if (!el) return;
      e.preventDefault();
      isDragging = true;
      dragStartIdx = getSlotIdx(el);
      dragEndIdx   = dragStartIdx;
      highlightRange(dragStartIdx, dragEndIdx);
    });

    // mousemove — extend selection
    row.addEventListener('mousemove', e => {
      if (!isDragging) return;
      const el = e.target.closest('.rv-slot--free');
      if (!el) return;
      const idx = getSlotIdx(el);
      if (idx === -1) return;
      dragEndIdx = idx;
      highlightRange(dragStartIdx, dragEndIdx);
    });

    // mouseup — finish drag
    row.addEventListener('mouseup', e => {
      if (!isDragging) return;
      isDragging = false;
      clearHighlight();
      if (dragStartIdx === -1) return;

      const lo = Math.min(dragStartIdx, dragEndIdx);
      const hi = Math.max(dragStartIdx, dragEndIdx);

      const startEl = freeSlots[lo];
      const endEl   = freeSlots[hi];
      if (!startEl || !endEl) return;

      openPopup({
        courtId,
        courtName,
        date: currentDate,
        startTime: startEl.dataset.start,
        endTime: endEl.dataset.end,
      });
      dragStartIdx = -1; dragEndIdx = -1;
    });
  });

  // mouseleave — cancel drag without opening popup
  calGrid.addEventListener('mouseleave', () => {
    if (!dragState) return;
    calGrid.querySelectorAll('.rv-slot--drag').forEach(s => s.classList.remove('rv-slot--drag'));
  });

  // mouseup poza gridem — cancel
  document.addEventListener('mouseup', () => {
    calGrid.querySelectorAll('.rv-slot--drag').forEach(s => s.classList.remove('rv-slot--drag'));
  }, { once: false });
}

// ── Timeline load ────────────────────────────────────────────────────────────
async function loadTimeline() {
  if (!facilityId) { showState('empty'); return; }
  showState('loading');
  try {
    const res = await fetch(`/api/courts/timeline/${facilityId}/?date=${currentDate}`, { credentials: 'include' });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    renderGrid(data);
  } catch (e) {
    errorMsg.textContent = `Nie udało się załadować grafiku. (${e.message})`;
    showState('error');
  }
}

// ── Week navigation ──────────────────────────────────────────────────────────

const dayNamesLong  = ['Niedziela','Poniedziałek','Wtorek','Środa','Czwartek','Piątek','Sobota'];
const dayNamesShort = ['niedz.','pon.','wt.','śr.','czw.','pt.','sob.'];
const monthNames    = ['stycznia','lutego','marca','kwietnia','maja','czerwca','lipca','sierpnia','września','października','listopada','grudnia'];

// Offset tygodni od bieżącego (0 = ten tydzień)
let weekOffset = 0;

function isoFromDate(d) { return d.toISOString().slice(0, 10); }

function addDays(iso, n) {
  const d = new Date(iso + 'T12:00:00');
  d.setDate(d.getDate() + n);
  return isoFromDate(d);
}

function buildWeekDays(offset) {
  const today = new Date();
  const todayStr = isoFromDate(today);
  const days = [];
  for (let i = 0; i < 7; i++) {
    const d = new Date(today);
    d.setDate(d.getDate() + offset * 7 + i);
    const iso = isoFromDate(d);
    const isToday = iso === todayStr;
    days.push({
      iso,
      label: isToday ? 'Dziś' : dayNamesLong[d.getDay()],
      sub: `${dayNamesShort[d.getDay()]} ${d.getDate()}`,
      isToday,
      isPast: iso < todayStr,
    });
  }
  return days;
}

function renderWeekNav() {
  const days = buildWeekDays(weekOffset);
  const picker = document.getElementById('rv-day-picker');
  if (!picker) return;

  // Aktywna data — jeśli obecna data jest w tym tygodniu, zachowaj, inaczej pierwszy dzień tygodnia
  const weekDates = days.map(d => d.iso);
  if (!weekDates.includes(currentDate)) {
    // Wybierz pierwszy nieprzeszły dzień tygodnia
    const first = days.find(d => !d.isPast) ?? days[0];
    currentDate = first.iso;
  }

  picker.innerHTML = days.map(d => `
    <button class="rv-day${d.iso === currentDate ? ' rv-day--active' : ''}${d.isPast ? ' rv-day--past' : ''}" data-date="${d.iso}" ${d.isPast ? 'disabled' : ''}>
      <span class="rv-day__label">${d.label}</span>
      <span class="rv-day__sub">${d.sub}</span>
    </button>
  `).join('');

  // Etykieta tygodnia
  const first = days[0], last = days[6];
  const firstD = new Date(first.iso + 'T12:00:00');
  const lastD  = new Date(last.iso  + 'T12:00:00');
  const label  = weekOffset === 0 ? 'Ten tydzień'
    : `${firstD.getDate()} ${monthNames[firstD.getMonth()]} – ${lastD.getDate()} ${monthNames[lastD.getMonth()]}`;
  const weekLabel = document.getElementById('rv-week-label');
  if (weekLabel) weekLabel.textContent = label;

  // Prev button disabled dla przeszłych tygodni
  const prevBtn = document.getElementById('rv-week-prev');
  if (prevBtn) prevBtn.disabled = weekOffset <= 0;

  // Obsługa kliknięć
  picker.querySelectorAll('.rv-day:not([disabled])').forEach(btn => {
    btn.addEventListener('click', () => {
      currentDate = btn.dataset.date;
      picker.querySelectorAll('.rv-day').forEach(b => b.classList.remove('rv-day--active'));
      btn.classList.add('rv-day--active');
      loadTimeline();
    });
  });
}

document.getElementById('rv-week-prev')?.addEventListener('click', () => {
  if (weekOffset <= 0) return;
  weekOffset--;
  renderWeekNav();
  loadTimeline();
});

document.getElementById('rv-week-next')?.addEventListener('click', () => {
  weekOffset++;
  renderWeekNav();
  loadTimeline();
});

// "Nowa rezerwacja" button scrolls to grid
document.getElementById('rv-new-res-btn')?.addEventListener('click', () => {
  document.querySelector('.rv-grid-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

// ── Init ─────────────────────────────────────────────────────────────────────
async function init() {
  renderWeekNav();
  showState('loading');
  try {
    const res = await fetch('/api/courts/facilities/', { credentials: 'include' });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const facilities = await res.json();
    if (!facilities || facilities.length === 0) { showState('empty'); return; }
    facilityId = facilities[0].id;
    await loadTimeline();
  } catch (e) {
    errorMsg.textContent = `Nie udało się załadować obiektów. (${e.message})`;
    showState('error');
  }
}

init();
</script>
