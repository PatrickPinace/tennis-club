---
// courts/reservations.astro — moje rezerwacje kortów + grafik dostępności (SSR)
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCurrentUser, getMyReservations, type ReservationEntry } from '@/lib/api';
import { url } from '@/lib/url';

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;

// SSR fetch — równolegle
const [currentUser, rawReservations] = await Promise.all([
  getCurrentUser(sessionCookie),
  getMyReservations(sessionCookie),
]);

if (!currentUser) {
  return Astro.redirect(url('/login') + '?next=' + encodeURIComponent(url('/courts/reservations')));
}

// Właściciel / staff — pobierz oczekujące rezerwacje do zatwierdzenia
interface PendingEntry {
  id: number;
  court_name: string | null;
  facility_name: string | null;
  start_time: string;
  end_time: string;
  status: string;
  user_name: string;
}
const isManager = currentUser.is_staff;  // rozszerzalne o facility.owner w przyszłości

// Dla is_staff pobieramy pending SSR; dla właściciela facility też (backend filtruje)
// Dla zwykłego usera nie fetchujemy w ogóle
let pendingReservations: PendingEntry[] = [];
if (isManager) {
  try {
    const DJANGO_API = import.meta.env.DJANGO_API_URL ?? process.env.DJANGO_API_URL ?? 'http://localhost:8000';
    const pr = await fetch(`${DJANGO_API}/api/courts/reservations/pending/`, {
      headers: { Cookie: sessionCookie ?? '', Accept: 'application/json' },
      redirect: 'manual',
    });
    if (pr.ok) pendingReservations = await pr.json();
  } catch { /* graceful — sekcja będzie pusta */ }
}

// Pomocnik formatowania daty i godziny z ISO datetime
function fmtDate(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' });
  } catch { return iso; }
}
function fmtTime(iso: string): string {
  try {
    return new Date(iso).toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
  } catch { return iso; }
}
function fmtDateTime(iso: string): string {
  try {
    return new Date(iso).toLocaleString('pl-PL', {
      weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit'
    });
  } catch { return iso; }
}

const myReservations = rawReservations.map((r: ReservationEntry) => ({
  id: r.id,
  court: r.court_name ?? 'Kort',
  facility: r.facility_name ?? '',
  date: fmtDate(r.start_time),
  time: `${fmtTime(r.start_time)}–${fmtTime(r.end_time)}`,
  startIso: r.start_time,
  status: r.status.toLowerCase() as 'pending' | 'confirmed' | 'rejected',
}));

// Konfiguracja statusu — jedna centralna definicja używana w SSR i JS
// badge: klasa CSS badge | hint: tekst pomocniczy | canCancel: czy pokazujemy "Anuluj"
function resStatusConfig(status: string, isFuture: boolean) {
  if (status === 'confirmed') return {
    badgeClass: 'tc-badge-success',
    badgeLabel: 'Zatwierdzona',
    hint: 'Rezerwacja potwierdzona przez właściciela.',
    canCancel: isFuture,
  };
  if (status === 'rejected') return {
    badgeClass: 'tc-badge-danger',
    badgeLabel: 'Odrzucona',
    hint: 'Rezerwacja została odrzucona przez właściciela.',
    canCancel: false,
  };
  // PENDING (domyślnie)
  return {
    badgeClass: 'tc-badge-warning',
    badgeLabel: 'Oczekuje',
    hint: 'Czeka na decyzję właściciela obiektu.',
    canCancel: isFuture,
  };
}

// Stałe dla grafiku (używane też w JS)
const GRID_START = 8;   // 08:00
const GRID_END   = 21;  // ostatni slot 20:30
const SLOT_PX    = 30;  // px na 30 min
const GRID_ROWS  = (GRID_END - GRID_START) * 2; // liczba slotów 30-min
const GRID_H_PX  = GRID_ROWS * SLOT_PX;
const hours      = Array.from({ length: GRID_END - GRID_START }, (_, i) => GRID_START + i);

// Dzisiejsza data jako default dla grafiku
const todayIso = new Date().toISOString().slice(0, 10);
---

<AppLayout
  title="Rezerwacje kortów"
  showSearch={false}
  showCta={false}
  currentUser={currentUser}
>

  <PageHeader
    eyebrow="Korty"
    title="Rezerwacje kortów"
    centered={true}
  />

  <!-- Sekcja managera — widoczna tylko dla is_staff / właściciela obiektu -->
  {isManager && (
    <section class="owner-section tc-card" aria-labelledby="owner-heading" id="owner-section">
      <div class="tc-card-header">
        <h2 class="tc-card-title" id="owner-heading">Oczekujące rezerwacje</h2>
        <span class="owner-section__badge" id="owner-pending-count">
          {pendingReservations.length > 0 ? `${pendingReservations.length} oczekuje` : 'Brak oczekujących'}
        </span>
      </div>

      <div id="owner-pending-list">
        {pendingReservations.length === 0 ? (
          <div class="owner-empty">
            <span aria-hidden="true">✓</span>
            Wszystkie rezerwacje są obsłużone.
          </div>
        ) : (
          <div class="owner-res-list">
            {pendingReservations.map(r => (
              <div class="owner-res-row" data-res-id={r.id}>
                <div class="owner-res-row__info">
                  <div class="owner-res-row__who">{r.user_name}</div>
                  <div class="owner-res-row__what">
                    {r.court_name ?? 'Kort'}
                    {r.facility_name && <span class="owner-res-row__facility"> · {r.facility_name}</span>}
                  </div>
                  <div class="owner-res-row__when">
                    {fmtDateTime(r.start_time)}–{fmtTime(r.end_time)}
                  </div>
                </div>
                <div class="owner-res-row__actions">
                  <button class="tc-btn tc-btn-success tc-btn-sm owner-approve-btn" data-res-id={r.id}>
                    Zatwierdź
                  </button>
                  <button class="tc-btn tc-btn-ghost tc-btn-sm owner-reject-btn" data-res-id={r.id}>
                    Odrzuć
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Moje rezerwacje — szybki podgląd -->
  <section class="my-res-section" aria-labelledby="my-res-heading">
    <h2 class="section-label" id="my-res-heading">Moje rezerwacje</h2>

    <div id="my-res-list">
      {myReservations.length === 0 ? (
        <div class="my-res-empty">
          <span class="my-res-empty__icon" aria-hidden="true">📅</span>
          <div class="my-res-empty__text">Nie masz żadnych rezerwacji.</div>
        </div>
      ) : (
        <div class="my-res-grid">
          {myReservations.map(r => {
            const isFuture = new Date(r.startIso) > new Date();
            const cfg = resStatusConfig(r.status, isFuture);
            return (
              <div class={`my-res-card my-res-card--${r.status}`} data-res-id={r.id}>
                <div class="my-res-card__left">
                  <div class="my-res-card__court">{r.court}</div>
                  {r.facility && <div class="my-res-card__facility">{r.facility}</div>}
                  <div class="my-res-card__time">{r.date} · {r.time}</div>
                  <div class="my-res-card__hint">{cfg.hint}</div>
                </div>
                <div class="my-res-card__right">
                  <span class={`tc-badge ${cfg.badgeClass}`}>{cfg.badgeLabel}</span>
                  {cfg.canCancel && (
                    <button class="my-res-cancel-btn" data-res-id={r.id} aria-label="Anuluj rezerwację">
                      Anuluj
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- Grafik kortów — dynamicznie ładowany przez JS -->
  <section class="calendar-section tc-card" aria-labelledby="calendar-heading">
    <div class="tc-card-header">
      <h2 class="tc-card-title" id="calendar-heading">Grafik kortów</h2>
      <div class="calendar-nav">
        <button id="cal-prev" class="tc-btn tc-btn-ghost tc-btn-sm tc-btn-icon" aria-label="Poprzedni dzień">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
        </button>

        <!-- Przycisk daty — input wewnątrz żeby picker otwierał się pod buttonem -->
        <button type="button" id="cal-date-btn" class="cal-date-btn" aria-label="Wybierz datę z kalendarza">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
          </svg>
          <span id="cal-date-label" class="cal-date-btn__label">—</span>
          <input id="cal-date-input" type="date" aria-label="Wybierz datę grafiku"
            style="position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:1px;height:1px;opacity:0;pointer-events:none;border:none;padding:0;" />
        </button>

        <button id="cal-today" class="tc-btn tc-btn-ghost tc-btn-sm" aria-label="Przejdź do dzisiaj">Dziś</button>

        <button id="cal-next" class="tc-btn tc-btn-ghost tc-btn-sm tc-btn-icon" aria-label="Następny dzień">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Skeleton / loading / empty states -->
    <div id="cal-loading" class="cal-state" style="display:none;">
      <span class="cal-state__icon" aria-hidden="true">⏳</span>
      <span>Ładowanie grafiku…</span>
    </div>
    <div id="cal-empty" class="cal-state" style="display:none;">
      <span class="cal-state__icon" aria-hidden="true">🎾</span>
      <span>Brak obiektów z włączoną rezerwacją online.</span>
    </div>
    <div id="cal-error" class="cal-state cal-state--error" style="display:none;">
      <span class="cal-state__icon" aria-hidden="true">⚠</span>
      <span id="cal-error-msg">Nie udało się załadować grafiku.</span>
    </div>

    <!-- Kontener na dynamiczny grid — wypełniany przez JS -->
    <!-- calendar-wrap-outer: scroll shadow hint (opacity 1 gdy grid szerszy niż kontener) -->
    <div class="calendar-wrap-outer">
      <div id="cal-wrap" class="calendar-wrap" style="overflow-x:auto; display:none;">
        <div id="cal-grid" class="calendar-grid"></div>
      </div>
    </div>

    <!-- Legenda -->
    <div class="tc-card-footer">
      <div class="cal-legend">
        <div class="cal-legend__item">
          <div class="cal-legend__dot cal-legend__dot--own" aria-hidden="true"></div>
          Moja rezerwacja
        </div>
        <div class="cal-legend__item">
          <div class="cal-legend__dot cal-legend__dot--other" aria-hidden="true"></div>
          Zarezerwowane
        </div>
        <div class="cal-legend__item">
          <div class="cal-legend__dot cal-legend__dot--free" aria-hidden="true"></div>
          Wolny slot
        </div>
      </div>
    </div>
  </section>

  <!-- Toast sukcesu / błędu -->
  <div id="res-toast" class="res-toast" style="display:none;" role="alert" aria-live="polite"></div>

  <!-- Popup potwierdzenia rezerwacji -->
  <div id="res-popup" class="res-popup-backdrop" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="res-popup-title">
    <div class="res-popup">

      <!-- Nagłówek -->
      <div class="res-popup__header">
        <div class="res-popup__icon" aria-hidden="true">🎾</div>
        <div>
          <div class="res-popup__title" id="res-popup-title">Rezerwacja kortu</div>
          <div class="res-popup__subtitle">Sprawdź szczegóły i potwierdź</div>
        </div>
        <button id="res-popup-close" class="res-popup__close" aria-label="Zamknij">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>

      <!-- Detale rezerwacji — wypełniane przez JS -->
      <div id="res-popup-detail" class="res-popup__detail"></div>

      <!-- Info o statusie PENDING -->
      <div class="res-popup__notice">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
        </svg>
        Rezerwacja będzie oczekiwać na zatwierdzenie przez właściciela obiektu.
      </div>

      <!-- Akcje -->
      <div class="res-popup__actions">
        <button id="res-popup-confirm" class="tc-btn tc-btn-primary tc-btn-sm">
          <span id="res-popup-confirm-label">Zarezerwuj</span>
        </button>
        <button id="res-popup-cancel" class="tc-btn tc-btn-ghost tc-btn-sm">Anuluj</button>
      </div>

      <!-- Komunikat błędu / sukcesu inline -->
      <div id="res-popup-msg" class="res-popup__msg" style="display:none;" role="alert"></div>
    </div>
  </div>

</AppLayout>

<style is:global>
  /* ── courts/reservations.astro ─────────────────────────────────────────── */
  /* is:global wymagane bo część klas (.calendar-*, .cal-res*) tworzonych przez JS */

  /* ── Owner section ─────────────────────────────────────────────────────── */
  .owner-section { margin-bottom: 24px; }

  .owner-section__badge {
    font-size: 0.72rem; font-weight: 700;
    padding: 3px 10px;
    border-radius: 99px;
    background: rgba(234,179,8,0.12);
    color: #92400e;
    border: 1px solid rgba(234,179,8,0.3);
  }
  [data-theme="dark"] .owner-section__badge { color: #fbbf24; }

  .owner-empty {
    display: flex; align-items: center; gap: 8px;
    padding: 18px 20px;
    font-size: 0.875rem; color: var(--text-muted);
  }

  .owner-res-list { display: flex; flex-direction: column; }

  .owner-res-row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    transition: background 0.1s;
  }
  .owner-res-row:last-child { border-bottom: none; }
  .owner-res-row:hover { background: var(--surface-2, rgba(128,128,128,0.04)); }

  .owner-res-row__info { flex: 1; min-width: 0; }
  .owner-res-row__who {
    font-weight: 700; font-size: 0.875rem; color: var(--text);
    margin-bottom: 2px;
  }
  .owner-res-row__what {
    font-size: 0.82rem; color: var(--text-muted); margin-bottom: 2px;
  }
  .owner-res-row__facility { opacity: 0.7; }
  .owner-res-row__when {
    font-size: 0.78rem; color: var(--text-dim);
  }

  .owner-res-row__actions {
    display: flex; gap: 8px; flex-shrink: 0;
  }

  /* tc-btn-success — jeśli nie ma w globalnych */
  .tc-btn-success {
    background: #22c55e; color: #fff; border: none;
  }
  .tc-btn-success:hover { background: #16a34a; }
  .tc-btn-success:disabled { background: #86efac; cursor: not-allowed; }

  /* ── My reservations ───────────────────────────────────────────────────── */
  .my-res-section { margin-bottom: 24px; }

  .section-label {
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--text-muted); margin-bottom: 10px; padding-left: 2px;
  }

  .my-res-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  .my-res-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px 18px;
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 12px;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.15s;
  }
  .my-res-card:hover { box-shadow: var(--shadow-md); }
  .my-res-card--confirmed { border-left: 3px solid #22c55e; }
  .my-res-card--pending   { border-left: 3px solid var(--warning); }
  .my-res-card--rejected  { border-left: 3px solid var(--danger, #dc2626); opacity: 0.75; }

  .my-res-card__court {
    font-weight: 700; font-size: 0.9rem; color: var(--text);
    margin-bottom: 3px;
  }
  .my-res-card__time {
    font-size: 0.8rem; color: var(--text-muted); margin-bottom: 2px;
  }
  .my-res-card__facility {
    font-size: 0.75rem; color: var(--text-dim); margin-bottom: 2px;
  }
  .my-res-card__hint {
    font-size: 0.72rem; color: var(--text-dim); margin-top: 4px; line-height: 1.4;
  }

  .my-res-empty {
    display: flex; align-items: center; gap: 10px;
    padding: 20px 16px;
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .my-res-empty__icon { font-size: 1.25rem; flex-shrink: 0; }

  .my-res-card__right {
    display: flex; flex-direction: column; align-items: flex-end;
    flex-shrink: 0; gap: 6px;
  }

  /* Przycisk Anuluj na karcie rezerwacji */
  .my-res-cancel-btn {
    background: none; border: none; cursor: pointer;
    font-size: 0.72rem; font-weight: 600;
    color: var(--text-dim);
    padding: 2px 0;
    text-decoration: underline;
    transition: color 0.12s;
  }
  .my-res-cancel-btn:hover { color: var(--danger, #dc2626); }

  /* Inline confirm — pojawia się po kliknięciu "Anuluj" */
  .my-res-inline-confirm {
    display: flex; flex-direction: column; align-items: flex-end; gap: 5px;
    animation: fadeIn 0.12s ease;
  }
  .my-res-inline-confirm__label {
    font-size: 0.72rem; font-weight: 600; color: var(--danger, #dc2626);
    white-space: nowrap;
  }
  .my-res-inline-confirm .tc-btn { font-size: 0.72rem; padding: 3px 10px; }

  /* tc-btn-danger — jeśli nie ma w globalnych stylach */
  .tc-btn-danger {
    background: var(--danger, #dc2626); color: #fff; border: none;
  }
  .tc-btn-danger:hover { background: #b91c1c; }

  /* tc-badge-danger — czerwony badge dla REJECTED */
  .tc-badge-danger {
    background: rgba(239,68,68,0.1);
    color: var(--danger, #dc2626);
    border: 1px solid rgba(239,68,68,0.25);
  }
  [data-theme="dark"] .tc-badge-danger {
    background: rgba(239,68,68,0.15);
    color: #f87171;
    border-color: rgba(239,68,68,0.3);
  }

  /* ── Calendar states ───────────────────────────────────────────────────── */
  .calendar-section { margin-top: 0; }

  .cal-state {
    display: flex; align-items: center; gap: 10px;
    padding: 24px 20px;
    font-size: 0.875rem; color: var(--text-muted);
  }
  .cal-state--error { color: var(--danger); }
  .cal-state__icon { font-size: 1.25rem; flex-shrink: 0; }

  /* ── Calendar nav ──────────────────────────────────────────────────────── */
  .calendar-nav {
    display: flex; align-items: center; gap: 8px;
  }
  /* ── Nawigacja daty ──────────────────────────────────────────────────────── */
  .calendar-nav { gap: 6px; }

  /* Przycisk daty — wygląda jak button, zawiera ukryty input[date] */
  .cal-date-btn {
    position: relative;
    display: inline-flex; align-items: center; gap: 7px;
    cursor: pointer;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 6px);
    background: var(--surface);
    transition: background 0.12s, border-color 0.12s, box-shadow 0.12s;
    white-space: nowrap;
  }
  .cal-date-btn:hover {
    background: var(--surface-2, rgba(128,128,128,0.07));
    border-color: var(--primary, #22c55e);
    box-shadow: 0 0 0 2px rgba(34,197,94,0.12);
  }
  .cal-date-btn svg { color: var(--text-muted); flex-shrink: 0; pointer-events: none; }

  .cal-date-btn__label {
    font-size: 0.85rem; font-weight: 600; color: var(--text);
    pointer-events: none;
  }

  /* Input daty — schowany wizualnie przez inline style, otwierany przez showPicker() */

  .calendar-wrap { padding-bottom: 4px; }
  .calendar-grid { min-width: 560px; }

  /* Nagłówki kortów */
  .calendar-header {
    display: grid;
    grid-template-columns: 56px repeat(var(--courts), 1fr);
    border-bottom: 1px solid var(--border);
    position: sticky; top: 0; z-index: 2;
    background: var(--surface);
  }

  .calendar-time-col { flex-shrink: 0; width: 56px; }

  .calendar-court-header {
    padding: 10px 8px;
    text-align: center;
    font-size: 0.78rem; font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.05em;
    border-left: 1px solid var(--border);
  }

  /* Body: godziny × korty */
  .calendar-body {
    display: grid;
    grid-template-columns: 56px repeat(var(--courts), 1fr);
  }

  .calendar-time-col { display: flex; flex-direction: column; }

  .calendar-hour-label {
    display: flex; align-items: flex-start;
