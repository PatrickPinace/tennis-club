---
// courts/reservations.astro — rezerwacje kortów (SSR)
// Layout wg prototypu astro6.jpeg — stat cards + day picker + siatka godzinowa + moje rezerwacje
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import { getCurrentUser, getMyReservations, type ReservationEntry } from '@/lib/api';
import { url } from '@/lib/url';

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;

const [currentUser, rawReservations] = await Promise.all([
  getCurrentUser(sessionCookie),
  getMyReservations(sessionCookie),
]);

if (!currentUser) {
  return Astro.redirect(url('/login') + '?next=' + encodeURIComponent(url('/courts/reservations')));
}

// Manager / staff — pobierz oczekujące rezerwacje
interface PendingEntry {
  id: number;
  court_name: string | null;
  facility_name: string | null;
  start_time: string;
  end_time: string;
  status: string;
  user_name: string;
}
const isManager = currentUser.is_staff;

let pendingReservations: PendingEntry[] = [];
if (isManager) {
  try {
    const DJANGO_API = import.meta.env.DJANGO_API_URL ?? process.env.DJANGO_API_URL ?? 'http://localhost:8000';
    const pr = await fetch(`${DJANGO_API}/api/courts/reservations/pending/`, {
      headers: { Cookie: sessionCookie ?? '', Accept: 'application/json' },
      redirect: 'manual',
    });
    if (pr.ok) pendingReservations = await pr.json();
  } catch { /* graceful */ }
}

// Formatowanie
function fmtDate(iso: string): string {
  try { return new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' }); }
  catch { return iso; }
}
function fmtTime(iso: string): string {
  try { return new Date(iso).toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' }); }
  catch { return iso; }
}
function fmtDateTime(iso: string): string {
  try { return new Date(iso).toLocaleString('pl-PL', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); }
  catch { return iso; }
}

const myReservations = rawReservations.map((r: ReservationEntry) => ({
  id: r.id,
  court: r.court_name ?? 'Kort',
  facility: r.facility_name ?? '',
  date: fmtDate(r.start_time),
  time: `${fmtTime(r.start_time)}–${fmtTime(r.end_time)}`,
  startIso: r.start_time,
  endIso: r.end_time,
  status: r.status.toLowerCase() as 'pending' | 'confirmed' | 'rejected',
  seriesId: (r as any).series_id ?? null,
}));

function resStatusConfig(status: string, isFuture: boolean) {
  if (status === 'confirmed') return { badgeClass: 'rv-badge--confirmed', badgeLabel: 'potwierdzona', canCancel: isFuture };
  if (status === 'rejected')  return { badgeClass: 'rv-badge--rejected',  badgeLabel: 'odrzucona',     canCancel: false };
  return { badgeClass: 'rv-badge--pending', badgeLabel: 'oczekuje', canCancel: isFuture };
}

// Stałe grafiku
const GRID_START = 8;
const GRID_END   = 21;
const SLOT_PX    = 30;
const GRID_ROWS  = (GRID_END - GRID_START) * 2;
const GRID_H_PX  = GRID_ROWS * SLOT_PX;
const todayIso   = new Date().toISOString().slice(0, 10);

// Day picker — 7 dni od dziś
const now = new Date();
const dayNames = ['Niedziela','Poniedziałek','Wtorek','Środa','Czwartek','Piątek','Sobota'];
const dayNamesShort = ['niedz.','pon','wt','śr','czw','pt','sob'];
const days: { iso: string; label: string; sub: string; isToday: boolean }[] = [];
for (let i = 0; i < 7; i++) {
  const d = new Date(now);
  d.setDate(d.getDate() + i);
  const iso = d.toISOString().slice(0, 10);
  days.push({
    iso,
    label: i === 0 ? 'Dziś' : dayNames[d.getDay()],
    sub: `${dayNamesShort[d.getDay()]} ${d.getDate()}`,
    isToday: i === 0,
  });
}

const futureReservations = myReservations.filter(r => new Date(r.endIso) > now);
---

<AppLayout
  title="Rezerwacje kortów"
  greeting="Rezerwacje"
  greetingSub="Twoje korty na ten tydzień"
  showSearch={false}
  showCta={true}
  ctaLabel="+ Nowa rezerwacja"
  ctaHref={url('/courts/reservations')}
>

  <!-- Stat cards -->
  <div class="rv-stats">
    <div class="rv-stat rv-stat--accent">
      <div class="rv-stat__label">WOLNE SLOTY DZIŚ</div>
      <div class="rv-stat__val" style="color:var(--tc-accent)" id="rv-free-slots">—</div>
      <div class="rv-stat__sub" id="rv-free-slots-sub">ładowanie…</div>
    </div>
    <div class="rv-stat">
      <div class="rv-stat__label">TWOJE REZERWACJE</div>
      <div class="rv-stat__val">{futureReservations.length}</div>
      <div class="rv-stat__sub">na ten tydzień</div>
    </div>
    <div class="rv-stat">
      <div class="rv-stat__label">KORTY OTWARTE</div>
      <div class="rv-stat__val" id="rv-courts-count">—</div>
      <div class="rv-stat__sub" id="rv-courts-sub">ładowanie…</div>
    </div>
    <div class="rv-stat">
      <div class="rv-stat__label">TWOJE ZUŻYTE GODZINY</div>
      <div class="rv-stat__val">{myReservations.length}</div>
      <div class="rv-stat__sub">rezerwacji łącznie</div>
    </div>
  </div>

  <!-- Day picker z nawigacją tygodniową -->
  <div class="rv-week-nav">
    <button class="rv-week-btn" id="rv-week-prev" aria-label="Poprzedni tydzień">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
    </button>
    <span class="rv-week-label" id="rv-week-label"></span>
    <button class="rv-week-btn" id="rv-week-next" aria-label="Następny tydzień">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
    </button>
  </div>
  <div class="rv-days" id="rv-day-picker">
    {days.map((d, i) => (
      <button
        class={`rv-day${i === 0 ? ' rv-day--active' : ''}`}
        data-date={d.iso}
      >
        <span class="rv-day__label">{d.label}</span>
        <span class="rv-day__sub">{d.isToday ? `${dayNamesShort[now.getDay()]} ${now.getDate()}` : d.sub}</span>
      </button>
    ))}
  </div>

  <!-- Manager panel — widoczny tylko dla staff -->
  {isManager && pendingReservations.length > 0 && (
    <section class="rv-manager" id="owner-section">
      <div class="rv-manager__header">
        <span class="rv-manager__title">Oczekujące rezerwacje</span>
        <span class="rv-manager__badge" id="owner-pending-count">{pendingReservations.length} oczekuje</span>
      </div>
      <div id="owner-pending-list">
        <div class="owner-res-list">
          {pendingReservations.map(r => (
            <div class="rv-manager-row" data-res-id={r.id}>
              <div class="rv-manager-row__info">
                <div class="rv-manager-row__who">{r.user_name}</div>
                <div class="rv-manager-row__what">{r.court_name ?? 'Kort'}{r.facility_name && ` · ${r.facility_name}`}</div>
                <div class="rv-manager-row__when">{fmtDateTime(r.start_time)}–{fmtTime(r.end_time)}</div>
              </div>
              <div class="rv-manager-row__actions">
                <button class="tr-btn-primary owner-approve-btn" data-res-id={r.id} style="padding:6px 14px;font-size:0.78rem;">Zatwierdź</button>
                <button class="rv-action-ghost owner-reject-btn" data-res-id={r.id}>Odrzuć</button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Siatka dostępności kortów -->
  <section class="rv-grid-card">
    <div class="rv-grid-header">
      <span class="rv-grid-title">DOSTĘPNOŚĆ KORTÓW</span>
      <div class="rv-legend">
        <div class="rv-legend__item"><div class="rv-legend__swatch rv-legend__swatch--mine"></div>Twoje</div>
        <div class="rv-legend__item"><div class="rv-legend__swatch rv-legend__swatch--free"></div>Wolne</div>
        <div class="rv-legend__item"><div class="rv-legend__swatch rv-legend__swatch--taken"></div>Zajęte</div>
        <div class="rv-legend__item"><div class="rv-legend__swatch rv-legend__swatch--past"></div>Minione</div>
      </div>
    </div>

    <!-- States -->
    <div id="cal-loading" class="rv-state" style="display:none;">Ładowanie grafiku…</div>
    <div id="cal-empty" class="rv-state" style="display:none;">Brak obiektów z włączoną rezerwacją online.</div>
    <div id="cal-error" class="rv-state rv-state--error" style="display:none;"><span id="cal-error-msg">Nie udało się załadować grafiku.</span></div>

    <!-- Siatka — renderowana przez JS -->
    <div class="rv-grid-scroll">
      <div id="cal-wrap" style="display:none;">
        <div id="cal-grid" class="rv-grid-table"></div>
      </div>
    </div>

    <div class="rv-grid-footer">
      <div class="rv-grid-footer__hint">
        Kliknij lub <strong>przeciągnij myszą</strong> po wolnych slotach, aby wybrać zakres godzin.
      </div>
      <button class="tr-btn-primary" id="rv-new-res-btn" style="padding:8px 18px;font-size:0.84rem;">+ Nowa rezerwacja</button>
    </div>
  </section>

  <!-- Moje rezerwacje -->
  <section class="rv-my-card">
    <div class="rv-my-header">
      <div class="rv-my-header__left">
        <span class="rv-card-dot" aria-hidden="true"></span>
        <span class="rv-my-title">MOJE REZERWACJE</span>
        <span class="rv-my-badge">{futureReservations.length}</span>
      </div>
    </div>

    <div id="my-res-list">
      {futureReservations.length === 0 ? (
        <div class="rv-empty-row">Nie masz nadchodzących rezerwacji.</div>
      ) : (
        futureReservations.map(r => {
          const isFuture = new Date(r.endIso) > now;
          const cfg = resStatusConfig(r.status, isFuture);
          return (
            <div class="rv-res-row" data-res-id={r.id} data-series-id={r.seriesId ?? ''}>
              <span class="rv-res-dot" aria-hidden="true"></span>
              <div class="rv-res-info">
                <div class="rv-res-when">{r.date} · {r.time}</div>
                <div class="rv-res-detail">{r.status === 'confirmed' ? 'Singiel' : 'Oczekuje'}</div>
              </div>
              <div class="rv-res-court">{r.court}{r.facility ? ` · ${r.facility}` : ''}</div>
              <span class={`rv-badge ${cfg.badgeClass}`}>{cfg.badgeLabel}</span>
              {cfg.canCancel && (
                <button class="rv-cancel-btn my-res-cancel-btn" data-res-id={r.id} data-series-id={r.seriesId ?? ''}>Anuluj</button>
              )}
            </div>
          );
        })
      )}
    </div>
  </section>

  <!-- Toast -->
  <div id="res-toast" class="res-toast" style="display:none;" role="alert" aria-live="polite"></div>

  <!-- Popup rezerwacji -->
  <div id="res-popup" class="res-popup-backdrop" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="res-popup-title">
    <div class="res-popup">
      <div class="res-popup__header">
        <div>
          <div class="res-popup__title" id="res-popup-title">Rezerwacja kortu</div>
          <div class="res-popup__subtitle">Sprawdź szczegóły i potwierdź</div>
        </div>
        <button id="res-popup-close" class="res-popup__close" aria-label="Zamknij">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
        </button>
      </div>
      <div id="res-popup-detail" class="res-popup__detail"></div>
      <div class="res-popup__recurring" id="res-popup-recurring-wrap">
        <label class="recurring-toggle">
          <input type="checkbox" id="res-recurring-check" />
          <span class="recurring-toggle__label">Rezerwacja cykliczna (co tydzień)</span>
        </label>
        <div class="recurring-weeks-row" id="res-recurring-weeks-row" style="display:none;">
          <label class="recurring-weeks-label" for="res-recurring-weeks">Liczba tygodni:</label>
          <select id="res-recurring-weeks" class="recurring-weeks-select">
            <option value="2">2 tygodnie</option>
            <option value="3">3 tygodnie</option>
            <option value="4" selected>4 tygodnie</option>
            <option value="6">6 tygodni</option>
            <option value="8">8 tygodni</option>
            <option value="12">12 tygodni</option>
          </select>
        </div>
      </div>
      <div class="res-popup__notice">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
        Rezerwacja będzie oczekiwać na zatwierdzenie przez właściciela obiektu.
      </div>
      <div class="res-popup__actions">
        <button id="res-popup-confirm" class="tr-btn-primary" style="flex:1;padding:10px 18px;">
          <span id="res-popup-confirm-label">Zarezerwuj</span>
        </button>
        <button id="res-popup-cancel" class="rv-action-ghost">Anuluj</button>
      </div>
      <div id="res-popup-msg" class="res-popup__msg" style="display:none;" role="alert"></div>
    </div>
  </div>

  <!-- Ukryty date input dla nawigacji kalendarza -->
  <input id="cal-date-input" type="date" style="position:absolute;width:0;height:0;opacity:0;pointer-events:none;" />

</AppLayout>

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════════
     REZERWACJE — layout wg prototypu astro6.jpeg, tokeny --tc-*
     ══════════════════════════════════════════════════════════════════════════ */

  /* ── Stat cards ──────────────────────────────────────────────────────────── */
  .rv-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 12px;
  }

  .rv-stat {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex; flex-direction: column; gap: 6px;
    transition: background 0.25s, border-color 0.25s;
  }
  .rv-stat--accent { border-color: var(--tc-accent-border); }
  .rv-stat__label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--tc-muted); }
  .rv-stat__val { font-size: 2rem; font-weight: 800; color: var(--tc-ink); line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }
  .rv-stat__sub { font-size: 0.72rem; color: var(--tc-muted); }

  /* ── Week nav ────────────────────────────────────────────────────────────── */
  .rv-week-nav {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 8px;
  }
  .rv-week-btn {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 8px;
    background: var(--tc-card-bg); border: 1px solid var(--tc-card-border);
    color: var(--tc-sub); cursor: pointer; transition: all 0.15s;
    flex-shrink: 0;
  }
  .rv-week-btn:hover { border-color: var(--tc-accent-border); color: var(--tc-accent); }
  .rv-week-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .rv-week-label {
    font-size: 0.82rem; font-weight: 600; color: var(--tc-sub);
    flex: 1; text-align: center;
  }

  /* ── Day picker ──────────────────────────────────────────────────────────── */
  .rv-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    margin-bottom: 12px;
  }

  .rv-day {
    padding: 12px 8px;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 10px;
    cursor: pointer;
    font-family: var(--font-sans);
    text-align: left;
    transition: all 0.15s;
  }
  .rv-day:hover { border-color: var(--tc-accent-border); }

  .rv-day--active {
    background: var(--tc-accent);
    border-color: var(--tc-accent);
    color: var(--tc-accent-ink);
    box-shadow: 0 4px 16px var(--tc-accent-glow);
  }

  .rv-day__label { display: block; font-size: 0.78rem; font-weight: 600; }
  .rv-day__sub { display: block; font-size: 1.15rem; font-weight: 800; margin-top: 2px; font-variant-numeric: tabular-nums; }

  .rv-day--active .rv-day__label,
  .rv-day--active .rv-day__sub { color: var(--tc-accent-ink); }
  .rv-day__label { color: var(--tc-sub); }
  .rv-day__sub { color: var(--tc-ink); }

  /* ── Grid card (siatka dostępności) ─────────────────────────────────────── */
  .rv-grid-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    margin-bottom: 12px;
    transition: background 0.25s, border-color 0.25s;
    overflow: hidden;
  }

  .rv-grid-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tc-card-border);
  }

  .rv-grid-title {
    font-size: 0.78rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--tc-ink);
  }

  .rv-legend { display: flex; align-items: center; gap: 14px; }
  .rv-legend__item { display: flex; align-items: center; gap: 6px; font-size: 0.72rem; color: var(--tc-muted); }
  .rv-legend__swatch { width: 12px; height: 12px; border-radius: 3px; }
  .rv-legend__swatch--mine { background: var(--tc-accent); }
  .rv-legend__swatch--free { background: var(--tc-card-bg); border: 1px solid var(--tc-card-border); }
  .rv-legend__swatch--taken { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); }
  .rv-legend__swatch--past { background: var(--tc-chip-bg); }

  /* States */
  .rv-state { padding: 32px 20px; text-align: center; font-size: 0.84rem; color: var(--tc-muted); }
  .rv-state--error { color: var(--tc-hot); }

  /* Grid scroll container */
  .rv-grid-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  /* ── Siatka godzinowa (pozioma tabela: korty × godziny) ────────────────── */
  .rv-grid-table { min-width: 900px; }

  /* Nagłówki godzin */
  .rv-hour-header {
    display: grid;
    border-bottom: 1px solid var(--tc-card-border);
    background: var(--tc-card-bg-2);
  }
  .rv-hour-header__label {
    padding: 10px 2px; text-align: center;
    font-family: var(--font-mono-plex);
    font-size: 0.68rem; font-weight: 500;
    color: var(--tc-muted);
    border-right: 1px solid var(--tc-card-border-soft);
    white-space: nowrap; overflow: hidden;
  }
  .rv-hour-header__label--half {
    border-left: 1px dashed var(--tc-card-border-soft);
    color: transparent;
  }
  .rv-hour-header__court {
    padding: 12px 16px;
    font-size: 0.6rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--tc-faint);
    border-right: 1px solid var(--tc-card-border);
  }

  /* Wiersz kortu */
  .rv-court-row {
    display: grid;
    border-bottom: 1px solid var(--tc-card-border-soft);
  }
  .rv-court-row:last-child { border-bottom: none; }

  .rv-court-label {
    padding: 14px 16px;
    border-right: 1px solid var(--tc-card-border);
    display: flex; flex-direction: column; justify-content: center; gap: 2px;
  }
  .rv-court-label__name { font-size: 0.84rem; font-weight: 600; color: var(--tc-ink); }
  .rv-court-label__surface { font-size: 0.68rem; color: var(--tc-muted); }

  /* Sloty */
  .rv-slot {
    display: grid; place-items: center;
    min-height: 46px;
    border-right: 1px solid var(--tc-card-border-soft);
    transition: background 0.1s;
    cursor: default;
    font-size: 0.65rem; font-weight: 700;
    user-select: none;
  }

  .rv-slot--free { cursor: pointer; color: var(--tc-faint); }
  .rv-slot--free:hover { background: var(--tc-accent-soft); color: var(--tc-accent); }

  .rv-slot--mine { background: var(--tc-accent); color: var(--tc-accent-ink); font-size: 0.62rem; letter-spacing: 0.08em; cursor: pointer; }
  .rv-slot--mine:hover { opacity: 0.9; }

  .rv-slot--taken { background: rgba(239,68,68,0.1); color: var(--tc-hot); }

  .rv-slot--past { background: var(--tc-chip-bg); color: transparent; cursor: not-allowed; }

  /* Slot co 30 min — separator wizualny między :00 a :30 */
  .rv-slot--hour { border-left: 1px solid var(--tc-card-border-soft); }
  .rv-slot--half { border-left: 1px dashed var(--tc-card-border-soft); }

  /* Drag highlight */
  .rv-slot--drag {
    background: var(--tc-accent-soft) !important;
    outline: 2px solid var(--tc-accent) !important;
    outline-offset: -1px;
    cursor: col-resize !important;
  }

  /* Przeszły dzień w day pickerze */
  .rv-day--past { opacity: 0.4; cursor: not-allowed; }

  /* Footer */
  .rv-grid-footer {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 14px 20px;
    border-top: 1px solid var(--tc-card-border);
