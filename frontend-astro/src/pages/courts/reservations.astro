  }
  .res-popup__close:hover { background: var(--surface-2); color: var(--text); }

  /* Detale — wypełniane przez JS jako structured HTML */
  .res-popup__detail {
    padding: 16px 20px 0;
  }
  .res-popup__row {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border);
