  }
  .res-popup__row:last-child { border-bottom: none; }
  .res-popup__row-icon {
    width: 16px; text-align: center; flex-shrink: 0;
    color: var(--text-dim); font-size: 0.85rem;
  }
  .res-popup__row-label {
    color: var(--text-muted); font-size: 0.78rem; min-width: 52px; flex-shrink: 0;
  }
  .res-popup__row-value {
    color: var(--text); font-weight: 600;
  }
  .res-popup__duration {
    display: inline-block;
    background: var(--surface-2, rgba(128,128,128,0.1));
    border-radius: 4px; padding: 1px 6px;
    font-size: 0.72rem; font-weight: 700;
    color: var(--text-muted); margin-left: 6px;
  }

  /* Notice PENDING */
  .res-popup__notice {
    display: flex; align-items: flex-start; gap: 8px;
    margin: 14px 20px 0;
    background: rgba(234,179,8,0.08);
    border: 1px solid rgba(234,179,8,0.25);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.78rem; color: var(--text-muted); line-height: 1.5;
  }
  .res-popup__notice svg { flex-shrink: 0; margin-top: 1px; color: #ca8a04; }

  /* Akcje */
  .res-popup__actions {
    display: flex; gap: 10px;
    padding: 16px 20px 20px;
  }
  .res-popup__actions .tc-btn:first-child { flex: 1; }

  /* Komunikat błędu inline */
  .res-popup__msg {
    margin: 0 20px 16px;
    padding: 9px 12px;
    border-radius: 7px;
    font-size: 0.82rem; font-weight: 600;
    display: flex; align-items: flex-start; gap: 7px;
    line-height: 1.4;
  }
  .res-popup__msg--error {
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.25);
    color: var(--danger, #dc2626);
  }
  .res-popup__msg--conflict {
    background: rgba(234,179,8,0.08);
    border: 1px solid rgba(234,179,8,0.3);
    color: #92400e;
  }
  [data-theme="dark"] .res-popup__msg--conflict { color: #fbbf24; }

  /* ── Toast ─────────────────────────────────────────────────────────────── */
  .res-toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    z-index: 60;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 18px;
    font-size: 0.875rem; font-weight: 600;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    color: var(--text);
    max-width: calc(100vw - 32px);
    white-space: normal; text-align: center;
    display: flex; align-items: center; gap: 8px;
    animation: toastIn 0.2s ease;
  }
  @keyframes toastIn { from { opacity:0; transform: translateX(-50%) translateY(8px); } to { opacity:1; transform: translateX(-50%) translateY(0); } }
  .res-toast--success { border-left: 3px solid #22c55e; }
  .res-toast--success .res-toast__icon { color: #16a34a; }
  .res-toast--error   { border-left: 3px solid var(--danger, #dc2626); }
  .res-toast--error .res-toast__icon   { color: var(--danger, #dc2626); }
  .res-toast__icon { font-size: 1rem; flex-shrink: 0; }
  [data-theme="dark"] .res-toast--success .res-toast__icon { color: #4ade80; }

  /* ── Responsive ────────────────────────────────────────────────────────── */

  /* ── 768px — tablet / duży telefon ──────────────────────────────── */
  @media (max-width: 768px) {
    .my-res-grid { grid-template-columns: 1fr; }

    /* Owner: wiersz stackuje się pionowo — info nad przyciskami */
    .owner-res-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 14px 16px;
    }
    .owner-res-row__actions {
      width: 100%;
      justify-content: flex-end;
    }

    /* tc-card header — tytuł + badge zawijają się */
    .tc-card-header {
      flex-wrap: wrap;
      gap: 8px;
    }

    /* Legenda grafiku — ciaśniejsza */
    .cal-legend { gap: 10px; }
  }

  /* ── 480px — telefon ──────────────────────────────────────────────── */
  @media (max-width: 480px) {
    /* Karty rezerwacji — lewa kolumna pełna szerokość, prawa poniżej */
    .my-res-card {
      flex-direction: column;
      gap: 10px;
      padding: 14px 14px;
    }
    .my-res-card__right {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      flex-shrink: unset;
    }
    /* Inline confirm na full-width karcie */
    .my-res-inline-confirm {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      width: 100%;
      justify-content: space-between;
    }
    .my-res-inline-confirm__label { white-space: normal; }

    /* Owner: przyciski pełna szerokość na bardzo wąskim */
    .owner-res-row__actions {
      flex-direction: column;
      gap: 6px;
    }
    .owner-res-row__actions .tc-btn {
      width: 100%;
      justify-content: center;
      min-height: 38px; /* wygodny dotyk */
    }

    /* Sekcja owner — mniejszy padding */
    .owner-section .tc-card-header { padding: 14px 14px; }

    /* Nawigacja grafiku — wraparound zamiast overflow */
    .calendar-nav {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 4px;
    }
    .cal-date-btn {
      padding: 5px 9px;
    }
    .cal-date-btn__label {
      /* Skróć etykietę daty — browser i tak da krótkie locale */
      max-width: 130px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Przycisk anuluj — większy area dotyku */
    .my-res-cancel-btn {
      padding: 6px 2px;
      min-height: 32px;
    }

    /* Popup — wypełnij cały ekran na mini telefonie */
    .res-popup-backdrop { padding: 8px; align-items: flex-end; }
    .res-popup {
      border-radius: var(--radius-lg, 12px) var(--radius-lg, 12px) 0 0;
      max-height: 90vh;
      overflow-y: auto;
    }

    /* Toast — full width na wąskim */
    .res-toast {
      left: 16px; right: 16px;
      transform: none;
      bottom: 16px;
      max-width: none;
    }
    @keyframes toastIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Legenda grafiku — pionowo */
    .cal-legend { flex-direction: column; gap: 6px; }
  }

  /* ── Grafik — świadomy poziomy scroll ─────────────────────────────── */
  /* .calendar-grid { min-width: 560px } zostawiamy — grafik z natury jest szeroki.
     .calendar-wrap { overflow-x: auto } już jest inline. Dodajemy visual hint. */
  .calendar-wrap {
    /* Smooth scrolling, overflow-x ustawiony inline w HTML */
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  /* Scroll shadow hint po prawej stronie gdy grid przewija się */
  .calendar-wrap-outer {
    position: relative;
  }
  .calendar-wrap-outer::after {
    content: '';
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 24px;
    background: linear-gradient(to right, transparent, var(--surface));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .calendar-wrap-outer.is-scrollable::after { opacity: 1; }
</style>

<script define:vars={{ GRID_START, GRID_END, SLOT_PX, GRID_H_PX, todayIso }}>
// ── Grafik kortów — dynamiczny render z API + create reservation ───────────

const SLOT_COUNT = (GRID_END - GRID_START) * 2;

let currentDate = todayIso;
let facilityId  = null;

// Aktualnie wybrany slot do rezerwacji
let pendingSlot = null; // { courtId, courtName, date, startTime, endTime }

// DOM refs — grafik
const loading   = document.getElementById('cal-loading');
const empty     = document.getElementById('cal-empty');
const errorBox  = document.getElementById('cal-error');
const errorMsg  = document.getElementById('cal-error-msg');
const calWrap   = document.getElementById('cal-wrap');
const calGrid   = document.getElementById('cal-grid');
const dateLabel = document.getElementById('cal-date-label');
const dateInput = document.getElementById('cal-date-input');

// DOM refs — popup
const popup        = document.getElementById('res-popup');
const popupDetail  = document.getElementById('res-popup-detail');
const popupConfirm = document.getElementById('res-popup-confirm');
const popupCancel  = document.getElementById('res-popup-cancel');
const popupMsg     = document.getElementById('res-popup-msg');

// DOM refs — toast
const toast = document.getElementById('res-toast');

// ── Utils ──────────────────────────────────────────────────────────────────

function getCsrf() {
  const m = document.cookie.match(/csrftoken=([^;]+)/);
  return m ? m[1] : '';
}

function showState(which) {
  loading.style.display  = which === 'loading' ? '' : 'none';
  empty.style.display    = which === 'empty'   ? '' : 'none';
  errorBox.style.display = which === 'error'   ? '' : 'none';
  calWrap.style.display  = which === 'grid'    ? '' : 'none';
}

function fmtDateLabel(iso) {
  try {
    return new Date(iso + 'T12:00:00').toLocaleDateString('pl-PL', {
      weekday: 'long', day: 'numeric', month: 'long'
    });
  } catch { return iso; }
}

function addDays(iso, n) {
  const d = new Date(iso + 'T12:00:00');
  d.setDate(d.getDate() + n);
  return d.toISOString().slice(0, 10);
}

// Czas końca slotu +30 min
function slotEnd(startTime) {
  const [h, m] = startTime.split(':').map(Number);
  const total  = h * 60 + m + 30;
  return `${String(Math.floor(total / 60)).padStart(2,'0')}:${String(total % 60).padStart(2,'0')}`;
}

// ── Toast ──────────────────────────────────────────────────────────────────

const TOAST_ICONS = { success: '✓', error: '✕', warning: '⚠' };

let toastTimer = null;
function showToast(msg, type = 'success') {
  const icon = TOAST_ICONS[type] ?? '';
  toast.innerHTML = `<span class="res-toast__icon" aria-hidden="true">${icon}</span><span>${msg}</span>`;
  toast.className = `res-toast res-toast--${type}`;
  toast.style.display = '';
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { toast.style.display = 'none'; }, 4000);
}

// ── Popup ──────────────────────────────────────────────────────────────────

function durationMin(start, end) {
  const [sh, sm] = start.split(':').map(Number);
  const [eh, em] = end.split(':').map(Number);
  return (eh * 60 + em) - (sh * 60 + sm);
}

function openPopup(slot) {
  // Blokada dat przeszłych — nie powinno się zdarzać, ale jako obrona
  if (slot.date < todayIso) return;
  pendingSlot = slot;

  const dur      = durationMin(slot.startTime, slot.endTime);
  const dateStr  = fmtDateLabel(slot.date);

  // Strukturalne detale — czytelne wiersze
  popupDetail.innerHTML = `
    <div class="res-popup__row">
      <span class="res-popup__row-icon" aria-hidden="true">🎾</span>
      <span class="res-popup__row-label">Kort</span>
      <span class="res-popup__row-value">${slot.courtName}</span>
    </div>
    <div class="res-popup__row">
      <span class="res-popup__row-icon" aria-hidden="true">📅</span>
      <span class="res-popup__row-label">Data</span>
      <span class="res-popup__row-value">${dateStr}</span>
    </div>
    <div class="res-popup__row">
      <span class="res-popup__row-icon" aria-hidden="true">⏰</span>
      <span class="res-popup__row-label">Godzina</span>
      <span class="res-popup__row-value">
        ${slot.startTime}–${slot.endTime}
        <span class="res-popup__duration">${dur} min</span>
      </span>
    </div>
  `;

  // Reset stanu
  popupMsg.style.display = 'none';
  popupMsg.innerHTML     = '';
  popupConfirm.disabled  = false;
  document.getElementById('res-popup-confirm-label').textContent = 'Zarezerwuj';
  popup.style.display = '';
  // Focus trap — focus na przycisk Zarezerwuj
  setTimeout(() => popupConfirm?.focus(), 50);
}

function closePopup() {
  popup.style.display = 'none';
  pendingSlot = null;
}

function showPopupError(msg, isConflict = false) {
  popupMsg.innerHTML     = `<span aria-hidden="true">${isConflict ? '⚠' : '✕'}</span><span>${msg}</span>`;
  popupMsg.className     = `res-popup__msg res-popup__msg--${isConflict ? 'conflict' : 'error'}`;
  popupMsg.style.display = '';
  popupConfirm.disabled  = false;
  document.getElementById('res-popup-confirm-label').textContent = 'Zarezerwuj';
}

// Zamknięcie: X button, klik tła, Escape
document.getElementById('res-popup-close')?.addEventListener('click', closePopup);
popupCancel?.addEventListener('click', closePopup);
popup?.addEventListener('click', e => { if (e.target === popup) closePopup(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && popup?.style.display !== 'none') closePopup(); });

popupConfirm?.addEventListener('click', async () => {
  if (!pendingSlot) return;
  popupConfirm.disabled  = true;
  document.getElementById('res-popup-confirm-label').textContent = 'Rezerwuję…';
  popupMsg.style.display = 'none';

  try {
    const res = await fetch('/api/courts/reserve/', {
      method: 'POST',
      credentials: 'include',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': getCsrf(),
      },
      body: JSON.stringify({
        court_id:   pendingSlot.courtId,
        date:       pendingSlot.date,
        start_time: pendingSlot.startTime,
        end_time:   pendingSlot.endTime,
      }),
    });

    const data = await res.json().catch(() => ({}));

    if (res.ok) {
      closePopup();
      showToast('Rezerwacja złożona — oczekuje na zatwierdzenie przez właściciela.', 'success');
      await Promise.all([loadTimeline(), reloadMyReservations()]);
    } else if (res.status === 409) {
      showPopupError(data.detail || 'Ten slot jest już zajęty. Wybierz inny termin.', true);
    } else if (res.status === 400) {
      showPopupError(data.detail || 'Nieprawidłowe dane rezerwacji.');
    } else {
      showPopupError(data.detail || `Błąd serwera (${res.status}). Spróbuj ponownie.`);
    }
  } catch {
    showPopupError('Brak połączenia z serwerem. Sprawdź internet i spróbuj ponownie.');
  }
});

// ── Reload "Moje rezerwacje" bez page refresh ──────────────────────────────

async function reloadMyReservations() {
  try {
    const res  = await fetch('/api/courts/reservations/', { credentials: 'include' });
    if (!res.ok) return;
    const list = await res.json();
    renderMyReservations(list);
  } catch { /* nie rób nic — sekcja pozostaje jak była */ }
}

function fmtDateShort(iso) {
  try { return new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' }); } catch { return iso; }
}
function fmtTimeStr(iso) {
  try { return new Date(iso).toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' }); } catch { return iso; }
}

function renderMyReservations(list) {
  const section = document.getElementById('my-res-list');
  if (!section) return;

  if (!list || list.length === 0) {
    section.innerHTML = `
      <div class="my-res-empty">
        <span class="my-res-empty__icon" aria-hidden="true">📅</span>
        <div class="my-res-empty__text">Nie masz żadnych rezerwacji.</div>
      </div>`;
    return;
  }

  const now = new Date();
  section.innerHTML = `<div class="my-res-grid">${list.map(r => {
    const status    = r.status.toLowerCase();
    const dateStr   = fmtDateShort(r.start_time);
    const timeStr   = `${fmtTimeStr(r.start_time)}–${fmtTimeStr(r.end_time)}`;
    const isFuture  = new Date(r.start_time) > now;

    let badgeClass, badgeLabel, hint, canCancel;
    if (status === 'confirmed') {
      badgeClass = 'tc-badge-success'; badgeLabel = 'Zatwierdzona';
      hint = 'Rezerwacja potwierdzona przez właściciela.';
      canCancel = isFuture;
    } else if (status === 'rejected') {
      badgeClass = 'tc-badge-danger'; badgeLabel = 'Odrzucona';
      hint = 'Rezerwacja została odrzucona przez właściciela.';
      canCancel = false;
    } else {
      badgeClass = 'tc-badge-warning'; badgeLabel = 'Oczekuje';
      hint = 'Czeka na decyzję właściciela obiektu.';
      canCancel = isFuture;
    }

    const badge     = `<span class="tc-badge ${badgeClass}">${badgeLabel}</span>`;
    const cancelBtn = canCancel
      ? `<button class="my-res-cancel-btn" data-res-id="${r.id}" aria-label="Anuluj rezerwację">Anuluj</button>`
      : '';
    return `
      <div class="my-res-card my-res-card--${status}" data-res-id="${r.id}">
        <div class="my-res-card__left">
          <div class="my-res-card__court">${r.court_name ?? 'Kort'}</div>
          ${r.facility_name ? `<div class="my-res-card__facility">${r.facility_name}</div>` : ''}
          <div class="my-res-card__time">${dateStr} · ${timeStr}</div>
          <div class="my-res-card__hint">${hint}</div>
        </div>
        <div class="my-res-card__right">${badge}${cancelBtn}</div>
      </div>`;
  }).join('')}</div>`;
}

// ── Anulowanie rezerwacji ──────────────────────────────────────────────────
//
// Flow: klik "Anuluj" → przycisk zmienia się w "Potwierdź / Cofnij" (inline confirm)
//       → klik "Potwierdź" → DELETE /api/courts/reservations/<id>/
//       → sukces: reload listy + reload timeline | błąd: toast

let cancelConfirmId = null; // ID rezerwacji w trybie inline-confirm

document.getElementById('my-res-list').addEventListener('click', async e => {
  const btn = e.target.closest('.my-res-cancel-btn, .my-res-confirm-btn, .my-res-undo-btn');
  if (!btn) return;

  const resId = parseInt(btn.dataset.resId, 10);

  // ── "Anuluj" → przejdź w tryb inline-confirm ──────────────────────────
  if (btn.classList.contains('my-res-cancel-btn')) {
    // Cofnij poprzedni inline-confirm jeśli jest inny
    if (cancelConfirmId && cancelConfirmId !== resId) {
      resetCancelState(cancelConfirmId);
    }
    cancelConfirmId = resId;
    const card = document.querySelector(`[data-res-id="${resId}"]`);
    if (!card) return;
    const right = card.querySelector('.my-res-card__right');
    // Schowaj oryginalny badge + przycisk Anuluj, pokaż inline confirm
    right.querySelectorAll('.tc-badge, .my-res-cancel-btn').forEach(el => el.style.display = 'none');
    right.insertAdjacentHTML('beforeend', `
      <div class="my-res-inline-confirm" data-confirm-id="${resId}">
        <span class="my-res-inline-confirm__label">Na pewno anulować?</span>
        <button class="my-res-confirm-btn tc-btn tc-btn-danger tc-btn-sm" data-res-id="${resId}">Tak, anuluj</button>
        <button class="my-res-undo-btn tc-btn tc-btn-ghost tc-btn-sm" data-res-id="${resId}">Cofnij</button>
      </div>
    `);
    return;
  }

  // ── "Cofnij" → wróć do normalnego stanu ──────────────────────────────
  if (btn.classList.contains('my-res-undo-btn')) {
    resetCancelState(resId);
    cancelConfirmId = null;
    return;
  }

  // ── "Tak, anuluj" → DELETE ────────────────────────────────────────────
  if (btn.classList.contains('my-res-confirm-btn')) {
    btn.disabled = true;
    btn.textContent = 'Anulowanie…';

    try {
      const res = await fetch(`/api/courts/reservations/${resId}/`, {
        method: 'DELETE',
        credentials: 'include',
        headers: { 'X-CSRFToken': getCsrf() },
      });

      if (res.ok || res.status === 204) {
        cancelConfirmId = null;
        showToast('Rezerwacja została anulowana.', 'success');
        await Promise.all([reloadMyReservations(), loadTimeline()]);
      } else {
        const data = await res.json().catch(() => ({}));
        showToast(data.detail || `Nie udało się anulować (błąd ${res.status}).`, 'error');
        resetCancelState(resId);
        cancelConfirmId = null;
      }
    } catch {
      showToast('Brak połączenia z serwerem. Spróbuj ponownie.', 'error');
      resetCancelState(resId);
      cancelConfirmId = null;
    }
  }
});

function resetCancelState(resId) {
  const card = document.querySelector(`[data-res-id="${resId}"]`);
  if (!card) return;
  const right = card.querySelector('.my-res-card__right');
  right.querySelector('.my-res-inline-confirm')?.remove();
  right.querySelectorAll('.tc-badge, .my-res-cancel-btn').forEach(el => el.style.display = '');
}

// ── Owner: zatwierdzanie / odrzucanie rezerwacji ───────────────────────────

const ownerList = document.getElementById('owner-pending-list');

if (ownerList) {
  ownerList.addEventListener('click', async e => {
    const btn = e.target.closest('.owner-approve-btn, .owner-reject-btn');
    if (!btn) return;

    const resId  = parseInt(btn.dataset.resId, 10);
    const action = btn.classList.contains('owner-approve-btn') ? 'approve' : 'reject';
    const row    = ownerList.querySelector(`[data-res-id="${resId}"]`);

    // Zablokuj oba przyciski w wierszu
    row?.querySelectorAll('button').forEach(b => { b.disabled = true; });
    btn.textContent = action === 'approve' ? 'Zatwierdzam…' : 'Odrzucam…';

    try {
      const res = await fetch(`/api/courts/reservations/${resId}/status/`, {
        method: 'PATCH',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRFToken': getCsrf(),
        },
        body: JSON.stringify({ action }),
      });

      if (res.ok) {
        const label = action === 'approve' ? 'Rezerwacja zatwierdzona.' : 'Rezerwacja odrzucona.';
        showToast(label, action === 'approve' ? 'success' : 'warning');
        // Usuń wiersz z listy
        row?.remove();
        // Aktualizuj licznik badge
        updateOwnerCount();
        // Odśwież timeline żeby zwolniony slot był widoczny (przy odrzuceniu)
        await loadTimeline();
      } else {
        const data = await res.json().catch(() => ({}));
        showToast(data.detail || `Błąd ${res.status}.`, 'error');
        row?.querySelectorAll('button').forEach(b => { b.disabled = false; });
        btn.textContent = action === 'approve' ? 'Zatwierdź' : 'Odrzuć';
      }
    } catch {
      showToast('Brak połączenia z serwerem.', 'error');
      row?.querySelectorAll('button').forEach(b => { b.disabled = false; });
      btn.textContent = action === 'approve' ? 'Zatwierdź' : 'Odrzuć';
    }
  });
}

function updateOwnerCount() {
  const rows  = ownerList?.querySelectorAll('.owner-res-row') ?? [];
  const count = rows.length;
  const badge = document.getElementById('owner-pending-count');
  if (!badge) return;

  if (count === 0) {
    badge.textContent = 'Brak oczekujących';
    // Pokaż empty state
    const list = ownerList?.querySelector('.owner-res-list');
    if (list) {
      list.innerHTML = `
        <div class="owner-empty">
          <span aria-hidden="true">✓</span>
          Wszystkie rezerwacje są obsłużone.
        </div>`;
    }
  } else {
    badge.textContent = `${count} oczekuje`;
  }
}

// ── Grid render ────────────────────────────────────────────────────────────

function renderGrid(data) {
  const courts = data.courts;
  if (!courts || courts.length === 0) { showState('empty'); return; }

  calGrid.style.setProperty('--courts', courts.length);

  const html = `
    <div class="calendar-header">
      <div class="calendar-time-col"></div>
      ${courts.map(c => `<div class="calendar-court-header">${c.name}</div>`).join('')}
    </div>
    <div class="calendar-body">
      <div class="calendar-time-col">
        ${Array.from({length: GRID_END - GRID_START}, (_, i) => {
          const h = GRID_START + i;
          return `<div class="calendar-hour-label" style="height:${SLOT_PX * 2}px;">${String(h).padStart(2,'0')}:00</div>`;
        }).join('')}
      </div>
      ${courts.map(court => {
        const slots = court.slots;

        // Buduj bloki ciągłych rezerwacji
        const blocks = [];
        let cur = null;
        for (let i = 0; i < slots.length; i++) {
          const s    = slots[i];
          const type = s.is_mine ? 'own' : (s.status !== 'FREE' ? 'other' : 'free');
          if (cur && cur.type === type && cur.type !== 'free') {
            cur.count++;
          } else {
            if (cur && cur.type !== 'free') blocks.push(cur);
            cur = { type, startIdx: i, count: 1, time: s.time };
          }
        }
        if (cur && cur.type !== 'free') blocks.push(cur);

        // Linie tła + klikalne wolne sloty
        const lines = Array.from({length: SLOT_COUNT}, (_, i) => {
          const isHour = i % 2 === 0;
          const slot   = slots[i];
          const isFree = slot && slot.status === 'FREE';
          if (isFree) {
            const endTime = slotEnd(slot.time);
            return `<div class="calendar-slot-line cal-slot-free ${isHour ? 'calendar-slot-line--hour' : 'calendar-slot-line--half'}"
              style="height:${SLOT_PX}px;"
              data-court-id="${court.id}"
              data-court-name="${court.name}"
              data-start="${slot.time}"
              data-end="${endTime}"
              role="button" tabindex="0"
              aria-label="Zarezerwuj ${court.name} ${slot.time}–${endTime}">
            </div>`;
          }
          return `<div class="calendar-slot-line ${isHour ? 'calendar-slot-line--hour' : 'calendar-slot-line--half'}" style="height:${SLOT_PX}px;" aria-hidden="true"></div>`;
        }).join('');

        // Bloki zajętych rezerwacji
        const resHtml = blocks.map(b => {
          const top    = b.startIdx * SLOT_PX;
          const height = b.count * SLOT_PX - 2;
          const endH   = GRID_START + Math.floor((b.startIdx + b.count) / 2);
          const endM   = ((b.startIdx + b.count) % 2) * 30;
          const endStr = `${String(endH).padStart(2,'0')}:${String(endM).padStart(2,'0')}`;
          const label  = b.type === 'own' ? 'Twoja rezerwacja' : 'Zarezerwowane';
          return `<div class="cal-res cal-res--${b.type}" style="top:${top}px; height:${height}px;">
            <div class="cal-res__time">${b.time}–${endStr}</div>
            <div class="cal-res__label">${label}</div>
          </div>`;
        }).join('');

        return `<div class="calendar-court-col" style="height:${GRID_H_PX}px;">${lines}${resHtml}</div>`;
      }).join('')}
    </div>
  `;

  calGrid.innerHTML = html;
  showState('grid');
  // Odśwież hint scrolla po wyrenderowaniu gridu
  requestAnimationFrame(() => window.__calScrollHintUpdate?.());

  // ── Drag-to-select na wolnych slotach ─────────────────────────────────────
  // Stan drag
  let dragCourtId   = null;
  let dragCourtName = null;
  let dragStartEl   = null;
  let dragEndEl     = null;
  let isDragging    = false;

  // Wszystkie wolne sloty w danej kolumnie kortu (po court-id)
  function freeSlotsByCourt(courtId) {
    return [...calGrid.querySelectorAll(`.cal-slot-free[data-court-id="${courtId}"]`)];
  }

  // Podświetl zakres slotów od startEl do endEl w obrębie jednego kortu
  function highlightRange(courtId, startEl, endEl) {
    const all     = freeSlotsByCourt(courtId);
    const startI  = all.indexOf(startEl);
    const endI    = all.indexOf(endEl);
    if (startI === -1 || endI === -1) return;
    const lo = Math.min(startI, endI);
    const hi = Math.max(startI, endI);

    // Sprawdź czy wszystkie sloty w zakresie są FREE (brak przeszkód między nimi)
    // — sloty zajęte nie mają klasy cal-slot-free więc przeskok oznacza blok zajęty
    const colEl  = startEl.closest('.calendar-court-col');
    const allInCol = [...colEl.querySelectorAll('.calendar-slot-line')];
    const startGlobal = allInCol.indexOf(startEl);
    const endGlobal   = allInCol.indexOf(endEl);
    const loG = Math.min(startGlobal, endGlobal);
    const hiG = Math.max(startGlobal, endGlobal);
    let   hasBlocked = false;
    for (let i = loG; i <= hiG; i++) {
      if (!allInCol[i].classList.contains('cal-slot-free')) { hasBlocked = true; break; }
    }

    // Czyść poprzednie podświetlenie
    all.forEach(el => el.classList.remove('cal-slot-drag'));

    if (!hasBlocked) {
      for (let i = lo; i <= hi; i++) all[i].classList.add('cal-slot-drag');
      return !hasBlocked;
    }
    return false;
  }

  function clearHighlight() {
    calGrid.querySelectorAll('.cal-slot-drag').forEach(el => el.classList.remove('cal-slot-drag'));
  }

  // Otwórz popup z zakresem od startEl do endEl
  function openFromDrag(courtId, courtName, startEl, endEl) {
    const colEl      = startEl.closest('.calendar-court-col');
    const allInCol   = [...colEl.querySelectorAll('.calendar-slot-line')];
    const startGlobal = allInCol.indexOf(startEl);
    const endGlobal   = allInCol.indexOf(endEl);
    const loEl = startGlobal <= endGlobal ? startEl : endEl;
    const hiEl = startGlobal <= endGlobal ? endEl   : startEl;

    const startTime = loEl.dataset.start;
    // endTime = hiEl.dataset.end (tj. +30 min od hiEl.dataset.start)
    const endTime   = hiEl.dataset.end;

    openPopup({ courtId: parseInt(courtId, 10), courtName, date: currentDate, startTime, endTime });
  }

  // Event delegation na calGrid
  calGrid.addEventListener('mousedown', e => {
    const el = e.target.closest('.cal-slot-free');
    if (!el) return;
    e.preventDefault(); // zapobiegaj zaznaczaniu tekstu
    isDragging    = true;
    dragCourtId   = el.dataset.courtId;
    dragCourtName = el.dataset.courtName;
    dragStartEl   = el;
    dragEndEl     = el;
    el.classList.add('cal-slot-drag');
  });

  calGrid.addEventListener('mouseover', e => {
    if (!isDragging) return;
    const el = e.target.closest('.cal-slot-free');
    if (!el || el.dataset.courtId !== dragCourtId) return;
    dragEndEl = el;
    highlightRange(dragCourtId, dragStartEl, dragEndEl);
  });

  document.addEventListener('mouseup', e => {
    if (!isDragging) return;
    isDragging = false;

    const el = e.target.closest?.('.cal-slot-free');
    // Jeśli mouseup na tym samym slocie co start — prosty klik (30 min)
    if (dragStartEl === dragEndEl) {
      clearHighlight();
      openPopup({
        courtId:   parseInt(dragCourtId, 10),
        courtName: dragCourtName,
        date:      currentDate,
        startTime: dragStartEl.dataset.start,
        endTime:   dragStartEl.dataset.end,
      });
    } else {
      // Drag — sprawdź czy zakres jest spójny (brak zajętych slotów)
      const ok = highlightRange(dragCourtId, dragStartEl, dragEndEl);
      clearHighlight();
      if (ok !== false) {
        openFromDrag(dragCourtId, dragCourtName, dragStartEl, dragEndEl);
      }
      // jeśli ok === false (był zajęty slot w środku) — nie otwieraj popupu
    }

    dragStartEl = dragEndEl = dragCourtId = dragCourtName = null;
  });

  // Keyboard: Enter/Space na slocie = pojedynczy 30-min slot
  calGrid.querySelectorAll('.cal-slot-free').forEach(el => {
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openPopup({
          courtId:   parseInt(el.dataset.courtId, 10),
          courtName: el.dataset.courtName,
          date:      currentDate,
          startTime: el.dataset.start,
          endTime:   el.dataset.end,
        });
      }
    });
  });
}

// ── Timeline load ──────────────────────────────────────────────────────────

async function loadTimeline() {
  if (!facilityId) { showState('empty'); return; }
  showState('loading');
  dateLabel.textContent = fmtDateLabel(currentDate);

  try {
    const res = await fetch(`/api/courts/timeline/${facilityId}/?date=${currentDate}`, {
      credentials: 'include',
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    renderGrid(data);
  } catch (e) {
    errorMsg.textContent = `Nie udało się załadować grafiku. (${e.message})`;
    showState('error');
  }
}

// ── Init ───────────────────────────────────────────────────────────────────

async function init() {
  showState('loading');
  if (dateInput) dateInput.value = currentDate;
  if (todayBtn) todayBtn.style.display = 'none'; // startujemy od dziś — zbędny
  dateLabel.textContent = fmtDateLabel(currentDate);

  try {
    const res = await fetch('/api/courts/facilities/', { credentials: 'include' });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const facilities = await res.json();
    if (!facilities || facilities.length === 0) { showState('empty'); return; }
    facilityId = facilities[0].id;
    await loadTimeline();
  } catch (e) {
    errorMsg.textContent = `Nie udało się załadować listy obiektów. (${e.message})`;
    showState('error');
  }
}

// ── Centralna zmiana daty — synchronizuje picker + etykietę + fetch ───────────

const todayBtn  = document.getElementById('cal-today');
const dateBtnEl = document.getElementById('cal-date-btn');

// Blokada przeszłych dat — min=dziś na inpucie
if (dateInput) dateInput.min = todayIso;

async function setDate(iso) {
  // Odrzuć daty z przeszłości (zabezpieczenie np. przy prev < dziś)
  if (iso < todayIso) iso = todayIso;
  currentDate = iso;
  if (dateInput) dateInput.value = iso;
  if (todayBtn) todayBtn.style.display = (iso === todayIso) ? 'none' : '';
  await loadTimeline();
}

// Prev: nie cofaj poniżej dzisiaj
document.getElementById('cal-prev')?.addEventListener('click', () => {
  const prev = addDays(currentDate, -1);
  if (prev >= todayIso) setDate(prev);
});
document.getElementById('cal-next')?.addEventListener('click', () => setDate(addDays(currentDate, 1)));
todayBtn?.addEventListener('click', () => setDate(todayIso));

// Klik w przycisk daty → showPicker() na ukrytym inpucie
dateBtnEl?.addEventListener('click', () => {
  if (!dateInput) return;
  try {
    dateInput.showPicker();
  } catch {
    // Fallback dla starszych przeglądarek — klik bezpośredni
    dateInput.click();
  }
});

dateInput?.addEventListener('change', () => {
  if (dateInput.value) setDate(dateInput.value);
});

init();

// ── Scroll shadow — wizualny hint że grid można przewijać ─────────────────
(function () {
  const outer = calWrap?.closest('.calendar-wrap-outer');
  if (!outer || !calWrap) return;

  function updateScrollHint() {
    const canScroll = calWrap.scrollWidth > calWrap.clientWidth;
    const atEnd     = calWrap.scrollLeft + calWrap.clientWidth >= calWrap.scrollWidth - 4;
    outer.classList.toggle('is-scrollable', canScroll && !atEnd);
  }

  calWrap.addEventListener('scroll', updateScrollHint, { passive: true });
  window.__calScrollHintUpdate = updateScrollHint;
})();
</script>
