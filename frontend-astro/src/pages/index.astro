---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { url } from '@/lib/url';

const title = "Znajdź Partnera do Gry";
const SITE = import.meta.env.PUBLIC_SITE_URL ?? 'https://portal.raketon.pl';

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Tennis Club",
    "url": SITE,
    "logo": `${SITE}/favicon.ico`,
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "itprima@medi3.pl",
      "contactType": "customer support",
      "availableLanguage": "Polish"
    },
    "sameAs": []
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Tennis Club",
    "url": SITE,
    "description": "Portal tenisowy — rezerwacje kortów, turnieje, ligi i rankingi dla klubów i graczy."
  }
]);
---

<PublicLayout title={title} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <header class="relative flex flex-1 items-center justify-center text-center py-10 px-8 max-[1024px]:py-[60px] max-[1024px]:px-4 max-[480px]:py-1 max-[480px]:px-0 bg-surface bg-[url('/static/img/01.png')] bg-no-repeat bg-center bg-cover text-white overflow-hidden [text-shadow:2px_2px_4px_rgba(0,0,0,0.6)]">
    <div class="absolute inset-0 bg-black/25 z-[1]"></div>
    <div class="relative z-[2] max-w-[1200px] mx-auto px-4 max-[480px]:py-1 max-[480px]:px-0 w-full">
      <h1 class="font-serif text-[clamp(1.8rem,5vw,3rem)] max-[480px]:text-[1.0rem] font-black leading-[1.2] mb-4 max-[480px]:mb-2 text-white tracking-[-0.01em] max-[480px]:px-0">Znajdź Partnera do Gry w Tenisa Już Dziś</h1>
      <p class="text-[clamp(1rem,2vw,1.15rem)] max-[480px]:text-[0.8rem] mb-8 max-[480px]:mb-4 max-[480px]:px-5 text-white/95 max-w-[1100px] mx-auto leading-[1.5] max-[480px]:leading-[1.35] font-medium">Dołącz do naszej społeczności pasjonatów tenisa. Umawiaj się na mecze,<br class="hidden md:block">rezerwuj korty i podnoś swoje umiejętności.</p>

    </div>
  </header>

  <!-- Sekcja "Dlaczego warto?" -->
  <section class="py-10 px-8 max-[480px]:py-0 max-[480px]:px-2 bg-bg">
    <div class="max-w-content mx-auto pb-5 pt-5">
      <div class="text-center mb-0">
        <h2 class="text-[clamp(1.75rem,4vw,2.25rem)] max-[480px]:text-[1.0rem] font-extrabold text-[#0f172a] tracking-[-0.02em] max-[480px]:px-5">Stworzone dla Graczy takich jak Ty</h2>
        <p class="text-[1.1rem] max-[480px]:text-[0.8rem] text-[#64748b] max-w-[65ch] mx-auto max-[480px]:px-8">Niezależnie od Twojego poziomu, nasza platforma ułatwi Ci grę.</p>
      </div>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-1 gap-12 max-[480px]:gap-4 mt-10 max-[480px]:mt-3 max-w-[1100px] max-[1024px]:max-w-[500px] mx-auto">
        <!-- Kafelek 1 -->
        <div class="!bg-transparent p-5 max-[480px]:py-1 text-center !border-none !shadow-none flex flex-col items-center">
          <div class="text-[2.8rem] max-[480px]:text-[1.8rem] mb-6 max-[480px]:mb-1 leading-none">👥</div>
          <h3 class="text-xl max-[480px]:text-[1.0rem] font-extrabold mb-3 max-[480px]:mb-1.5 text-[#0f172a]">Znajdź Graczy</h3>
          <p class="text-[#64748b] leading-[1.6] max-[480px]:leading-[1.45] text-[0.95rem] max-[480px]:text-[0.8rem] m-0">Przeglądaj profile graczy w Twojej okolicy i filtruj ich według poziomu zaawansowania.</p>
        </div>
        
        <!-- Kafelek 2 -->
        <div class="!bg-transparent p-5 max-[480px]:py-1 text-center !border-none !shadow-none flex flex-col items-center">
          <div class="text-[2.8rem] max-[480px]:text-[1.8rem] mb-6 max-[480px]:mb-1 leading-none">📊</div>
          <h3 class="text-xl max-[480px]:text-[1.0rem] font-extrabold mb-3 max-[480px]:mb-1.5 text-[#0f172a]">Twórz Historię Spotkań</h3>
          <p class="text-[#64748b] leading-[1.6] max-[480px]:leading-[1.45] text-[0.95rem] max-[480px]:text-[0.8rem] m-0">Zapisuj wyniki meczów, analizuj statystyki i śledź swoje postępy w czasie.</p>
        </div>
        
        <!-- Kafelek 3 -->
        <div class="!bg-transparent p-5 max-[480px]:py-1 text-center !border-none !shadow-none flex flex-col items-center">
          <div class="text-[2.8rem] max-[480px]:text-[1.8rem] mb-6 max-[480px]:mb-1 leading-none">🏆</div>
          <h3 class="text-xl max-[480px]:text-[1.0rem] font-extrabold mb-3 max-[480px]:mb-1.5 text-[#0f172a]">Rywalizuj i Rozwijaj się</h3>
          <p class="text-[#64748b] leading-[1.6] max-[480px]:leading-[1.45] text-[0.95rem] max-[480px]:text-[0.8rem] m-0">Bierz udział w lokalnych ligach i turniejach. Obserwuj postępy w rankingu.</p>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
