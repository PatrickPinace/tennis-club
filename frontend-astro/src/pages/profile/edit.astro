---
// profile/edit.astro — edycja danych profilu
// SSR wymagane — chronione przez middleware.ts (/profile/edit → PRIVATE_PATHS)
// Flow: wczytaj aktualne dane → PATCH /api/auth/profile/update/ → redirect /profile?saved=1
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import ProfileEditForm from '@/components/ProfileEditForm.tsx';
import { getUserProfile } from '@/lib/api';
import { url } from '@/lib/url';

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const profileData   = await getUserProfile(sessionCookie);
const user          = profileData?.user ?? null;

const initialData = {
  firstName: user?.first_name ?? '',
  lastName: user?.last_name ?? '',
  email: user?.email ?? '',
  city: user?.city ?? '',
  birthDate: user?.birth_date ?? '',
  username: user?.username ?? '—',
};
---

<AppLayout
  title="Edycja profilu"
  greeting="Edycja profilu"
  showCta={false}
  currentUser={user}
>
  <ProfileEditForm
    client:load
    initialData={initialData}
    profileUrl={url('/profile')}
  />
</AppLayout>

<style is:global>
.edit-wrap {
  max-width: 580px;
  margin: 0 auto;
  width: 100%;
}

.edit-header {
  margin-bottom: 20px;
}

.edit-back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.875rem;
  color: var(--tc-sub);
  text-decoration: none;
  font-weight: 500;
}
.edit-back:hover { color: var(--tc-ink); }

.edit-card {
  padding: 32px;
}

.edit-title {
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--tc-ink);
  margin: 0 0 4px;
  letter-spacing: -0.02em;
}

.edit-subtitle {
  font-size: 0.875rem;
  color: var(--tc-sub);
  margin: 0 0 28px;
}

/* ── Alerts ── */
.edit-alert {
  font-size: 0.875rem;
  font-weight: 500;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  margin-bottom: 20px;
}
.edit-alert--ok {
  background: rgba(34, 197, 94, 0.08);
  border: 1px solid rgba(34, 197, 94, 0.22);
  color: var(--tc-win);
}
.edit-alert--err {
  background: rgba(239, 68, 68, 0.08);
  border: 1px solid rgba(239, 68, 68, 0.22);
  color: var(--tc-hot);
}

/* ── Form ── */
.edit-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media (max-width: 480px) {
  .edit-card { padding: 20px 16px; }
  .edit-row { grid-template-columns: 1fr; gap: 0; }
}

.edit-field {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin-bottom: 18px;
}

.edit-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--tc-sub);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.label-optional {
  font-weight: 400;
  text-transform: none;
  color: var(--tc-muted);
  font-size: 0.72rem;
  letter-spacing: 0;
}

/* .edit-input → zastąpione przez globalne .tc-input */

/* ── Field errors ── */
.field-error {
  display: none;
  font-size: 0.76rem;
  color: var(--tc-hot);
  font-weight: 500;
}

/* ── Read-only field (login) ── */
.edit-field--readonly {
  margin-bottom: 24px;
}
.edit-readonly {
  font-size: 0.9375rem;
  color: var(--tc-sub);
  padding: 0 2px;
  font-style: italic;
}

/* ── Actions ── */
.edit-actions {
  display: flex;
  gap: 12px;
  margin-top: 8px;
}
</style>
