---
// dashboard.astro — realistyczny UI dashboardu wg projektu grafika
// Turnieje i powiadomienia: prawdziwe dane z Django API (server-side fetch)
// SSR wymagane (prerender = false) — dashboard/summary potrzebuje cookie sesji
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import {
  getDashboardTournaments,
  getUnreadCount,
  getCurrentUser,
  getMatchHistory,
  getUserProfile,
  TOURNAMENT_STATUS_LABEL,
  TOURNAMENT_TYPE_LABEL,
  type TournamentListEntry,
  type MatchHistoryEntry,
} from '../lib/api';
import { url } from '@/lib/url';
import ActivityFeed from '@/components/ActivityFeed.tsx';
import BentoHero from '@/components/BentoHero.tsx';
import TournamentsList from '@/components/TournamentsList.tsx';
import StatsStrip from '@/components/StatsStrip.tsx';

// ── Dane z Django API (server-side) ──────────────────────────────────────────

// Bieżący użytkownik — SSR z cookie sesji
const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const [currentUser, apiTournaments, matchHistoryRaw, profileData] = await Promise.all([
  getCurrentUser(sessionCookie),
  getDashboardTournaments(5),
  getMatchHistory(sessionCookie),
  getUserProfile(sessionCookie),
]);

const tStats = profileData?.tournament_stats ?? null;

/// Powiadomienia: tryb static — nie możemy pobrać cookie sesji w build-time
// Liczba powiadomień ładowana jest client-side przez JS (patrz script na końcu)
// Gdy backend niedostępny lub niezalogowany — graceful degradation (brak odznaki)
const unreadCount = null; // null = nie renderuj odznaki SSR

// Greeting: imię z profilu lub fallback
const firstName = currentUser?.first_name?.trim() || currentUser?.username || null;

// Mapuj turnieje z API na format UI dashboardu
function formatDate(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' });
}

const liveTournaments = apiTournaments.map((t: TournamentListEntry) => ({
  id: t.id,
  name: t.name,
  type: TOURNAMENT_TYPE_LABEL[t.tournament_type] ?? t.tournament_type,
  date: t.start_date ? formatDate(t.start_date) : '—',
  status: t.status === 'REG' ? 'open' : t.status === 'SCH' ? 'scheduled' : 'active',
  statusLabel: TOURNAMENT_STATUS_LABEL[t.status] ?? t.status,
  participants: t.participant_count,
}));

const tournaments = liveTournaments;
const isLiveData = liveTournaments.length > 0;

// ── Ostatnia aktywność — z historii meczów (ostatnie 3) ──────────────────────

function activityDate(iso: string): string {
  try {
    // "YYYY-MM-DD" → compare by calendar date, not milliseconds
    if (/^\d{4}-\d{2}-\d{2}$/.test(iso)) {
      const todayStr = new Date().toISOString().slice(0, 10);
      if (iso === todayStr) return 'dziś';
      const yesterday = new Date();
      yesterday.setDate(yesterday.getDate() - 1);
      if (iso === yesterday.toISOString().slice(0, 10)) return 'wczoraj';
      const d = new Date(iso + 'T12:00:00');
      const diffDays = Math.floor((Date.now() - d.getTime()) / 86_400_000);
      if (diffDays < 7) return `${diffDays} dni temu`;
      return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
    }
    const d = new Date(iso);
    const now = new Date();
    const diffDays = Math.floor((now.getTime() - d.getTime()) / 86_400_000);
    if (diffDays === 0) return d.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
    if (diffDays === 1) return 'wczoraj';
    if (diffDays < 7)  return `${diffDays} dni temu`;
    return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
  } catch { return iso; }
}

function matchScore(m: MatchHistoryEntry): string {
  const parts: string[] = [];
  if (m.p1_set1 !== null && m.p2_set1 !== null) parts.push(`${m.p1_set1}:${m.p2_set1}`);
  if (m.p1_set2 !== null && m.p2_set2 !== null) parts.push(`${m.p1_set2}:${m.p2_set2}`);
  if (m.p1_set3 !== null && m.p2_set3 !== null) parts.push(`${m.p1_set3}:${m.p2_set3}`);
  return parts.join(', ') || '—';
}

function matchOpponent(m: MatchHistoryEntry): string {
  const isP1Side =
    (m.user === 'user-win'  && m.win === 'p1') ||
    (m.user === 'user-loss' && m.win === 'p2');
  const opp = isP1Side ? m.p2 : m.p1;
  if (!opp) return 'Nieznany';
  return [opp.first_name, opp.last_name].filter(Boolean).join(' ') || opp.username;
}

const recentActivity = matchHistoryRaw.slice(0, 3).map(m => {
  const isWin  = m.user === 'user-win';
  const isDraw = m.user === 'user-draw';
  const result = isWin ? 'win' : isDraw ? 'neutral' : 'loss';
  const label  = isWin ? 'Wygrana' : isDraw ? 'Remis' : 'Porażka';
  const fmt    = m.match_double ? 'Debel' : 'Singiel';
  const score  = matchScore(m);
  return {
    type:      'match',
    title:     `${label} vs ${matchOpponent(m)}`,
    desc:      fmt,
    score,
    time:      activityDate(m.match_date),
    timestamp: m.match_date,
    result,
  };
});

// ── Moje mecze — statystyki z historii meczów (spójne z "Ostatnią aktywnością") ─
const matchesPlayed = matchHistoryRaw.length;
const matchesWon    = matchHistoryRaw.filter(m => m.user === 'user-win').length;
const matchesLost   = matchHistoryRaw.filter(m => m.user === 'user-loss').length;
const winRate       = matchesPlayed > 0 ? Math.round(matchesWon / matchesPlayed * 100) : 0;

// Greeting: "Witaj" dla nowego usera (brak meczów i turniejów), "Witaj z powrotem" dla aktywnych
const greeting = firstName
  ? (matchesPlayed === 0 && tStats === null ? `Witaj, ${firstName}!` : `Witaj z powrotem, ${firstName}!`)
  : undefined;

// Data pod greeting — "pon · 25 maja 2026 · 14:32"
const now = new Date();
const dayName = now.toLocaleDateString('pl-PL', { weekday: 'short' });
const datePart = now.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
const timePart = now.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
const greetingSub = `${dayName} · ${datePart} · ${timePart}`;
---

<AppLayout
  title="Dashboard"
  greeting={greeting}
  greetingSub={greetingSub}
  showSearch={true}
  showCta={true}
  unreadCount={unreadCount}
>

  <!-- ── Bento hero grid (React island) ── -->
  <BentoHero
    client:load
    matchHistory={matchHistoryRaw.slice(0, 8).map(m => ({ user: m.user, match_double: m.match_double }))}
    matchesPlayed={matchesPlayed}
    courtsUrl={url('/courts/reservations')}
  />

  <!-- ── Main grid: turnieje | aktywność ── -->
  <div class="main-grid">

    <!-- LEFT: turnieje (React island) -->
    <div class="main-col-left">
      <TournamentsList
        client:load
        tournaments={tournaments.map(t => ({ ...t, href: url(`/tournaments/${t.id}`) }))}
        tournamentsUrl={url('/tournaments')}
      />
    </div>

    <!-- RIGHT: aktywność (React island) -->
    <div class="main-col-right">
      <ActivityFeed
        client:load
        items={recentActivity}
        matchesUrl={url('/matches')}
        tournamentsUrl={url('/tournaments')}
      />
    </div>
  </div>

  <!-- ── Stats strip na dole (React island) ── -->
  <StatsStrip
    client:load
    matchesPlayed={matchesPlayed}
    matchesWon={matchesWon}
    matchesLost={matchesLost}
    winRate={winRate}
    tournamentsActive={tStats?.tournaments_active ?? 0}
    matchHistory={matchHistoryRaw.slice(0, 8).map(m => ({ user: m.user }))}
  />

</AppLayout>

<!-- Powiadomienia obsługiwane przez Topbar.astro -->
<!-- Bento hero + Activity feed — obsługiwane przez React islands (BentoHero.tsx, ActivityFeed.tsx) -->

<style is:global>
  /* ── Bento hero (is:global — rendered by React island BentoHero.tsx) ─── */
  .bento-hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto;
    gap: 16px;
    margin-bottom: 24px;
  }

  .bento-last-match {
    grid-column: span 5;
    grid-row: span 2;
  }

  .bento-ranking {
    grid-column: span 3;
    grid-row: span 2;
  }

  .bento-reservation {
    grid-column: span 4;
    grid-row: span 1;
  }

  .bento-stats {
    grid-column: span 4;
    grid-row: span 1;
  }

  .bento-last-match {
    display: flex;
    flex-direction: column;
  }

  .lm-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .lm-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 99px;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    min-height: auto;
  }

  .lm-body {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 16px 0;
  }

  .lm-score {
    font-size: 6.5rem;
    font-weight: 800;
    color: var(--tc-ink);
    letter-spacing: -0.04em;
    line-height: 1;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .lm-score__colon { color: var(--tc-faint); }
  .lm-score__loss  { color: var(--tc-muted); }

  .lm-set__my--win { color: var(--tc-accent) !important; }
  .lm-set__dash { color: var(--tc-faint); margin: 0 4px; }
  .lm-set__opp { font-weight: 700; color: var(--tc-muted); }

  .lm-opponent {
    flex: 1;
    min-width: 0;
  }

  .lm-opponent__prefix {
    font-size: 0.68rem;
    color: var(--tc-muted);
    margin-bottom: 4px;
  }

  .lm-opponent__name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--tc-ink);
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .lm-opponent__meta {
    font-size: 0.73rem;
    color: var(--tc-muted);
    margin-top: 2px;
  }

  .lm-sets {
    display: flex;
    gap: 0;
    margin-top: auto;
    border-top: 1px solid var(--tc-card-border);
    padding-top: 12px;
  }

  .lm-set {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 14px;
    border-left: 1px solid var(--tc-card-border);
  }

  .lm-set:first-child {
    border-left: none;
    padding-left: 0;
  }

  .lm-set--empty { opacity: 0.45; }

  .lm-set__label {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tc-muted);
  }

  .lm-set__score {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--tc-ink);
    font-variant-numeric: tabular-nums;
  }

  .bento-ranking {
    display: flex;
    flex-direction: column;
  }

  .rk-main {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 8px;
    flex: 1;
  }

  .rk-position {
    font-size: 7rem;
    font-weight: 800;
    color: var(--tc-accent);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .rk-label {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--tc-sub);
    margin-bottom: 18px;
  }

  .rk-trend {
    font-size: 0.75rem;
    color: var(--tc-muted);
    margin-top: 6px;
    line-height: 1.4;
    min-height: 1em;
  }

  .rk-bottom {
    display: flex;
    gap: 14px;
    border-top: 1px solid var(--tc-card-border);
    padding-top: 12px;
    margin-top: auto;
  }

  .rk-stat__label {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tc-muted);
    margin-bottom: 4px;
  }

  .rk-stat__value {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--tc-ink);
    font-variant-numeric: tabular-nums;
  }

  .rk-stat__value--accent { color: var(--tc-accent); }

  .bento-reservation--dashed {
    border-style: dashed;
    border-color: var(--tc-card-border);
    background: transparent;
    padding: 16px 20px;
  }

  .reservation-inner {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .reservation-icon-box {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    display: grid;
    place-items: center;
    color: var(--tc-muted);
    flex-shrink: 0;
  }

  .reservation-text {
    flex: 1;
    min-width: 0;
  }

  .reservation-btn {
    display: inline-flex;
    align-items: center;
    padding: 7px 14px;
    border-radius: 8px;
    background: transparent;
    color: var(--tc-sub);
    border: 1px solid var(--tc-card-border);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .reservation-btn:hover {
    background: var(--tc-overlay);
    border-color: var(--tc-accent-border);
    color: var(--tc-ink);
  }

  .bento-stats {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
  }

  .bento-form-section {
    flex-shrink: 0;
  }

  .bento-form-blocks {
    display: flex;
    gap: 3px;
    margin-top: 8px;
  }

  .form-block {
    width: 16px;
    height: 22px;
    border-radius: 3px;
    font-size: 9px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .form-block--win {
    background: var(--tc-accent);
    color: var(--tc-accent-ink);
  }
  .form-block--loss {
    background: var(--tc-faint);
    color: var(--tc-muted);
    opacity: 0.65;
  }
  .form-block--neutral {
    background: var(--tc-overlay);
    color: var(--tc-muted);
  }

  .bento-total-section {
    flex: 1;
    border-left: 1px solid var(--tc-card-border);
    padding-left: 16px;
  }

  .bento-total-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-top: 6px;
  }

  .bento-total__value {
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--tc-ink);
    line-height: 1;
  }

  .bento-total__sub {
    font-size: 0.8rem;
    color: var(--tc-muted);
  }

  .stat-card__value {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--tc-ink);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .stat-card__detail {
    font-size: 0.8rem;
    color: var(--tc-sub);
    line-height: 1.4;
  }

  /* ── Bento hero responsive ─────────────────────────────────────────────── */
  @media (max-width: 1280px) {
    .bento-hero {
      grid-template-columns: repeat(8, 1fr);
    }
    .bento-last-match { grid-column: span 4; }
    .bento-ranking    { grid-column: span 4; }
    .bento-reservation { grid-column: span 4; }
    .bento-stats      { grid-column: span 4; }
  }

  @media (max-width: 1024px) {
    .bento-hero {
      display: flex;
      flex-wrap: wrap;
    }
    .bento-last-match,
    .bento-ranking,
    .bento-reservation,
    .bento-stats {
      flex: 1 1 calc(50% - 8px);
      min-width: 0;
    }
  }

  @media (max-width: 640px) {
    .bento-hero {
      gap: 10px;
      margin-bottom: 16px;
    }
    .bento-last-match,
    .bento-ranking,
    .bento-reservation,
    .bento-stats {
      flex: 1 1 100%;
    }
    .lm-score { font-size: 4rem; }
    .lm-body { gap: 16px; }
    .rk-position { font-size: 4rem; }
    .reservation-inner { flex-wrap: wrap; }
    .reservation-btn { width: 100%; justify-content: center; }
  }

  /* ── Main grid ─────────────────────────────────────────────────────────── */
  .main-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 20px;
    align-items: start;
  }

  .main-col-left,
  .main-col-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── Tournaments table ─────────────────────────────────────────────────── */
  .tourn-table-head {
    display: grid;
    grid-template-columns: 28px 1fr 120px 60px 80px;
    gap: 12px;
    padding: 8px 20px;
    border-bottom: 1px solid var(--tc-card-border-soft);
    margin: 12px -20px 0;
  }

  .tourn-table-head > span {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--tc-muted);
  }

  .th-num { text-align: center; }
  .th-players, .th-status { text-align: right; }
  .tourn-table-body { margin: 0 -20px; }

  .dash-row {
    display: grid;
    gap: 12px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--tc-card-border-soft);
    transition: background 0.1s;
    text-decoration: none;
    color: inherit;
  }
  .dash-row:hover { background: var(--tc-overlay); }
  .dash-row:last-child { border-bottom: none; }

  .tourn-row {
    grid-template-columns: 28px 1fr 120px 60px 80px;
    align-items: center;
  }

  .tourn-row__num {
    text-align: center;
    font-size: 0.78rem;
    color: var(--tc-muted);
    font-variant-numeric: tabular-nums;
  }

  .tourn-row__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--tc-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.12s;
  }
  .dash-row:hover .tourn-row__name { color: var(--tc-accent); }

  .tourn-row__type {
    font-size: 0.72rem;
    color: var(--tc-sub);
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border-soft);
    border-radius: 4px;
    padding: 2px 6px;
    white-space: nowrap;
  }

  .tourn-row__players {
    text-align: right;
    font-size: 0.82rem;
    color: var(--tc-sub);
    font-variant-numeric: tabular-nums;
  }

  .tourn-row__status {
    text-align: right;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
  }

  .tourn-status--open      { color: var(--tc-win); }
  .tourn-status--active    { color: var(--tc-accent); }
  .tourn-status--scheduled { color: var(--tc-sub); }

  .tourn-status__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 4px currentColor;
    flex-shrink: 0;
  }

  /* ── Stats strip ──────────────────────────────────────────────────────── */
  .stats-strip {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    padding: 18px 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr) 1.6fr;
    gap: 24px;
    align-items: center;
    margin-top: 20px;
    transition: background 0.25s, border-color 0.25s;
  }

  .stats-strip__value {
    font-size: 2.1rem;
    font-weight: 800;
    color: var(--tc-ink);
    line-height: 1;
    margin-top: 8px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }

  .stats-strip__frac {
    font-size: 1rem;
    font-weight: 500;
    color: var(--tc-muted);
  }

  .stats-strip__bars {
    display: flex;
    gap: 4px;
    align-items: flex-end;
    height: 32px;
    margin-top: 8px;
  }

  .stats-bar { width: 10px; border-radius: 2px; }
  .stats-bar--win { background: var(--tc-accent); height: 24px; }
  .stats-bar--loss { background: var(--tc-faint); opacity: 0.6; height: 14px; }

  .stats-strip__bars-summary {
    margin-left: 8px;
    font-size: 0.75rem;
    color: var(--tc-muted);
    align-self: flex-end;
    padding-bottom: 2px;
    white-space: nowrap;
  }

  /* ── Responsive: layout + tournaments + stats ──────────────────────────── */
  @media (max-width: 1024px) {
    .main-grid { grid-template-columns: 1fr; }
    .main-col-right { order: -1; }
    .tourn-table-head, .tourn-row { grid-template-columns: 28px 1fr 70px 50px; }
    .th-type, .tourn-row__type { display: none; }
    .stats-strip { grid-template-columns: repeat(2, 1fr); }
    .stats-strip__form { grid-column: span 2; }
  }

  @media (max-width: 640px) {
    .main-grid { gap: 12px; }
    .main-col-left, .main-col-right { gap: 12px; }
    .dash-section-header { padding: 12px 16px; margin: -20px -20px 0; }
    .dash-card { padding: 16px; }
    .tourn-table-head, .tourn-row { grid-template-columns: 1fr 60px; padding: 10px 16px; }
    .th-num, .tourn-row__num, .th-type, .tourn-row__type, .th-players, .tourn-row__players { display: none; }
    .stats-strip { grid-template-columns: 1fr 1fr; gap: 16px; padding: 16px; }
    .stats-strip__form { grid-column: span 2; }
    .stats-strip__bars-summary { display: none; }
  }

  /* Activity feed — is:global bo lista wstrzykiwana przez JS (innerHTML) */
  .activity-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .activity-item {
