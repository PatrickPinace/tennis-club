---
// dashboard.astro — realistyczny UI dashboardu wg projektu grafika
// Turnieje i powiadomienia: prawdziwe dane z Django API (server-side fetch)
// SSR wymagane (prerender = false) — dashboard/summary potrzebuje cookie sesji
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import {
  getDashboardTournaments,
  getUnreadCount,
  getCurrentUser,
  getMatchHistory,
  getUserProfile,
  TOURNAMENT_STATUS_LABEL,
  TOURNAMENT_TYPE_LABEL,
  type TournamentListEntry,
  type MatchHistoryEntry,
} from '../lib/api';
import { url } from '@/lib/url';

// ── Dane z Django API (server-side) ──────────────────────────────────────────

// Bieżący użytkownik — SSR z cookie sesji
const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const [currentUser, apiTournaments, matchHistoryRaw, profileData] = await Promise.all([
  getCurrentUser(sessionCookie),
  getDashboardTournaments(5),
  getMatchHistory(sessionCookie),
  getUserProfile(sessionCookie),
]);

const tStats = profileData?.tournament_stats ?? null;

/// Powiadomienia: tryb static — nie możemy pobrać cookie sesji w build-time
// Liczba powiadomień ładowana jest client-side przez JS (patrz script na końcu)
// Gdy backend niedostępny lub niezalogowany — graceful degradation (brak odznaki)
const unreadCount = null; // null = nie renderuj odznaki SSR

// Greeting: imię z profilu lub fallback
const firstName = currentUser?.first_name?.trim() || currentUser?.username || null;

// Mapuj turnieje z API na format UI dashboardu
function formatDate(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' });
}

const liveTournaments = apiTournaments.map((t: TournamentListEntry) => ({
  id: t.id,
  name: t.name,
  type: TOURNAMENT_TYPE_LABEL[t.tournament_type] ?? t.tournament_type,
  date: t.start_date ? formatDate(t.start_date) : '—',
  status: t.status === 'REG' ? 'open' : t.status === 'SCH' ? 'scheduled' : 'active',
  statusLabel: TOURNAMENT_STATUS_LABEL[t.status] ?? t.status,
  participants: t.participant_count,
}));

const tournaments = liveTournaments;
const isLiveData = liveTournaments.length > 0;

// ── Ostatnia aktywność — z historii meczów (ostatnie 3) ──────────────────────

function activityDate(iso: string): string {
  try {
    const d = new Date(iso);
    const now = new Date();
    const diffDays = Math.floor((now.getTime() - d.getTime()) / 86_400_000);
    if (diffDays === 0) return d.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
    if (diffDays === 1) return 'wczoraj';
    if (diffDays < 7)  return `${diffDays} dni temu`;
    return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
  } catch { return iso; }
}

function matchScore(m: MatchHistoryEntry): string {
  const parts: string[] = [];
  if (m.p1_set1 !== null && m.p2_set1 !== null) parts.push(`${m.p1_set1}:${m.p2_set1}`);
  if (m.p1_set2 !== null && m.p2_set2 !== null) parts.push(`${m.p1_set2}:${m.p2_set2}`);
  if (m.p1_set3 !== null && m.p2_set3 !== null) parts.push(`${m.p1_set3}:${m.p2_set3}`);
  return parts.join(', ') || '—';
}

function matchOpponent(m: MatchHistoryEntry): string {
  const isP1Side =
    (m.user === 'user-win'  && m.win === 'p1') ||
    (m.user === 'user-loss' && m.win === 'p2');
  const opp = isP1Side ? m.p2 : m.p1;
  if (!opp) return 'Nieznany';
  return [opp.first_name, opp.last_name].filter(Boolean).join(' ') || opp.username;
}

const recentActivity = matchHistoryRaw.slice(0, 3).map(m => {
  const isWin  = m.user === 'user-win';
  const isDraw = m.user === 'user-draw';
  const result = isWin ? 'win' : isDraw ? 'neutral' : 'loss';
  const label  = isWin ? 'Wygrana' : isDraw ? 'Remis' : 'Porażka';
  const fmt    = m.match_double ? 'Debel' : 'Singiel';
  const score  = matchScore(m);
  return {
    type:      'match',
    title:     `${label} vs ${matchOpponent(m)}`,
    desc:      fmt,
    score,
    time:      activityDate(m.match_date),
    timestamp: m.match_date,
    result,
  };
});

// ── Moje mecze — statystyki z historii meczów (spójne z "Ostatnią aktywnością") ─
const matchesPlayed = matchHistoryRaw.length;
const matchesWon    = matchHistoryRaw.filter(m => m.user === 'user-win').length;
const matchesLost   = matchHistoryRaw.filter(m => m.user === 'user-loss').length;
const winRate       = matchesPlayed > 0 ? Math.round(matchesWon / matchesPlayed * 100) : 0;

// Greeting: "Witaj" dla nowego usera (brak meczów i turniejów), "Witaj z powrotem" dla aktywnych
const greeting = firstName
  ? (matchesPlayed === 0 && tStats === null ? `Witaj, ${firstName}!` : `Witaj z powrotem, ${firstName}!`)
  : undefined;

// Data pod greeting — "pon · 25 maja 2026 · 14:32"
const now = new Date();
const dayName = now.toLocaleDateString('pl-PL', { weekday: 'short' });
const datePart = now.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
const timePart = now.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
const greetingSub = `${dayName} · ${datePart} · ${timePart}`;
---

<AppLayout
  title="Dashboard"
  greeting={greeting}
  greetingSub={greetingSub}
  showSearch={true}
  showCta={true}
  unreadCount={unreadCount}
>

  <!-- ── Bento hero grid ── -->
  <section class="bento-hero" aria-label="Podsumowanie">

    <!-- Ostatni mecz — span 5 -->
    <div class="dash-card bento-last-match" data-card-id="last-match">
      <div class="lm-header">
        <div class="bento-label">OSTATNI MECZ</div>
        <span class="lm-badge" id="lm-badge"></span>
      </div>

      <div class="lm-body">
        <div class="lm-score">—</div>
        <div class="lm-opponent">
          <div class="lm-opponent__prefix">przeciwko</div>
          <div class="lm-opponent__name">Brak danych</div>
          <div class="lm-opponent__meta" id="lm-meta"></div>
        </div>
      </div>

      <div class="lm-sets" aria-hidden="true">
        <div class="lm-set lm-set--empty">
          <span class="lm-set__label">SET 1</span>
          <span class="lm-set__score" id="lm-set1">—</span>
        </div>
        <div class="lm-set lm-set--empty">
          <span class="lm-set__label">SET 2</span>
          <span class="lm-set__score" id="lm-set2">—</span>
        </div>
        <div class="lm-set lm-set--empty">
          <span class="lm-set__label">SET 3</span>
          <span class="lm-set__score" id="lm-set3">—</span>
        </div>
      </div>
    </div>

    <!-- Ranking — span 3 -->
    <div class="dash-card bento-ranking" data-card-id="ranking">
      <div class="bento-label">RANKING KLUBOWY</div>
      <div class="rk-main">
        <div class="rk-position">—</div>
        <div class="rk-label">miejsce</div>
      </div>
      <div class="rk-trend"></div>
      <div class="rk-bottom">
        <div class="rk-stat">
          <span class="rk-stat__label">PUNKTY</span>
          <span class="rk-stat__value" id="rk-points">—</span>
        </div>
        <div class="rk-stat">
          <span class="rk-stat__label">SKUTECZNOŚĆ</span>
          <span class="rk-stat__value rk-stat__value--accent" id="rk-winrate">—</span>
        </div>
      </div>
    </div>

    <!-- Rezerwacja — span 4, dashed -->
    <div class="dash-card bento-reservation bento-reservation--dashed" data-card-id="reservation">
      <div class="reservation-inner">
        <div class="reservation-icon-box" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
        </div>
        <div class="reservation-text">
          <div class="bento-label" style="margin-bottom:4px;">NAJBLIŻSZA REZERWACJA</div>
          <div class="stat-card__value reservation-value" style="font-size:0.875rem;font-weight:500;">Brak nadchodzących</div>
          <div class="stat-card__detail reservation-detail" style="display:none;"></div>
          <div class="stat-card__footer"></div>
        </div>
        <a href={url('/courts/reservations')} class="reservation-btn">Zarezerwuj kort →</a>
      </div>
    </div>

    <!-- Forma + łącznie meczów — span 4 -->
    <div class="dash-card bento-stats">
      <div class="bento-form-section">
        <div class="bento-label">FORMA · OSTATNIE 8</div>
        {matchesPlayed > 0 ? (
          <div class="bento-form-blocks" aria-label="Forma (ostatnie mecze)">
            {matchHistoryRaw.slice(0, 8).map(m => {
              const r = m.user === 'user-win' ? 'W' : m.user === 'user-loss' ? 'P' : 'R';
              return (
                <div class={`form-block form-block--${r === 'W' ? 'win' : r === 'P' ? 'loss' : 'neutral'}`} title={r === 'W' ? 'Wygrana' : r === 'P' ? 'Porażka' : 'Remis'}>{r}</div>
              );
            })}
          </div>
        ) : (
          <div class="bento-form-blocks bento-form-blocks--empty">
            <span style="font-size:0.78rem;color:var(--tc-muted);">Brak meczów</span>
          </div>
        )}
      </div>
      <div class="bento-total-section">
        <div class="bento-label">ŁĄCZNIE MECZÓW</div>
        <div class="bento-total-row">
          <span class="bento-total__value">{matchesPlayed}</span>
          <span class="bento-total__sub">w tym sezonie</span>
        </div>
      </div>
    </div>

  </section>

  <!-- ── Main grid: turnieje | aktywność ── -->
  <div class="main-grid">

    <!-- LEFT: turnieje -->
    <div class="main-col-left">

      <!-- Nadchodzące turnieje -->
      <div class="dash-card" aria-labelledby="tournaments-heading">
        <div class="dash-section-header">
          <h2 class="dash-section-title" id="tournaments-heading">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" style="color:var(--tc-accent);flex-shrink:0;">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            Nadchodzące turnieje
            {isLiveData && <span class="section-badge">{tournaments.length}</span>}
          </h2>
          <a href={url('/tournaments')} class="dash-link-sm">Wszystkie →</a>
        </div>

        {isLiveData ? (
          <>
            <!-- Nagłówek tabeli -->
            <div class="tourn-table-head">
              <span class="th-num">#</span>
              <span class="th-main">Turniej</span>
              <span class="th-type">Typ</span>
              <span class="th-players">Gracze</span>
              <span class="th-status">Status</span>
            </div>
            <div class="tourn-table-body">
              {tournaments.map((t, i) => (
                <a class="dash-row tourn-row" href={url(`/tournaments/${t.id}`)}>
                  <span class="tourn-row__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="tourn-row__name">{t.name}</span>
                  <span class="tourn-row__type">{t.type}</span>
                  <span class="tourn-row__players">{t.participants}</span>
                  <span class={`tourn-row__status tourn-status--${t.status}`}>
                    {(t.status === 'active' || t.status === 'open') && <span class="tourn-status__dot" aria-hidden="true"></span>}
                    {t.statusLabel}
                  </span>
                </a>
              ))}
            </div>
            <div class="dash-card-footer">
              <a href={url('/tournaments')} class="dash-btn-secondary">+ Zapisz się do turnieju</a>
            </div>
          </>
        ) : (
          <div class="dash-empty-block">
            <div class="dash-empty-block__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.25 9.71 2 12 2c2.291 0 4.545.25 6.75.721v1.515M18.75 4.236c.983.143 1.955.317 2.917.52A6.003 6.003 0 0016.27 9.728M18.75 4.236V4.5a9.023 9.023 0 01-2.48 5.228" />
              </svg>
            </div>
            <p class="dash-empty-block__title">Brak nadchodzących turniejów</p>
            <p class="dash-empty-block__sub">Przeglądaj dostępne turnieje i zapisz się.</p>
            <div class="dash-empty-block__links">
              <a href={url('/tournaments')} class="dash-btn-primary">Przeglądaj turnieje →</a>
            </div>
          </div>
        )}
      </div>

    </div>

    <!-- RIGHT: aktywność + teaser turniejów + statystyki -->
    <div class="main-col-right">

      <!-- Ostatnia aktywność -->
      <div class="dash-card" aria-labelledby="activity-heading">
        <div class="dash-section-header">
          <h2 class="dash-section-title" id="activity-heading">Aktywność</h2>
          <div class="activity-seg" role="group" aria-label="Filtruj aktywność">
            <button class="activity-seg__btn activity-seg__btn--active" data-filter="today" type="button">Dziś</button>
            <button class="activity-seg__btn" data-filter="week" type="button">Tydzień</button>
            <button class="activity-seg__btn" data-filter="month" type="button">Miesiąc</button>
          </div>
        </div>

        {recentActivity.length === 0 ? (
          <div id="activity-feed-empty" class="dash-empty-block">
            <div class="dash-empty-block__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
              </svg>
            </div>
            <p class="dash-empty-block__title">Brak rozegranych meczów</p>
            <p class="dash-empty-block__sub">Tu pojawią się Twoje ostatnie mecze — towarzyskie i turniejowe.</p>
            <div class="dash-empty-block__links">
              <a href={url('/matches')} class="dash-link-sm">Moje mecze</a>
              <a href={url('/tournaments')} class="dash-link-sm">Turnieje</a>
            </div>
          </div>
        ) : (
          <ul id="activity-feed-list" class="activity-list" role="list">
            {recentActivity.map(item => (
              <li class="activity-item" data-timestamp={item.timestamp}>
                <div class={`activity-dot activity-dot--${item.result}`} aria-hidden="true"></div>
                <div class="activity-item__body">
                  <div class="activity-item__title">{item.title}</div>
                  <div class="activity-item__desc">
                    {item.desc}
                    {item.score && item.score !== '—' && (
                      <>
                        <span class="activity-item__sep">·</span>
                        <span class="activity-item__score">{item.score}</span>
                      </>
                    )}
                  </div>
                </div>
                <div class="activity-item__time">{item.time}</div>
              </li>
            ))}
          </ul>
        )}

        <div class="dash-card-footer activity-footer">
          <span class="activity-footer__count">
            <strong>{recentActivity.length}</strong> {recentActivity.length === 1 ? 'wpis' : 'wpisów'}
          </span>
          <a href={url('/matches')} class="dash-link-sm">Historia meczów →</a>
        </div>
      </div>

    </div>
  </div>

  <!-- ── Stats strip na dole ── -->
  <section class="stats-strip" aria-label="Statystyki ogólne">
    <div class="stats-strip__stat">
      <div class="bento-label">ŁĄCZNIE MECZÓW</div>
      <div class="stats-strip__value">{matchesPlayed}</div>
    </div>
    <div class="stats-strip__stat">
      <div class="bento-label">WYGRANE</div>
      <div class="stats-strip__value">
        <span style="color:var(--tc-accent)">{matchesWon}</span>
        <span class="stats-strip__frac">/ {matchesPlayed}</span>
      </div>
    </div>
    <div class="stats-strip__stat">
      <div class="bento-label">SKUTECZNOŚĆ</div>
      <div class="stats-strip__value">
        {winRate}<span class="stats-strip__frac">%</span>
      </div>
    </div>
    <div class="stats-strip__stat">
      <div class="bento-label">AKTYWNE TURNIEJE</div>
      <div class="stats-strip__value">{tStats?.tournaments_active ?? 0}</div>
    </div>
    <div class="stats-strip__form">
      <div class="bento-label">FORMA · OSTATNIE 8</div>
      <div class="stats-strip__bars">
        {matchHistoryRaw.slice(0, 8).map(m => {
          const isWin = m.user === 'user-win';
          return (
            <div
              class={`stats-bar ${isWin ? 'stats-bar--win' : 'stats-bar--loss'}`}
              title={isWin ? 'Wygrana' : 'Porażka'}
            ></div>
          );
        })}
        <span class="stats-strip__bars-summary">
          <span style="color:var(--tc-accent);font-weight:700;">{matchesWon} wygranych</span> · {matchesLost} porażki
        </span>
      </div>
    </div>
  </section>

</AppLayout>

<!--
  Client-side: odśwież licznik powiadomień z Django API.
  Wymaga sesji Django w przegladarce (cookies).
  Graceful degradation: jeśli brak sesji lub backend niedostępny — nic nie robi.
-->
<!-- Powiadomienia obsługiwane przez Topbar.astro -->

<!--
  Client-side: ładuje dane dashboard summary z /api/dashboard/summary/.
  Wymaga sesji Django (cookies). Graceful degradation — fallback z HTML.
-->
<script>
  (async function initDashboardSummary() {
    const API_BASE =
      (document.querySelector('meta[name="api-base"]') as HTMLMetaElement)?.content ??
      'http://localhost:8000';

    function setCard(id: string, value: string, detail: string) {
      const card = document.querySelector(`[data-card-id="${id}"]`);
      if (!card) return;
      const valEl = card.querySelector('.stat-card__value');
      const detEl = card.querySelector('.stat-card__detail');
      if (valEl) valEl.textContent = value;
      if (detEl) detEl.textContent = detail;
    }

    function setTrend(id: string, trend: string, up: boolean) {
      const card = document.querySelector(`[data-card-id="${id}"]`);
      if (!card) return;
      const footer = card.querySelector('.stat-card__footer');
      if (!footer) return;
      let trendEl = footer.querySelector('.stat-card__trend') as HTMLElement | null;
      if (!trendEl) {
        trendEl = document.createElement('span');
        footer.appendChild(trendEl);
      }
      trendEl.className = `stat-card__trend stat-card__trend--${up ? 'up' : 'down'}`;
      trendEl.textContent = `${up ? '\u2197' : '\u2198'} ${trend}`;
    }

    try {
      const res = await fetch(`${API_BASE}/api/dashboard/summary/`, {
        credentials: 'include',
        headers: { 'Accept': 'application/json' },
        redirect: 'manual',
      });

      if (res.type === 'opaqueredirect' || !res.ok) return; // niezalogowany

      const d = await res.json();

      // ── Rezerwacja ─────────────────────────────────────────────
      if (d.next_reservation) {
        const r = d.next_reservation;
        setCard('reservation',
          `${r.date}–${r.end_time}`,
          r.court ?? 'Kort nieokreślony'
        );
      } else {
        setCard('reservation', 'Brak', 'Brak nadchodzących rezerwacji');
      }

      // ── Ostatni mecz ──────────────────────────────────────────
      if (d.last_match) {
        const m = d.last_match;
        const card = document.querySelector('[data-card-id="last-match"]');
        if (card) {
          // Sety z API — format "gem1a:gem1b gem2a:gem2b ..." oddzielone spacją
          const sets = (m.score ?? '').split(' ').map((s: string) => s.trim()).filter(Boolean);

          // Wynik setowy (ile setów wygranych) jako duży numer
          const scoreEl = card.querySelector('.lm-score') as HTMLElement | null;
          if (scoreEl) {
            const setsWon = sets.filter((s: string) => {
              const [a, b] = s.split(':').map(Number);
              return a > b;
            }).length;
            const setsLost = sets.length - setsWon;
            scoreEl.innerHTML = `${setsWon}<span class="lm-score__colon">:</span><span class="lm-score__loss">${setsLost}</span>`;
          }

          // Badge — wygrana/porażka
          const badge = document.getElementById('lm-badge');
          if (badge) {
            badge.textContent = m.won ? '● Wygrana' : '● Porażka';
            badge.style.background = m.won ? 'var(--tc-accent-soft)' : 'rgba(239,68,68,0.1)';
            badge.style.color = m.won ? 'var(--tc-accent)' : 'var(--tc-hot)';
            badge.style.padding = '3px 10px';
            badge.style.borderRadius = '99px';
            badge.style.fontSize = '0.72rem';
            badge.style.fontWeight = '700';
          }

          // Przeciwnik
          const nameEl = card.querySelector('.lm-opponent__name') as HTMLElement | null;
          if (nameEl) nameEl.textContent = m.opponent ?? '';

          // Meta (data) — sformatowana czytelnie
          const metaEl = document.getElementById('lm-meta');
          if (metaEl && m.date) {
            try {
              const dt = new Date(m.date);
              metaEl.textContent = dt.toLocaleDateString('pl-PL', {
                day: 'numeric', month: 'long', year: 'numeric'
              });
            } catch {
              metaEl.textContent = m.date;
            }
          }

          // Sety — gem scores z kolorami (wygrany set = accent)
          ['lm-set1', 'lm-set2', 'lm-set3'].forEach((id, i) => {
            const el = document.getElementById(id);
            if (!el) return;
            const setDiv = el.closest('.lm-set');
            if (sets[i]) {
              const [a, b] = sets[i].split(':').map(Number);
              const myWon = a > b;
              el.innerHTML = `<span class="${myWon ? 'lm-set__my--win' : ''}">${a}</span> <span class="lm-set__dash">—</span> <span class="lm-set__opp">${b}</span>`;
              if (setDiv) setDiv.classList.remove('lm-set--empty');
            }
          });
        }
      }

      // ── Ranking ───────────────────────────────────────────────
      if (d.ranking && d.ranking.position !== null) {
        const rk = d.ranking;
        const card = document.querySelector('[data-card-id="ranking"]');
        if (card) {
          // Pozycja — duży numer (selektor rk-position)
          const posEl = card.querySelector('.rk-position') as HTMLElement | null;
          if (posEl) posEl.textContent = String(rk.position);

          // Trend pod numerem: punkty i win_rate (API nie zwraca change)
          const trendEl = card.querySelector('.rk-trend') as HTMLElement | null;
          if (trendEl) {
            const parts: string[] = [];
            if (rk.matches_played !== null) parts.push(`${rk.matches_played} meczów`);
            if (rk.matches_won !== null) parts.push(`${rk.matches_won} wygranych`);
            if (parts.length > 0) {
              trendEl.textContent = parts.join(' · ');
            }
          }

          // Punkty i skuteczność — bottom bar
          const pointsEl = document.getElementById('rk-points');
          if (pointsEl && rk.points !== null) pointsEl.textContent = String(Math.round(rk.points));
          const wrEl = document.getElementById('rk-winrate');
          if (wrEl && rk.win_rate !== null) wrEl.textContent = `${rk.win_rate}%`;
        }
      }

      // ── Activity feed — z filtrowaniem po timestamp ──────────────
      if (Array.isArray(d.activity)) {
        const emptyEl = document.getElementById('activity-feed-empty');
        const listEl  = document.getElementById('activity-feed-list');
        const section = emptyEl?.closest('[aria-labelledby="activity-heading"]') ?? listEl?.closest('[aria-labelledby="activity-heading"]');
        const footerCountEl = section?.querySelector<HTMLElement>('.activity-footer__count');

        function relativeTime(iso: string): string {
          try {
            const dt = new Date(iso);
            const diff = Math.floor((Date.now() - dt.getTime()) / 86400000);
            if (diff === 0) return dt.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
            if (diff === 1) return 'wczoraj';
            if (diff < 7)  return `${diff} dni temu`;
            return dt.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
          } catch { return ''; }
        }

        function iconSvg(result: string): string {
          if (result === 'win' || result === 'loss') {
            return `<svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/></svg>`;
          }
          if (result === 'tournament_join') {
            return `<svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`;
          }
          return `<svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>`;
        }

        function buildItemHtml(ev: {type:string;timestamp:string;title:string;detail:string;score?:string;href?:string;result:string}): string {
          const dotClass = ev.result === 'win'
            ? 'activity-dot--win'
            : ev.result === 'loss'
              ? 'activity-dot--loss'
              : 'activity-dot--neutral';
          const titleHtml = ev.href
            ? `<a href="${ev.href}" class="activity-item__title-link">${ev.title}</a>`
            : `<span>${ev.title}</span>`;
          // detail + score w mono
          const scoreHtml = ev.score
            ? `<span class="activity-item__sep">·</span><span class="activity-item__score">${ev.score}</span>`
            : '';
          return `<li class="activity-item">
            <div class="activity-dot ${dotClass}" aria-hidden="true"></div>
            <div class="activity-item__body">
              <div class="activity-item__title">${titleHtml}</div>
              <div class="activity-item__desc">${ev.detail}${scoreHtml}</div>
            </div>
            <div class="activity-item__time">${relativeTime(ev.timestamp)}</div>
          </li>`;
        }

        // Pobierz lub utwórz element listy
        const getOrCreateList = () => {
          if (listEl) return listEl;
          const ul = document.createElement('ul');
          ul.id = 'activity-feed-list';
          ul.className = 'activity-list';
          ul.setAttribute('role', 'list');
          const footer = section?.querySelector('.activity-footer');
          if (footer && section) section.insertBefore(ul, footer);
          else if (emptyEl?.parentNode) emptyEl.parentNode.insertBefore(ul, emptyEl);
          return ul;
        };

        // Funkcja renderująca dla danego okresu
        function renderForPeriod(period: string) {
          const now = Date.now();
          let fromMs: number;
          if (period === 'today') {
            const d0 = new Date(); d0.setHours(0, 0, 0, 0);
            fromMs = d0.getTime();
          } else if (period === 'week') {
            fromMs = now - 7 * 86_400_000;
          } else {
            fromMs = now - 30 * 86_400_000;
          }

          const filtered = d.activity.filter(
            (ev: {timestamp: string}) => new Date(ev.timestamp).getTime() >= fromMs
          );

          // Pobierz lub utwórz empty element (raz — potem reużywamy)
          const getOrCreateEmpty = (): HTMLElement => {
            const existing = document.getElementById('activity-feed-empty');
            if (existing) return existing as HTMLElement;
            const div = document.createElement('div');
            div.id = 'activity-feed-empty';
            div.className = 'dash-empty-block';
            div.innerHTML = `<p class="dash-empty-block__title">Brak aktywności</p><p class="dash-empty-block__sub">Tu pojawią się Twoje ostatnie mecze i akcje.</p>`;
            const footer2 = section?.querySelector('.activity-footer');
            if (footer2 && section) section.insertBefore(div, footer2);
            return div;
          };

          if (filtered.length === 0) {
            if (listEl) listEl.style.display = 'none';
            const empty = getOrCreateEmpty();
            const titleEl = empty.querySelector<HTMLElement>('.dash-empty-block__title');
            const subEl   = empty.querySelector<HTMLElement>('.dash-empty-block__sub');
            if (period === 'today') {
              if (titleEl) titleEl.textContent = 'Brak aktywności dziś';
              if (subEl)   subEl.textContent   = 'Nic się nie wydarzyło jeszcze dzisiaj.';
            } else if (period === 'week') {
              if (titleEl) titleEl.textContent = 'Brak aktywności w tym tygodniu';
              if (subEl)   subEl.textContent   = 'Tu pojawią się Twoje mecze i akcje z ostatnich 7 dni.';
            } else {
              if (titleEl) titleEl.textContent = 'Brak aktywności w tym miesiącu';
              if (subEl)   subEl.textContent   = 'Tu pojawią się Twoje mecze i akcje z ostatnich 30 dni.';
            }
            empty.style.display = '';
            if (footerCountEl) footerCountEl.innerHTML = '<strong>0</strong> wpisów';
          } else {
            // Ukryj empty (zarówno SSR jak i dynamicznie stworzony)
            document.getElementById('activity-feed-empty')?.style.setProperty('display', 'none');
            const target = getOrCreateList();
            target.innerHTML = filtered.map(buildItemHtml).join('');
            target.style.display = '';
            if (footerCountEl) {
              const n = filtered.length;
              const label = n === 1 ? 'wpis' : 'wpisów';
              footerCountEl.innerHTML = `<strong>${n}</strong> ${label}`;
            }
          }
        }

        // Przekaż dane i renderFn do systemu filtrów
        if (typeof (window as any).__initActivityFiltersWithData === 'function') {
          (window as any).__initActivityFiltersWithData(d.activity, renderForPeriod);
        } else {
          // Fallback — render bez filtrowania
          if (d.activity.length === 0) {
            if (listEl) listEl.style.display = 'none';
            if (emptyEl) emptyEl.style.display = '';
          } else {
            if (emptyEl) emptyEl.style.display = 'none';
            const target = getOrCreateList();
            target.innerHTML = d.activity.map(buildItemHtml).join('');
            target.style.display = '';
          }
        }
      }

      // ── Turnieje (jeśli nie mamy z build-time) ───────────────────
      if (d.upcoming_tournaments_count !== null) {
        const card = document.querySelector('[data-card-id="tournaments"]');
        const valEl = card?.querySelector('.stat-card__value');
        // aktualizuj tylko jeśli karta ma nadal wartość — (tzn. nie nadpisała jej inna sekcja)
        if (valEl && (valEl.textContent?.trim() === '—' || valEl.textContent?.trim() === '')) {
          valEl.textContent = `${d.upcoming_tournaments_count} aktywnych`;
          const detEl = card?.querySelector('.stat-card__detail');
          if (detEl) detEl.textContent = 'turniejów w toku lub rekrutacji';
        }
      }

    } catch {
      // backend niedostępny — pozostają fallbacki z HTML
    }
  })();

  // ── Activity filters — smart auto-fallback + filtrowanie po timestamp ───────
  (function initActivityFilters() {
    // Przechowuje wszystkie wpisy z API (uzupełniane po fetch)
    let allActivity: Array<{type:string;timestamp:string;title:string;detail:string;href?:string;result:string}> = [];

    // Zapisz referencję do renderowania listy (uzupełni się po fetch)
    // Ta funkcja jest wywoływana również ręcznie przy kliknięciu filtra
    let renderFn: ((period: string) => void) | null = null;

    function msFor(period: string): number {
      if (period === 'today') {
        // od początku dzisiejszego dnia (00:00)
        const now = new Date();
        now.setHours(0, 0, 0, 0);
        return Date.now() - now.getTime();
      }
      if (period === 'week')  return 7 * 86_400_000;
      if (period === 'month') return 30 * 86_400_000;
      return Infinity;
    }

    function setActiveFilter(period: string) {
      document.querySelectorAll('.activity-seg__btn').forEach(b => {
        b.classList.toggle('activity-seg__btn--active', (b as HTMLButtonElement).dataset.filter === period);
      });
    }

    function bestPeriod(items: typeof allActivity): string {
      const todayStart = new Date();
      todayStart.setHours(0, 0, 0, 0);
      const todayMs = todayStart.getTime();
      const weekMs  = Date.now() - 7 * 86_400_000;
      const monthMs = Date.now() - 30 * 86_400_000;

      if (items.some(ev => new Date(ev.timestamp).getTime() >= todayMs)) return 'today';
      if (items.some(ev => new Date(ev.timestamp).getTime() >= weekMs))  return 'week';
      if (items.some(ev => new Date(ev.timestamp).getTime() >= monthMs)) return 'month';
      return 'month'; // pokaż miesięczny (może być pusty — pokaże empty state)
    }

    // Filtrowanie SSR DOM po data-timestamp (fallback gdy brak danych z API)
    function renderSsrForPeriod(period: string) {
      const listEl = document.getElementById('activity-feed-list');
      if (!listEl) return;
      const items = listEl.querySelectorAll<HTMLLIElement>('li[data-timestamp]');
      if (items.length === 0) return;

      const now = Date.now();
      let fromMs: number;
      if (period === 'today') {
        const d0 = new Date(); d0.setHours(0, 0, 0, 0);
        fromMs = d0.getTime();
      } else if (period === 'week') {
        fromMs = now - 7 * 86_400_000;
      } else {
        fromMs = now - 30 * 86_400_000;
      }

      let visible = 0;
      items.forEach(li => {
        const ts = new Date(li.dataset.timestamp ?? '').getTime();
        const show = !isNaN(ts) && ts >= fromMs;
        li.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      const section = listEl.closest('[aria-labelledby="activity-heading"]');
      const countEl = section?.querySelector<HTMLElement>('.activity-footer__count');
      if (countEl) {
        countEl.innerHTML = `<strong>${visible}</strong> ${visible === 1 ? 'wpis' : 'wpisów'}`;
      }

      // Pokaż/ukryj empty state
      let emptyEl = document.getElementById('activity-feed-empty') as HTMLElement | null;
      if (visible === 0) {
        listEl.style.display = 'none';
        if (!emptyEl) {
          emptyEl = document.createElement('div');
          emptyEl.id = 'activity-feed-empty';
          emptyEl.className = 'dash-empty-block';
          const footer = section?.querySelector('.activity-footer');
          if (footer && section) section.insertBefore(emptyEl, footer);
        }
        const labels: Record<string, [string, string]> = {
          today: ['Brak aktywności dziś', 'Nic się nie wydarzyło jeszcze dzisiaj.'],
          week:  ['Brak aktywności w tym tygodniu', 'Tu pojawią się mecze z ostatnich 7 dni.'],
          month: ['Brak aktywności w tym miesiącu', 'Tu pojawią się mecze z ostatnich 30 dni.'],
        };
        const [title, sub] = labels[period] ?? labels.month;
        emptyEl.innerHTML = `<p class="dash-empty-block__title">${title}</p><p class="dash-empty-block__sub">${sub}</p>`;
        emptyEl.style.display = '';
      } else {
        listEl.style.display = '';
        if (emptyEl) emptyEl.style.display = 'none';
      }
    }

    // Podpięcie kliknięć — renderFn z API (preferowane) lub SSR DOM fallback
    document.querySelectorAll<HTMLButtonElement>('.activity-seg__btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const period = btn.dataset.filter ?? 'today';
        setActiveFilter(period);
        if (renderFn) renderFn(period);
        else renderSsrForPeriod(period);
      });
    });

    // Auto-select aktywnego filtru na podstawie SSR timestamps przy załadowaniu
    (function autoSelectFilter() {
      const listEl = document.getElementById('activity-feed-list');
      const items = listEl ? listEl.querySelectorAll<HTMLLIElement>('li[data-timestamp]') : [];
      if (items.length === 0) return;

      const todayStart = new Date(); todayStart.setHours(0, 0, 0, 0);
      const todayMs = todayStart.getTime();
      const weekMs  = Date.now() - 7 * 86_400_000;
      const monthMs = Date.now() - 30 * 86_400_000;

      let best = 'month';
      for (const li of Array.from(items)) {
        const ts = new Date(li.dataset.timestamp ?? '').getTime();
        if (!isNaN(ts)) {
          if (ts >= todayMs) { best = 'today'; break; }
          if (ts >= weekMs)  { best = 'week'; }
        }
      }
      setActiveFilter(best);
      renderSsrForPeriod(best);
    })();

    // Eksportuj inicjalizację do użycia przez initDashboardSummary
    (window as any).__initActivityFiltersWithData = function(
      items: typeof allActivity,
      render: (period: string) => void
    ) {
      allActivity = items;
      renderFn = render;
      const period = bestPeriod(items);
      setActiveFilter(period);
      render(period);
    };
  })();
</script>

