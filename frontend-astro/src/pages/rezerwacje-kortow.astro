---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { url } from '@/lib/url';

export const prerender = true;
---

<PublicLayout
  title="Rezerwacje Kortów Tenisowych Online"
  description="Rezerwuj korty tenisowe online — jednorazowe i cykliczne, z powiadomieniami i akceptacją przez managera klubu. System dla klubów tenisowych."
>
  <section class="py-16 px-8 max-[480px]:py-8 max-[480px]:px-4 bg-bg">
    <div class="max-w-[860px] mx-auto">
      <h1 class="text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold text-[#0f172a] tracking-[-0.02em] mb-4">
        Rezerwacje kortów tenisowych online
      </h1>
      <p class="text-[1.1rem] text-[#64748b] mb-10 max-w-[65ch]">
        Grafik kortów dostępny 24/7. Gracze rezerwują samodzielnie, manager zatwierdza.
        Koniec z telefonami i arkuszami.
      </p>

      <ul class="space-y-4 mb-12 text-[1rem] text-[#0f172a]">
        <li class="flex gap-3 items-start"><span class="text-[#16a34a] font-bold mt-0.5">✓</span> Rezerwacje jednorazowe i cykliczne (2–12 tygodni)</li>
        <li class="flex gap-3 items-start"><span class="text-[#16a34a] font-bold mt-0.5">✓</span> Anulowanie pojedynczej rezerwacji lub całej serii</li>
        <li class="flex gap-3 items-start"><span class="text-[#16a34a] font-bold mt-0.5">✓</span> Powiadomienia o akceptacji i odrzuceniu</li>
        <li class="flex gap-3 items-start"><span class="text-[#16a34a] font-bold mt-0.5">✓</span> Widok grafiku dla całego klubu</li>
        <li class="flex gap-3 items-start"><span class="text-[#16a34a] font-bold mt-0.5">✓</span> Obsługa wielu obiektów / kortów</li>
      </ul>

      <div class="flex gap-4 flex-wrap">
        <a href={url('/register')} class="tc-btn tc-btn-primary">Zarejestruj klub</a>
        <a href={url('/kontakt')} class="tc-btn tc-btn-secondary">Zapytaj o wdrożenie</a>
      </div>
    </div>
  </section>
</PublicLayout>
