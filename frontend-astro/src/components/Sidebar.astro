---
// Sidebar.astro — redesign v2 (tc-theme tokens, flat nav bez ikon, brand z piłką tenisową)
import { url } from '@/lib/url';
import type { CurrentUser } from '@/lib/api';

interface Props {
  currentPath?: string;
  currentUser?: CurrentUser | null;
}
const { currentPath = '/', currentUser = null } = Astro.props;

// Dane do footera — inicjały, display name, rola
const displayName = currentUser
  ? ([currentUser.first_name, currentUser.last_name].filter(Boolean).join(' ') || currentUser.username)
  : 'Użytkownik';
const initials = displayName
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((w: string) => w[0].toUpperCase())
  .join('') || 'U';
const roleLabel = currentUser?.is_staff ? 'Administrator' : (currentUser ? 'Członek' : '—');

const _classicBase = import.meta.env.PUBLIC_CLASSIC_URL ?? '';
const classicUrl = (_classicBase ? _classicBase.replace(/\/$/, '') : '') + '/tournaments';

const navItems = [
  { href: url('/dashboard'),          label: 'Start',       match: ['/dashboard'] },
  { href: url('/courts/reservations'),label: 'Rezerwacje',  match: ['/courts/reservations', '/courts'] },
  { href: url('/matches'),            label: 'Mecze',       match: ['/matches'] },
  { href: url('/tournaments'),        label: 'Turnieje',    match: ['/tournaments'] },
  { href: url('/rankings'),           label: 'Ranking',     match: ['/rankings'] },
  { href: url('/profile'),            label: 'Profil',      match: ['/profile'] },
];

const adminItems = [
  { href: '/manage/',  label: 'Zarządzanie', match: ['/manage'] },
];

function isActive(item: { match: string[] }): boolean {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const path = currentPath.startsWith(base) ? currentPath.slice(base.length) || '/' : currentPath;
  return item.match.some(m => path === m || path.startsWith(m + '/'));
}
---

<aside class="sidebar" id="app-sidebar">

  <!-- Brand -->
  <div class="sidebar-brand">
    <a href={url('/dashboard')} class="sidebar-brand__link">
      <div class="sidebar-brand__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M6.3 6.3c2.4 2.4 2.4 9 0 11.4M17.7 6.3c-2.4 2.4-2.4 9 0 11.4"/>
        </svg>
      </div>
      <div class="sidebar-brand__text">
        <span class="sidebar-brand__name">Tennis Club</span>
        <span class="sidebar-brand__status" aria-label="Online">
          <span class="sidebar-brand__dot" aria-hidden="true"></span>
          ONLINE
        </span>
      </div>
    </a>
  </div>

  <!-- Main navigation -->
  <nav class="sidebar-nav" aria-label="Główna nawigacja">
    {navItems.map(item => (
      <a
        href={item.href}
        class={`sidebar-nav__link${isActive(item) ? ' sidebar-nav__link--active' : ''}`}
        aria-current={isActive(item) ? 'page' : undefined}
      >
        {item.label}
        {isActive(item) && <span class="sidebar-nav__arrow" aria-hidden="true">→</span>}
      </a>
    ))}

    {currentUser?.is_staff && (
      <>
        <div class="sidebar-nav__sep" aria-hidden="true"></div>
        <div class="sidebar-nav__section-label">Administracja</div>
        {adminItems.map(item => (
          <a
            href={item.href}
            class={`sidebar-nav__link sidebar-nav__link--muted${isActive(item) ? ' sidebar-nav__link--active' : ''}`}
          >
            {item.label}
            {isActive(item) && <span class="sidebar-nav__arrow" aria-hidden="true">→</span>}
          </a>
        ))}
      </>
    )}

    <div class="sidebar-nav__sep" aria-hidden="true"></div>
    <a href={classicUrl} class="sidebar-nav__link sidebar-nav__link--classic">
      ← Wersja klasyczna
    </a>
  </nav>

  <!-- User footer -->
  <div class="sidebar-user">
    <div class="sidebar-user__avatar" aria-hidden="true">{initials}</div>
    <div class="sidebar-user__info">
      <div class="sidebar-user__name">{displayName}</div>
      <div class="sidebar-user__role">{roleLabel}</div>
    </div>
    <a href={url('/profile/edit')} class="sidebar-user__settings" title="Edytuj profil" aria-label="Edytuj profil">
      <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/>
      </svg>
    </a>
  </div>

</aside>

<!-- Mobile overlay -->
<div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>

<style>
  /* ── Sidebar shell ──────────────────────────────────────────────────────── */
  .sidebar {
    background: var(--tc-sidebar-bg);
    border-right: 1px solid var(--tc-sidebar-border);
    width: 220px;
    min-height: 100vh;
    position: fixed;
    top: 0; left: 0; bottom: 0;
    display: flex; flex-direction: column;
    z-index: 100;
    overflow-y: auto;
    overflow-x: hidden;
  }

  /* ── Brand ──────────────────────────────────────────────────────────────── */
  .sidebar-brand {
    height: var(--topbar-height);
    padding: 0 14px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--tc-sidebar-border);
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .sidebar-brand__link {
    display: flex; align-items: center; gap: 11px;
    text-decoration: none;
  }

  .sidebar-brand__icon {
    width: 32px; height: 32px;
    border-radius: 10px;
    background: var(--tc-accent);
    color: var(--tc-accent-ink);
    display: grid; place-items: center;
    flex-shrink: 0;
  }

  .sidebar-brand__text {
    display: flex; flex-direction: column; gap: 2px;
    min-width: 0;
  }

  .sidebar-brand__name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--tc-ink);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .sidebar-brand__status {
    display: flex; align-items: center; gap: 4px;
    font-size: 0.6rem;
    color: var(--tc-accent);
    letter-spacing: 0.14em;
    font-weight: 600;
    line-height: 1;
  }

  .sidebar-brand__dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--tc-accent);
    box-shadow: 0 0 4px var(--tc-accent);
    flex-shrink: 0;
  }

  /* ── Navigation ─────────────────────────────────────────────────────────── */
  .sidebar-nav {
    flex: 1;
    padding: 14px 14px 8px;
    display: flex; flex-direction: column; gap: 1px;
  }

  .sidebar-nav__link {
    display: flex; align-items: center; justify-content: space-between;
    padding: 9px 12px;
    border-radius: 7px;
    color: var(--tc-sub);
    font-size: 0.8125rem; font-weight: 500;
    text-decoration: none;
    transition: background 0.12s, color 0.12s;
  }

  .sidebar-nav__link:hover {
    background: var(--tc-overlay);
    color: var(--tc-ink);
  }

  .sidebar-nav__link--active {
    background: var(--tc-accent) !important;
    color: var(--tc-accent-ink) !important;
    font-weight: 600;
  }

  .sidebar-nav__link--muted {
    color: var(--tc-muted);
    font-size: 0.8rem;
  }

  .sidebar-nav__arrow {
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono-plex);
    flex-shrink: 0;
  }

  .sidebar-nav__sep {
    height: 1px;
    background: var(--tc-sidebar-border);
    margin: 10px 4px;
  }

  .sidebar-nav__section-label {
    font-size: 0.59rem;
    color: var(--tc-faint);
    padding: 4px 12px 6px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .sidebar-nav__link--classic {
    opacity: 0.5;
    font-size: 0.775rem;
  }
  .sidebar-nav__link--classic:hover { opacity: 0.8; }

  /* ── User footer ─────────────────────────────────────────────────────────── */
  .sidebar-user {
    padding: 11px 14px;
    display: flex; align-items: center; gap: 10px;
    flex-shrink: 0;
    background: var(--tc-card-bg);
    border-radius: 10px;
    border: 1px solid var(--tc-card-border);
    margin: 0 8px 8px;
  }

  .sidebar-user__avatar {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: var(--tc-accent-soft);
    border: 1.5px solid var(--tc-accent);
    color: var(--tc-accent);
    font-weight: 700; font-size: 0.7rem;
    display: grid; place-items: center;
    flex-shrink: 0;
  }

  .sidebar-user__info { flex: 1; min-width: 0; }

  .sidebar-user__name {
    font-size: 0.78rem; font-weight: 600; color: var(--tc-ink);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .sidebar-user__role {
    font-size: 0.67rem; color: var(--tc-muted); margin-top: 1px;
  }

  .sidebar-user__settings {
    width: 26px; height: 26px;
    border-radius: 6px;
    background: none; border: none;
    color: var(--tc-muted);
    display: grid; place-items: center;
    flex-shrink: 0;
    transition: background 0.12s, color 0.12s;
    cursor: pointer;
    text-decoration: none;
  }
  .sidebar-user__settings:hover {
    background: var(--tc-overlay);
    color: var(--tc-sub);
  }

  /* ── Mobile overlay ─────────────────────────────────────────────────────── */
  .sidebar-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.65); z-index: 99;
    backdrop-filter: blur(3px);
  }
  .sidebar-overlay.is-visible { display: block; }

  @media (max-width: 1024px) {
    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .sidebar.is-open { transform: translateX(0); }
  }
</style>
