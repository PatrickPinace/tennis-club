# Adres Django backendu — potrzebny przy fetch do API w trybie SSR
# W trybie dev ustaw tu URL lokalnego Django
DJANGO_API_URL=http://localhost:8000

# URL klasycznej wersji Django widoczny w przeglądarce (link "Wersja klasyczna").
# Dev: http://localhost:8000 (Django chodzi osobno na :8000)
# Prod: zostaw puste — Caddy przekierowuje /tournaments → Django na tej samej domenie
PUBLIC_CLASSIC_URL=http://localhost:8000

# Opcjonalnie: JWT token dla dev-fixtures (nie commituj prawdziwego tokenu!)
# DEV_JWT_TOKEN=

# SEO / Analytics — tylko produkcja (nie ustawiaj lokalnie)
# Canonical URL bazowy — używany w <link rel="canonical"> i sitemap.xml
# PUBLIC_SITE_URL=https://portal.raketon.pl

# Plausible Analytics — ustaw domenę żeby włączyć skrypt (lokalnie zostaw puste)
# PUBLIC_PLAUSIBLE_DOMAIN=portal.raketon.pl

# URL skryptu Plausible — dla self-host zmień na własną instancję
# Dla cloud Plausible: https://plausible.io/js/script.js (domyślne)
# Dla self-host: https://stats.raketon.pl/js/script.js
# PUBLIC_PLAUSIBLE_SCRIPT_URL=https://stats.raketon.pl/js/script.js
