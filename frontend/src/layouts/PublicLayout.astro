---
import '@/styles/global.css';
import { url } from '@/lib/url';
import { getCurrentUser } from '@/lib/api';
import CookieBanner from '@/components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  /** Opcjonalny JSON-LD string (serialize przed przekazaniem) — wstrzykiwany do <head> */
  jsonLd?: string;
}

const {
  title = 'Tennis Club',
  description = 'Portal tenisowy — rezerwacje kortów, turnieje, ligi i rankingi dla klubów i graczy.',
  canonical,
  ogImage,
  jsonLd,
} = Astro.props;

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const currentUser = await getCurrentUser(sessionCookie);

const SITE = import.meta.env.PUBLIC_SITE_URL ?? 'https://portal.raketon.pl';
// Strip ASTRO_BASE prefix z pathname żeby canonical był zawsze względem domeny root
const BASE = import.meta.env.BASE_URL ?? '/';
const rawPath = Astro.url.pathname;
const cleanPath = BASE !== '/' ? rawPath.replace(new RegExp('^' + BASE.replace(/\/$/, '')), '') || '/' : rawPath;
const canonicalUrl = canonical ?? (SITE + cleanPath);
const ogImageUrl = ogImage ?? `${SITE}/og-default.png`;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? '';
const fullTitle = `${title} — Tennis Club`;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
---

<!doctype html>
<html lang="pl" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="Tennis Club" />

  <!-- Twitter / X card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="icon" href={url('/favicon.ico')} type="image/x-icon" />

  <!-- Structured data — JSON-LD (opcjonalny, przekazywany przez prop) -->
  {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

  <!-- Plausible analytics — tylko gdy PUBLIC_PLAUSIBLE_DOMAIN ustawiony (prod) -->
  {plausibleDomain && (
    <script
      is:inline
      defer
      data-domain={plausibleDomain}
      src="https://plausible.io/js/script.js"
    />
  )}

  {gaMeasurementId && (
    <>
      <script is:inline define:vars={{ gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}

        const storedConsent = localStorage.getItem('tc_cookie_consent');
        let consent = null;
        try {
          consent = storedConsent ? JSON.parse(storedConsent) : null;
        } catch(e) {}

        gtag('consent', 'default', {
          'analytics_storage': consent && consent.statistics ? 'granted' : 'denied',
          'ad_storage': consent && consent.marketing ? 'granted' : 'denied',
          'ad_user_data': consent && consent.marketing ? 'granted' : 'denied',
          'ad_personalization': consent && consent.marketing ? 'granted' : 'denied'
        });
      </script>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script is:inline define:vars={{ gaMeasurementId }}>
        gtag('js', new Date());
        gtag('config', gaMeasurementId);

        document.addEventListener('astro:page-load', () => {
          if (typeof gtag === 'function') {
            gtag('event', 'page_view', {
              page_path: window.location.pathname,
              page_location: window.location.href
            });
          }
        });
      </script>
    </>
  )}
</head>

<body class="flex flex-col min-h-screen bg-bg text-text font-['Times_New_Roman',Times,serif]">
  <nav class="sticky top-0 z-[200] bg-white/95 backdrop-blur-[10px] border-b border-border h-[64px] sm:h-[72px] flex items-center">
    <div class="max-w-content mx-auto w-full px-4 sm:px-8 flex justify-between items-center gap-4">
      <a href={url('/')} class="text-[1.1rem] sm:text-2xl font-extrabold text-[#16a34a] no-underline tracking-[-0.02em] whitespace-nowrap shrink-0">🎾 Tennis Club</a>
      <!-- Linki nawigacyjne — desktop only -->
      <div class="hidden lg:flex gap-6 text-[0.875rem] font-medium text-[#475569]">
        <a href={url('/dla-klubow')} class="hover:text-[#16a34a] transition-colors no-underline">Dla klubów</a>
        <a href={url('/rezerwacje-kortow')} class="hover:text-[#16a34a] transition-colors no-underline">Rezerwacje</a>
        <a href={url('/turnieje-ligi-rankingi')} class="hover:text-[#16a34a] transition-colors no-underline">Turnieje</a>
        <a href={url('/cennik')} class="hover:text-[#16a34a] transition-colors no-underline">Cennik</a>
      </div>
      <div class="nav-actions shrink-0">
        {currentUser ? (
          <a href={url('/dashboard')} class="tc-btn tc-btn-primary tc-btn-sm">Panel główny</a>
        ) : (
          <div class="relative flex items-center">
            <!-- Desktop: Dwa przyciski -->
            <div class="hidden md:flex gap-[0.75rem]">
              <a href={url('/login')} class="tc-btn tc-btn-secondary tc-btn-sm md:h-[40px] md:px-5 md:text-[0.875rem]">Zaloguj się</a>
              <a href={url('/register')} class="tc-btn tc-btn-primary tc-btn-sm md:h-[40px] md:px-5 md:text-[0.875rem]">Zarejestruj się</a>
            </div>
            
            <!-- Mobile: Jeden przycisk z menu -->
            <div class="flex md:hidden relative">
              <button id="mobile-auth-btn" class="tc-btn tc-btn-primary tc-btn-sm max-sm:!py-[6px] max-sm:!px-[12px] max-sm:!text-[0.75rem]">
                Logowanie ▾
              </button>
              <div id="mobile-auth-dropdown" class="auth-dropdown absolute top-full right-0 mt-2 w-48 bg-surface border border-border shadow-lg rounded-md overflow-hidden z-[300] hidden flex-col [&.is-open]:flex divide-y divide-border">
                <a href={url('/login')} class="px-4 py-2.5 sm:py-3 text-[0.825rem] sm:text-sm text-text hover:bg-bg transition-colors no-underline">Zaloguj się</a>
                <a href={url('/register')} class="px-4 py-2.5 sm:py-3 text-[0.825rem] sm:text-sm text-text hover:bg-bg transition-colors no-underline">Zarejestruj się</a>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </nav>

  <script>
    const btn = document.getElementById('mobile-auth-btn');
    const dropdown = document.getElementById('mobile-auth-dropdown');
    
    if (btn && dropdown) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('is-open');
      });
      
      // Zamknij menu po kliknięciu poza nie
      document.addEventListener('click', () => {
        dropdown.classList.remove('is-open');
      });
    }
  </script>

  <main class="flex-1 flex flex-col">
    <slot />
  </main>

  <footer class="px-4 pt-8 pb-4 bg-bg-secondary border-t border-border text-[0.875rem]">
    <div class="max-w-content mx-auto">
      <!-- Kolumny linków -->
      <div class="flex flex-wrap gap-x-12 gap-y-6 mb-6">
        <div>
          <div class="font-semibold text-[#0f172a] mb-2 text-[0.8rem] uppercase tracking-wide">Portal</div>
          <ul class="space-y-1.5 list-none p-0 m-0">
            <li><a href={url('/dla-klubow')} class="text-text-muted hover:text-[#16a34a] no-underline transition-colors">Dla klubów</a></li>
            <li><a href={url('/rezerwacje-kortow')} class="text-text-muted hover:text-[#16a34a] no-underline transition-colors">Rezerwacje kortów</a></li>
            <li><a href={url('/turnieje-ligi-rankingi')} class="text-text-muted hover:text-[#16a34a] no-underline transition-colors">Turnieje i rankingi</a></li>
            <li><a href={url('/cennik')} class="text-text-muted hover:text-[#16a34a] no-underline transition-colors">Cennik</a></li>
            <li><a href={url('/kontakt')} class="text-text-muted hover:text-[#16a34a] no-underline transition-colors">Kontakt</a></li>
          </ul>
        </div>
        <div>
          <div class="font-semibold text-[#0f172a] mb-2 text-[0.8rem] uppercase tracking-wide">Konto</div>
          <ul class="space-y-1.5 list-none p-0 m-0">
            <li><a href={url('/register')} class="text-text-muted hover:text-[#16a34a] no-underline transition-colors">Zarejestruj się</a></li>
            <li><a href={url('/login')} class="text-text-muted hover:text-[#16a34a] no-underline transition-colors">Zaloguj się</a></li>
          </ul>
        </div>
        <div>
          <div class="font-semibold text-[#0f172a] mb-2 text-[0.8rem] uppercase tracking-wide">Prawne</div>
          <ul class="space-y-1.5 list-none p-0 m-0">
            <li><a href={url('/polityka-prywatnosci')} class="text-text-muted hover:text-[#16a34a] no-underline transition-colors">Polityka prywatności</a></li>
            <li><a href={url('/regulamin')} class="text-text-muted hover:text-[#16a34a] no-underline transition-colors">Regulamin</a></li>
          </ul>
        </div>
      </div>
      <!-- Copyright -->
      <div class="border-t border-border pt-3 text-center text-text-muted text-[0.8rem]">
        &copy; {new Date().getFullYear()} Tennis Club / portal.raketon.pl. Wszystkie prawa zastrzeżone.
      </div>
    </div>
  </footer>
  <CookieBanner />
</body>
</html>
