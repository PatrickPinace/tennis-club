---
import '@/styles/global.css';
import { url } from '@/lib/url';
import { getCurrentUser } from '@/lib/api';
import CookieBanner from '@/components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  /** Opcjonalny JSON-LD string (serialize przed przekazaniem) — wstrzykiwany do <head> */
  jsonLd?: string;
}

const {
  title = 'Tennis Club',
  description = 'Portal tenisowy — rezerwacje kortów, turnieje, ligi i rankingi dla klubów i graczy.',
  canonical,
  ogImage,
  jsonLd,
} = Astro.props;

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const currentUser = await getCurrentUser(sessionCookie);

const SITE = import.meta.env.PUBLIC_SITE_URL ?? 'https://portal.raketon.pl';
// Strip ASTRO_BASE prefix z pathname żeby canonical był zawsze względem domeny root
const BASE = import.meta.env.BASE_URL ?? '/';
const rawPath = Astro.url.pathname;
const cleanPath = BASE !== '/' ? rawPath.replace(new RegExp('^' + BASE.replace(/\/$/, '')), '') || '/' : rawPath;
const canonicalUrl = canonical ?? (SITE + cleanPath);
const ogImageUrl = ogImage ?? `${SITE}/og-default.png`;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? '';
const fullTitle = `${title} — Tennis Club`;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
---

<!doctype html>
<html lang="pl" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="Tennis Club" />

  <!-- Twitter / X card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="icon" href={url('/favicon.ico')} type="image/x-icon" />

  <!-- Structured data — JSON-LD (opcjonalny, przekazywany przez prop) -->
  {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

  <!-- Plausible analytics — tylko gdy PUBLIC_PLAUSIBLE_DOMAIN ustawiony (prod) -->
  {plausibleDomain && (
    <script
      is:inline
      defer
      data-domain={plausibleDomain}
      src="https://plausible.io/js/script.js"
    />
  )}

  {gaMeasurementId && (
    <>
      <script is:inline define:vars={{ gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        // Jawne przypisanie do window, aby funkcja była dostępna globalnie
        window.gtag = window.gtag || function() {
          window.dataLayer.push(arguments);
        };

        const storedConsent = localStorage.getItem('tc_cookie_consent');
        let consent = null;
        try {
          consent = storedConsent ? JSON.parse(storedConsent) : null;
        } catch(e) {}

        // Wywołanie default przed załadowaniem gtag.js
        window.gtag('consent', 'default', {
          'analytics_storage': consent && consent.statistics ? 'granted' : 'denied',
          'ad_storage': consent && consent.marketing ? 'granted' : 'denied',
          'ad_user_data': consent && consent.marketing ? 'granted' : 'denied',
          'ad_personalization': consent && consent.marketing ? 'granted' : 'denied'
        });
      </script>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script is:inline define:vars={{ gaMeasurementId }}>
        gtag('js', new Date());
        gtag('config', gaMeasurementId);

        document.addEventListener('astro:page-load', () => {
          if (typeof gtag === 'function') {
            gtag('event', 'page_view', {
              page_path: window.location.pathname,
              page_location: window.location.href
            });
          }
        });
      </script>
    </>
  )}
</head>

<body class="flex flex-col min-h-screen bg-bg text-text font-['Times_New_Roman',Times,serif]">
  <nav class="sticky top-0 z-[200] bg-[#111827]/95 backdrop-blur-[10px] border-b border-gray-800 h-[64px] sm:h-[72px] flex items-center">
    <div class="max-w-content mx-auto w-full px-4 sm:px-8 flex justify-between items-center gap-4">
      <a href={url('/')} class="flex items-center gap-3 no-underline shrink-0 group">
        <div class="w-9 h-9 rounded-[10px] bg-[#5a7d22] text-white flex items-center justify-center shrink-0 shadow-sm transition-transform duration-200 group-hover:scale-105" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M6.3 6.3c2.4 2.4 2.4 9 0 11.4M17.7 6.3c-2.4 2.4-2.4 9 0 11.4"/>
          </svg>
        </div>
        <span class="text-[1.35rem] font-black text-white tracking-[-0.02em] font-serif leading-none">Tennis Club</span>
      </a>
      <!-- Linki nawigacyjne — desktop only -->
      <div class="hidden lg:flex gap-6 text-[0.875rem] font-sans font-medium text-gray-300">
        <a href={url('/dla-klubow')} class="hover:text-[#5a7d22] transition-colors no-underline">Dla klubów</a>
        <a href={url('/rezerwacje-kortow')} class="hover:text-[#5a7d22] transition-colors no-underline">Rezerwacje</a>
        <a href={url('/turnieje-ligi-rankingi')} class="hover:text-[#5a7d22] transition-colors no-underline">Turnieje</a>
        <a href={url('/cennik')} class="hover:text-[#5a7d22] transition-colors no-underline">Cennik</a>
      </div>
      <div class="nav-actions shrink-0">
        {currentUser ? (
          <a href={url('/dashboard')} class="tc-btn tc-btn-secondary tc-btn-sm md:h-[40px] md:px-5 md:text-[0.875rem] !bg-gray-800/80 !border-gray-700 !text-gray-200 hover:!bg-gray-700">Panel główny</a>
        ) : (
          <div class="relative flex items-center">
            <!-- Desktop: Dwa przyciski -->
            <div class="hidden md:flex gap-[0.75rem]">
              <a href={url('/login')} class="tc-btn tc-btn-secondary tc-btn-sm md:h-[40px] md:px-5 md:text-[0.875rem] !bg-gray-800/80 !border-gray-700 !text-gray-200 hover:!bg-gray-700">Zaloguj się</a>
              <a href={url('/register')} class="tc-btn tc-btn-primary tc-btn-sm md:h-[40px] md:px-5 md:text-[0.875rem] !bg-[#5a7d22] !border-[#5a7d22] !text-white hover:!bg-[#47621a]">Zarejestruj się</a>
            </div>
            
            <!-- Mobile: Jeden przycisk z menu (sama ikona) -->
            <div class="flex md:hidden relative">
              <button id="mobile-auth-btn" class="w-9 h-9 rounded-full bg-[#5a7d22] text-white flex items-center justify-center hover:bg-[#47621a] focus:outline-none transition-all duration-200 shrink-0" aria-label="Konto użytkownika">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </button>
              <div id="mobile-auth-dropdown" class="auth-dropdown absolute top-full right-0 mt-2 w-48 bg-gray-900 border border-gray-800 shadow-lg rounded-md overflow-hidden z-[300] hidden flex-col [&.is-open]:flex divide-y divide-gray-800">
                <a href={url('/login')} class="px-4 py-2.5 sm:py-3 text-[0.825rem] sm:text-sm text-gray-200 hover:bg-gray-800 transition-colors no-underline">Zaloguj się</a>
                <a href={url('/register')} class="px-4 py-2.5 sm:py-3 text-[0.825rem] sm:text-sm text-gray-200 hover:bg-gray-800 transition-colors no-underline">Zarejestruj się</a>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </nav>

  <script>
    const btn = document.getElementById('mobile-auth-btn');
    const dropdown = document.getElementById('mobile-auth-dropdown');
    
    if (btn && dropdown) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('is-open');
      });
      
      // Zamknij menu po kliknięciu poza nie
      document.addEventListener('click', () => {
        dropdown.classList.remove('is-open');
      });
    }
  </script>

  <main class="flex-1 flex flex-col">
    <slot />
  </main>

  <footer class="px-6 py-16 bg-[#111827] border-t border-gray-800 text-[0.875rem] font-sans text-gray-300">
    <div class="max-w-content mx-auto">
      <!-- Główna siatka stopek -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-12">
        
        <!-- Kolumna 1: Brand i Opis -->
        <div class="lg:col-span-2 flex flex-col gap-5">
          <a href={url('/')} class="flex items-center gap-3 no-underline shrink-0 group w-fit">
            <div class="w-9 h-9 rounded-[10px] bg-[#5a7d22] text-white flex items-center justify-center shrink-0 shadow-sm transition-transform duration-200 group-hover:scale-105" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M6.3 6.3c2.4 2.4 2.4 9 0 11.4M17.7 6.3c-2.4 2.4-2.4 9 0 11.4"/>
              </svg>
            </div>
            <span class="text-[1.35rem] font-black text-white tracking-[-0.02em] font-serif leading-none">Tennis Club</span>
          </a>
          <p class="text-gray-400 leading-[1.65] max-w-[36ch] m-0">
            Nowoczesny portal dla miłośników tenisa. Ułatwiamy rezerwację kortów, łączymy graczy i rozwijamy lokalne społeczności sportowe.
          </p>
          <div class="flex flex-col gap-2.5 mt-2">
            <div class="flex items-center gap-2.5 text-gray-400 hover:text-[#5a7d22] transition-colors group w-fit">
              <svg class="shrink-0 transition-transform group-hover:scale-110" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <a href="mailto:itprima@medi3.pl" class="text-[0.85rem] text-gray-400 group-hover:text-[#5a7d22] no-underline font-medium transition-colors">itprima@medi3.pl</a>
            </div>
          </div>
        </div>

        <!-- Kolumna 2: Portal -->
        <div class="flex flex-col gap-4">
          <div class="font-bold text-white text-[0.75rem] uppercase tracking-[0.12em]">Portal</div>
          <ul class="space-y-3 list-none p-0 m-0">
            <li><a href={url('/dla-klubow')} class="text-gray-400 hover:text-[#5a7d22] no-underline transition-all hover:translate-x-1 inline-block transform duration-150">Dla klubów</a></li>
            <li><a href={url('/rezerwacje-kortow')} class="text-gray-400 hover:text-[#5a7d22] no-underline transition-all hover:translate-x-1 inline-block transform duration-150">Rezerwacje kortów</a></li>
            <li><a href={url('/turnieje-ligi-rankingi')} class="text-gray-400 hover:text-[#5a7d22] no-underline transition-all hover:translate-x-1 inline-block transform duration-150">Turnieje i rankingi</a></li>
            <li><a href={url('/cennik')} class="text-gray-400 hover:text-[#5a7d22] no-underline transition-all hover:translate-x-1 inline-block transform duration-150">Cennik</a></li>
            <li><a href={url('/kontakt')} class="text-gray-400 hover:text-[#5a7d22] no-underline transition-all hover:translate-x-1 inline-block transform duration-150">Kontakt</a></li>
          </ul>
        </div>

        <!-- Kolumna 3: Konto -->
        <div class="flex flex-col gap-4">
          <div class="font-bold text-white text-[0.75rem] uppercase tracking-[0.12em]">Konto</div>
          <ul class="space-y-3 list-none p-0 m-0">
            <li><a href={url('/register')} class="text-gray-400 hover:text-[#5a7d22] no-underline transition-all hover:translate-x-1 inline-block transform duration-150">Zarejestruj się</a></li>
            <li><a href={url('/login')} class="text-gray-400 hover:text-[#5a7d22] no-underline transition-all hover:translate-x-1 inline-block transform duration-150">Zaloguj się</a></li>
          </ul>
        </div>

        <!-- Kolumna 4: Prawne -->
        <div class="flex flex-col gap-4">
          <div class="font-bold text-white text-[0.75rem] uppercase tracking-[0.12em]">Prawne</div>
          <ul class="space-y-3 list-none p-0 m-0">
            <li><a href={url('/polityka-prywatnosci')} class="text-gray-400 hover:text-[#5a7d22] no-underline transition-all hover:translate-x-1 inline-block transform duration-150">Polityka prywatności</a></li>
            <li><a href={url('/regulamin')} class="text-gray-400 hover:text-[#5a7d22] no-underline transition-all hover:translate-x-1 inline-block transform duration-150">Regulamin</a></li>
          </ul>
        </div>

      </div>

      <!-- Dolny panel: Copyright -->
      <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-gray-500 text-[0.8rem]">
        <div>
          &copy; {new Date().getFullYear()} Tennis Club / portal.raketon.pl. Wszystkie prawa zastrzeżone.
        </div>
        <div class="flex gap-4">
          <span class="text-gray-600">Stworzone z pasją do tenisa</span>
        </div>
      </div>
    </div>
  </footer>
  <CookieBanner />
</body>
</html>
