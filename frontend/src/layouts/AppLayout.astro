---
import Sidebar from '@/components/Sidebar.astro';
import Topbar from '@/components/Topbar.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import GlobalMatchModals from '@/components/GlobalMatchModals.tsx';
import '@/styles/global.css';
import { url } from '@/lib/url';
import { getCurrentUser, type CurrentUser } from '@/lib/api';

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? '';
const plausibleScriptUrl = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL ?? 'https://plausible.io/js/script.js';
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';

interface Props {
  title?: string;
  greeting?: string;
  greetingSub?: string;
  showSearch?: boolean;
  showCta?: boolean;
  ctaLabel?: string;
  ctaLabelMobile?: string;
  ctaHref?: string;
  /** Liczba nieprzeczytanych powiadomień z Django API (null = niezalogowany) */
  unreadCount?: number | null;
}

const {
  title = 'Tennis Club',
  greeting,
  greetingSub,
  showSearch = true,
  showCta = false,
  ctaLabel,
  ctaLabelMobile,
  ctaHref,
  unreadCount = null,
} = Astro.props;

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const currentUser = await getCurrentUser(sessionCookie);

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Tennis Club</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href={url('/favicon.ico')} type="image/x-icon" />
  <!-- Adres Django API — używany przez client-side JS do fetchów -->
  <!-- W dev bez PUBLIC_API_BASE_URL: pusty string = relative URL → Vite proxy /api/* → :8000 -->
  <!-- W produkcji: ustaw PUBLIC_API_BASE_URL na adres Django, np. https://api.example.com -->
  <meta name="api-base" content={import.meta.env.PUBLIC_API_BASE_URL ?? ''} />
  <!-- Referrer-Policy: same-origin — wymagane przez Django CSRF Referer check dla HTTPS -->
  <meta name="referrer" content="same-origin" />

  {plausibleDomain && (
    <script is:inline defer data-domain={plausibleDomain} src={plausibleScriptUrl} />
  )}

  <!-- Zapobiegaj FOIT: ustaw motyw PRZED renderowaniem -->
  <script is:inline>
    (function () {
      var t = localStorage.getItem('tc-theme') || 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>

  {gaMeasurementId && (
    <>
      <script is:inline define:vars={{ gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        // Jawne przypisanie do window, aby funkcja była dostępna globalnie
        window.gtag = window.gtag || function() {
          window.dataLayer.push(arguments);
        };

        const storedConsent = localStorage.getItem('tc_cookie_consent');
        let consent = null;
        try {
          consent = storedConsent ? JSON.parse(storedConsent) : null;
        } catch(e) {}

        // Wywołanie default przed załadowaniem gtag.js
        window.gtag('consent', 'default', {
          'analytics_storage': consent && consent.statistics ? 'granted' : 'denied',
          'ad_storage': consent && consent.marketing ? 'granted' : 'denied',
          'ad_user_data': consent && consent.marketing ? 'granted' : 'denied',
          'ad_personalization': consent && consent.marketing ? 'granted' : 'denied'
        });
      </script>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script is:inline define:vars={{ gaMeasurementId }}>
        gtag('js', new Date());
        gtag('config', gaMeasurementId);

        document.addEventListener('astro:page-load', () => {
          if (typeof gtag === 'function') {
            gtag('event', 'page_view', {
              page_path: window.location.pathname,
              page_location: window.location.href
            });
          }
        });
      </script>
    </>
  )}
</head>

<body>
  <a href="#main-content" class="skip-link">Przejdź do treści</a>

  <Sidebar currentPath={currentPath} currentUser={currentUser} />

  <div class="app-main">
    <Topbar
      greeting={greeting}
      greetingSub={greetingSub}
      showSearch={showSearch}
      showCta={showCta}
      ctaLabel={ctaLabel}
      ctaLabelMobile={ctaLabelMobile}
      ctaHref={ctaHref}
      unreadCount={unreadCount}
      currentUser={currentUser}
    />

    <main id="main-content" class="app-content">
      <slot />
    </main>
  </div>

  <!-- Global JS: theme toggle, sidebar toggle, notifications -->
  <script is:inline>
    /* ── Theme ── */
    function toggleTheme() {
      var current = document.documentElement.getAttribute('data-theme') || 'light';
      var next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('tc-theme', next);
      _updateThemeIcon(next);
    }

    function _updateThemeIcon(theme) {
      var d = document.getElementById('theme-icon-dark');
      var l = document.getElementById('theme-icon-light');
      if (!d || !l) return;
      d.style.display = theme === 'dark'  ? 'block' : 'none';
      l.style.display = theme === 'light' ? 'block' : 'none';
    }

    (function () { _updateThemeIcon(localStorage.getItem('tc-theme') || 'light'); })();

    /* ── Mobile sidebar ── */
    function toggleSidebar() {
      var s = document.getElementById('app-sidebar');
      var o = document.getElementById('sidebar-overlay');
      if (s) s.classList.toggle('is-open');
      if (o) o.classList.toggle('is-visible');
    }

    if (window.innerWidth <= 1024) {
      var tog = document.getElementById('sidebar-toggle');
      if (tog) tog.style.display = 'flex';
    }

    /* ── Notifications — pełna implementacja w Topbar.astro <script> ── */
    /* Stuby tylko jako fallback zanim moduł Topbar się załaduje */
    if (typeof window.toggleNotifPanel === 'undefined') {
      window.toggleNotifPanel = function() {};
    }
    if (typeof window.readAllNotif === 'undefined') {
      window.readAllNotif = function() {};
    }

    /* ── Global "+ Mecz" action sheet ── */
    var addMatchSheet = null;

    function closeAddMatchSheet() {
      if (addMatchSheet) {
        addMatchSheet.remove();
        addMatchSheet = null;
        document.removeEventListener('click', onDocClickCloseSheet);
      }
    }

    function onDocClickCloseSheet(e) {
      if (addMatchSheet && !addMatchSheet.contains(e.target) && !e.target.closest('.topbar__cta')) {
        closeAddMatchSheet();
      }
    }

    function openAddMatchSheet(anchor) {
      closeAddMatchSheet();
      var sheet = document.createElement('div');
      var isMobile = window.matchMedia('(max-width: 640px)').matches;
      sheet.className = 'add-match-sheet' + (isMobile ? ' add-match-sheet--mobile' : '');
      sheet.innerHTML = `
        <button type="button" class="add-match-sheet__item" data-action="friendly">
          <span class="add-match-sheet__icon" aria-hidden="true">🎾</span>
          <span>Mecz towarzyski</span>
        </button>
        <button type="button" class="add-match-sheet__item" data-action="tournament">
          <span class="add-match-sheet__icon" aria-hidden="true">🏆</span>
          <span>Mecz turniejowy</span>
        </button>
      `;
      document.body.appendChild(sheet);

      if (!isMobile) {
        var rect = anchor.getBoundingClientRect();
        sheet.style.top = (rect.bottom + window.scrollY + 6) + 'px';
        sheet.style.right = Math.max(8, window.innerWidth - rect.right) + 'px';
      }

      sheet.querySelector('[data-action="friendly"]').addEventListener('click', function() {
        closeAddMatchSheet();
        window.dispatchEvent(new CustomEvent('open-add-match-modal'));
      });
      sheet.querySelector('[data-action="tournament"]').addEventListener('click', function() {
        closeAddMatchSheet();
        window.dispatchEvent(new CustomEvent('open-tournament-matches-modal'));
      });

      addMatchSheet = sheet;
      setTimeout(function() { document.addEventListener('click', onDocClickCloseSheet); }, 0);
    }

    document.addEventListener('click', function(e) {
      var cta = e.target.closest('.topbar__cta');
      if (cta && cta.getAttribute('href') === '#add-match') {
        e.preventDefault();
        if (addMatchSheet) closeAddMatchSheet();
        else openAddMatchSheet(cta);
      }
    });
  </script>
  <GlobalMatchModals client:load myId={currentUser?.id} addMatchUrl={url('/matches')} />
  <CookieBanner />
</body>
</html>

<style>
  /* ── App main area ─────────────────────────────────────────────────────── */
  .app-main {
    margin-left: var(--sidebar-width);
    min-width: 0;
    display: flex; flex-direction: column;
    min-height: 100vh;
    background: var(--tc-bg);
    position: relative;
  }

  /* Pseudoelement obsługujący połączone tło i gradienty */
  .app-main::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-repeat: no-repeat;
    background-position: top center;
    background-size: cover;
    background-attachment: fixed;
    transition: filter 0.3s ease, background 0.3s ease;
  }

  /* Zastosowanie tła i nakładek dla motywu jasnego */
  :global([data-theme="light"]) .app-main::before {
    background-image: 
      radial-gradient(circle at center, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.15) 100%),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.65) 100%),
      url('/static/img/background_01.png');
    filter: grayscale(1);
    opacity: 0.45;
  }

  /* Zastosowanie tła dla motywu ciemnego (subtelna tekstura o bardzo niskim kryciu) */
  :global([data-theme="dark"]) .app-main::before {
    background-image: url('/static/img/background_01.png');
    filter: invert(1);
    opacity: 0.06;
  }

  /* Zapewnienie, że zawartość wyświetla się nad nakładką tła */
  .app-main > * {
    position: relative;
    z-index: 1;
  }

  /* Pseudoelement dla ozdobnego blasku (glow) */
  .app-main::after {
    content: "";
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 500px;
    height: 300px;
    border-radius: 50%;
    filter: blur(100px);
    z-index: 0;
    pointer-events: none;
    transition: background 0.3s ease;
  }

  /* Blask w motywie jasnym (neutralny szary) */
  :global([data-theme="light"]) .app-main::after {
    background: rgba(200, 200, 200, 0.12);
  }

  /* Blask w motywie ciemnym (neonowa limonka tenisowa) */
  :global([data-theme="dark"]) .app-main::after {
    background: rgba(200, 241, 97, 0.08);
  }

  .app-content {
    flex: 1;
    padding: 28px var(--content-px);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  @media (max-width: 1024px) {
    .app-main { margin-left: 0; }
  }

  @media (max-width: 768px) {
    .app-content { padding: 20px 16px; }
  }

  @media (max-width: 480px) {
    .app-content { padding: 16px 14px; }
  }

  /* ── Global "+ Mecz" action sheet ── */
  :global(.add-match-sheet) {
    position: fixed;
    z-index: 210;
    min-width: 220px;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: var(--radius-md, 10px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25), 0 2px 8px rgba(0,0,0,0.15);
    overflow: hidden;
    animation: add-match-sheet-enter 0.15s ease;
  }
  @keyframes add-match-sheet-enter {
    from { opacity: 0; transform: translateY(-6px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  :global(.add-match-sheet--mobile) {
    right: 8px;
    top: 56px;
    width: max-content;
    max-width: calc(100vw - 16px);
    min-width: 0;
  }

  :global(.add-match-sheet__item) {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 16px;
    background: none;
    border: none;
    border-bottom: 1px solid var(--tc-card-border);
    color: var(--tc-ink);
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 0.1s;
  }
  :global(.add-match-sheet__item:last-child) { border-bottom: none; }
  :global(.add-match-sheet__item:hover),
  :global(.add-match-sheet__item:active) { background: var(--tc-overlay); }

  :global(.add-match-sheet__icon) {
    font-size: 1rem;
    flex-shrink: 0;
  }
</style>
