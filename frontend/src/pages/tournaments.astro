---
// tournaments.astro — lista turniejów połączona z Django API
// GET /api/tournaments/list/   (IsAuthenticatedOrReadOnly — publiczny)
// GET /api/tournaments/mine/   (IsAuthenticated — opcjonalny, graceful fallback)
// GET /api/tournaments/{id}/detail/  (publiczny — featured card standings)
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import TournamentsPage from '@/components/TournamentsPage.tsx';
import {
  getTournamentsList,
  getMyTournaments,
  getTournamentDetail,
  getCurrentUser,
  type TournamentListEntry,
  type TournamentDetail,
  type RRStandingRow,
  type CurrentUser,
} from '@/lib/api';
import { url } from '@/lib/url';

// ── Auth ────────────────────────────────────────────────────────────────────
const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const currentUser: CurrentUser | null = await getCurrentUser(sessionCookie);

// ── Dane z API ──────────────────────────────────────────────────────────────
let tournaments: TournamentListEntry[] = [];
let isLive = false;
let myTournamentIds: Set<number> = new Set();

try {
  const data = await getTournamentsList();
  if (data && data.length > 0) {
    tournaments = data;
    isLive = true;
  }
} catch (e) {
  console.warn('[tournaments] API error, using fallback demo data:', e);
}

if (currentUser) {
  try {
    const mine = await getMyTournaments(sessionCookie);
    myTournamentIds = new Set(mine.map(t => t.id));
  } catch {}
}


// ── Stałe mapy ──────────────────────────────────────────────────────────────
const TYPE_LABEL: Record<string, string> = {
  SGL: 'Eliminacja pojedyncza', DBE: 'Eliminacja podwójna',
  RND: 'Round Robin', LDR: 'Drabinka', AMR: 'Americano', SWS: 'System szwajcarski',
};

function fmtDate(iso: string | null): string {
  if (!iso) return '—';
  try {
    return new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
  } catch { return iso; }
}

// ── Segmentacja ─────────────────────────────────────────────────────────────
const publicTournaments = tournaments.filter(t => t.status !== 'DRF');
const running = publicTournaments.filter(t => t.status === 'ACT');
const registration = publicTournaments.filter(t => t.status === 'REG');
const finished = publicTournaments.filter(t => t.status === 'FIN' || t.status === 'CNC');
const myCount = currentUser ? publicTournaments.filter(t => myTournamentIds.has(t.id)).length : null;

// ── Featured tournaments (all running) ──────────────────────────────────────
const featuredList = [];
// Put user's tournament first, then the rest
const sortedRunning = [
  ...running.filter(t => myTournamentIds.has(t.id)),
  ...running.filter(t => !myTournamentIds.has(t.id)),
];

for (const entry of sortedRunning) {
  let standings: { displayName: string; points: number; isMe: boolean }[] = [];
  try {
    const detail = await getTournamentDetail(entry.id);
    if (detail?.standings) {
      standings = detail.standings.slice(0, 4).map(s => ({
        displayName: s.display_name,
        points: Math.round(Number(s.points)),
        isMe: !!(currentUser && s.display_name.toLowerCase().includes(currentUser.last_name?.toLowerCase() ?? '___NOMATCH___')),
      }));
    }
  } catch {}

  featuredList.push({
    id: entry.id,
    name: entry.name,
    type: TYPE_LABEL[entry.tournament_type] ?? entry.tournament_type,
    participants: entry.participant_count,
    total: entry.matches_progress?.total ?? 0,
    done: entry.matches_progress?.done ?? 0,
    href: url(`/tournaments/${entry.id}`),
    isMine: myTournamentIds.has(entry.id),
    standings,
  });
}

// ── Map rows ────────────────────────────────────────────────────────────────
const tournamentRows = publicTournaments.map(t => ({
  id: t.id,
  name: t.name,
  status: t.status,
  tournamentType: t.tournament_type,
  participantCount: t.participant_count,
  startDate: fmtDate(t.start_date),
  joined: myTournamentIds.has(t.id),
  href: url(`/tournaments/${t.id}`),
  matchesProgress: t.matches_progress,
}));
---

<AppLayout
  title="Turnieje"
  greeting="Turnieje"
  greetingSub={`${running.length} aktywnych · ${registration.length} do dołączenia`}
  showSearch={false}
  showCta={true}
  ctaLabel="+ Utwórz turniej"
  ctaLabelMobile="+ Turniej"
  ctaHref={url('/tournaments/create')}
>
  <TournamentsPage
    client:load
    tournaments={tournamentRows}
    featured={featuredList}
    stats={{ running: running.length, registration: registration.length, myCount, finished: finished.length }}
    createUrl={url('/tournaments/create')}
  />
</AppLayout>

<style is:global>
  /* ── Mobile CTA ─────────────────────────────────────────────────────────── */
  .tr-mobile-cta {
    display: none;
    margin-bottom: 12px;
  }

  .tr-mobile-cta__btn {
    display: inline-flex; align-items: center;
    padding: 0 16px; height: 38px;
    background: var(--tc-accent); color: var(--tc-accent-ink);
    border-radius: 8px;
    font-size: 0.875rem; font-weight: 700;
    text-decoration: none; white-space: nowrap;
    box-shadow: 0 2px 8px var(--tc-accent-glow);
  }

  @media (max-width: 640px) {
    .tr-mobile-cta { display: block; }
  }

  /* ── Stat cards ──────────────────────────────────────────────────────────── */
  .tr-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 12px;
  }

  .tr-stat-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: background 0.25s, border-color 0.25s;
  }

  .tr-stat-card--accent { border-color: var(--tc-accent-border); }

  .tr-stat-label {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tc-muted);
  }

  .tr-stat-val {
    font-size: 2rem;
    font-weight: 800;
    color: var(--tc-ink);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }

  .tr-stat-sub {
    font-size: 0.72rem;
    color: var(--tc-muted);
  }

  /* ── Featured tournament card ──────────────────────────────────────────── */
  .tr-featured {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-accent-border);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    margin-bottom: 12px;
    transition: background 0.25s, border-color 0.25s;
  }

  .tr-featured__accent-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--tc-accent), var(--tc-accent-soft));
  }

  .tr-featured__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
  }

  .tr-featured__info {
    padding: 22px 24px;
  }

  .tr-featured__top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .tr-featured__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--tc-accent-soft);
    border: 1px solid var(--tc-accent-border);
    color: var(--tc-accent);
  }

  .tr-featured__badge::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--tc-accent);
  }

  .tr-featured__tag {
    font-size: 0.72rem;
    color: var(--tc-muted);
  }

  .tr-feat-nav {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .tr-feat-nav__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px; height: 26px;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 6px;
    color: var(--tc-sub);
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .tr-feat-nav__btn:hover {
    background: var(--tc-overlay);
    color: var(--tc-ink);
  }

  .tr-feat-nav__counter {
    font-size: 0.68rem;
    color: var(--tc-muted);
    font-variant-numeric: tabular-nums;
    min-width: 28px;
    text-align: center;
  }

  .tr-featured__name {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--tc-ink);
    letter-spacing: -0.03em;
    margin: 0 0 6px;
    line-height: 1.2;
  }

  .tr-featured__meta {
    font-size: 0.78rem;
    color: var(--tc-muted);
    margin-bottom: 20px;
  }

  .tr-featured__progress { margin-bottom: 20px; }

  .tr-progress-bar {
    height: 6px;
    background: var(--tc-chip-bg);
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .tr-progress-bar__fill {
    height: 100%;
    background: var(--tc-accent);
    box-shadow: 0 0 8px var(--tc-accent-glow);
    border-radius: 99px;
    transition: width 0.3s;
  }

  .tr-progress-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--tc-muted);
  }

  .tr-progress-val {
    font-family: var(--font-mono-plex);
    font-weight: 600;
    color: var(--tc-ink);
  }

  .tr-featured__actions {
    display: flex;
    gap: 8px;
  }

  .tr-btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 8px 18px; border-radius: 8px;
    background: var(--tc-accent); color: var(--tc-accent-ink);
    font-size: 0.84rem; font-weight: 700;
    text-decoration: none; transition: opacity 0.15s;
  }
  .tr-btn-primary:hover { opacity: 0.88; }

  .tr-btn-secondary {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 8px 18px; border-radius: 8px;
    background: transparent;
    border: 1px solid var(--tc-card-border);
    color: var(--tc-ink);
    font-size: 0.84rem; font-weight: 600;
    text-decoration: none; transition: background 0.15s;
  }
  .tr-btn-secondary:hover { background: var(--tc-overlay); }

  /* ── Standings ──────────────────────────────────────────────────────────── */
  .tr-featured__standings {
    padding: 22px 24px;
    border-left: 1px solid var(--tc-card-border);
    background: var(--tc-card-bg-2);
  }

  .tr-standings-label {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tc-muted);
    margin-bottom: 12px;
  }

  .tr-standings-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tr-standing-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 7px;
    transition: background 0.1s;
  }

  .tr-standing-row--me {
    background: var(--tc-accent-soft);
    border: 1px solid var(--tc-accent-border);
  }

  .tr-standing-pos {
    width: 22px; height: 22px;
    border-radius: 5px;
    background: var(--tc-chip-bg);
    color: var(--tc-sub);
    font-size: 0.72rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .tr-standing-pos--first {
    background: var(--tc-accent);
    color: var(--tc-accent-ink);
  }

  .tr-standing-name {
    flex: 1;
    min-width: 0;
    font-size: 0.82rem;
    color: var(--tc-ink);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tr-standing-row--me .tr-standing-name { font-weight: 600; }

  .tr-standing-me {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--tc-accent);
    margin-left: 6px;
  }

  .tr-standing-pts {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--tc-ink);
    font-variant-numeric: tabular-nums;
  }

  .tr-standing-pts--me { color: var(--tc-accent); }

  .tr-standing-pkt {
    font-size: 0.62rem;
    color: var(--tc-muted);
  }

  /* ── Table card ────────────────────────────────────────────────────────── */
  .tr-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    transition: background 0.25s, border-color 0.25s;
  }

  .tr-card__header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tc-card-border);
    flex-wrap: wrap;
  }

  .tr-card__title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tr-card__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--tc-accent);
    flex-shrink: 0;
  }

  .tr-card__title {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--tc-ink);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tr-card__badge {
    display: inline-flex;
    align-items: center; justify-content: center;
    min-width: 20px; height: 20px;
    padding: 0 6px; border-radius: 99px;
    background: var(--tc-chip-bg);
    color: var(--tc-muted);
    font-size: 0.72rem; font-weight: 700;
  }

  .tr-segmented {
    display: flex;
    padding: 2px;
    background: var(--tc-chip-bg);
    border-radius: 7px;
  }

  .tr-seg {
    padding: 5px 14px;
    background: transparent;
    border: none; border-radius: 5px;
    font-size: 0.75rem; font-weight: 600;
    color: var(--tc-muted);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .tr-seg:hover { color: var(--tc-sub); }

  .tr-seg--active {
    background: var(--tc-card-bg);
    color: var(--tc-ink);
    box-shadow: var(--tc-shadow);
  }

  .tr-thead {
    display: grid;
    grid-template-columns: 36px 1fr 160px 120px 110px;
    gap: 12px;
    padding: 8px 20px;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tc-faint);
    border-bottom: 1px solid var(--tc-card-border);
  }

  .tr-th--r { text-align: right; }

  .tr-row {
    display: grid;
    grid-template-columns: 36px 1fr 160px 120px 110px;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    padding: 14px 20px;
    align-items: center;
    border-bottom: 1px solid var(--tc-card-border-soft);
    transition: background 0.1s;
    cursor: pointer;
  }

  .tr-row:last-child { border-bottom: none; }
  .tr-row:hover { background: var(--tc-overlay); }

  .tr-row__idx {
    font-family: var(--font-mono-plex);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--tc-faint);
  }

  .tr-row__tournament { min-width: 0; }

  .tr-row__name-line {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tr-row__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--tc-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tr-row:hover .tr-row__name { color: var(--tc-accent); }

  .tr-row__joined-badge {
    font-size: 0.58rem;
    font-weight: 700;
    padding: 1px 5px;
    background: var(--tc-accent-soft);
    border: 1px solid var(--tc-accent-border);
    color: var(--tc-accent);
    border-radius: 3px;
    letter-spacing: 0.05em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .tr-row__date {
    font-size: 0.72rem;
    color: var(--tc-muted);
    margin-top: 2px;
  }

  .tr-row__type {
    font-size: 0.78rem;
    color: var(--tc-sub);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tr-row__participants {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: flex-end;
  }

  .tr-row__p-count {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--tc-ink);
    font-variant-numeric: tabular-nums;
  }

  .tr-row__p-max {
    font-size: 0.72rem;
    color: var(--tc-muted);
  }

  .tr-row__p-bar {
    width: 40px;
    height: 4px;
    background: var(--tc-chip-bg);
    border-radius: 2px;
    overflow: hidden;
  }

  .tr-row__p-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.3s;
  }

  .tr-row__p-fill--accent { background: var(--tc-accent); opacity: 0.7; }
  .tr-row__p-fill--win    { background: var(--tc-win); opacity: 0.7; }
  .tr-row__p-fill--muted  { background: var(--tc-muted); opacity: 0.4; }

  .tr-row__status {
    font-size: 0.75rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .tr-row__status--accent { color: var(--tc-accent); }
  .tr-row__status--win    { color: var(--tc-win); }
  .tr-row__status--muted  { color: var(--tc-sub); }

  .tr-row__status-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 4px currentColor;
  }

  .tr-empty {
    padding: 40px 20px;
    text-align: center;
    color: var(--tc-muted);
    font-size: 0.84rem;
  }

  /* ── Responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .tr-stats { grid-template-columns: repeat(2, 1fr); }

    .tr-featured__grid { grid-template-columns: 1fr; }
    .tr-featured__standings {
      border-left: none;
      border-top: 1px solid var(--tc-card-border);
    }

    .tr-thead { display: none; }

    .tr-row {
      grid-template-columns: 1fr auto;
      gap: 10px;
      padding: 12px 16px;
    }

    .tr-row__idx,
    .tr-row__type,
    .tr-row__participants { display: none; }

    .tr-card__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  @media (max-width: 640px) {
    .tr-stats { gap: 8px; }
    .tr-stat-card { padding: 14px 16px; }
    .tr-stat-val { font-size: 1.6rem; }

    .tr-featured__info { padding: 18px 16px; }
    .tr-featured__name { font-size: 1.2rem; }
    .tr-featured__standings { padding: 16px; }
    .tr-featured__actions { flex-direction: column; gap: 6px; }
    .tr-btn-primary, .tr-btn-secondary { text-align: center; }

    .tr-row { padding: 11px 14px; }
    .tr-row__name { font-size: 0.82rem; }
    .tr-segmented { flex-wrap: wrap; }
    .tr-seg { padding: 3px 8px; font-size: 0.68rem; }

    .tr-row__status { display: none; }
    .tr-row {
      grid-template-columns: 1fr;
    }
    .tr-row__name-line { flex-wrap: wrap; }
  }
</style>
