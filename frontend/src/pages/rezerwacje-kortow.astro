---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { url } from '@/lib/url';

export const prerender = true;
---

<PublicLayout
  title="Rezerwacje Kortów Tenisowych"
  description="Rezerwuj korty tenisowe online — jednorazowe i cykliczne, z powiadomieniami i akceptacją przez managera klubu. System dla klubów tenisowych."
>
  <div class="relative overflow-hidden w-full min-h-screen">
    <!-- Tło graficzne z filtrem grayscale i kryciem -->
    <div class="absolute inset-0 bg-surface bg-[url('/static/img/background_01.png')] bg-no-repeat bg-top bg-cover bg-fixed filter grayscale(1) opacity-[0.45] z-0 pointer-events-none"></div>
    
    <!-- Gradient radialny i liniowy -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/20 via-white/60 to-white/80 z-[1]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.6)_0%,rgba(255,255,255,0.05)_100%)] z-[1]"></div>
    
    <div class="relative z-[2] w-full">
      <section class="py-20 px-8 max-[480px]:py-12 max-[480px]:px-4 bg-transparent">
        <div class="max-w-[860px] mx-auto">
          <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] font-black text-[#1A1A1A] tracking-[-0.03em] mb-6 leading-[1.2]">
            Rezerwacje kortów tenisowych
          </h1>
          <p class="text-[clamp(1.05rem,1.8vw,1.2rem)] text-[#475569] mb-12 leading-[1.65] font-medium">
            Grafik kortów dostępny 24/7. Gracze rezerwują samodzielnie, manager zatwierdza.
            Koniec z telefonami.
          </p>

          <div class="bg-white/85 backdrop-blur-[6px] border border-gray-200/60 shadow-sm rounded-[12px] p-8 max-[480px]:p-5 mb-12">
            <ul class="space-y-4 text-[1.05rem] text-[#334155] font-medium list-none p-0 m-0">
              <li class="flex gap-3 items-center"><span class="text-[#5a7d22] font-extrabold text-xl">✓</span> Rezerwacje jednorazowe i cykliczne (2–12 tygodni)</li>
              <li class="flex gap-3 items-center"><span class="text-[#5a7d22] font-extrabold text-xl">✓</span> Anulowanie pojedynczej rezerwacji lub całej serii</li>
              <li class="flex gap-3 items-center"><span class="text-[#5a7d22] font-extrabold text-xl">✓</span> Powiadomienia o akceptacji i odrzuceniu</li>
              <li class="flex gap-3 items-center"><span class="text-[#5a7d22] font-extrabold text-xl">✓</span> Widok grafiku dla całego klubu</li>
              <li class="flex gap-3 items-center"><span class="text-[#5a7d22] font-extrabold text-xl">✓</span> Obsługa wielu obiektów / kortów</li>
            </ul>
          </div>

          <div class="flex gap-4 flex-wrap">
            <a href={url('/register')} class="tc-btn tc-btn-primary tc-btn-lg !bg-[#5a7d22] hover:!bg-[#47621a] !border-[#5a7d22] hover:!border-[#47621a] !text-white font-semibold transition-all duration-300 transform hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[#5a7d22]/20 !rounded-[8px] !py-3.5 !px-8 !text-base shrink-0">
              Zarejestruj klub
            </a>
            <a href={url('/kontakt')} class="tc-btn tc-btn-lg !bg-[#5a7d22]/8 hover:!bg-[#5a7d22]/15 !border-[#5a7d22]/30 hover:!border-[#5a7d22] !text-[#5a7d22] font-semibold border transition-all duration-300 transform hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[#5a7d22]/10 !rounded-[8px] !py-3.5 !px-8 !text-base shrink-0">
              Zapytaj o wdrożenie
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</PublicLayout>
