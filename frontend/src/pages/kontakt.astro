---
import PublicLayout from '@/layouts/PublicLayout.astro';

export const prerender = true;
---

<PublicLayout
  title="Kontakt"
  description="Skontaktuj się z nami w sprawie systemu zarządzania klubem tenisowym — rezerwacje kortów, turnieje, ligi i rankingi. Odpowiemy w ciągu 24 godzin."
>
  <div class="relative overflow-hidden w-full min-h-screen">
    <!-- Tło graficzne z filtrem grayscale i kryciem -->
    <div class="absolute inset-0 bg-surface bg-[url('/static/img/background_01.png')] bg-no-repeat bg-top bg-cover bg-fixed filter grayscale(1) opacity-[0.45] z-0 pointer-events-none"></div>
    
    <!-- Gradient radialny i liniowy -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/20 via-white/60 to-white/80 z-[1]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.6)_0%,rgba(255,255,255,0.05)_100%)] z-[1]"></div>
    
    <div class="relative z-[2] w-full">
      <section class="py-20 px-8 max-[480px]:py-12 max-[480px]:px-4 bg-transparent">
        <div class="max-w-[640px] mx-auto">
          <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] font-black text-[#1A1A1A] tracking-[-0.03em] mb-6 leading-[1.2]">
            Kontakt
          </h1>
          <p class="text-[clamp(1.05rem,1.8vw,1.2rem)] text-[#475569] mb-12 leading-[1.65] font-medium">
            Masz pytania o system, chcesz zamówić demo lub porozmawiać o wdrożeniu?
            Napisz do nas — odpowiemy w ciągu 24 godzin.
          </p>

          <div class="bg-white/85 backdrop-blur-[6px] border border-gray-200/60 shadow-sm rounded-[12px] p-8 space-y-6 mb-8 hover:shadow-md transition-all duration-300">
            <div>
              <div class="text-[0.75rem] font-bold text-[#64748b] uppercase tracking-wider mb-2">E-mail</div>
              <a href="mailto:itprima@medi3.pl" class="text-[1.1rem] text-[#5a7d22] font-semibold hover:underline">
                itprima@medi3.pl
              </a>
            </div>
            <div>
              <div class="text-[0.75rem] font-bold text-[#64748b] uppercase tracking-wider mb-2">Portal</div>
              <a href="https://portal.raketon.pl" class="text-[1.1rem] text-[#5a7d22] font-semibold hover:underline" target="_blank" rel="noopener noreferrer">
                portal.raketon.pl
              </a>
            </div>
          </div>

          <p class="text-[0.875rem] text-[#94a3b8] font-medium">
            Jeśli chcesz przetestować system — możesz zarejestrować się bezpłatnie i od razu zacząć.
          </p>
        </div>
      </section>
    </div>
  </div>
</PublicLayout>
