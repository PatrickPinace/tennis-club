---
import PublicLayout from '@/layouts/PublicLayout.astro';

export const prerender = true;
---

<PublicLayout
  title="Kontakt"
  description="Skontaktuj się z nami w sprawie systemu zarządzania klubem tenisowym — rezerwacje kortów, turnieje, ligi i rankingi. Odpowiemy w ciągu 24 godzin."
>
  <section class="py-16 px-8 max-[480px]:py-8 max-[480px]:px-4 bg-bg">
    <div class="max-w-[640px] mx-auto">
      <h1 class="text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold text-[#0f172a] tracking-[-0.02em] mb-4">
        Kontakt
      </h1>
      <p class="text-[1.1rem] text-[#64748b] mb-10 max-w-[55ch]">
        Masz pytania o system, chcesz zamówić demo lub porozmawiać o wdrożeniu?
        Napisz do nas — odpowiemy w ciągu 24 godzin.
      </p>

      <div class="tc-card p-8 space-y-6">
        <div>
          <div class="text-[0.75rem] font-semibold text-[#64748b] uppercase tracking-wide mb-1">E-mail</div>
          <a href="mailto:itprima@medi3.pl" class="text-[1rem] text-[#16a34a] font-medium hover:underline">
            itprima@medi3.pl
          </a>
        </div>
        <div>
          <div class="text-[0.75rem] font-semibold text-[#64748b] uppercase tracking-wide mb-1">Portal</div>
          <a href="https://portal.raketon.pl" class="text-[1rem] text-[#16a34a] font-medium hover:underline">
            portal.raketon.pl
          </a>
        </div>
      </div>

      <p class="text-[0.85rem] text-[#94a3b8] mt-6">
        Jeśli chcesz przetestować system — możesz zarejestrować się bezpłatnie i od razu zacząć.
      </p>
    </div>
  </section>
</PublicLayout>
