---
// rankings.astro — tabela rankingowa połączona z Django API
// GET /api/rankings/list/?type=SNG  (IsAuthenticatedOrReadOnly — publiczny)
// Karta "Moja pozycja" wypełniana client-side z /api/dashboard/summary/
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import RankingsTable from '@/components/RankingsTable.tsx';
import { getRankings, type PlayerRankingEntry } from '@/lib/api';

// ── Pobierz dane przy budowaniu (publiczny endpoint, bez auth) ─────────────────
let players: PlayerRankingEntry[] = [];
let isLive = false;

try {
  const data = await getRankings('SNG');
  if (data && data.length > 0) {
    players = data;
    isLive = true;
  }
} catch (e) {
  console.warn('[rankings] API error, using fallback demo data:', e);
}


const totalPlayers = players.length;

const initialPlayers = players.map(p => ({
  position: p.position,
  display_name: p.display_name,
  points: p.points,
  matches_played: p.matches_played,
  matches_won: p.matches_won,
  matches_lost: p.matches_lost,
  win_rate: p.win_rate,
}));
---

<AppLayout
  title="Ranking"
  greeting="Ranking klubowy"
  greetingSub={`${totalPlayers} graczy · sezon wiosna 2026`}
  showCta={false}
  showSearch={false}
>
  <RankingsTable
    client:load
    initialPlayers={initialPlayers}
    isLive={isLive}
    totalPlayers={totalPlayers}
  />
</AppLayout>

<style is:global>
  /* ── Moja pozycja (zielona karta - gdy zalogowany) ─────────────────────── */
  .rk-my {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-accent-border);
    border-radius: 14px;
    padding: 20px 24px;
    margin-bottom: 16px;
  }

  .rk-my__left {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .rk-my__pos { text-align: center; }

  .rk-my__pos-num {
    display: block;
    font-size: 2.8rem;
    font-weight: 900;
    color: var(--tc-accent);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .rk-my__pos-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--tc-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .rk-my__sep {
    width: 1px;
    height: 40px;
    background: var(--tc-accent-border);
  }

  .rk-my__title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--tc-ink);
  }

  .rk-my__sub {
    font-size: 0.78rem;
    color: var(--tc-muted);
    margin-top: 2px;
  }

  .rk-my__stats {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .rk-my__stat { text-align: left; }

  .rk-my__stat-label {
    display: block;
    font-size: 0.6rem;
    color: var(--tc-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
  }

  .rk-my__stat-val {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--tc-ink);
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  /* ── Podium ────────────────────────────────────────────────────────────── */
  .rk-podium {
    display: grid;
    grid-template-columns: 1fr 1.08fr 1fr;
    align-items: flex-end;
    gap: 10px;
    margin-bottom: 16px;
  }

  .rk-podium__card--raised {
    margin-bottom: 16px;
    z-index: 1;
  }

  .rk-podium__card {
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    transition: background 0.25s, border-color 0.25s;
  }

  .rk-podium__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
  }

  .rk-podium__label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.85);
  }

  .rk-podium__num {
    font-size: 2.5rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .rk-podium__body {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px 12px;
  }

  .rk-podium__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.88rem;
    flex-shrink: 0;
  }

  .rk-podium__avatar--gold   { background: color-mix(in srgb, var(--tc-medal-gold)   15%, transparent); border: 2px solid color-mix(in srgb, var(--tc-medal-gold)   50%, transparent); color: var(--tc-medal-gold); }
  .rk-podium__avatar--silver { background: color-mix(in srgb, var(--tc-medal-silver) 15%, transparent); border: 2px solid color-mix(in srgb, var(--tc-medal-silver) 50%, transparent); color: var(--tc-medal-silver); }
  .rk-podium__avatar--bronze { background: color-mix(in srgb, var(--tc-medal-bronze) 15%, transparent); border: 2px solid color-mix(in srgb, var(--tc-medal-bronze) 50%, transparent); color: var(--tc-medal-bronze); }

  .rk-podium__info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .rk-podium__name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--tc-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rk-podium__meta {
    font-size: 0.72rem;
    color: var(--tc-muted);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rk-podium__footer {
    display: flex;
    gap: 24px;
    padding: 12px 16px 16px;
    border-top: 1px solid var(--tc-card-border-soft);
  }

  .rk-podium__stat { display: flex; flex-direction: column; gap: 2px; }

  .rk-podium__stat-label {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tc-muted);
  }

  .rk-podium__stat-val {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--tc-ink);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .rk-podium__stat-of {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--tc-muted);
  }

  /* ── Karta rankingowa ──────────────────────────────────────────────────── */
  .rk-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    transition: background 0.25s, border-color 0.25s;
  }

  .rk-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tc-card-border);
  }

  .rk-card__title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rk-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tc-accent);
    flex-shrink: 0;
  }

  .rk-card__title {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--tc-ink);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .rk-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 99px;
    background: var(--tc-chip-bg);
    color: var(--tc-muted);
    font-size: 0.72rem;
    font-weight: 700;
  }

  /* ── Segmented control ─────────────────────────────────────────────────── */
  .rk-segmented {
    display: flex;
    padding: 2px;
    background: var(--tc-chip-bg);
    border-radius: 7px;
  }

  .rk-seg {
    padding: 5px 14px;
    background: transparent;
    border: none;
    border-radius: 5px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--tc-muted);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .rk-seg:hover { color: var(--tc-sub); }

  .rk-seg--active {
    background: var(--tc-card-bg);
    color: var(--tc-ink);
    box-shadow: var(--tc-shadow);
  }

  /* ── Table head ────────────────────────────────────────────────────────── */
  .rk-thead {
    display: grid;
    grid-template-columns: 60px 1fr 100px 120px 130px;
    gap: 12px;
    padding: 8px 20px;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tc-faint);
    border-bottom: 1px solid var(--tc-card-border);
  }

  .rk-th--r { text-align: right; }

  /* ── Table rows ────────────────────────────────────────────────────────── */
  .rk-row {
    display: grid;
    grid-template-columns: 60px 1fr 100px 120px 130px;
    gap: 12px;
    padding: 14px 20px;
    align-items: center;
    border-bottom: 1px solid var(--tc-card-border-soft);
    transition: background 0.1s;
    position: relative;
  }

  .rk-row:last-child { border-bottom: none; }
  .rk-row:hover { background: var(--tc-overlay); }

  .rk-row--first,
  .rk-row--me {
    background: var(--tc-accent-soft);
  }
  .rk-row--first::before,
  .rk-row--me::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--tc-accent);
    border-radius: 0 2px 2px 0;
  }
  .rk-row--first:hover,
  .rk-row--me:hover { background: var(--tc-accent-soft); }

  .rk-pos-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 700;
    background: var(--tc-chip-bg);
    color: var(--tc-muted);
  }

  .rk-pos-badge--1 { background: color-mix(in srgb, var(--tc-medal-gold)   20%, transparent); color: var(--tc-medal-gold); }
  .rk-pos-badge--2 { background: color-mix(in srgb, var(--tc-medal-silver) 15%, transparent); color: var(--tc-medal-silver); }
  .rk-pos-badge--3 { background: color-mix(in srgb, var(--tc-medal-bronze) 15%, transparent); color: var(--tc-medal-bronze); }

  .rk-row__player {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .rk-row__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--tc-chip-bg);
    border: 2px solid var(--tc-card-border);
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--tc-muted);
    flex-shrink: 0;
  }

  .rk-row__avatar--gold   { background: color-mix(in srgb, var(--tc-medal-gold)   10%, transparent); border-color: color-mix(in srgb, var(--tc-medal-gold)   40%, transparent); color: var(--tc-medal-gold); }
  .rk-row__avatar--silver { background: color-mix(in srgb, var(--tc-medal-silver) 10%, transparent); border-color: color-mix(in srgb, var(--tc-medal-silver) 40%, transparent); color: var(--tc-medal-silver); }
  .rk-row__avatar--bronze { background: color-mix(in srgb, var(--tc-medal-bronze) 10%, transparent); border-color: color-mix(in srgb, var(--tc-medal-bronze) 40%, transparent); color: var(--tc-medal-bronze); }

  .rk-row__player-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 1px;
  }

  .rk-row__name {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--tc-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rk-row__winrate {
    font-size: 0.72rem;
    color: var(--tc-muted);
    white-space: nowrap;
  }

  .rk-me-badge {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 700;
    background: var(--tc-accent-soft);
    border: 1px solid var(--tc-accent-border);
    color: var(--tc-accent);
    padding: 1px 7px;
    border-radius: 99px;
    width: fit-content;
  }

  .rk-row__num {
    text-align: right;
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
  }

  .rk-row__points {
    font-weight: 700;
    color: var(--tc-ink);
    font-size: 0.92rem;
  }

  .rk-row__pkt {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--tc-muted);
  }

  .rk-row__muted { color: var(--tc-muted); }

  .rk-row__of {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--tc-faint);
  }

  /* ── Footer ────────────────────────────────────────────────────────────── */
  .rk-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    border-top: 1px solid var(--tc-card-border);
  }

  .rk-footer-info {
    font-size: 0.72rem;
    color: var(--tc-muted);
  }

  .rk-footer-label {
    font-size: 0.72rem;
    color: var(--tc-faint);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ── Empty state ───────────────────────────────────────────────────────── */
  .rk-empty {
    padding: 40px 20px;
    text-align: center;
    color: var(--tc-muted);
    font-size: 0.84rem;
  }

  /* ── Responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .rk-podium { gap: 8px; }
    .rk-podium__num { font-size: 2rem; }
    .rk-podium__stat-val { font-size: 1.15rem; }

    .rk-thead { display: none; }

    .rk-row {
      grid-template-columns: 48px 1fr auto;
      gap: 10px;
      padding: 12px 16px;
    }

    .rk-row > .rk-row__num:nth-child(3),
    .rk-row > .rk-row__num:nth-child(4) { display: none; }

    .rk-card__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .rk-my {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .rk-podium {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .rk-podium__card--raised {
      margin-bottom: 0;
      order: -1;
    }

    .rk-podium__header { padding: 10px 14px; }
    .rk-podium__num { font-size: 1.8rem; }
    .rk-podium__body { padding: 12px 14px 10px; }
    .rk-podium__footer { padding: 10px 14px 12px; gap: 20px; }
    .rk-podium__stat-val { font-size: 1rem; }

    .rk-my__pos-num { font-size: 2.2rem; }
    .rk-my__stats { gap: 20px; }
    .rk-my__stat-val { font-size: 1.25rem; }

    .rk-row { padding: 11px 14px; gap: 8px; }
    .rk-pos-badge { width: 28px; height: 28px; font-size: 0.78rem; }
    .rk-row__avatar { width: 30px; height: 30px; font-size: 0.68rem; }
    .rk-row__name { font-size: 0.82rem; }
    .rk-row__points { font-size: 0.84rem; }

    .rk-card__footer {
      flex-direction: column;
      gap: 4px;
      align-items: flex-start;
    }
  }
</style>
