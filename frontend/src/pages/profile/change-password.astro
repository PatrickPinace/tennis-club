---
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import ChangePasswordForm from '@/components/ChangePasswordForm.tsx';
import { getCurrentUser } from '@/lib/api';
import { url } from '@/lib/url';

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const user = await getCurrentUser(sessionCookie);
if (!user) return Astro.redirect(url('/login'));
---

<AppLayout
  title="Zmień hasło"
  greeting="Zmiana hasła"
  greetingSub="Ustaw nowe hasło do swojego konta"
  showCta={false}
  showSearch={false}
>
  <div class="pw-page">
    <div class="pw-card dash-card">
      <div class="pw-card-header">
        <h2 class="pw-card-title">Zmień hasło</h2>
        <p class="pw-card-sub">Podaj aktualne hasło i wybierz nowe. Minimalna długość: 8 znaków.</p>
      </div>
      <ChangePasswordForm client:load changeUrl={url('/profile/change-password')} />
    </div>
  </div>
</AppLayout>

<style is:global>
  .pw-page { max-width: 480px; }

  .pw-card-header { padding: 20px 24px 0; }
  .pw-card-title { font-size: 1rem; font-weight: 700; color: var(--tc-ink); margin: 0 0 4px; }
  .pw-card-sub { font-size: 0.8rem; color: var(--tc-muted); margin: 0 0 20px; }

  .pw-wrap { padding: 0 24px 24px; }

  .pw-form { display: flex; flex-direction: column; gap: 16px; }

  .pw-field { display: flex; flex-direction: column; gap: 6px; }
  .pw-label { font-size: 0.8rem; font-weight: 600; color: var(--tc-sub); }

  .pw-input {
    height: 40px;
    padding: 0 12px;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 8px;
    color: var(--tc-ink);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.15s;
  }
  .pw-input:focus { border-color: var(--tc-accent); }
  .pw-input--error { border-color: var(--tc-hot); }

  .pw-hint { font-size: 0.75rem; }
  .pw-hint--error { color: var(--tc-hot); }
  .pw-hint--info {
    font-size: 0.78rem;
    color: var(--tc-muted);
    padding: 10px 12px;
    background: var(--tc-overlay);
    border-radius: 7px;
    border: 1px solid var(--tc-card-border-soft);
  }
  .pw-hint--info a { color: var(--tc-accent); text-decoration: none; }

  .pw-error {
    font-size: 0.82rem;
    color: var(--tc-hot);
    padding: 8px 12px;
    background: rgba(239,68,68,0.07);
    border-radius: 7px;
    border: 1px solid rgba(239,68,68,0.2);
  }

  .pw-success {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--tc-accent);
    padding: 14px 16px;
    background: var(--tc-accent-soft);
    border-radius: 8px;
    border: 1px solid var(--tc-accent-border);
    line-height: 1.5;
  }
  .pw-success svg { flex-shrink: 0; margin-top: 1px; }
  .pw-success a { color: var(--tc-accent); font-weight: 600; }

  .pw-actions { display: flex; align-items: center; gap: 16px; margin-top: 4px; }

  .pw-btn {
    height: 40px;
    padding: 0 20px;
    background: var(--tc-accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .pw-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .pw-btn:not(:disabled):hover { opacity: 0.88; }

  .pw-cancel {
    font-size: 0.82rem;
    color: var(--tc-muted);
    text-decoration: none;
  }
  .pw-cancel:hover { color: var(--tc-ink); }

  .pw-desc {
    font-size: 0.85rem;
    color: var(--tc-sub);
    margin: 0 0 4px;
    line-height: 1.5;
  }
</style>
