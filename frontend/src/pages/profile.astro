---
// profile.astro — Profil gracza (redesign wg astro7.jpeg)
// SSR wymagane — middleware chroni tę stronę przed niezalogowanymi
export const prerender = false;

import AppLayout from '../layouts/AppLayout.astro';
import { getUserProfile, getMatchHistory, getRankings, getMyTournaments, type MatchHistoryEntry } from '../lib/api';
import { url } from '@/lib/url';

// ── Dane z Django API (server-side, z cookie sesji) ──────────────────────────

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const [profileData, matchHistory, rankingsAll, myTournaments] = await Promise.all([
  getUserProfile(sessionCookie),
  getMatchHistory(sessionCookie),
  getRankings('SNG').catch(() => []),
  getMyTournaments(sessionCookie).catch(() => []),
]);

// ── Dane użytkownika ──────────────────────────────────────────────────────────

const user    = profileData?.user ?? null;
const rSng    = profileData?.ranking_sng ?? null;
const rDbl    = profileData?.ranking_dbl ?? null;
const tStats  = profileData?.tournament_stats ?? null;

const displayName = user
  ? [user.first_name, user.last_name].filter(Boolean).join(' ') || user.username
  : '—';

const initials = user
  ? ((user.first_name?.[0] ?? '') + (user.last_name?.[0] ?? '')).toUpperCase() || user.username.slice(0, 2).toUpperCase()
  : '?';

const roleLabel = user?.is_staff ? 'Administrator' : 'Członek';

function formatDatePL(iso: string | null | undefined): string {
  if (!iso) return '—';
  try {
    const d = new Date(iso);
    return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
  } catch {
    return iso;
  }
}

const memberSince = formatDatePL(user?.member_since ?? user?.date_joined);

// Banner sukcesu po powrocie z /profile/edit
const saved = Astro.url.searchParams.get('saved') === '1';

// ── Statystyki ───────────────────────────────────────────────────────────────

const ranking      = rSng?.position   ?? null;
const totalPlayers = rankingsAll.length;
const points       = rSng?.points     ?? null;
const winRate      = rSng?.win_rate   ?? null;
const matchesPlayed = rSng?.matches_played ?? null;
const matchesWon   = rSng?.matches_won  ?? null;
const matchesLost  = rSng?.matches_lost ?? null;
const setsWon      = rSng?.sets_won   ?? null;
const setsLost     = rSng?.sets_lost  ?? null;

// Aktywne turnieje
const activeTournaments = myTournaments.filter(t =>
  t.status === 'ACT' || t.status === 'REG' || t.status === 'SCH'
).length;

// ── Ostatnie mecze (max 8 do formy) ─────────────────────────────────────────

function formatMatchDate(iso: string): string {
  try {
    const d = new Date(iso);
    return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
  } catch {
    return iso;
  }
}

function getOpponentName(m: MatchHistoryEntry): string {
  const isP1Side =
    (m.user === 'user-win'  && m.win === 'p1') ||
    (m.user === 'user-loss' && m.win === 'p2');
  const opp = isP1Side ? m.p2 : m.p1;
  if (!opp) return 'Nieznany';
  return [opp.first_name, opp.last_name].filter(Boolean).join(' ') || opp.username;
}

function getMatchScore(m: MatchHistoryEntry): string {
  const userSetsWon = m.user === 'user-win'
    ? (m.win === 'p1' ? m.p1_win_set : m.p2_win_set)
    : (m.win === 'p1' ? m.p2_win_set : m.p1_win_set);
  const userSetsLost = m.user === 'user-win'
    ? (m.win === 'p1' ? m.p2_win_set : m.p1_win_set)
    : (m.win === 'p1' ? m.p1_win_set : m.p2_win_set);
  return `${userSetsWon}:${userSetsLost}`;
}

const recentMatches = matchHistory.slice(0, 8).map(m => ({
  opponent: getOpponentName(m),
  result: m.user === 'user-win' ? 'W' : m.user === 'user-loss' ? 'L' : 'R',
  score: getMatchScore(m),
  date: formatMatchDate(m.match_date),
  isDouble: m.match_double,
  isTournament: m.is_tournament ?? false,
}));

const recentWins = recentMatches.filter(m => m.result === 'W').length;
const recentLosses = recentMatches.filter(m => m.result === 'L').length;

// ── Statystyki szczegółowe ───────────────────────────────────────────────────

// Debel stats
const dblMatches = matchHistory.filter(m => m.match_double);
const dblWon = dblMatches.filter(m => m.user === 'user-win').length;
const dblLost = dblMatches.filter(m => m.user === 'user-loss').length;

// Turniej stats
const trnMatches = matchHistory.filter(m => m.is_tournament);
const trnWon = trnMatches.filter(m => m.user === 'user-win').length;
const trnLost = trnMatches.filter(m => m.user === 'user-loss').length;

// Średnia długość meczu (sety)
const totalSets = matchHistory.reduce((sum, m) => {
  let sets = 0;
  if (m.p1_set1 !== null) sets++;
  if (m.p1_set2 !== null) sets++;
  if (m.p1_set3 !== null) sets++;
  return sum + sets;
}, 0);
const avgSets = matchHistory.length > 0 ? (totalSets / matchHistory.length).toFixed(1) : '—';
const minSets = matchHistory.length > 0 ? Math.min(...matchHistory.map(m => {
  let s = 0;
  if (m.p1_set1 !== null) s++;
  if (m.p1_set2 !== null) s++;
  if (m.p1_set3 !== null) s++;
  return s;
})) : 0;
const maxSets = matchHistory.length > 0 ? Math.max(...matchHistory.map(m => {
  let s = 0;
  if (m.p1_set1 !== null) s++;
  if (m.p1_set2 !== null) s++;
  if (m.p1_set3 !== null) s++;
  return s;
})) : 0;

// Sety wygrane
const totalSetsAll = matchHistory.reduce((sum, m) => {
  let s = 0;
  if (m.p1_set1 !== null) s++;
  if (m.p1_set2 !== null) s++;
  if (m.p1_set3 !== null) s++;
  return sum + s;
}, 0);
const userSetsWonTotal = setsWon ?? 0;
const setsWinPct = totalSetsAll > 0 ? Math.round((userSetsWonTotal / totalSetsAll) * 100) : 0;

// Najczęstszy przeciwnik (wygrywasz z)
function getMostWonAgainst(): { name: string; wins: number; total: number } | null {
  const wins = matchHistory.filter(m => m.user === 'user-win');
  const oppMap = new Map<string, { wins: number; total: number }>();
  for (const m of matchHistory) {
    const name = getOpponentName(m);
    if (!oppMap.has(name)) oppMap.set(name, { wins: 0, total: 0 });
    oppMap.get(name)!.total++;
    if (m.user === 'user-win') oppMap.get(name)!.wins++;
  }
  let best: { name: string; wins: number; total: number } | null = null;
  for (const [name, stats] of oppMap) {
    if (stats.wins > 0 && (!best || stats.wins > best.wins)) {
      best = { name, ...stats };
    }
  }
  return best;
}
const mostWonAgainst = getMostWonAgainst();

// ── Osiągnięcia (computed from real data) ────────────────────────────────────

interface Achievement {
  icon: string;
  title: string;
  desc: string;
  unlocked: boolean;
}

const achievements: Achievement[] = [
  {
    icon: '🏆',
    title: 'Pierwszy turniej',
    desc: 'Wygrana w turnieju klubowym',
    unlocked: trnWon > 0,
  },
  {
    icon: '🔥',
    title: 'Hat-trick',
    desc: '3 wygrane z rzędu',
    unlocked: (() => {
      let streak = 0;
      for (const m of matchHistory) {
        if (m.user === 'user-win') { streak++; if (streak >= 3) return true; }
        else streak = 0;
      }
      return false;
    })(),
  },
  {
    icon: '🎯',
    title: 'Bez straty',
    desc: 'Wygrana 6:0 6:0',
    unlocked: matchHistory.some(m => {
      if (m.user !== 'user-win') return false;
      const isP1 = m.win === 'p1';
      if (isP1) return m.p1_set1 === 6 && m.p2_set1 === 0 && m.p1_set2 === 6 && m.p2_set2 === 0;
      return m.p2_set1 === 6 && m.p1_set1 === 0 && m.p2_set2 === 6 && m.p1_set2 === 0;
    }),
  },
  {
    icon: '⭐',
    title: 'Top 3',
    desc: 'W rankingu klubowym',
    unlocked: ranking !== null && ranking <= 3,
  },
  {
    icon: '💎',
    title: 'Maraton',
    desc: 'Mecz 3-setowy ponad 2h',
    unlocked: matchHistory.some(m => m.p1_set3 !== null),
  },
  {
    icon: '🏅',
    title: '10 turniejów',
    desc: 'Ukończono 10 turniejów',
    unlocked: (tStats?.tournaments_finished ?? 0) >= 10,
  },
  {
    icon: '🎾',
    title: 'Debiut',
    desc: 'Pierwszy rozegrany mecz',
    unlocked: matchHistory.length > 0,
  },
  {
    icon: '📈',
    title: 'Seria 5',
    desc: '5 wygranych z rzędu',
    unlocked: (() => {
      let streak = 0;
      for (const m of matchHistory) {
        if (m.user === 'user-win') { streak++; if (streak >= 5) return true; }
        else streak = 0;
      }
      return false;
    })(),
  },
  {
    icon: '🤝',
    title: 'Regularny',
    desc: 'Rozegrano 25 meczów',
    unlocked: matchHistory.length >= 25,
  },
  {
    icon: '🏟️',
    title: 'Uczestnik',
    desc: 'Wzięto udział w turnieju',
    unlocked: (tStats?.tournaments_played ?? 0) > 0,
  },
];

const unlockedCount = achievements.filter(a => a.unlocked).length;

function nd(val: number | string | null | undefined, suffix = ''): string {
  if (val === null || val === undefined) return '—';
  return `${val}${suffix}`;
}
---

<AppLayout
  title="Profil"
  greeting={user ? `Twój profil` : 'Profil'}
  showCta={false}
  currentUser={user}
>

  {saved && (
    <div class="pf-saved" role="status">
      ✓ Profil został zaktualizowany.
    </div>
  )}

  <!-- ── Hero — karta profilu ── -->
  <div class="pf-hero">
    <div class="pf-hero__left">
      <div class="pf-avatar" aria-hidden="true">{initials}</div>
      <div class="pf-hero__info">
        <div class="pf-hero__meta">
          <span class="pf-role-badge">● {roleLabel}</span>
          <span class="pf-member-since">Członek od {memberSince}</span>
        </div>
        <h2 class="pf-hero__name">{displayName}</h2>
        <div class="pf-hero__contact">
          {user?.email && <span>{user.email}</span>}
          {user?.email && <span class="pf-dot">·</span>}
          {user?.city && <span>{user.city}</span>}
          {user?.city && <span class="pf-dot">·</span>}
          {ranking !== null && <span>Ranking #{ranking}</span>}
        </div>
        {user?.phone_number
          ? <div class="pf-phone">
              <svg width="13" height="13" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
              <a href={`tel:${user.phone_number}`} class="pf-phone__link">{user.phone_number}</a>
            </div>
          : <div class="pf-phone pf-phone--empty">
              <svg width="13" height="13" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
              <a href={url('/profile/edit')} class="pf-phone__add">Dodaj numer telefonu →</a>
            </div>
        }
      </div>
    </div>
    <div class="pf-hero__actions">
      <a href={url('/profile/edit')} class="pf-btn pf-btn--secondary">Edytuj profil</a>
      <a href={url('/profile/change-password')} class="pf-btn pf-btn--secondary">Zmień hasło</a>
      <button class="pf-btn pf-btn--primary" id="pf-share-btn">Udostępnij →</button>
    </div>
  </div>

  <!-- ── 4 Stat cards ── -->
  <div class="pf-stats">
    <div class="pf-stat-card pf-stat-card--accent">
      <span class="pf-stat-card__label">RANKING</span>
      <div class="pf-stat-card__value">
        {ranking !== null ? `#${ranking}` : '—'}
        {totalPlayers > 0 && <span class="pf-stat-card__sub-inline"> z {totalPlayers}</span>}
      </div>
      <span class="pf-stat-card__sub">↑ ranking singlowy</span>
    </div>
    <div class="pf-stat-card">
      <span class="pf-stat-card__label">PUNKTY</span>
      <div class="pf-stat-card__value">
        {points !== null ? Math.round(Number(points)) : '—'}
      </div>
      <span class="pf-stat-card__sub">suma w sezonie 2026</span>
    </div>
    <div class="pf-stat-card">
      <span class="pf-stat-card__label">SKUTECZNOŚĆ</span>
      <div class="pf-stat-card__value">
        {winRate !== null ? winRate : '—'}<span class="pf-stat-card__pct">%</span>
      </div>
      <span class="pf-stat-card__sub">{nd(matchesWon)} wygranych / {nd(matchesPlayed)} rozegranych</span>
    </div>
    <div class="pf-stat-card">
      <span class="pf-stat-card__label">AKTYWNE TURNIEJE</span>
      <div class="pf-stat-card__value">{activeTournaments}</div>
      <span class="pf-stat-card__sub">bierzesz teraz udział</span>
    </div>
  </div>

  <!-- ── Two-col: Statystyki + Osiągnięcia ── -->
  <div class="pf-two-col">

    <!-- Lewa — statystyki sezonu -->
    <section class="pf-section-card">
      <div class="pf-section-header">
        <div class="pf-section-header__left">
          <span class="pf-green-dot"></span>
          <h3 class="pf-section-title">STATYSTYKI W SEZONIE</h3>
        </div>
        <a href={url('/matches')} class="pf-section-link">Pełna historia →</a>
      </div>

      <div class="pf-stat-rows">
        <div class="pf-stat-row">
          <div class="pf-stat-row__left">
            <span class="pf-stat-row__label">Mecze rozegrane</span>
            <span class="pf-stat-row__detail">{nd(matchesWon)} wygranych · {nd(matchesLost)} porażek</span>
          </div>
          <span class="pf-stat-row__value">{nd(matchesPlayed)}</span>
        </div>

        <div class="pf-stat-row">
          <div class="pf-stat-row__left">
            <span class="pf-stat-row__label">W tym debel</span>
            <span class="pf-stat-row__detail">{dblWon} wygrana · {dblLost} porażka</span>
          </div>
          <span class="pf-stat-row__value">{dblMatches.length}</span>
        </div>

        <div class="pf-stat-row">
          <div class="pf-stat-row__left">
            <span class="pf-stat-row__label">W tym turniejowe</span>
            <span class="pf-stat-row__detail">{trnWon} wygrane · {trnLost} porażki</span>
          </div>
          <span class="pf-stat-row__value">{trnMatches.length}</span>
        </div>

        <div class="pf-stat-row">
          <div class="pf-stat-row__left">
            <span class="pf-stat-row__label">Średnia długość meczu</span>
            <span class="pf-stat-row__detail">najkrótszy: {minSets} set · najdłuższy: {maxSets}</span>
          </div>
          <span class="pf-stat-row__value">{avgSets} <span class="pf-stat-row__unit">setów</span></span>
        </div>

        <div class="pf-stat-row">
          <div class="pf-stat-row__left">
            <span class="pf-stat-row__label">Sety wygrane</span>
            <span class="pf-stat-row__detail">z {totalSetsAll} rozegranych · {setsWinPct}%</span>
          </div>
          <span class="pf-stat-row__value">{nd(setsWon)}</span>
        </div>

        {mostWonAgainst && (
          <div class="pf-stat-row pf-stat-row--last">
            <div class="pf-stat-row__left">
              <span class="pf-stat-row__label">Najczęściej wygrywasz z</span>
              <span class="pf-stat-row__detail">{mostWonAgainst.wins} wygrane z {mostWonAgainst.total} starć</span>
            </div>
            <span class="pf-stat-row__value pf-stat-row__value--name">{mostWonAgainst.name}</span>
          </div>
        )}
      </div>
    </section>

    <!-- Prawa — osiągnięcia -->
    <section class="pf-section-card">
      <div class="pf-section-header">
        <div class="pf-section-header__left">
          <span class="pf-green-dot"></span>
          <h3 class="pf-section-title">OSIĄGNIĘCIA</h3>
          <span class="pf-badge-count">{unlockedCount} z {achievements.length}</span>
        </div>
      </div>

      <div class="pf-achievements">
        {achievements.map(a => (
          <div class={`pf-achievement ${a.unlocked ? '' : 'pf-achievement--locked'}`}>
            <div class={`pf-achievement__icon ${a.unlocked ? '' : 'pf-achievement__icon--locked'}`}>
              {a.icon}
            </div>
            <div class="pf-achievement__text">
              <span class="pf-achievement__title">{a.title}</span>
              <span class="pf-achievement__desc">{a.desc}</span>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>

  <!-- ── Forma — ostatnie mecze ── -->
  {recentMatches.length > 0 && (
    <section class="pf-section-card">
      <div class="pf-section-header">
        <div class="pf-section-header__left">
          <span class="pf-green-dot"></span>
          <h3 class="pf-section-title">FORMA · OSTATNIE {recentMatches.length} MECZÓW</h3>
        </div>
        <div class="pf-section-header__right">
          <span class="pf-form-summary">
            <span class="pf-form-wins">{recentWins} wygranych</span> · {recentLosses} porażki
          </span>
          <a href={url('/matches')} class="pf-section-link">Wszystkie mecze →</a>
        </div>
      </div>

      <div class="pf-form-chart">
        {recentMatches.map(m => (
          <div class="pf-form-item">
            <div class={`pf-form-bar ${m.result === 'W' ? 'pf-form-bar--win' : 'pf-form-bar--loss'}`}>
              <span class="pf-form-bar__result">{m.result === 'W' ? 'W' : 'P'}</span>
              <span class="pf-form-bar__score">{m.score}</span>
            </div>
            <span class="pf-form-date">{m.date}</span>
          </div>
        ))}
      </div>
    </section>
  )}

</AppLayout>

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   PROFIL — redesign wg astro7.jpeg
   Tokeny: --tc-* (dark/light compatible)
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Saved banner ─────────────────────────────────────────────── */
.pf-saved {
  background: var(--tc-accent-soft);
  border: 1px solid var(--tc-accent-border);
  border-radius: 10px;
  color: var(--tc-accent);
  font-size: 13px; font-weight: 600;
  padding: 10px 16px;
  margin-bottom: 16px;
}

/* ── Hero card ────────────────────────────────────────────────── */
.pf-hero {
  background: var(--tc-card-bg);
  border: 1px solid var(--tc-card-border);
  border-radius: 14px;
  padding: 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 12px;
}

.pf-hero__left {
  display: flex;
  align-items: center;
  gap: 20px;
  min-width: 0;
}

.pf-avatar {
  width: 88px; height: 88px; border-radius: 50%;
  background: var(--tc-accent-soft);
  border: 3px solid var(--tc-accent);
  color: var(--tc-accent);
  font-size: 32px; font-weight: 800;
  display: grid; place-items: center;
  flex-shrink: 0;
}

.pf-hero__info {
  min-width: 0;
}

.pf-hero__meta {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 6px;
}

.pf-role-badge {
  font-size: 11px; font-weight: 600;
  color: var(--tc-accent);
  background: var(--tc-accent-soft);
  border: 1px solid var(--tc-accent-border);
  padding: 2px 10px;
  border-radius: 999px;
}

.pf-member-since {
  font-size: 12px; color: var(--tc-muted);
}

.pf-hero__name {
  font-size: 30px; font-weight: 800;
  letter-spacing: -0.8px;
  color: var(--tc-ink);
  margin: 0 0 4px;
  line-height: 1.15;
}

.pf-hero__contact {
  font-size: 13px; color: var(--tc-muted);
  display: flex; align-items: center; gap: 8px;
  flex-wrap: wrap;
}

.pf-dot { color: var(--tc-faint); }

.pf-phone {
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; margin-top: 6px;
  color: var(--tc-sub);
}
.pf-phone svg { flex-shrink: 0; color: var(--tc-muted); }
.pf-phone__link {
  color: var(--tc-ink); text-decoration: none; font-weight: 500;
}
.pf-phone__link:hover { color: var(--tc-accent); }
.pf-phone--empty { color: var(--tc-muted); }
.pf-phone__add {
  color: var(--tc-muted); font-size: 12px; text-decoration: none;
}
.pf-phone__add:hover { color: var(--tc-accent); }

.pf-hero__actions {
  display: flex; gap: 8px;
  flex-shrink: 0;
}

.pf-btn {
  font-size: 13px; font-weight: 600;
  padding: 8px 18px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.15s, opacity 0.15s;
}
.pf-btn--secondary {
  background: var(--tc-chip-bg);
  color: var(--tc-ink);
  border: 1px solid var(--tc-card-border);
}
.pf-btn--secondary:hover { opacity: 0.8; }
.pf-btn--primary {
  background: var(--tc-accent);
  color: var(--tc-accent-ink);
}
.pf-btn--primary:hover { opacity: 0.85; }

/* ── Stat cards ───────────────────────────────────────────────── */
.pf-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 12px;
}

.pf-stat-card {
  background: var(--tc-card-bg);
