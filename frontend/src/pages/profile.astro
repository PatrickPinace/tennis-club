  padding: 20px;
}

.pf-stat-card--accent {
  border-color: var(--tc-accent-border);
}

.pf-stat-card__label {
  display: block;
  font-size: 10px; font-weight: 700;
  color: var(--tc-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 8px;
}

.pf-stat-card--accent .pf-stat-card__label {
  color: var(--tc-accent);
}

.pf-stat-card__value {
