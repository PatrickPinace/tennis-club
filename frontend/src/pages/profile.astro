/* ── Two-col layout ───────────────────────────────────────────── */
.pf-two-col {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 12px;
  margin-bottom: 12px;
}

/* ── Section card ─────────────────────────────────────────────── */
.pf-section-card {
  background: var(--tc-card-bg);
  border: 1px solid var(--tc-card-border);
  border-radius: 14px;
  overflow: hidden;
}

/* ── Section header ───────────────────────────────────────────── */
.pf-section-header {
