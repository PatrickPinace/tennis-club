---
// courts/reservations.astro — rezerwacje kortów (SSR)
// Layout wg prototypu astro6.jpeg — stat cards + day picker + siatka godzinowa + moje rezerwacje
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import CourtReservations from '@/components/CourtReservations.tsx';
import { getCurrentUser, getMyReservations, type ReservationEntry } from '@/lib/api';
import { url } from '@/lib/url';

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;

const [currentUser, rawReservations] = await Promise.all([
  getCurrentUser(sessionCookie),
  getMyReservations(sessionCookie),
]);

if (!currentUser) {
  return Astro.redirect(url('/login') + '?next=' + encodeURIComponent(url('/courts/reservations')));
}

// Manager / staff — pobierz oczekujące rezerwacje
interface PendingEntry {
  id: number;
  court_name: string | null;
  facility_name: string | null;
  start_time: string;
  end_time: string;
  status: string;
  user_name: string;
}
const isManager = currentUser.is_staff;

let pendingReservations: PendingEntry[] = [];
if (isManager) {
  try {
    const DJANGO_API = import.meta.env.DJANGO_API_URL ?? process.env.DJANGO_API_URL ?? 'http://localhost:8000';
    const pr = await fetch(`${DJANGO_API}/api/courts/reservations/pending/`, {
      headers: { Cookie: sessionCookie ?? '', Accept: 'application/json' },
      redirect: 'manual',
    });
    if (pr.ok) pendingReservations = await pr.json();
  } catch { /* graceful */ }
}

// Formatowanie
function fmtDate(iso: string): string {
  try { return new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' }); }
  catch { return iso; }
}
function fmtTime(iso: string): string {
  try { return new Date(iso).toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' }); }
  catch { return iso; }
}

const now = new Date();
const todayIso = now.toISOString().slice(0, 10);

const myReservations = rawReservations.map((r: ReservationEntry) => ({
  id: r.id,
  courtId: (r as any).court_id ?? null,
  court: r.court_name ?? 'Kort',
  facility: r.facility_name ?? '',
  date: fmtDate(r.start_time),
  time: `${fmtTime(r.start_time)}–${fmtTime(r.end_time)}`,
  startIso: r.start_time,
  endIso: r.end_time,
  status: r.status.toLowerCase() as 'pending' | 'confirmed' | 'rejected',
  seriesId: (r as any).series_id ?? null,
}));

const futureReservations = myReservations.filter((r: any) => new Date(r.endIso) > now);

const GRID_START = 8;
const GRID_END = 21;
---

<AppLayout
  title="Rezerwacje kortów"
  greeting="Rezerwacje"
  greetingSub="Twoje korty na ten tydzień"
  showSearch={false}
  showCta={false}
>
  <CourtReservations
    client:load
    initialReservations={myReservations}
    pendingReservations={pendingReservations}
    isManager={isManager}
    futureCount={futureReservations.length}
    totalCount={myReservations.length}
    gridStart={GRID_START}
    gridEnd={GRID_END}
    todayIso={todayIso}
  />
</AppLayout>

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════════
     REZERWACJE — layout wg prototypu astro6.jpeg, tokeny --tc-*
     ══════════════════════════════════════════════════════════════════════════ */

  /* ── Stat cards ──────────────────────────────────────────────────────────── */
  .rv-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 12px;
  }

  .rv-stat {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex; flex-direction: column; gap: 6px;
    transition: background 0.25s, border-color 0.25s;
  }
  .rv-stat--accent { border-color: var(--tc-accent-border); }
  .rv-stat__label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--tc-muted); }
  .rv-stat__val { font-size: 2rem; font-weight: 800; color: var(--tc-ink); line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }
  .rv-stat__sub { font-size: 0.72rem; color: var(--tc-muted); }

  /* ── Facility picker ─────────────────────────────────────────────────────── */
  .rv-facility-picker {
    display: flex; gap: 8px; flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .rv-facility-btn {
    padding: 7px 16px; border-radius: 8px;
    background: var(--tc-chip-bg); border: 1px solid var(--tc-card-border);
    color: var(--tc-sub); font-size: 0.84rem; font-weight: 600;
    cursor: pointer; font-family: var(--font-sans);
    transition: background 0.12s, color 0.12s, border-color 0.12s;
  }
  .rv-facility-btn:hover { border-color: var(--tc-accent-border); color: var(--tc-ink); }
  .rv-facility-btn--active {
    background: var(--tc-accent-soft); border-color: var(--tc-accent-border); color: var(--tc-accent);
  }

  /* ── Edit button ─────────────────────────────────────────────────────────── */
  .rv-edit-btn {
    background: none; border: none; cursor: pointer;
    font-size: 0.78rem; font-weight: 600; color: var(--tc-accent);
    padding: 4px 0; transition: opacity 0.12s; font-family: var(--font-sans);
  }
  .rv-edit-btn:hover { opacity: 0.75; }

  /* ── Week nav ────────────────────────────────────────────────────────────── */
  .rv-week-nav {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 8px;
  }
  .rv-week-btn {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 8px;
    background: var(--tc-card-bg); border: 1px solid var(--tc-card-border);
    color: var(--tc-sub); cursor: pointer; transition: all 0.15s;
    flex-shrink: 0;
  }
  .rv-week-btn:hover { border-color: var(--tc-accent-border); color: var(--tc-accent); }
  .rv-week-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .rv-week-label {
    font-size: 0.82rem; font-weight: 600; color: var(--tc-sub);
    flex: 1; text-align: center;
  }

  /* ── Day picker ──────────────────────────────────────────────────────────── */
  .rv-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    margin-bottom: 12px;
  }

  .rv-day {
    padding: 12px 8px;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 10px;
    cursor: pointer;
    font-family: var(--font-sans);
    text-align: left;
    transition: all 0.15s;
  }
  .rv-day:hover { border-color: var(--tc-accent-border); }

  .rv-day--active {
    background: var(--tc-accent);
    border-color: var(--tc-accent);
    color: var(--tc-accent-ink);
    box-shadow: 0 4px 16px var(--tc-accent-glow);
  }

  .rv-day__label { display: block; font-size: 0.78rem; font-weight: 600; }
  .rv-day__sub { display: block; font-size: 1.15rem; font-weight: 800; margin-top: 2px; font-variant-numeric: tabular-nums; }

  .rv-day--active .rv-day__label,
  .rv-day--active .rv-day__sub { color: var(--tc-accent-ink); }
  .rv-day__label { color: var(--tc-sub); }
  .rv-day__sub { color: var(--tc-ink); }

  /* ── Grid card (siatka dostępności) ─────────────────────────────────────── */
  .rv-grid-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    margin-bottom: 12px;
    transition: background 0.25s, border-color 0.25s;
    overflow: hidden;
  }

  .rv-grid-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tc-card-border);
  }

  .rv-grid-title {
    font-size: 0.78rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--tc-ink);
  }

  .rv-legend { display: flex; align-items: center; gap: 14px; }
  .rv-legend__item { display: flex; align-items: center; gap: 6px; font-size: 0.72rem; color: var(--tc-muted); }
  .rv-legend__swatch { width: 12px; height: 12px; border-radius: 3px; }
  .rv-legend__swatch--mine { background: var(--tc-accent); }
  .rv-legend__swatch--free { background: var(--tc-card-bg); border: 1px solid var(--tc-card-border); }
  .rv-legend__swatch--taken { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); }
  .rv-legend__swatch--past { background: var(--tc-chip-bg); }

  /* States */
  .rv-state { padding: 32px 20px; text-align: center; font-size: 0.84rem; color: var(--tc-muted); }
  .rv-state--error { color: var(--tc-hot); }

  /* Grid scroll container */
  .rv-grid-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  /* ── Siatka godzinowa (pozioma tabela: korty × godziny) ────────────────── */
  .rv-grid-table { min-width: 900px; }

  /* Nagłówki godzin */
  .rv-hour-header {
    display: grid;
    border-bottom: 1px solid var(--tc-card-border);
    background: var(--tc-card-bg-2);
  }
  .rv-hour-header__label {
    padding: 10px 2px; text-align: center;
    font-family: var(--font-mono-plex);
    font-size: 0.68rem; font-weight: 500;
    color: var(--tc-muted);
    border-right: 1px solid var(--tc-card-border-soft);
    white-space: nowrap; overflow: hidden;
  }
  .rv-hour-header__label--half {
    border-left: 1px dashed var(--tc-card-border-soft);
    color: transparent;
  }
  .rv-hour-header__court {
    padding: 12px 16px;
    font-size: 0.6rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--tc-faint);
    border-right: 1px solid var(--tc-card-border);
  }

  /* Wiersz kortu */
  .rv-court-row {
    display: grid;
    border-bottom: 1px solid var(--tc-card-border-soft);
  }
  .rv-court-row:last-child { border-bottom: none; }

  .rv-court-label {
    padding: 14px 16px;
    border-right: 1px solid var(--tc-card-border);
    display: flex; flex-direction: column; justify-content: center; gap: 2px;
  }
  .rv-court-label__name { font-size: 0.84rem; font-weight: 600; color: var(--tc-ink); }
  .rv-court-label__surface { font-size: 0.68rem; color: var(--tc-muted); }

  /* Sloty */
  .rv-slot {
    display: grid; place-items: center;
    min-height: 46px;
    border-right: 1px solid var(--tc-card-border-soft);
    transition: background 0.1s;
    cursor: default;
    font-size: 0.65rem; font-weight: 700;
    user-select: none;
  }

  .rv-slot--free { cursor: pointer; color: var(--tc-faint); }
  .rv-slot--free:hover { background: var(--tc-accent-soft); color: var(--tc-accent); }

  .rv-slot--mine { background: var(--tc-accent); color: var(--tc-accent-ink); font-size: 0.62rem; letter-spacing: 0.08em; cursor: pointer; }
  .rv-slot--mine:hover { opacity: 0.9; }

  .rv-slot--taken { background: rgba(239,68,68,0.1); color: var(--tc-hot); }

  .rv-slot--past { background: var(--tc-chip-bg); color: transparent; cursor: not-allowed; }

  /* Slot co 30 min — separator wizualny między :00 a :30 */
  .rv-slot--hour { border-left: 1px solid var(--tc-card-border-soft); }
  .rv-slot--half { border-left: 1px dashed var(--tc-card-border-soft); }

  /* Drag highlight */
  .rv-slot--drag {
    background: var(--tc-accent-soft) !important;
    outline: 2px solid var(--tc-accent) !important;
    outline-offset: -1px;
    cursor: col-resize !important;
  }

  /* Przeszły dzień w day pickerze */
  .rv-day--past { opacity: 0.4; cursor: not-allowed; }

  /* Footer */
  .rv-grid-footer {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 14px 20px;
    border-top: 1px solid var(--tc-card-border);
  }
  .rv-grid-footer__hint { font-size: 0.78rem; color: var(--tc-muted); }
  .rv-grid-footer__hint strong { color: var(--tc-ink); }

  /* ── Moje rezerwacje ───────────────────────────────────────────────────── */
  .rv-my-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    transition: background 0.25s, border-color 0.25s;
  }

  .rv-my-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tc-card-border);
  }

  .rv-my-header__left { display: flex; align-items: center; gap: 8px; }

  .rv-card-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--tc-accent); flex-shrink: 0; }

  .rv-my-title {
    font-size: 0.78rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--tc-ink); margin: 0;
  }
  .rv-my-badge {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 20px; height: 20px; padding: 0 6px; border-radius: 99px;
    background: var(--tc-chip-bg); color: var(--tc-muted);
    font-size: 0.72rem; font-weight: 700;
  }

  .rv-res-row {
    display: grid;
    grid-template-columns: 12px 1fr 1fr auto auto auto;
    gap: 16px; padding: 14px 20px;
    align-items: center;
    border-bottom: 1px solid var(--tc-card-border-soft);
    transition: background 0.1s;
  }
  .rv-res-row:last-child { border-bottom: none; }
  .rv-res-row:hover { background: var(--tc-overlay); }

  .rv-res-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--tc-accent); box-shadow: 0 0 6px var(--tc-accent);
  }

  .rv-res-when { font-size: 0.875rem; font-weight: 600; color: var(--tc-ink); }
  .rv-res-detail { font-size: 0.72rem; color: var(--tc-muted); margin-top: 2px; }
  .rv-res-court { font-size: 0.84rem; color: var(--tc-sub); }

  .rv-badge {
    font-size: 0.68rem; font-weight: 700;
    padding: 3px 10px; border-radius: 99px;
    display: inline-flex; align-items: center; gap: 4px;
  }
  .rv-badge--confirmed { background: var(--tc-accent-soft); border: 1px solid var(--tc-accent-border); color: var(--tc-accent); }
  .rv-badge--confirmed::before { content: '●'; font-size: 0.5rem; }
  .rv-badge--pending { background: rgba(234,179,8,0.1); border: 1px solid rgba(234,179,8,0.3); color: #ca8a04; }
  .rv-badge--rejected { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: var(--tc-hot); }

  .rv-cancel-btn {
    background: none; border: none; cursor: pointer;
    font-size: 0.78rem; font-weight: 600; color: var(--tc-muted);
    padding: 4px 0; transition: color 0.12s; font-family: var(--font-sans);
  }
  .rv-cancel-btn:hover { color: var(--tc-hot); }

  .rv-empty-row { padding: 32px 20px; text-align: center; font-size: 0.84rem; color: var(--tc-muted); }

  /* ── Manager ───────────────────────────────────────────────────────────── */
  .rv-manager {
    background: var(--tc-card-bg); border: 1px solid var(--tc-card-border);
    border-radius: 14px; margin-bottom: 12px;
  }
  .rv-manager__header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 20px; border-bottom: 1px solid var(--tc-card-border);
  }
  .rv-manager__title { font-size: 0.88rem; font-weight: 700; color: var(--tc-ink); }
  .rv-manager__badge {
    font-size: 0.72rem; font-weight: 700; padding: 3px 10px; border-radius: 99px;
    background: rgba(234,179,8,0.12); color: #ca8a04; border: 1px solid rgba(234,179,8,0.3);
  }
  .rv-manager-row {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 14px 20px; border-bottom: 1px solid var(--tc-card-border-soft);
  }
  .rv-manager-row:last-child { border-bottom: none; }
  .rv-manager-row__who { font-weight: 700; font-size: 0.875rem; color: var(--tc-ink); }
  .rv-manager-row__what { font-size: 0.78rem; color: var(--tc-muted); margin-top: 2px; }
  .rv-manager-row__when { font-size: 0.72rem; color: var(--tc-faint); margin-top: 2px; }
  .rv-manager-row__actions { display: flex; gap: 8px; flex-shrink: 0; }

  .rv-action-ghost {
    background: none; border: 1px solid var(--tc-card-border);
    border-radius: 6px; padding: 6px 14px; font-size: 0.78rem; font-weight: 600;
    color: var(--tc-muted); cursor: pointer; font-family: var(--font-sans);
    transition: background 0.15s, color 0.15s;
  }
  .rv-action-ghost:hover { background: var(--tc-overlay); color: var(--tc-ink); }

  /* ── Shared button ────────────────────────────────────────────────────── */
  .tr-btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 8px 18px; border-radius: 8px;
    background: var(--tc-accent); color: var(--tc-accent-ink);
    font-size: 0.84rem; font-weight: 700; border: none;
    text-decoration: none; cursor: pointer; font-family: var(--font-sans);
    transition: opacity 0.15s;
  }
  .tr-btn-primary:hover { opacity: 0.88; }
  .tr-btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Popup ─────────────────────────────────────────────────────────────── */
  .res-popup-backdrop {
    position: fixed; inset: 0; z-index: 50;
    background: rgba(0,0,0,0.4);
    display: flex; align-items: center; justify-content: center;
    padding: 16px; animation: fadeIn 0.15s ease;
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .res-popup {
    background: var(--tc-card-bg); border: 1px solid var(--tc-card-border);
    border-radius: 14px; padding: 0;
    width: 100%; max-width: 400px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.22);
    animation: slideUp 0.18s ease; overflow: hidden;
  }
  @keyframes slideUp { from { opacity:0; transform: translateY(10px); } to { opacity:1; transform: translateY(0); } }

  .res-popup__header {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
    padding: 20px 20px 16px; border-bottom: 1px solid var(--tc-card-border);
  }
  .res-popup__title { font-size: 0.95rem; font-weight: 700; color: var(--tc-ink); }
  .res-popup__subtitle { font-size: 0.78rem; color: var(--tc-muted); margin-top: 2px; }
  .res-popup__close {
    background: none; border: none; cursor: pointer; color: var(--tc-muted);
    padding: 2px; border-radius: 4px; display: flex; transition: color 0.12s;
  }
  .res-popup__close:hover { color: var(--tc-ink); }

  .res-popup__detail { padding: 16px 20px 0; }
  .res-popup__row {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 0; border-bottom: 1px solid var(--tc-card-border-soft);
    font-size: 0.875rem;
  }
  .res-popup__row:last-child { border-bottom: none; }
  .res-popup__row-label { color: var(--tc-muted); font-size: 0.78rem; min-width: 52px; }
  .res-popup__row-value { color: var(--tc-ink); font-weight: 600; }
  .res-popup__duration {
    display: inline-block; background: var(--tc-chip-bg);
    border-radius: 4px; padding: 1px 6px;
    font-size: 0.72rem; font-weight: 700; color: var(--tc-muted); margin-left: 6px;
  }
  .res-popup__row-icon { width: 16px; text-align: center; color: var(--tc-faint); font-size: 0.85rem; }

  .res-popup__notice {
    display: flex; align-items: flex-start; gap: 8px;
    margin: 14px 20px 0;
    background: rgba(234,179,8,0.08); border: 1px solid rgba(234,179,8,0.25);
    border-radius: 8px; padding: 10px 12px;
    font-size: 0.78rem; color: var(--tc-muted); line-height: 1.5;
  }
  .res-popup__notice svg { flex-shrink: 0; margin-top: 1px; color: #ca8a04; }
  .res-popup__actions { display: flex; gap: 10px; padding: 16px 20px 20px; }

  .res-popup__msg {
    margin: 0 20px 16px; padding: 9px 12px; border-radius: 7px;
    font-size: 0.82rem; font-weight: 600; line-height: 1.4;
    display: flex; align-items: center; gap: 6px;
  }
  .res-popup__msg--error { background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.25); color: var(--tc-hot); }
  .res-popup__msg--conflict { background: rgba(234,179,8,0.08); border: 1px solid rgba(234,179,8,0.3); color: #ca8a04; }

  .res-popup__recurring { padding: 14px 20px 0; }
  .recurring-toggle { display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; }
  .recurring-toggle input { width: 16px; height: 16px; accent-color: var(--tc-accent); cursor: pointer; }
  .recurring-toggle__label { font-size: 0.82rem; font-weight: 600; color: var(--tc-muted); }
  .recurring-weeks-row {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px; background: var(--tc-overlay); border: 1px solid var(--tc-card-border);
    border-radius: 8px;
  }
  .recurring-weeks-label { font-size: 0.78rem; color: var(--tc-muted); white-space: nowrap; }
  .recurring-weeks-select {
    flex: 1; padding: 4px 8px; border: 1px solid var(--tc-card-border);
    border-radius: 6px; background: var(--tc-input-bg); color: var(--tc-ink);
    font-size: 0.82rem; font-family: var(--font-sans);
  }

  /* ── Toast ─────────────────────────────────────────────────────────────── */
  .res-toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 60;
    background: var(--tc-card-bg); border: 1px solid var(--tc-card-border);
    border-radius: 10px; padding: 12px 18px;
    font-size: 0.875rem; font-weight: 600; box-shadow: var(--tc-shadow);
    color: var(--tc-ink); display: flex; align-items: center; gap: 8px;
  }
