---
// reset-password.astro — publiczna strona resetu hasła
// ?token=... → tryb confirm (ustawienie nowego hasła)
// bez tokenu → tryb request (podaj email)
export const prerender = false;

import AuthCard from '@/components/AuthCard.astro';
import ResetPasswordForm from '@/components/ResetPasswordForm.tsx';
---

<AuthCard
  pageTitle="Reset hasła — Raketon"
  title="Reset hasła"
  subtitle="Odzyskaj dostęp do swojego konta"
>
  <ResetPasswordForm client:load />
</AuthCard>
