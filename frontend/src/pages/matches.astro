---
// matches.astro — historia meczów połączona z Django API
// GET /api/matches/history/ (IsAuthenticated — wymaga cookie sesji)
// SSR wymagane (prerender = false) — potrzebujemy cookie sesji z requestu
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import MatchHistory from '@/components/MatchHistory.tsx';
import ClubMatches from '@/components/ClubMatches.tsx';
import { getMatchHistory, getCurrentUser, getClubMatches, type MatchHistoryEntry, type MatchUser } from '@/lib/api';
import { url } from '@/lib/url';

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
let rawMatches: MatchHistoryEntry[] = [];
let isLive = false;

const [matchData, currentUser, clubMatchesData] = await Promise.all([
  getMatchHistory(sessionCookie).catch(() => null),
  getCurrentUser(sessionCookie).catch(() => null),
  getClubMatches(sessionCookie, 50).catch(() => []),
]);

if (matchData !== null && matchData !== undefined) {
  rawMatches = matchData;
  isLive = true;
}

const userDisplayName = currentUser
  ? [currentUser.first_name, currentUser.last_name].filter(Boolean).join(' ') || currentUser.username
  : null;

const currentYear = new Date().getFullYear();

// ── Helpers ──────────────────────────────────────────────────────────────────

function userName(u: MatchUser | null): string {
  if (!u) return '?';
  const full = [u.first_name, u.last_name].filter(Boolean).join(' ');
  return full || u.username;
}

// Skrócona forma do debli: "Marek Kowalski" → "M. Kowalski". Username bez zmian.
function shortName(u: MatchUser | null): string {
  if (!u) return '?';
  if (u.first_name && u.last_name) return `${u.first_name[0]}. ${u.last_name}`;
  return u.last_name || u.first_name || u.username || '?';
}


function formatScore(m: MatchHistoryEntry, isP1Side: boolean): string {
  const sets: string[] = [];
  const pairs: [number | null, number | null][] = [
    [m.p1_set1, m.p2_set1],
    [m.p1_set2, m.p2_set2],
    [m.p1_set3, m.p2_set3],
  ];
  for (let i = 0; i < pairs.length; i++) {
    const [p1s, p2s] = pairs[i];
    if (p1s !== null && p2s !== null) {
      if (i === 2 && p1s === 0 && p2s === 0) continue;
      const my = isP1Side ? p1s : p2s;
      const opp = isP1Side ? p2s : p1s;
      sets.push(`${my}:${opp}`);
    }
  }
  return sets.join(' ') || '—';
}

function setsScore(m: MatchHistoryEntry, isP1Side: boolean): string {
  let won = 0, lost = 0;
  const pairs: [number | null, number | null][] = [
    [m.p1_set1, m.p2_set1],
    [m.p1_set2, m.p2_set2],
    [m.p1_set3, m.p2_set3],
  ];
  for (const [p1s, p2s] of pairs) {
    if (p1s === null || p2s === null) continue;
    const my = isP1Side ? p1s : p2s;
    const opp = isP1Side ? p2s : p1s;
    if (my > opp) won++;
    else if (opp > my) lost++;
  }
  return `${won}:${lost}`;
}

function formatDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' });
}

// ── Map API data → UI rows ──────────────────────────────────────────────────

function mapMatch(m: MatchHistoryEntry) {
  const resultMap = {
    'user-win':  { result: 'win'  as const, label: 'Wygrana',  letter: 'W' },
    'user-loss': { result: 'loss' as const, label: 'Porażka',  letter: 'P' },
    'user-draw': { result: 'draw' as const, label: 'Remis',    letter: 'R' },
  };
  const r = resultMap[m.user] ?? { result: 'draw' as const, label: '—', letter: '?' };

  const uid = currentUser?.id ?? null;
  const inTeamA = uid !== null && (m.p1?.id === uid || m.p3?.id === uid);
  const isP1Side =
    (m.user === 'user-win'  && m.win === 'p1') ||
    (m.user === 'user-loss' && m.win === 'p2') ||
    (m.user === 'user-draw' && inTeamA);

  const oppTeam: [MatchUser | null, MatchUser | null] = isP1Side ? [m.p2, m.p4] : [m.p1, m.p3];
  const opponentObj = oppTeam[0] ?? oppTeam[1];
  const opponent = userName(opponentObj);

  const isDouble = m.match_double;
  // Dla debla skracamy do "M. Kowalski / J. Nowak" — żeby się mieściło w jednej linii.
  const oppNames = oppTeam.map(p => isDouble ? shortName(p) : userName(p)).filter(n => n !== '?');
  const opponentFull = isDouble && oppNames.length > 1
    ? oppNames.join(' / ')
    : oppNames[0] ?? opponent;

  const isTournament = m.is_tournament ?? false;
  const tournamentId = m.tournament_id ?? null;
  const matchIdNum = typeof m.id === 'number' ? m.id : null;

  const TOURNAMENT_TYPE_LABEL: Record<string, string> = {
    RND: 'Round Robin',
    SGL: 'Eliminacja',
    DBE: 'Elim. podwójna',
    LDR: 'Drabinka',
    AMR: 'Americano',
    SWS: 'Szwajcarski',
  };

  let typeLabel: string;
  if (isTournament) {
    const tName = m.tournament_name
      ?? (m.description?.startsWith('Turniej: ') ? m.description.slice('Turniej: '.length) : null);
    const tType = m.tournament_type ? TOURNAMENT_TYPE_LABEL[m.tournament_type] ?? null : null;
    if (tName && tType) typeLabel = `${tName} · ${tType}`;
    else if (tName)     typeLabel = tName;
    else                typeLabel = 'Turniejowy';
  } else {
    typeLabel = 'Towarzyski';
  }

  const href = isTournament && tournamentId
    ? url(`/tournaments/${tournamentId}`)
    : matchIdNum ? url(`/matches/${matchIdNum}`) : '#';

  return {
    id: m.id,
    href,
    result: r.result,
    resultLetter: r.letter,
    opponentFull,
    isDouble,
    isTournament,
    date: formatDate(m.match_date),
    rawDate: m.match_date,
    score: formatScore(m, isP1Side),
    setsScore: setsScore(m, isP1Side),
    format: (m.match_double ? 'DBL' : 'SNG') as 'SNG' | 'DBL',
    formatLabel: m.match_double ? 'Debel' : 'Singiel',
    typeLabel,
  };
}

const matches = isLive ? rawMatches.map(mapMatch) : [];
const clubMatches = clubMatchesData ?? [];
---

<AppLayout
  title="Mecze"
  greeting="Historia meczów"
  greetingSub={userDisplayName ? `${userDisplayName} · sezon ${currentYear}` : undefined}
  showSearch={false}
  showCta={true}
  ctaLabel="+ Dodaj mecz towarzyski"
  ctaLabelMobile="+ Mecz"
  ctaHref="#add-match"
>
  <!-- Przełącznik scope: Moje mecze / Mecze klubu -->
  <div class="matches-scope-switch">
    <button
      type="button"
      class="mss-btn mss-btn--active"
      id="mss-mine"
      aria-pressed="true"
    >Moje mecze</button>
    <button
      type="button"
      class="mss-btn"
      id="mss-club"
      aria-pressed="false"
      title="Zakończone mecze turniejowe rozgrywane w klubie"
    >Mecze klubu</button>
  </div>

  <div id="matches-panel-mine">
    <MatchHistory
      client:load
      matches={matches}
      userDisplayName={userDisplayName}
      addMatchUrl={url('/matches/add')}
      myId={currentUser?.id}
      today={new Date().toISOString().slice(0, 10)}
    />
  </div>

  <div id="matches-panel-club" style="display:none">
    <ClubMatches
      client:load
      matches={clubMatches}
      tournamentsUrl={url('/tournaments')}
      matchesUrl={url('/matches')}
    />
  </div>
</AppLayout>

<script is:inline define:vars={{ tournamentsUrl: url('/tournaments') }}>
  // Na mobile: "+ Mecz" otwiera mini-menu wyboru (towarzyski / turniejowy).
  // Na desktopie: od razu otwiera modal dodawania meczu towarzyskiego.
  let addMatchSheet = null;

  function closeAddMatchSheet() {
    if (addMatchSheet) {
      addMatchSheet.remove();
      addMatchSheet = null;
      document.removeEventListener('click', onDocClickCloseSheet);
    }
  }

  function onDocClickCloseSheet(e) {
    if (addMatchSheet && !addMatchSheet.contains(e.target) && !e.target.closest('.topbar__cta')) {
      closeAddMatchSheet();
    }
  }

  function openAddMatchSheet(anchor) {
    closeAddMatchSheet();
    const sheet = document.createElement('div');
    sheet.className = 'add-match-sheet';
    sheet.innerHTML = `
      <button type="button" class="add-match-sheet__item" data-action="friendly">
        <span class="add-match-sheet__icon" aria-hidden="true">🎾</span>
        <span>Dodaj mecz towarzyski</span>
      </button>
      <button type="button" class="add-match-sheet__item" data-action="tournament">
        <span class="add-match-sheet__icon" aria-hidden="true">🏆</span>
        <span>Dodaj mecz turniejowy</span>
      </button>
    `;
    document.body.appendChild(sheet);

    const rect = anchor.getBoundingClientRect();
    sheet.style.top = `${rect.bottom + window.scrollY + 6}px`;
    sheet.style.right = `${Math.max(8, window.innerWidth - rect.right)}px`;

    sheet.querySelector('[data-action="friendly"]').addEventListener('click', () => {
      closeAddMatchSheet();
      window.dispatchEvent(new CustomEvent('open-add-match-modal'));
    });
    sheet.querySelector('[data-action="tournament"]').addEventListener('click', () => {
      closeAddMatchSheet();
      window.location.href = tournamentsUrl;
    });

    addMatchSheet = sheet;
    setTimeout(() => document.addEventListener('click', onDocClickCloseSheet), 0);
  }

  document.addEventListener('click', (e) => {
    const cta = e.target.closest('.topbar__cta');
    if (cta && cta.getAttribute('href') === '#add-match') {
      e.preventDefault();
      if (window.matchMedia('(max-width: 640px)').matches) {
        if (addMatchSheet) closeAddMatchSheet();
        else openAddMatchSheet(cta);
      } else {
        window.dispatchEvent(new CustomEvent('open-add-match-modal'));
      }
    }
  });

  (function () {
    const btnMine  = document.getElementById('mss-mine');
    const btnClub  = document.getElementById('mss-club');
    const panelMine = document.getElementById('matches-panel-mine');
    const panelClub = document.getElementById('matches-panel-club');
    if (!btnMine || !btnClub || !panelMine || !panelClub) return;

    function activate(scope) {
      const isMine = scope === 'mine';
      btnMine.classList.toggle('mss-btn--active', isMine);
      btnClub.classList.toggle('mss-btn--active', !isMine);
      btnMine.setAttribute('aria-pressed', String(isMine));
      btnClub.setAttribute('aria-pressed', String(!isMine));
      panelMine.style.display = isMine ? '' : 'none';
      panelClub.style.display = isMine ? 'none' : '';
    }

    btnMine.addEventListener('click', () => activate('mine'));
    btnClub.addEventListener('click', () => activate('club'));
  })();
</script>

<style is:global>
  /* ── Scope switch (Moje mecze / Mecze klubu) ─────────────────────────── */
  .matches-scope-switch {
    display: flex;
    gap: 2px;
    padding: 2px;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 10px;
    width: fit-content;
    margin-bottom: 20px;
  }

  .mss-btn {
    padding: 7px 20px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: var(--tc-muted);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }

  .mss-btn:hover { color: var(--tc-sub); }

  .mss-btn--active {
    background: var(--tc-card-bg);
    color: var(--tc-ink);
    box-shadow: var(--tc-shadow);
  }

  /* ── "+ Mecz" action sheet (mobile) ──────────────────────────────────── */
  .add-match-sheet {
    position: fixed;
    z-index: 210;
    min-width: 220px;
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: var(--radius-md, 10px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25), 0 2px 8px rgba(0,0,0,0.15);
    overflow: hidden;
    animation: add-match-sheet-enter 0.15s ease;
  }
  @keyframes add-match-sheet-enter {
    from { opacity: 0; transform: translateY(-6px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .add-match-sheet__item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 16px;
    background: none;
    border: none;
    border-bottom: 1px solid var(--tc-card-border);
    color: var(--tc-ink);
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 0.1s;
  }
  .add-match-sheet__item:last-child { border-bottom: none; }
  .add-match-sheet__item:hover,
  .add-match-sheet__item:active { background: var(--tc-overlay); }

  .add-match-sheet__icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  /* ── Club matches ─────────────────────────────────────────────────────── */
  .cm-scope-hint {
    font-size: 0.72rem;
    color: var(--tc-muted);
    margin: 2px 0 0;
    font-weight: 400;
  }

  .cm-type-sep { color: var(--tc-faint); }
  .cm-type-friendly { color: var(--tc-sub); }

  .cm-loading-badge { opacity: 0.5; }

  .cm-fetch-error {
    padding: 10px 20px;
    font-size: 0.82rem;
    color: var(--tc-danger, #ef4444);
    background: color-mix(in srgb, var(--tc-danger, #ef4444) 8%, transparent);
    border-bottom: 1px solid var(--tc-card-border);
  }

  /* Mecze klubu — zwycięstwo per strona */
  .cm-team--win { color: var(--tc-ink); font-weight: 700; }
  .cm-vs { color: var(--tc-faint); font-weight: 500; }
  .cm-trophy { margin-left: 4px; font-size: 0.85em; }
  .cm-agg--win { color: var(--tc-accent); }
  .cm-agg--lose { color: var(--tc-muted); }
  .cm-agg-sep { color: var(--tc-faint); margin: 0 1px; }

  .m-score {
    font-family: var(--font-mono-plex, 'IBM Plex Mono', monospace);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tc-ink);
  }



  .m-my-chip {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    color: var(--tc-muted);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .m-added-banner {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px; border-radius: 8px; margin-bottom: 16px;
    background: var(--tc-accent-soft);
    border: 1px solid var(--tc-accent-border);
    color: var(--tc-accent); font-size: 0.84rem; font-weight: 600;
  }

  .m-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  .m-stat-card {
    background: var(--tc-card-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background 0.25s, border-color 0.25s;
  }

  .m-stat-card--accent {
    border-color: var(--tc-accent-border);
  }

  .m-stat-card__value {
    font-size: 2rem;
    font-weight: 800;
    color: var(--tc-ink);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }

  .m-stat-card__streak-letter {
    font-size: 1rem;
    font-weight: 500;
    color: var(--tc-muted);
    margin-left: 2px;
  }

  .m-stat-card__sub {
    font-size: 0.72rem;
    color: var(--tc-muted);
  }

  .m-table-card { padding: 0; overflow: hidden; border-radius: 14px; }

  /* ── Rząd 1: nagłówek + search ─────────────────────────────────────────── */
  .m-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px 10px;
    gap: 12px;
  }

  /* ── Rząd 2: filtry + sortowanie ───────────────────────────────────────── */
  .m-filters-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    padding: 0 20px 12px;
    border-bottom: 1px solid var(--tc-card-border);
  }

  .m-filter-groups {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }

  .m-sort-group {
    flex-shrink: 0;
    padding-left: 16px;
    border-left: 1px solid var(--tc-card-border-soft);
  }

  /* ── Labeled filter (etykieta + control) ───────────────────────────────── */
  .m-labeled-filter {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .m-filter-label {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tc-faint);
    padding-left: 2px;
  }

  /* ── Search ─────────────────────────────────────────────────────────────── */
  .m-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .m-search__icon {
    position: absolute;
    left: 9px;
    color: var(--tc-muted);
    pointer-events: none;
    flex-shrink: 0;
  }

  .m-search {
    height: 32px;
    padding: 0 10px 0 30px;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 7px;
    color: var(--tc-ink);
    font-size: 0.78rem;
    font-family: var(--font-sans);
    width: 180px;
    outline: none;
    transition: border-color 0.15s, width 0.2s;
  }
  .m-search:focus { border-color: var(--tc-accent); width: 220px; }
  .m-search::placeholder { color: var(--tc-muted); }
  .m-search::-webkit-search-cancel-button { -webkit-appearance: none; }

  /* wariant dla "Mecze klubu" — dłuższy placeholder */
  .m-search--wide { width: 240px; }
  .m-search--wide:focus { width: 280px; }

  /* ── Segmented controls ─────────────────────────────────────────────────── */
  .m-segmented {
    display: flex;
    padding: 2px;
    background: var(--tc-chip-bg);
    border-radius: 7px;
  }

  .m-seg {
    padding: 4px 10px;
    background: transparent;
    border: none;
    border-radius: 5px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--tc-muted);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }
  .m-seg:hover { color: var(--tc-sub); }

  .m-seg--active {
    background: var(--tc-card-bg);
    color: var(--tc-ink);
    box-shadow: var(--tc-shadow);
  }

  .m-table-head {
    display: grid;
    grid-template-columns: 40px 1fr 220px 110px 120px;
    gap: 12px;
    padding: 8px 20px;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--tc-faint);
    border-bottom: 1px solid var(--tc-card-border);
  }

  .m-th-right { text-align: right; }

  .m-row {
    display: grid;
    grid-template-columns: 40px 1fr 220px 110px 120px;
    gap: 12px;
    padding: 14px 20px;
    align-items: center;
    border-bottom: 1px solid var(--tc-card-border-soft);
    transition: background 0.1s;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }
  .m-row:last-child { border-bottom: none; }
  .m-row:hover { background: var(--tc-overlay); }

  .m-result-badge {
    width: 32px; height: 24px; border-radius: 5px;
    display: grid; place-items: center;
    font-size: 0.68rem; font-weight: 700; flex-shrink: 0;
  }
  .m-result-badge--win { background: var(--tc-accent-soft); border: 1px solid var(--tc-accent-border); color: var(--tc-accent); }
  .m-result-badge--loss { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: var(--tc-hot); }
  .m-result-badge--draw { background: var(--tc-overlay); border: 1px solid var(--tc-card-border); color: var(--tc-muted); }
  /* neutral: inicjały zwycięzcy w klubie — bez konotacji win/loss z perspektywy usera */
  .m-result-badge--neutral {
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    color: var(--tc-sub);
    font-size: 0.62rem;
    letter-spacing: 0.02em;
  }

  .m-opponent { min-width: 0; }
  .m-opponent__name {
    font-size: 0.875rem; font-weight: 600; color: var(--tc-ink);
    line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .m-opponent__name--dbl { font-size: 0.8rem; }
  .m-row:hover .m-opponent__name { color: var(--tc-accent); }
  .m-opponent__type {
    font-size: 0.72rem; color: var(--tc-muted); margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .m-sets { display: flex; align-items: baseline; gap: 8px; }
  .m-sets__score { font-size: 1.1rem; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--tc-ink); }
  .m-sets__score--win { color: var(--tc-accent); }
  .m-sets__score--loss { color: var(--tc-ink); }
  .m-sets__score--draw { color: var(--tc-muted); }
  .m-sets__detail {
    font-size: 0.72rem; font-weight: 500; color: var(--tc-muted);
    font-family: var(--font-mono-plex); white-space: nowrap;
  }

  .m-format { font-size: 0.78rem; color: var(--tc-sub); }
  .m-date { font-size: 0.78rem; color: var(--tc-muted); text-align: right; white-space: nowrap; }

  @media (max-width: 1024px) {
    .m-stats { grid-template-columns: repeat(2, 1fr); }
    .m-table-head { display: none; }
