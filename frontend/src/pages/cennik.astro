---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { url } from '@/lib/url';

export const prerender = false;
---

<PublicLayout
  title="Cennik"
  description="Cennik systemu zarządzania klubem tenisowym. Skontaktuj się z nami, aby otrzymać ofertę dopasowaną do Twojego klubu."
>
  <div class="relative overflow-hidden w-full min-h-screen">
    <!-- Tło graficzne z filtrem grayscale i kryciem -->
    <div class="absolute inset-0 bg-surface bg-[url('/static/img/background_01.png')] bg-no-repeat bg-top bg-cover bg-fixed filter grayscale(1) opacity-[0.45] z-0 pointer-events-none"></div>
    
    <!-- Gradient radialny i liniowy -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/20 via-white/60 to-white/80 z-[1]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.6)_0%,rgba(255,255,255,0.05)_100%)] z-[1]"></div>
    
    <div class="relative z-[2] w-full">
      <section class="py-20 px-8 max-[480px]:py-12 max-[480px]:px-4 bg-transparent">
        <div class="max-w-[860px] mx-auto">
          <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] font-black text-[#1A1A1A] tracking-[-0.03em] mb-6 leading-[1.2]">
            Cennik
          </h1>
          <p class="text-[clamp(1.05rem,1.8vw,1.2rem)] text-[#475569] mb-12 leading-[1.65] font-medium">
            Oferta dopasowana do wielkości klubu i zakresu funkcji.
          </p>

          <div class="bg-white/85 backdrop-blur-[6px] border border-gray-200/60 shadow-sm rounded-[12px] p-8 text-center max-w-[480px] mb-8 hover:shadow-md transition-all duration-300">
            <div class="text-[2.5rem] mb-4 leading-none">📬</div>
            <h2 class="text-xl font-bold mb-3 text-[#0f172a]">Indywidualna oferta</h2>
            <p class="text-[0.95rem] text-[#64748b] leading-[1.6] mb-8">
              Napisz do nas z informacją o liczbie kortów, graczy i potrzebnych funkcjach.
              Odpowiemy w ciągu 24 godzin.
            </p>
            <a href={url('/kontakt')} class="tc-btn tc-btn-primary tc-btn-lg !bg-[#5a7d22] hover:!bg-[#47621a] !border-[#5a7d22] hover:!border-[#47621a] !text-white font-semibold transition-all duration-300 transform hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[#5a7d22]/20 !rounded-[8px] !py-3.5 !px-8 !text-base shrink-0 w-full">
              Zapytaj o ofertę
            </a>
          </div>

          <p class="text-[0.875rem] text-[#94a3b8] font-medium">
            Rejestracja i testowanie systemu jest bezpłatne.
          </p>
        </div>
      </section>
    </div>
  </div>
</PublicLayout>
