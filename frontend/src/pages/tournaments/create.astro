---
// tournaments/create.astro — wizard tworzenia nowego turnieju (3 kroki)
export const prerender = false;

import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CreateTournamentWizard from '@/components/CreateTournamentWizard.tsx';
import { getCurrentUser } from '@/lib/api';
import { url } from '@/lib/url';

const sessionCookie = Astro.request.headers.get('cookie') ?? undefined;
const currentUser = await getCurrentUser(sessionCookie);

if (!currentUser) {
  return Astro.redirect(url('/login') + '?next=' + encodeURIComponent(url('/tournaments/create')));
}
---

<AppLayout title="Nowy turniej" showSearch={false} showCta={false} currentUser={currentUser}>
  <nav class="tc-breadcrumb" aria-label="Nawigacja">
    <a href={url('/tournaments/manage')}>&larr; Moje turnieje</a>
  </nav>

  <PageHeader
    title="Nowy turniej"
    subtitle="Skonfiguruj turniej krok po kroku"
  />

  <CreateTournamentWizard
    client:load
    manageUrl={url('/tournaments/manage')}
    tournamentBaseUrl={url('/tournaments')}
  />
</AppLayout>

<style is:global>
  /* ═══ WIZARD ═══ */
  .wiz-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding-bottom: 48px;
  }

  .wiz-progress { margin-bottom: 28px; }
  .wiz-steps { display: flex; align-items: center; }
  .wiz-step {
    display: flex; flex-direction: column; align-items: center; gap: 5px;
    flex-shrink: 0;
  }
  .wiz-step__dot {
    width: 34px; height: 34px; border-radius: 50%;
    border: 2px solid var(--tc-card-border);
    background: var(--tc-card-bg);
    color: var(--tc-muted);
    font-size: 0.82rem; font-weight: 700;
    display: grid; place-items: center;
    transition: background 0.2s, border-color 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .wiz-step__label {
    font-size: 0.72rem; font-weight: 600;
    color: var(--tc-muted);
    transition: color 0.2s;
  }
  .wiz-step--active .wiz-step__dot {
    background: var(--tc-accent);
    border-color: var(--tc-accent);
    color: var(--tc-accent-ink);
    box-shadow: 0 0 12px var(--tc-accent-glow);
  }
  .wiz-step--active .wiz-step__label { color: var(--tc-accent); }
  .wiz-step--done .wiz-step__dot {
    background: var(--tc-accent-soft);
    border-color: var(--tc-accent-border);
    color: var(--tc-accent);
  }
  .wiz-step--done .wiz-step__label { color: var(--tc-sub); }
  .wiz-step-connector {
    flex: 1; height: 2px;
    background: var(--tc-card-border);
    margin: 0 8px; margin-bottom: 22px;
  }

  .wiz-card {
    background: var(--tc-card-bg);
    border-color: var(--tc-card-border);
    border-radius: var(--radius-lg);
    padding: var(--tc-card-pad) 28px;
  }

  .wiz-pane__title {
    font-size: 1.05rem; font-weight: 700; color: var(--tc-ink);
    margin: 0 0 4px;
  }
  .wiz-pane__sub {
    font-size: 0.82rem; color: var(--tc-sub);
    margin: 0 0 24px;
  }

  .wiz-alert {
    padding: 10px 14px; border-radius: var(--radius-sm);
    font-size: 0.84rem; margin-bottom: 20px;
  }
  .wiz-alert--err {
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.25);
    color: #ef4444;
  }

  /* ── Form fields ── */
  .cr-field {
    display: flex; flex-direction: column; gap: 5px;
    margin-bottom: 18px;
  }
  .cr-field--sm { max-width: 120px; }

  .cr-label {
    font-size: 0.78rem; font-weight: 600;
    color: var(--tc-sub);
  }
  .cr-required { color: var(--tc-hot); }

  .cr-input {
    padding: 9px 12px; border-radius: var(--radius-xs);
    border: 1px solid var(--tc-card-border);
    background: var(--tc-input-bg); color: var(--tc-ink);
    font-size: 0.88rem; font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%; box-sizing: border-box;
  }
  .cr-input:focus {
    border-color: var(--tc-accent);
    box-shadow: 0 0 0 3px var(--tc-accent-soft);
  }
  .cr-input::placeholder { color: var(--tc-faint); }
  .cr-select { cursor: pointer; }
  .cr-textarea { resize: vertical; min-height: 60px; }

  .cr-row {
    display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 0;
  }
  .cr-row .cr-field { flex: 1; min-width: 120px; }

  .cr-hint { font-size: 0.74rem; color: var(--tc-muted); }
  .cr-hint--warn { color: var(--tc-warning, #b45309); margin-top: 4px; display: block; }

  .cr-checkbox-label {
    display: flex; align-items: center; gap: 10px;
    cursor: pointer; font-size: 0.9rem; color: var(--tc-ink);
  }
  .cr-checkbox-label input[type="checkbox"] {
    width: 16px; height: 16px; flex-shrink: 0;
    accent-color: var(--tc-accent); cursor: pointer;
  }

  /* ── Actions ── */
  .wiz-actions {
    display: flex; align-items: center; gap: 12px;
    margin-top: 28px; flex-wrap: wrap;
  }

  /* ── Config spinners ── */
  /* Sekcja mechaniki (Sety/Gemy/Uczestnicy) — zachowuje stary styl */
  .cfg-group-label {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--tc-muted);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--tc-card-border-soft);
    margin-bottom: 14px;
  }

  .cfg-spinners-row {
    display: flex; gap: 18px; flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .cfg-spinner-col {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
  }
  .cfg-spinner-label {
    font-size: 0.72rem; color: var(--tc-sub); text-align: center;
    white-space: nowrap;
  }
  .cfg-hint {
    font-size: 0.68rem; color: var(--tc-muted); text-align: center;
  }

  .cfg-spinner {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
  }
  .cfg-spin-btn {
    width: 64px; height: 22px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.6rem; line-height: 1;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: var(--radius-xs);
    color: var(--tc-sub);
    cursor: pointer; user-select: none;
    transition: background 0.12s, color 0.12s, border-color 0.12s;
  }
  .cfg-spin-btn:hover {
    background: var(--tc-accent);
    color: var(--tc-accent-ink);
    border-color: var(--tc-accent);
  }
  .cfg-spin-btn:active { transform: scale(0.94); }

  .cfg-spin-input {
    width: 64px; height: 38px; text-align: center;
    font-size: 1rem; font-weight: 700;
    font-family: var(--font-mono);
    border: 1px solid var(--tc-card-border);
    border-radius: var(--radius-xs);
    background: var(--tc-input-bg); color: var(--tc-ink);
    outline: none;
    -moz-appearance: textfield; appearance: textfield;
  }
  .cfg-spin-input::-webkit-outer-spin-button,
  .cfg-spin-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .cfg-spin-input:focus {
    border-color: var(--tc-accent);
    box-shadow: 0 0 0 2px var(--tc-accent-soft);
  }

  /* Grupy punktów — etykieta i spinners jako jeden blok */
  .cfg-point-group {
    margin-top: 20px;
  }
  .cfg-point-group__label {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--tc-muted);
    margin-bottom: 10px;
    display: flex; align-items: center; gap: 8px;
  }
  .cfg-point-group__label::after {
    content: ''; flex: 1;
    height: 1px; background: var(--tc-card-border-soft);
  }
  .cfg-point-group__row {
    display: flex; gap: 12px; flex-wrap: wrap;
  }
  /* Spinner wewnątrz grupy punktów: label nad inputem, wyrównany poziomo */
  .cfg-point-group .cfg-spinner-col {
    flex: 1; min-width: 80px; max-width: 140px;
  }

  .cr-field--checkbox {
    flex-direction: row; align-items: center;
    gap: 10px; cursor: pointer; margin-bottom: 4px;
  }
  .cr-field--checkbox input[type="checkbox"] {
    width: 16px; height: 16px; flex-shrink: 0;
    accent-color: var(--tc-accent); cursor: pointer;
  }
  .cr-field--checkbox span {
    font-size: 0.9rem; color: var(--tc-ink);
  }

  /* ── Summary ── */
  .sum-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
    margin-bottom: 4px;
  }
  @media (max-width: 520px) { .sum-grid { grid-template-columns: 1fr; } }

  .sum-group {
    background: var(--tc-card-bg-2, var(--tc-card-bg));
    border: 1px solid var(--tc-card-border);
    border-radius: var(--radius-sm); overflow: hidden;
  }
  .sum-group-label {
    padding: 8px 14px;
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--tc-muted);
    background: var(--tc-chip-bg);
    border-bottom: 1px solid var(--tc-card-border-soft);
  }
  .sum-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 6px 14px;
    font-size: 0.82rem; color: var(--tc-sub);
    border-bottom: 1px solid var(--tc-card-border-soft);
  }
  .sum-row:last-child { border-bottom: none; }
  .sum-row strong { color: var(--tc-ink); font-weight: 600; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .wiz-card { padding: 16px; }
    .cr-row { flex-direction: column; gap: 0; }
    .cfg-spinners-row { gap: 12px; }
    .wiz-step__label { font-size: 0.65rem; }
  }
</style>
