---
// OrgPanelHeader — card header + locked msg + status section, shared across all 3 org panels.
import { url } from '@/lib/url';

interface Props {
  status: string;
  statusLabel: string;
}

const { status, statusLabel } = Astro.props;
---

<div class="tc-card-header org-panel-header" id="org-panel-toggle-header" style="cursor:pointer;" title="Kliknij aby zwinąć / rozwinąć">
  <span class="tc-card-title">
    <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" style="display:inline-block;vertical-align:-2px;margin-right:6px;color:var(--tc-accent);">
      <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
    </svg>
    Zarządzanie turniejem
  </span>
  <div style="display:flex;align-items:center;gap:8px;">
    <a href={url('/tournaments/manage')} class="org-manage-link" onclick="event.stopPropagation()">
      <svg width="11" height="11" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
      </svg>
      Moje turnieje
    </a>
    <span class="tc-badge tc-badge-warning" style="font-size:0.72rem;">Organizator</span>
    <span class="org-toggle-hint">
      <span class="org-toggle-hint__label">zwiń</span>
      <span class="org-toggle-chevron" aria-hidden="true">▲</span>
    </span>
  </div>
</div>

<div id="org-locked-msg" style="display:none;" class="org-locked-notice">
  Turniej jest zakończony lub odwołany — edycja wyników jest zablokowana.
</div>

<!-- Status -->
<div id="org-status-section" style="padding:0 20px 16px; border-bottom:1px solid var(--tc-card-border);">
  <div class="org-section-label" style="margin-bottom:10px;">Status turnieju</div>
  <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
    <span id="org-status-badge" class="tc-badge tc-badge-neutral" style="font-size:0.8rem;">
      {statusLabel}
    </span>
    <div id="org-status-actions" style="display:flex;gap:8px;flex-wrap:wrap;"></div>
    <span id="org-status-msg" class="org-form-msg" style="margin-left:4px;"></span>
  </div>
</div>
