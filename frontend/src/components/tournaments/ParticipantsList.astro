---
// ParticipantsList — public participants card shared across SGL, AMR, RND views.
// phone_number widoczny tylko dla zalogowanych (isLoggedIn=true).
interface Props {
  participants: Array<{
    display_name: string;
    seed_number?: number | null;
    phone_number?: string | null;
  }>;
  count: number;
  isLoggedIn?: boolean;
}

const { participants, count, isLoggedIn = false } = Astro.props;

function getInitials(name: string): string {
  return name.split(' ').filter((w: string) => w && w !== '/').slice(0, 2).map((w: string) => w[0]).join('');
}

const showSearch = participants.length >= 1;
const listId = `pl-list-${Math.random().toString(36).slice(2, 7)}`;
---

{participants.length > 0 && (
  <div class="tc-card" style="margin-bottom:24px;">
    <div class="tc-card-header">
      <span class="tc-card-title">Uczestnicy ({count})</span>
      {showSearch && (
        <div class="pl-search-wrap">
          <svg class="pl-search-icon" width="13" height="13" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
          </svg>
          <input
            type="search"
            class="pl-search"
            placeholder="Szukaj uczestnika…"
            aria-label="Szukaj uczestnika"
            autocomplete="off"
            data-list={listId}
          />
        </div>
      )}
    </div>
    <div class="td-participants-grid" id={listId}>
      {participants.map(p => (
        <div class="td-participant-card" data-name={p.display_name.toLowerCase()}>
          <div class="td-participant-card__avatar-wrap">
            <div class="td-participant-card__avatar" aria-hidden="true">
              {getInitials(p.display_name)}
            </div>
            {p.seed_number && (
              <span class="td-participant-card__seed" title={`Rozstawienie #${p.seed_number}`}>
                #{p.seed_number}
              </span>
            )}
          </div>
          <div class="td-participant-card__info">
            <div class="td-participant-card__name">{p.display_name}</div>
            <div class="td-participant-card__status">
              {p.seed_number ? `Rozstawiony #${p.seed_number}` : 'Uczestnik'}
            </div>
            {isLoggedIn && p.phone_number && (
              <a href={`tel:${p.phone_number}`} class="td-participant-phone">
                📞 {p.phone_number}
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
    <div class="pl-empty" id={`${listId}-empty`} style="display:none; padding:12px 20px; font-size:0.82rem; color:var(--tc-muted);">
      Brak uczestników pasujących do wyszukiwania.
    </div>
  </div>
)}

{showSearch && (
  <script>
    document.querySelectorAll('.pl-search').forEach(input => {
      const listId = (input as HTMLInputElement).dataset.list!;
      const list = document.getElementById(listId)!;
      const empty = document.getElementById(`${listId}-empty`)!;
      input.addEventListener('input', () => {
        const q = (input as HTMLInputElement).value.toLowerCase().trim();
        let visible = 0;
        list.querySelectorAll<HTMLElement>('.td-participant-card').forEach(card => {
          const match = !q || card.dataset.name!.includes(q);
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        empty.style.display = visible === 0 ? '' : 'none';
      });
    });
  </script>
)}

<style>
  .pl-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .pl-search-icon {
    position: absolute;
    left: 8px;
    color: var(--tc-muted);
    pointer-events: none;
  }
  .pl-search {
    height: 28px;
    padding: 0 8px 0 26px;
    background: var(--tc-chip-bg);
    border: 1px solid var(--tc-card-border);
    border-radius: 6px;
    color: var(--tc-ink);
    font-size: 0.78rem;
    width: 160px;
    outline: none;
    transition: border-color 0.15s, width 0.2s;
  }
  .pl-search:focus {
    border-color: var(--tc-accent);
    width: 200px;
  }
  .pl-search::placeholder { color: var(--tc-muted); }
  .pl-search::-webkit-search-cancel-button { -webkit-appearance: none; }
</style>
