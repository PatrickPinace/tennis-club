---
// ParticipantsList — public participants card shared across SGL, AMR, RND views.
interface Props {
  participants: Array<{
    display_name: string;
    seed_number?: number | null;
  }>;
  count: number;
}

const { participants, count } = Astro.props;

function getInitials(name: string): string {
  return name.split(' ').filter((w: string) => w && w !== '/').slice(0, 2).map((w: string) => w[0]).join('');
}
---

{participants.length > 0 && (
  <div class="tc-card" style="margin-bottom:24px;">
    <div class="tc-card-header">
      <span class="tc-card-title">Uczestnicy ({count})</span>
    </div>
    <div class="td-participants-grid">
      {participants.map(p => (
        <div class="td-participant-card">
          <div class="td-participant-card__avatar-wrap">
            <div class="td-participant-card__avatar" aria-hidden="true">
              {getInitials(p.display_name)}
            </div>
            {p.seed_number && (
              <span class="td-participant-card__seed" title={`Rozstawienie #${p.seed_number}`}>
                #{p.seed_number}
              </span>
            )}
          </div>
          <div class="td-participant-card__info">
            <div class="td-participant-card__name">{p.display_name}</div>
            <div class="td-participant-card__status">
              {p.seed_number ? `Rozstawiony #${p.seed_number}` : 'Uczestnik'}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
)}
